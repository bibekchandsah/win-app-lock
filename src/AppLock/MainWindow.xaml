<Window
    x:Class="AppLock.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AppLock">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar with App Icon and Theme Sync -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="10">
                <Image x:Name="AppTitleIcon" 
                       Source="ms-appx:///icons/32x32.png" 
                       Width="18" Height="18" 
                       VerticalAlignment="Center"/>
                <TextBlock x:Name="AppTitleText" 
                           Text="AppLock" 
                           FontSize="12" 
                           FontWeight="Normal"
                           VerticalAlignment="Center" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Main Body (Navigation Rail + Content) -->
        <Grid x:Name="MainBodyGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavPaneColumn" Width="48"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Rail -->
            <Grid x:Name="NavRail" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top: Hamburger Toggle Pane Button -->
                <Button x:Name="NavTogglePaneButton"
                        Grid.Row="0"
                        Width="40" Height="40"
                        Margin="4,6,4,2"
                        Padding="0"
                        CornerRadius="6"
                        Click="NavTogglePaneButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Left"
                        ToolTipService.ToolTip="Toggle navigation pane">
                    <FontIcon x:Name="NavTogglePaneIcon" Glyph="&#xE700;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Button>

                <!-- Top Navigation Items -->
                <StackPanel Grid.Row="1" Spacing="4" Margin="0,4,0,0">
                    <Button x:Name="ProtectionNavButton" 
                            Height="40" 
                            Margin="4,0"
                            Padding="0"
                            CornerRadius="6"
                            Click="ProtectionNavButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ToolTipService.ToolTip="Protection">
                        <Grid Height="40" HorizontalAlignment="Stretch">
                            <Border x:Name="ProtectionNavBackground"
                                    CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="Collapsed"/>
                            <Border x:Name="ProtectionNavIndicator"
                                    Width="3" Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="1,0,0,0"
                                    CornerRadius="1.5"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed"/>
                            <Grid ColumnSpacing="0" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="ProtectionNavIcon" 
                                          Grid.Column="0"
                                          Glyph="&#xE72E;" 
                                          FontSize="16"
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ProtectionNavLabel"
                                           Grid.Column="1"
                                           Text="Protection"
                                           FontSize="13"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="6,0,12,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Button>
                    
                    <Button x:Name="RulesNavButton" 
                            Height="40" 
                            Margin="4,0"
                            Padding="0"
                            CornerRadius="6"
                            IsEnabled="False"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ToolTipService.ToolTip="Rules/Profiles (Coming Soon)">
                        <Grid Height="40" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="RulesNavIcon"
                                      Glyph="&#xE90F;" 
                                      Grid.Column="0"
                                      FontSize="16" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="RulesNavLabel"
                                       Grid.Column="1"
                                       Text="Rules (Coming Soon)"
                                       FontSize="13"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="6,0,12,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    
                    <Button x:Name="WebsitesNavButton" 
                            Height="40" 
                            Margin="4,0"
                            Padding="0"
                            CornerRadius="6"
                            IsEnabled="False"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ToolTipService.ToolTip="Websites (Phase 2)">
                        <Grid Height="40" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="WebsitesNavIcon"
                                      Glyph="&#xE774;" 
                                      Grid.Column="0"
                                      FontSize="16" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="WebsitesNavLabel"
                                       Grid.Column="1"
                                       Text="Websites (Phase 2)"
                                       FontSize="13"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="6,0,12,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Bottom Navigation Items -->
                <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,8">
                    <Button x:Name="FeedbackNavButton" 
                            Height="40" 
                            Margin="4,0"
                            Padding="0"
                            CornerRadius="6"
                            Click="FeedbackNavButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ToolTipService.ToolTip="Feedback &amp; Community">
                        <Grid Height="40" HorizontalAlignment="Stretch">
                            <Border x:Name="FeedbackNavBackground"
                                    CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="Collapsed"/>
                            <Border x:Name="FeedbackNavIndicator"
                                    Width="3" Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="1,0,0,0"
                                    CornerRadius="1.5"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed"/>
                            <Grid ColumnSpacing="0" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="FeedbackNavIcon" 
                                          Grid.Column="0"
                                          Glyph="&#xED15;" 
                                          FontSize="16"
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="FeedbackNavLabel"
                                           Grid.Column="1"
                                           Text="Feedback &amp; Community"
                                           FontSize="13"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="6,0,12,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Button>
                    
                    <Button x:Name="SettingsNavButton" 
                            Height="40" 
                            Margin="4,0"
                            Padding="0"
                            CornerRadius="6"
                            Click="SettingsNavButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ToolTipService.ToolTip="Settings">
                        <Grid Height="40" HorizontalAlignment="Stretch">
                            <Border x:Name="SettingsNavBackground"
                                    CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="Collapsed"/>
                            <Border x:Name="SettingsNavIndicator"
                                    Width="3" Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="1,0,0,0"
                                    CornerRadius="1.5"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed"/>
                            <Grid ColumnSpacing="0" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="SettingsNavIcon" 
                                          Grid.Column="0"
                                          Glyph="&#xE713;" 
                                          FontSize="16"
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="SettingsNavLabel"
                                           Grid.Column="1"
                                           Text="Settings"
                                           FontSize="13"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="6,0,12,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content Area -->
            <Frame x:Name="ContentFrame" Grid.Column="1" />
        </Grid>

        <!-- In-App Toast Notification Host (Matches Professional Fluent Style) -->
        <Border x:Name="InAppToastCard"
                Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Canvas.ZIndex="9999"
                Visibility="Collapsed"
                Background="{ThemeResource ToastBackgroundBrush}"
                BorderBrush="{ThemeResource ToastBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                MinWidth="280"
                MaxWidth="500">
            <Border.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="20"/>
                </TransitionCollection>
            </Border.Transitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Vertical Line using Window Accent Color -->
                <Border x:Name="ToastAccentBar"
                        Grid.Column="0"
                        Width="3.5"
                        CornerRadius="2"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        VerticalAlignment="Stretch"
                        Margin="0,2,0,2"/>

                <!-- Content: Title and Message -->
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ToastTitleText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="ToastMessageText"
                               FontSize="12"
                               TextWrapping="WrapWholeWords"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Close 'x' Button -->
                <Button x:Name="ToastCloseButton"
                        Grid.Column="2"
                        Click="ToastCloseButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6"
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        ToolTipService.ToolTip="Close">
                    <FontIcon x:Name="ToastCloseIcon" Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
