<Window
    x:Class="AppLock.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AppLock">

    <!-- The window itself is Mica; this translucent purple veil tints it (and becomes the whole
         window colour when Mica is unavailable, see SetupMica). -->
    <Grid x:Name="RootGrid" Background="{ThemeResource ShellWindowTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar with App Icon and Theme Sync -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="10">
                <Image x:Name="AppTitleIcon" 
                       Source="ms-appx:///icons/32x32.png" 
                       Width="18" Height="18" 
                       VerticalAlignment="Center"/>
                <TextBlock x:Name="AppTitleText" 
                           Text="AppLock" 
                           FontSize="12" 
                           FontWeight="Normal"
                           VerticalAlignment="Center" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Main Body (Navigation Rail + Content) -->
        <Grid x:Name="MainBodyGrid" Grid.Row="1" Margin="8,8,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavPaneColumn" Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Floating sidebar card: detached from the window edges, rounded, hairline border.
                 Its width is animated (column is Auto) so collapsing slides the content along. -->
            <Border x:Name="NavRailCard" Grid.Column="0" Width="50"
                    Background="{ThemeResource ShellCardFillBrush}"
                    BorderBrush="{ThemeResource ShellCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
            <Grid x:Name="NavRail" SizeChanged="NavRail_SizeChanged">
                <Grid.Resources>
                    <ResourceDictionary>
                        <!-- Theme-aware nav hover/press fills (the stock ones are invisible on a light pane).
                             Brushes are declared per theme with literal colours: struct resources such as
                             <Color>/<CornerRadius> do not survive element syntax here. -->
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26D9A0E8"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3DD9A0E8"/>
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26B79BE8"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3DB79BE8"/>
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top: Hamburger Toggle Pane Button. Its hover/pressed visuals are animated in code
                     (see NavTogglePaneButton_Pointer*), so the stock button states are transparent. -->
                <Button x:Name="NavTogglePaneButton"
                        Grid.Row="0"
                        Width="40" Height="40"
                        Margin="4,10,4,2"
                        Padding="0"
                        CornerRadius="8"
                        Click="NavTogglePaneButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Left"
                        PointerEntered="NavTogglePaneButton_PointerEntered"
                        PointerExited="NavTogglePaneButton_PointerExited"
                        PointerPressed="NavTogglePaneButton_PointerPressed"
                        PointerReleased="NavTogglePaneButton_PointerReleased"
                        PointerCaptureLost="NavTogglePaneButton_PointerExited"
                        ToolTipService.ToolTip="Toggle navigation pane">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                    </Button.Resources>
                    <Grid Width="40" Height="40">
                        <Border x:Name="NavToggleHoverFill"
                                CornerRadius="8"
                                Background="{ThemeResource ShellNavHoverBrush}"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                        <FontIcon x:Name="NavTogglePaneIcon" Glyph="&#xE700;" FontSize="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Button>

                <!-- Top Navigation Items -->
                <StackPanel Grid.Row="1" Spacing="4" Margin="0,4,0,0">
                    <Button x:Name="ProtectionNavButton" 
                            Height="40" 
                            Margin="4,0"
                            Padding="0"
                            CornerRadius="8"
                            Click="ProtectionNavButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ToolTipService.ToolTip="Protection">
                        <Grid Height="40" HorizontalAlignment="Stretch">
                            <Border x:Name="ProtectionNavBackground"
                                    CornerRadius="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="Collapsed"/>
                            <Border x:Name="ProtectionNavIndicator"
                                    Width="3" Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="1,0,0,0"
                                    CornerRadius="1.5"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed"/>
                            <Grid ColumnSpacing="0" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="ProtectionNavIcon" 
                                          Grid.Column="0"
                                          Glyph="&#xE72E;" 
                                          FontSize="16"
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ProtectionNavLabel"
                                           Grid.Column="1"
                                           Text="Protection"
                                           FontSize="13"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="6,0,12,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Button>
                    
                    <Button x:Name="RulesNavButton" 
                            Height="40" 
                            Margin="4,0"
                            Padding="0"
                            CornerRadius="8"
                            IsEnabled="False"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ToolTipService.ToolTip="Rules/Profiles (Coming Soon)">
                        <Grid Height="40" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="RulesNavIcon"
                                      Glyph="&#xE90F;" 
                                      Grid.Column="0"
                                      FontSize="16" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="RulesNavLabel"
                                       Grid.Column="1"
                                       Text="Rules (Coming Soon)"
                                       FontSize="13"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="6,0,12,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    
                    <Button x:Name="WebsitesNavButton" 
                            Height="40" 
                            Margin="4,0"
                            Padding="0"
                            CornerRadius="8"
                            IsEnabled="False"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ToolTipService.ToolTip="Websites (Phase 2)">
                        <Grid Height="40" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="WebsitesNavIcon"
                                      Glyph="&#xE774;" 
                                      Grid.Column="0"
                                      FontSize="16" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="WebsitesNavLabel"
                                       Grid.Column="1"
                                       Text="Websites (Phase 2)"
                                       FontSize="13"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="6,0,12,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Button>

                    <Button x:Name="InternetAccessNavButton" 
                            Height="40" 
                            Margin="4,0"
                            Padding="0"
                            CornerRadius="8"
                            Click="InternetAccessNavButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ToolTipService.ToolTip="Internet Access">
                        <Grid Height="40" HorizontalAlignment="Stretch">
                            <Border x:Name="InternetAccessNavBackground"
                                    CornerRadius="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="Collapsed"/>
                            <Border x:Name="InternetAccessNavIndicator"
                                    Width="3" Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="1,0,0,0"
                                    CornerRadius="1.5"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed"/>
                            <Grid ColumnSpacing="0" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="InternetAccessNavIcon" 
                                          Grid.Column="0"
                                          Glyph="&#xEB5E;" 
                                          FontSize="16"
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="InternetAccessNavLabel"
                                           Grid.Column="1"
                                           Text="Internet Access"
                                           FontSize="13"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="6,0,12,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Button>

                    <Button x:Name="BitLockerNavButton" 
                            Height="40" 
                            Margin="4,0"
                            Padding="0"
                            CornerRadius="8"
                            Click="BitLockerNavButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ToolTipService.ToolTip="BitLocker"
                            Visibility="Collapsed">
                        <Grid Height="40" HorizontalAlignment="Stretch">
                            <Border x:Name="BitLockerNavBackground"
                                    CornerRadius="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="Collapsed"/>
                            <Border x:Name="BitLockerNavIndicator"
                                    Width="3" Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="1,0,0,0"
                                    CornerRadius="1.5"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed"/>
                            <Grid ColumnSpacing="0" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="BitLockerNavIcon" 
                                          Grid.Column="0"
                                          Glyph="&#xEDA2;" 
                                          FontSize="16"
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="BitLockerNavLabel"
                                           Grid.Column="1"
                                           Text="BitLocker"
                                           FontSize="13"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="6,0,12,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Bottom Navigation Items -->
                <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,8">
                    <Button x:Name="OthersNavButton" 
                            Height="40" 
                            Margin="4,0"
                            Padding="0"
                            CornerRadius="8"
                            Click="OthersNavButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ToolTipService.ToolTip="Others">
                        <Grid Height="40" HorizontalAlignment="Stretch">
                            <Border x:Name="OthersNavBackground"
                                    CornerRadius="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="Collapsed"/>
                            <Border x:Name="OthersNavIndicator"
                                    Width="3" Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="1,0,0,0"
                                    CornerRadius="1.5"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed"/>
                            <Grid ColumnSpacing="0" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="OthersNavIcon" 
                                          Grid.Column="0"
                                          Glyph="&#xE712;" 
                                          FontSize="16"
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="OthersNavLabel"
                                           Grid.Column="1"
                                           Text="Others"
                                           FontSize="13"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="6,0,12,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Button>

                    <Button x:Name="FeedbackNavButton" 
                            Height="40" 
                            Margin="4,0"
                            Padding="0"
                            CornerRadius="8"
                            Click="FeedbackNavButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ToolTipService.ToolTip="Feedback &amp; Community">
                        <Grid Height="40" HorizontalAlignment="Stretch">
                            <Border x:Name="FeedbackNavBackground"
                                    CornerRadius="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="Collapsed"/>
                            <Border x:Name="FeedbackNavIndicator"
                                    Width="3" Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="1,0,0,0"
                                    CornerRadius="1.5"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed"/>
                            <Grid ColumnSpacing="0" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="FeedbackNavIcon" 
                                          Grid.Column="0"
                                          Glyph="&#xED15;" 
                                          FontSize="16"
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="FeedbackNavLabel"
                                           Grid.Column="1"
                                           Text="Feedback &amp; Community"
                                           FontSize="13"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="6,0,12,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Button>
                    
                    <Button x:Name="SettingsNavButton" 
                            Height="40" 
                            Margin="4,0"
                            Padding="0"
                            CornerRadius="8"
                            Click="SettingsNavButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ToolTipService.ToolTip="Settings">
                        <Grid Height="40" HorizontalAlignment="Stretch">
                            <Border x:Name="SettingsNavBackground"
                                    CornerRadius="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="Collapsed"/>
                            <Border x:Name="SettingsNavIndicator"
                                    Width="3" Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="1,0,0,0"
                                    CornerRadius="1.5"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed"/>
                            <Grid ColumnSpacing="0" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="SettingsNavIcon" 
                                          Grid.Column="0"
                                          Glyph="&#xE713;" 
                                          FontSize="16"
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="SettingsNavLabel"
                                           Grid.Column="1"
                                           Text="Settings"
                                           FontSize="13"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="6,0,12,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- One accent pill for the selected item: it slides between items rather than
                     popping in and out of each row. -->
                <Border x:Name="NavSelectionPill"
                        Grid.RowSpan="3"
                        Width="3" Height="18"
                        Margin="4,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        CornerRadius="1.5"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"/>
            </Grid>
            </Border>

            <!-- Main content card, same rounded/bordered treatment, 8 px away from the sidebar. -->
            <Border x:Name="ContentHost"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Background="{ThemeResource ShellCardFillBrush}"
                    BorderBrush="{ThemeResource ShellCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    SizeChanged="ContentHost_SizeChanged">
                <Frame x:Name="ContentFrame"/>
            </Border>
        </Grid>

        <!-- In-App Toast Notification Host (Matches Professional Fluent Style) -->
        <Border x:Name="InAppToastCard"
                Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Canvas.ZIndex="9999"
                Visibility="Collapsed"
                Background="{ThemeResource ToastBackgroundBrush}"
                BorderBrush="{ThemeResource ToastBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                MinWidth="280"
                MaxWidth="500">
            <Border.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="20"/>
                </TransitionCollection>
            </Border.Transitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Vertical Line using Window Accent Color -->
                <Border x:Name="ToastAccentBar"
                        Grid.Column="0"
                        Width="3.5"
                        CornerRadius="2"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        VerticalAlignment="Stretch"
                        Margin="0,2,0,2"/>

                <!-- Content: Title and Message -->
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ToastTitleText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="ToastMessageText"
                               FontSize="12"
                               TextWrapping="WrapWholeWords"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Close 'x' Button -->
                <Button x:Name="ToastCloseButton"
                        Grid.Column="2"
                        Click="ToastCloseButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6"
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        ToolTipService.ToolTip="Close">
                    <FontIcon x:Name="ToastCloseIcon" Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
