<Window
    x:Class="AppLock.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AppLock">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Rail -->
        <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Navigation Items -->
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,8,0,0">
                <Button x:Name="ProtectionNavButton" 
                        Width="40" Height="40" 
                        Margin="4,0"
                        Click="ProtectionNavButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Protection">
                    <FontIcon Glyph="&#xE72E;" FontSize="16"/>
                </Button>
                
                <Button x:Name="RulesNavButton" 
                        Width="40" Height="40" 
                        Margin="4,0"
                        IsEnabled="False"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Rules/Profiles (Coming Soon)">
                    <FontIcon Glyph="&#xE90F;" FontSize="16"/>
                </Button>
                
                <Button x:Name="WebsitesNavButton" 
                        Width="40" Height="40" 
                        Margin="4,0"
                        IsEnabled="False"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Websites (Phase 2)">
                    <FontIcon Glyph="&#xE774;" FontSize="16"/>
                </Button>
            </StackPanel>

            <!-- Bottom Navigation Items -->
            <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,8">
                <Button x:Name="FeedbackNavButton" 
                        Width="40" Height="40" 
                        Margin="4,0"
                        IsEnabled="False"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Feedback">
                    <FontIcon Glyph="&#xED15;" FontSize="16"/>
                </Button>
                
                <Button x:Name="SettingsNavButton" 
                        Width="40" Height="40" 
                        Margin="4,0"
                        Click="SettingsNavButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Frame x:Name="ContentFrame" Grid.Column="1" />
    </Grid>
</Window>
