<Application
    x:Class="AppLock.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AppLock"
    xmlns:tb="using:H.NotifyIcon">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme-aware overrides for modern design -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
                    <CornerRadius x:Key="ContentDialogCornerRadius">8</CornerRadius>
                    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
                    <SolidColorBrush x:Key="OverlayBackdropBrush" Color="#99141414"/>
                    <SolidColorBrush x:Key="OverlayCardBackgroundBrush" Color="#2C2C2C"/>
                    <SolidColorBrush x:Key="OverlayCardBorderBrush" Color="#3D3D3D"/>
                    <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#202020"/>
                    <SolidColorBrush x:Key="ToastBorderBrush" Color="#444444"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
                    <CornerRadius x:Key="ContentDialogCornerRadius">8</CornerRadius>
                    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
                    <SolidColorBrush x:Key="OverlayBackdropBrush" Color="#99141414"/>
                    <SolidColorBrush x:Key="OverlayCardBackgroundBrush" Color="#2C2C2C"/>
                    <SolidColorBrush x:Key="OverlayCardBorderBrush" Color="#3D3D3D"/>
                    <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#202020"/>
                    <SolidColorBrush x:Key="ToastBorderBrush" Color="#444444"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
                    <CornerRadius x:Key="ContentDialogCornerRadius">8</CornerRadius>
                    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
                    <SolidColorBrush x:Key="OverlayBackdropBrush" Color="#66000000"/>
                    <SolidColorBrush x:Key="OverlayCardBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="OverlayCardBorderBrush" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ToastBorderBrush" Color="#D1D1D1"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="ContentDialogCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
            
            <!-- App-wide accent color -->
            <Color x:Key="AccentColor">#D9A0E8</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

            
            <!-- Tray Icon -->
            <tb:TaskbarIcon
                x:Key="AppTrayIcon"
                ToolTipText="AppLock">
                
                <tb:TaskbarIcon.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="OpenMenuItem" Text="Open AppLock">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8A7;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        
                        <MenuFlyoutSeparator/>
                        
                        <MenuFlyoutItem x:Name="ProtectionMenuItem" Text="Disable Protection">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72E;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        
                        <MenuFlyoutSeparator/>
                        
                        <MenuFlyoutItem x:Name="EmergencyLockMenuItem" Text="Emergency Lock">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72E;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        
                        <MenuFlyoutSeparator/>

                        <!-- Clipboard Controls -->
                        <MenuFlyoutItem x:Name="ClipboardToggleMenuItem" Text="Disable Clipboard">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem x:Name="ClipboardHistoryMenuItem" Text="Open history">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE81C;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSubItem x:Name="ClipboardPauseSubItem" Text="Pause capture">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE769;"/>
                            </MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem x:Name="ClipboardPause5mItem" Text="Pause for 5 minutes"/>
                            <MenuFlyoutItem x:Name="ClipboardPause15mItem" Text="Pause for 15 minutes"/>
                            <MenuFlyoutItem x:Name="ClipboardPause1hItem" Text="Pause for 1 hour"/>
                            <MenuFlyoutItem x:Name="ClipboardPauseIndefiniteItem" Text="Pause until resumed"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="ClipboardResumeItem" Text="Resume capture">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE768;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>

                        <MenuFlyoutSeparator/>
                        
                        <MenuFlyoutItem x:Name="BrightnessHotkeysMenuItem" Text="Disable Brightness Hotkeys">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE706;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        
                        <MenuFlyoutItem x:Name="BlurHotkeyMenuItem" Text="Disable Blur Hotkey">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7B3;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        
                        <MenuFlyoutSeparator/>

                        <!-- Eye Care Controls -->
                        <MenuFlyoutItem x:Name="EyeCareToggleMenuItem" Text="Disable Eye Care">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7B3;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSubItem x:Name="EyeCareIntervalSubItem" Text="Reminder interval">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE823;"/>
                            </MenuFlyoutSubItem.Icon>
                            <ToggleMenuFlyoutItem x:Name="EyeCareInterval1mItem" Text="1 minute"/>
                            <ToggleMenuFlyoutItem x:Name="EyeCareInterval20mItem" Text="20 minutes"/>
                            <ToggleMenuFlyoutItem x:Name="EyeCareInterval25mItem" Text="25 minutes"/>
                            <ToggleMenuFlyoutItem x:Name="EyeCareInterval30mItem" Text="30 minutes"/>
                            <ToggleMenuFlyoutItem x:Name="EyeCareInterval60mItem" Text="60 minutes"/>
                            <MenuFlyoutSeparator/>
                            <ToggleMenuFlyoutItem x:Name="EyeCareIntervalCustomItem" Text="Custom..."/>
                        </MenuFlyoutSubItem>
                        
                        <MenuFlyoutSeparator/>

                        <!-- Ring Light Controls -->
                        <MenuFlyoutItem x:Name="RingLightToggleMenuItem" Text="Enable Ring Light">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE781;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSubItem x:Name="RingLightPresetsSubItem" Text="Ring Light Presets">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE721;"/>
                            </MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem x:Name="PresetWarmMenuItem"    Text="Warm"/>
                            <MenuFlyoutItem x:Name="PresetNeutralMenuItem" Text="Neutral"/>
                            <MenuFlyoutItem x:Name="PresetCoolMenuItem"    Text="Cool"/>
                            <MenuFlyoutItem x:Name="PresetSoftMenuItem"    Text="Soft"/>
                            <MenuFlyoutItem x:Name="PresetStudioMenuItem"  Text="Studio"/>
                            <MenuFlyoutItem x:Name="PresetMaxMenuItem"     Text="Max light"/>
                        </MenuFlyoutSubItem>
                        
                        <MenuFlyoutSeparator/>
                        
                        <MenuFlyoutItem x:Name="ExitMenuItem" Text="Exit">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE711;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </tb:TaskbarIcon.ContextFlyout>
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
