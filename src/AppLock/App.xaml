<Application
    x:Class="AppLock.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AppLock"
    xmlns:tb="using:H.NotifyIcon">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme-aware overrides for modern design -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- Shell tokens -->
                    <Color x:Key="ShellWindowTintColor">#4D1B1426</Color>
                    <Color x:Key="ShellWindowFallbackColor">#FF1B1426</Color>
                    <Color x:Key="ShellCardFillColor">#12FFFFFF</Color>
                    <Color x:Key="ShellCardBorderColor">#1AFFFFFF</Color>
                    <Color x:Key="ShellNavHoverColor">#26D9A0E8</Color>
                    <Color x:Key="ShellNavPressedColor">#3DD9A0E8</Color>
                    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
                    <CornerRadius x:Key="ContentDialogCornerRadius">8</CornerRadius>
                    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
                    <SolidColorBrush x:Key="OverlayBackdropBrush" Color="#99141414"/>
                    <SolidColorBrush x:Key="OverlayCardBackgroundBrush" Color="#2C2C2C"/>
                    <SolidColorBrush x:Key="OverlayCardBorderBrush" Color="#3D3D3D"/>
                    <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#202020"/>
                    <SolidColorBrush x:Key="ToastBorderBrush" Color="#444444"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!-- Shell tokens: purple-tinted Mica, translucent cards, lavender hover -->
                    <Color x:Key="ShellWindowTintColor">#4D1B1426</Color>
                    <Color x:Key="ShellWindowFallbackColor">#FF1B1426</Color>
                    <Color x:Key="ShellCardFillColor">#12FFFFFF</Color>
                    <Color x:Key="ShellCardBorderColor">#1AFFFFFF</Color>
                    <Color x:Key="ShellNavHoverColor">#26D9A0E8</Color>
                    <Color x:Key="ShellNavPressedColor">#3DD9A0E8</Color>
                    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
                    <CornerRadius x:Key="ContentDialogCornerRadius">8</CornerRadius>
                    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
                    <SolidColorBrush x:Key="OverlayBackdropBrush" Color="#99141414"/>
                    <SolidColorBrush x:Key="OverlayCardBackgroundBrush" Color="#2C2C2C"/>
                    <SolidColorBrush x:Key="OverlayCardBorderBrush" Color="#3D3D3D"/>
                    <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#202020"/>
                    <SolidColorBrush x:Key="ToastBorderBrush" Color="#444444"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <!-- Shell tokens: light-lavender tint, white cards, soft grey hover -->
                    <Color x:Key="ShellWindowTintColor">#4DF7F2FB</Color>
                    <Color x:Key="ShellWindowFallbackColor">#FFF6F1FB</Color>
                    <Color x:Key="ShellCardFillColor">#B3FFFFFF</Color>
                    <Color x:Key="ShellCardBorderColor">#14000000</Color>
                    <Color x:Key="ShellNavHoverColor">#26B79BE8</Color>
                    <Color x:Key="ShellNavPressedColor">#3DB79BE8</Color>
                    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
                    <CornerRadius x:Key="ContentDialogCornerRadius">8</CornerRadius>
                    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
                    <SolidColorBrush x:Key="OverlayBackdropBrush" Color="#66000000"/>
                    <SolidColorBrush x:Key="OverlayCardBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="OverlayCardBorderBrush" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ToastBorderBrush" Color="#D1D1D1"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Shell styling: one place for radii, gaps and the floating-card colours -->
            <CornerRadius x:Key="ShellCornerRadius">12</CornerRadius>
            <CornerRadius x:Key="ShellNavItemCornerRadius">8</CornerRadius>
            <SolidColorBrush x:Key="ShellWindowTintBrush" Color="{ThemeResource ShellWindowTintColor}"/>
            <SolidColorBrush x:Key="ShellWindowFallbackBrush" Color="{ThemeResource ShellWindowFallbackColor}"/>
            <SolidColorBrush x:Key="ShellCardFillBrush" Color="{ThemeResource ShellCardFillColor}"/>
            <SolidColorBrush x:Key="ShellCardBorderBrush" Color="{ThemeResource ShellCardBorderColor}"/>
            <SolidColorBrush x:Key="ShellNavHoverBrush" Color="{ThemeResource ShellNavHoverColor}"/>
            <SolidColorBrush x:Key="ShellNavPressedBrush" Color="{ThemeResource ShellNavPressedColor}"/>

            <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="ContentDialogCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
            
            <!-- App-wide accent color -->
            <Color x:Key="AccentColor">#D9A0E8</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

            
            <!-- Tray Icon -->
            <tb:TaskbarIcon
                x:Key="AppTrayIcon"
                ToolTipText="AppLock">
                
                <tb:TaskbarIcon.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="OpenMenuItem" Text="Open AppLock">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8A7;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        
                        <MenuFlyoutSeparator/>
                        
                        <MenuFlyoutItem x:Name="ProtectionMenuItem" Text="Disable Protection">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72E;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        
                        <MenuFlyoutSeparator/>
                        
                        <MenuFlyoutItem x:Name="EmergencyLockMenuItem" Text="Emergency Lock">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72E;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        
                        <MenuFlyoutSeparator/>

                        <!-- Clipboard Controls -->
                        <MenuFlyoutItem x:Name="ClipboardToggleMenuItem" Text="Disable Clipboard">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem x:Name="ClipboardHistoryMenuItem" Text="Open history">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE81C;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSubItem x:Name="ClipboardPauseSubItem" Text="Pause capture">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE769;"/>
                            </MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem x:Name="ClipboardPause5mItem" Text="Pause for 5 minutes"/>
                            <MenuFlyoutItem x:Name="ClipboardPause15mItem" Text="Pause for 15 minutes"/>
                            <MenuFlyoutItem x:Name="ClipboardPause1hItem" Text="Pause for 1 hour"/>
                            <MenuFlyoutItem x:Name="ClipboardPauseIndefiniteItem" Text="Pause until resumed"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="ClipboardResumeItem" Text="Resume capture">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE768;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>

                        <MenuFlyoutSeparator/>
                        
                        <MenuFlyoutItem x:Name="BrightnessHotkeysMenuItem" Text="Disable Brightness Hotkeys">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE706;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        
                        <MenuFlyoutItem x:Name="BlurHotkeyMenuItem" Text="Disable Blur Hotkey">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7B3;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        
                        <MenuFlyoutSeparator/>

                        <!-- Eye Care Controls -->
                        <MenuFlyoutItem x:Name="EyeCareToggleMenuItem" Text="Disable Eye Care">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7B3;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSubItem x:Name="EyeCareIntervalSubItem" Text="Reminder interval">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE823;"/>
                            </MenuFlyoutSubItem.Icon>
                            <ToggleMenuFlyoutItem x:Name="EyeCareInterval1mItem" Text="1 minute"/>
                            <ToggleMenuFlyoutItem x:Name="EyeCareInterval20mItem" Text="20 minutes"/>
                            <ToggleMenuFlyoutItem x:Name="EyeCareInterval25mItem" Text="25 minutes"/>
                            <ToggleMenuFlyoutItem x:Name="EyeCareInterval30mItem" Text="30 minutes"/>
                            <ToggleMenuFlyoutItem x:Name="EyeCareInterval60mItem" Text="60 minutes"/>
                            <MenuFlyoutSeparator/>
                            <ToggleMenuFlyoutItem x:Name="EyeCareIntervalCustomItem" Text="Custom..."/>
                        </MenuFlyoutSubItem>
                        
                        <MenuFlyoutSeparator/>

                        <!-- Ring Light Controls -->
                        <MenuFlyoutItem x:Name="RingLightToggleMenuItem" Text="Enable Ring Light">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE781;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSubItem x:Name="RingLightPresetsSubItem" Text="Ring Light Presets">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE721;"/>
                            </MenuFlyoutSubItem.Icon>
                            <ToggleMenuFlyoutItem x:Name="PresetWarmMenuItem"    Text="Warm"/>
                            <ToggleMenuFlyoutItem x:Name="PresetNeutralMenuItem" Text="Neutral"/>
                            <ToggleMenuFlyoutItem x:Name="PresetCoolMenuItem"    Text="Cool"/>
                            <ToggleMenuFlyoutItem x:Name="PresetSoftMenuItem"    Text="Soft"/>
                            <ToggleMenuFlyoutItem x:Name="PresetStudioMenuItem"  Text="Studio"/>
                            <ToggleMenuFlyoutItem x:Name="PresetMaxMenuItem"     Text="Max light"/>
                        </MenuFlyoutSubItem>
                        
                        <MenuFlyoutSeparator/>
                        
                        <!-- Volume Mixer Controls -->
                        <MenuFlyoutItem x:Name="VolumeMixerToggleMenuItem" Text="Enable Volume Mixer">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE767;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSubItem x:Name="VolumeMixerPositionSubItem" Text="Icon Position">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE762;"/>
                            </MenuFlyoutSubItem.Icon>
                            <ToggleMenuFlyoutItem x:Name="VmPosTopLeftItem"      Text="Top Left"/>
                            <ToggleMenuFlyoutItem x:Name="VmPosTopCenterItem"    Text="Top Center"/>
                            <ToggleMenuFlyoutItem x:Name="VmPosTopRightItem"     Text="Top Right"/>
                            <ToggleMenuFlyoutItem x:Name="VmPosBottomLeftItem"   Text="Bottom Left"/>
                            <ToggleMenuFlyoutItem x:Name="VmPosBottomCenterItem" Text="Bottom Center"/>
                            <ToggleMenuFlyoutItem x:Name="VmPosBottomRightItem"  Text="Bottom Right"/>
                        </MenuFlyoutSubItem>
                        
                        <MenuFlyoutSeparator/>

                        <!-- Notification Position Controls -->
                        <MenuFlyoutItem x:Name="NotificationEnabledMenuItem" Text="Enable Notification Positioning">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE91C;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSubItem x:Name="NotificationPositionSubItem" Text="Anchor Position">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE762;"/>
                            </MenuFlyoutSubItem.Icon>
                            <ToggleMenuFlyoutItem x:Name="NotifTopLeftMenuItem"      Text="Top Left"/>
                            <ToggleMenuFlyoutItem x:Name="NotifTopCenterMenuItem"    Text="Top Center"/>
                            <ToggleMenuFlyoutItem x:Name="NotifTopRightMenuItem"     Text="Top Right"/>
                            <ToggleMenuFlyoutItem x:Name="NotifMiddleLeftMenuItem"   Text="Middle Left"/>
                            <ToggleMenuFlyoutItem x:Name="NotifCenterMenuItem"       Text="Center"/>
                            <ToggleMenuFlyoutItem x:Name="NotifMiddleRightMenuItem"  Text="Middle Right"/>
                            <ToggleMenuFlyoutItem x:Name="NotifBottomLeftMenuItem"   Text="Bottom Left"/>
                            <ToggleMenuFlyoutItem x:Name="NotifBottomCenterMenuItem" Text="Bottom Center"/>
                            <ToggleMenuFlyoutItem x:Name="NotifBottomRightMenuItem"  Text="Bottom Right"/>
                            <MenuFlyoutSeparator/>
                            <ToggleMenuFlyoutItem x:Name="NotifCustomMenuItem"       Text="Custom..."/>
                        </MenuFlyoutSubItem>
                        
                        <MenuFlyoutSeparator/>
                        
                        <MenuFlyoutItem x:Name="ExitMenuItem" Text="Exit">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE711;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </tb:TaskbarIcon.ContextFlyout>
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
