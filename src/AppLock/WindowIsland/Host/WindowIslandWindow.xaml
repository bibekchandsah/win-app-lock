<Window
    x:Class="AppLock.WindowIsland.Host.WindowIslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="Transparent" PointerWheelChanged="OnRootGridPointerWheelChanged">
        <Grid.Resources>
            <Style x:Key="TabButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="#C0FFFFFF" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#20FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#30FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="QuietButtonStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="#30FFFFFF" />
                <Setter Property="Foreground" Value="#A0FFFFFF" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Height" Value="26" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#15FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#25FFFFFF" />
                                                <Setter Target="Root.BorderBrush" Value="#60CDFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PinButtonStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="#A0FFFFFF" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#20FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#20FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <!-- ═══════════════════════════════════════════════════════════════
             FOLDED LAYER — clock + battery (shown when island is collapsed)
        ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="FoldedLayer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Height="32"
              IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">

                <!-- Folded media mini (shown when media is playing) -->
                <StackPanel x:Name="FoldedMediaMini"
                            Orientation="Horizontal"
                            Spacing="5"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Border Width="22" Height="22" CornerRadius="3" Background="#28FFFFFF">
                        <Image x:Name="FoldedArt" Stretch="UniformToFill" />
                    </Border>
                    <!-- Equalizer bars animated via code-behind -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Border x:Name="EqBar0" Width="3" Height="8"
                                Background="#60CDFF" CornerRadius="1"
                                VerticalAlignment="Bottom" />
                        <Border x:Name="EqBar1" Width="3" Height="12"
                                Background="#60CDFF" CornerRadius="1"
                                VerticalAlignment="Bottom" />
                        <Border x:Name="EqBar2" Width="3" Height="6"
                                Background="#60CDFF" CornerRadius="1"
                                VerticalAlignment="Bottom" />
                    </StackPanel>
                </StackPanel>

                <!-- Folded timer mini (shows countdown when timer is running) -->
                <StackPanel x:Name="FoldedTimerMini"
                            Orientation="Horizontal"
                            Spacing="3"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE916;" FontSize="10" Foreground="#60CDFF" />
                    <TextBlock x:Name="FoldedTimerText"
                               Text="05:00"
                               FontFamily="Segoe UI Variable Small"
                               FontSize="11"
                               Foreground="#60CDFF"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Folded weather mini (shows temperature + weather icon) -->
                <StackPanel x:Name="FoldedWeatherMini"
                            Orientation="Horizontal"
                            Spacing="3"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <FontIcon x:Name="FoldedWeatherIcon" Glyph="&#xE706;" FontSize="10" Foreground="#FFD700" />
                    <TextBlock x:Name="FoldedWeatherTemp"
                               Text="21°"
                               FontFamily="Segoe UI Variable Small"
                               FontSize="11"
                               Foreground="#D0FFFFFF"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Clock -->
                <StackPanel x:Name="ClockContainer"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="#99FFFFFF" />
                    <TextBlock x:Name="FoldedClockText"
                               Text="12:45"
                               FontFamily="Segoe UI Variable Display"
                               FontWeight="SemiBold"
                               FontSize="12"
                               CharacterSpacing="0"
                               Foreground="#F0FFFFFF"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Battery -->
                <StackPanel x:Name="BatteryContainer"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <FontIcon x:Name="BatteryIcon"
                              Glyph="&#xE83F;"
                              FontSize="12"
                              Foreground="#99FFFFFF" />
                    <TextBlock x:Name="FoldedBatteryText"
                               Text="100%"
                               FontFamily="Segoe UI Variable Small"
                               FontSize="11"
                               Foreground="#C0FFFFFF"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Milestone 12: Mic / Camera indicator dots -->
                <!-- Orange dot = microphone active, Green dot = camera active -->
                <StackPanel x:Name="MicCamDotsContainer"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Ellipse x:Name="MicDot"
                             Width="6" Height="6"
                             Fill="#FFAA00"
                             Visibility="Collapsed"
                             ToolTipService.ToolTip="Microphone in use" />
                    <Ellipse x:Name="CamDot"
                             Width="6" Height="6"
                             Fill="#22CC44"
                             Visibility="Collapsed"
                             ToolTipService.ToolTip="Camera in use" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             LIVE CARD LAYER — temporary pop-out cards (Caps Lock, Volume, Copied, etc.)
        ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="CardLayer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Height="38"
              Opacity="0"
              IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Padding="14,0,14,0">
                <FontIcon x:Name="CardIcon"
                          Glyph="&#xE7BA;"
                          FontSize="13"
                          Foreground="#60CDFF"
                          VerticalAlignment="Center" />
                <TextBlock x:Name="CardTitle"
                           Text="Caps Lock"
                           FontFamily="Segoe UI Variable Display"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="#F0FFFFFF"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="CardDetail"
                           Text="On"
                           FontFamily="Segoe UI Variable Small"
                           FontSize="11"
                           Foreground="#C0FFFFFF"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="180"
                           VerticalAlignment="Center" />
                <!-- Optional Volume Progress Bar -->
                <ProgressBar x:Name="CardProgressBar"
                             Width="56"
                             Height="4"
                             Minimum="0"
                             Maximum="100"
                             Value="50"
                             Foreground="#60CDFF"
                             VerticalAlignment="Center"
                             Visibility="Collapsed" />
                <TextBlock x:Name="CardValueText"
                           Text="50%"
                           FontFamily="Segoe UI Variable Small"
                           FontSize="11"
                           Foreground="#90FFFFFF"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             COMMAND BAR LAYER — Alt+Space or Command Tile
        ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="CommandLayer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Width="520"
              Height="270"
              Opacity="0"
              IsHitTestVisible="False">
            <Grid Margin="16,10,16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Search Box -->
                    <RowDefinition Height="*"    /> <!-- Results list -->
                    <RowDefinition Height="Auto" /> <!-- Footer shortcuts -->
                </Grid.RowDefinitions>

                <!-- Search Input Box -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*"    />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE721;"
                              FontSize="13"
                              Foreground="#60CDFF"
                              VerticalAlignment="Center"
                              Margin="4,0,8,0" />
                    <TextBox x:Name="CommandInput"
                             Grid.Column="1"
                             PlaceholderText="Search files, apps, commands, or calculate…"
                             FontSize="12"
                             Background="Transparent"
                             BorderBrush="Transparent"
                             Foreground="#F0FFFFFF"
                             Padding="2,4"
                             TextChanged="CommandInput_TextChanged"
                             KeyDown="CommandInput_KeyDown" />
                    <Button x:Name="CommandCloseBtn"
                            Grid.Column="2"
                            Style="{StaticResource TabButtonStyle}"
                            Width="26" Height="26"
                            Click="CommandClose_Click"
                            ToolTipService.ToolTip="Close (Esc)">
                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                    </Button>
                </Grid>

                <!-- Divider -->
                <Border Grid.Row="0"
                        Height="1"
                        Background="#20FFFFFF"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,-2" />

                <!-- Results List -->
                <ScrollViewer Grid.Row="1"
                              Margin="0,6,0,6"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CommandResultList" Spacing="2" />
                </ScrollViewer>

                <!-- Footer Hints -->
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <TextBlock Text="↵ Open  ·  Ctrl+↵ In folder  ·  Alt+↵ Copy  ·  Esc Close"
                               FontSize="9"
                               Foreground="#50FFFFFF"
                               HorizontalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             OPEN LAYER — tab strip + content (shown when island is expanded)
        ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="OpenLayer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Width="560"
              Height="250"
              Opacity="0"
              IsHitTestVisible="False">

            <Grid Margin="16,10,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />  <!-- Tab bar row -->
                    <RowDefinition Height="*"  />  <!-- Content area -->
                    <RowDefinition Height="20" />  <!-- Frame stats row -->
                </Grid.RowDefinitions>

                <!-- ── Tab Bar ──────────────────────────────────────────────── -->
                <Grid Grid.Row="0">
                    <!-- Left: 8 tab buttons -->
                    <StackPanel x:Name="TabStrip"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">

                        <!-- Home -->
                        <Button x:Name="TabHome"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="0"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Home">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="TabHomeIcon" Glyph="&#xE80F;" FontSize="13" />
                                <TextBlock x:Name="TabHomeText" Text="Home" FontSize="11" />
                            </StackPanel>
                        </Button>

                        <!-- Clipboard -->
                        <Button x:Name="TabClipboard"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="1"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Clipboard">
                            <FontIcon x:Name="TabClipboardIcon" Glyph="&#xF0E3;" FontSize="13" />
                        </Button>

                        <!-- Shelf -->
                        <Button x:Name="TabShelf"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="2"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Shelf">
                            <FontIcon x:Name="TabShelfIcon" Glyph="&#xE8F1;" FontSize="13" />
                        </Button>

                        <!-- Text -->
                        <Button x:Name="TabText"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="3"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Text tools">
                            <FontIcon x:Name="TabTextIcon" Glyph="&#xE8D2;" FontSize="13" />
                        </Button>

                        <!-- Chat -->
                        <Button x:Name="TabChat"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="4"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Chat (AI)">
                            <FontIcon x:Name="TabChatIcon" Glyph="&#xE8BD;" FontSize="13" />
                        </Button>

                        <!-- Note -->
                        <Button x:Name="TabNote"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="5"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Note &amp; Timer">
                            <FontIcon x:Name="TabNoteIcon" Glyph="&#xE70B;" FontSize="13" />
                        </Button>

                        <!-- Weather -->
                        <Button x:Name="TabWeather"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="6"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Weather">
                            <FontIcon x:Name="TabWeatherIcon" Glyph="&#xE9CA;" FontSize="13" />
                        </Button>

                        <!-- Controls -->
                        <Button x:Name="TabControls"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="7"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Controls">
                            <FontIcon x:Name="TabControlsIcon" Glyph="&#xE713;" FontSize="13" />
                        </Button>
                    </StackPanel>

                    <!-- Right: Quiet chip + Pin + Settings -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">

                        <!-- Quiet chip (hide cards temporarily) -->
                        <ToggleButton x:Name="QuietButton"
                                      Style="{StaticResource QuietButtonStyle}"
                                      ToolTipService.ToolTip="Quiet — pause live cards"
                                      Click="OnQuietClick">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <FontIcon Glyph="&#xE74F;" FontSize="11" />
                                <TextBlock Text="Quiet" FontSize="10" />
                            </StackPanel>
                        </ToggleButton>

                        <!-- Pin open -->
                        <ToggleButton x:Name="PinButton"
                                      Style="{StaticResource PinButtonStyle}"
                                      ToolTipService.ToolTip="Pin open"
                                      Click="OnPinClick">
                            <FontIcon Glyph="&#xE840;" FontSize="13" />
                        </ToggleButton>

                        <!-- Settings -->
                        <Button Style="{StaticResource TabButtonStyle}"
                                ToolTipService.ToolTip="Island settings"
                                Click="OnIslandSettingsClick">
                            <FontIcon Glyph="&#xE713;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ── Content Area ─────────────────────────────────────────── -->
                <Grid x:Name="ContentHost" Grid.Row="1">

                    <!-- Tab indicator strip (1px line under tab buttons, slides to active tab) -->
                    <Border x:Name="TabIndicator"
                            Width="24" Height="2"
                            Background="#60CDFF"
                            CornerRadius="1"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Left"
                            Margin="0,-2,0,0" />

                    <!-- Home tab — media player + volume + 8 tiles + launcher shortcuts -->
                    <Grid x:Name="ContentHome" Opacity="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*"   />
                        </Grid.ColumnDefinitions>

                        <!-- ── Left column: media player + recent + volume ── -->
                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,2,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"  />
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Media player panel (shown when a session exists) -->
                            <StackPanel x:Name="MediaPlayerPanel"
                                        Grid.Row="0"
                                        Spacing="4"
                                        Visibility="Collapsed">

                                <!-- Art + text row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*"  />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="40" Height="40"
                                            CornerRadius="4"
                                            Background="#28FFFFFF"
                                            VerticalAlignment="Top">
                                        <Image x:Name="MediaArt"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="6,0,0,0"
                                                Spacing="1"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="MediaTitle"
                                                   Text="—"
                                                   FontFamily="Segoe UI Variable Display"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="#F0FFFFFF"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="MediaArtist"
                                                   Text=""
                                                   FontSize="11"
                                                   Foreground="#B0FFFFFF"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="MediaApp"
                                                   Text=""
                                                   FontSize="10"
                                                   Foreground="#70FFFFFF"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <!-- Progress bar (Slider styled thin) -->
                                <Slider x:Name="MediaProgress"
                                        Minimum="0" Maximum="1"
                                        Value="0"
                                        HorizontalAlignment="Stretch"
                                        Height="14" />

                                <!-- Playback controls -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="4">
                                    <Button x:Name="MediaPrev"
                                            Click="MediaPrev_Click"
                                            Width="32" Height="32"
                                            Style="{StaticResource TabButtonStyle}"
                                            ToolTipService.ToolTip="Previous">
                                        <FontIcon Glyph="&#xE7C2;" FontSize="13" />
                                    </Button>
                                    <Button x:Name="MediaPlayPause"
                                            Click="MediaPlayPause_Click"
                                            Width="36" Height="36"
                                            Style="{StaticResource TabButtonStyle}"
                                            ToolTipService.ToolTip="Play / Pause">
                                        <FontIcon x:Name="MediaPlayPauseIcon" Glyph="&#xE768;" FontSize="15" />
                                    </Button>
                                    <Button x:Name="MediaNext"
                                            Click="MediaNext_Click"
                                            Width="32" Height="32"
                                            Style="{StaticResource TabButtonStyle}"
                                            ToolTipService.ToolTip="Next">
                                        <FontIcon Glyph="&#xE7C1;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Recent clipboard (shown when no media) -->
                            <StackPanel x:Name="RecentPanel"
                                        Grid.Row="0"
                                        Spacing="4"
                                        Visibility="Visible">
                                <TextBlock Text="RECENTLY COPIED"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#60FFFFFF"
                                           CharacterSpacing="80" />
                                <TextBlock x:Name="Recent0"
                                           Text="—"
                                           FontSize="11"
                                           Foreground="#C0FFFFFF"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="Recent1"
                                           Text="—"
                                           FontSize="11"
                                           Foreground="#80FFFFFF"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Volume row (always visible at bottom of left col) -->
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*"    />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="VolumeIcon"
                                          Grid.Column="0"
                                          Glyph="&#xE993;"
                                          FontSize="12"
                                          Foreground="#90FFFFFF"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0" />
                                <Slider x:Name="VolumeSlider"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        ValueChanged="VolumeSlider_ValueChanged" />
                                <TextBlock x:Name="VolumeText"
                                           Grid.Column="2"
                                           Text="—"
                                           FontSize="11"
                                           Foreground="#90FFFFFF"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"
                                           MinWidth="30" />
                            </Grid>
                        </Grid>

                        <!-- ── Right column: 2×4 tile grid ── -->
                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Row 0 -->
                            <Button x:Name="TileArea"
                                    Grid.Row="0" Grid.Column="0"
                                    Margin="2" HorizontalAlignment="Stretch"
                                    Click="TileArea_Click"
                                    Style="{StaticResource TabButtonStyle}"
                                    ToolTipService.ToolTip="Area capture (Win+Shift+S)">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE7C8;" FontSize="12" />
                                    <TextBlock Text="Area" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TileFullScreen"
                                    Grid.Row="0" Grid.Column="1"
                                    Margin="2" HorizontalAlignment="Stretch"
                                    Click="TileFullScreen_Click"
                                    Style="{StaticResource TabButtonStyle}"
                                    ToolTipService.ToolTip="Full screen capture">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="12" />
                                    <TextBlock Text="Full" FontSize="10" />
                                </StackPanel>
                            </Button>

                            <!-- Row 1 -->
                            <Button x:Name="TileScreenText"
                                    Grid.Row="1" Grid.Column="0"
                                    Margin="2" HorizontalAlignment="Stretch"
                                    Click="TileScreenText_Click"
                                    Style="{StaticResource TabButtonStyle}"
                                    ToolTipService.ToolTip="Screen text (Win+Shift+T / PowerToys)">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8D2;" FontSize="12" />
                                    <TextBlock Text="Text" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TileQR"
                                    Grid.Row="1" Grid.Column="1"
                                    Margin="2" HorizontalAlignment="Stretch"
                                    Click="TileQR_Click"
                                    Style="{StaticResource TabButtonStyle}"
                                    ToolTipService.ToolTip="Scan QR code from screen">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE774;" FontSize="12" />
                                    <TextBlock Text="QR" FontSize="10" />
                                </StackPanel>
                            </Button>

                            <!-- Row 2 -->
                            <Button x:Name="TileNetwork"
                                    Grid.Row="2" Grid.Column="0"
                                    Margin="2" HorizontalAlignment="Stretch"
                                    Click="TileNetwork_Click"
                                    Style="{StaticResource TabButtonStyle}"
                                    ToolTipService.ToolTip="Network speed">
                                <StackPanel Spacing="1">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <FontIcon Glyph="&#xE8BE;" FontSize="10" />
                                        <TextBlock Text="Net" FontSize="9" />
                                    </StackPanel>
                                    <TextBlock x:Name="TileNetDown"
                                               Text="↓ —"
                                               FontSize="9"
                                               Foreground="#90FFFFFF" />
                                    <TextBlock x:Name="TileNetUp"
                                               Text="↑ —"
                                               FontSize="9"
                                               Foreground="#90FFFFFF" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TileCpuRam"
                                    Grid.Row="2" Grid.Column="1"
                                    Margin="2" HorizontalAlignment="Stretch"
                                    Click="TileCpuRam_Click"
                                    Style="{StaticResource TabButtonStyle}"
                                    ToolTipService.ToolTip="CPU &amp; RAM (opens Task Manager)">
                                <StackPanel Spacing="1">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="10" />
                                        <TextBlock Text="Sys" FontSize="9" />
                                    </StackPanel>
                                    <TextBlock x:Name="TileCpuText"
                                               Text="CPU —"
                                               FontSize="9"
                                               Foreground="#90FFFFFF" />
                                    <TextBlock x:Name="TileRamText"
                                               Text="RAM —"
                                               FontSize="9"
                                               Foreground="#90FFFFFF" />
                                </StackPanel>
                            </Button>

                            <!-- Row 3 -->
                            <Button x:Name="TileRecord"
                                    Grid.Row="3" Grid.Column="0"
                                    Margin="2" HorizontalAlignment="Stretch"
                                    Click="TileRecord_Click"
                                    Style="{StaticResource TabButtonStyle}"
                                    ToolTipService.ToolTip="Record screen (Win+Shift+R)">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE7A0;" FontSize="12" />
                                    <TextBlock Text="Record" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TileCommand"
                                    Grid.Row="3" Grid.Column="1"
                                    Margin="2" HorizontalAlignment="Stretch"
                                    Click="TileCommand_Click"
                                    Style="{StaticResource TabButtonStyle}"
                                    ToolTipService.ToolTip="Command bar">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE773;" FontSize="12" />
                                    <TextBlock Text="Cmd" FontSize="10" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- ── Bottom row: Shortcuts (launcher) ── -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                              AllowDrop="True"
                              DragOver="LauncherRow_DragOver"
                              Drop="LauncherRow_Drop">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Enabled"
                                          VerticalScrollMode="Disabled">
                                <StackPanel x:Name="LauncherList"
                                            Orientation="Horizontal"
                                            Spacing="5"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="LauncherEmptyText"
                                               Text="Drop app shortcuts, folders or files here"
                                               FontSize="10"
                                               Foreground="#50FFFFFF"
                                               VerticalAlignment="Center"
                                               Margin="4,0,4,0" />
                                    <Button x:Name="LauncherAddBtn"
                                            Width="30" Height="30"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderBrush="#40FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Click="LauncherAddBtn_Click"
                                            ToolTipService.ToolTip="Add shortcut">
                                        <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="#C0FFFFFF" />
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- In-island Add Dialog Overlay -->
                        <Border x:Name="LauncherAddOverlay"
                                Grid.RowSpan="2" Grid.ColumnSpan="2"
                                Background="#F0181818"
                                CornerRadius="8"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                Padding="14,10"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="A link for the launcher"
                                           FontFamily="Segoe UI Variable Display"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="#F0FFFFFF"
                                           Margin="0,0,0,6" />

                                <TextBox x:Name="LauncherTargetInput"
                                         Grid.Row="1"
                                         PlaceholderText="https://… or file/folder path"
                                         FontSize="11"
                                         Background="#20FFFFFF"
                                         Foreground="#F0FFFFFF"
                                         BorderBrush="#30FFFFFF"
                                         CornerRadius="5"
                                         Padding="8,4"
                                         Margin="0,0,0,4" />

                                <TextBox x:Name="LauncherNameInput"
                                         Grid.Row="2"
                                         PlaceholderText="Name (optional)"
                                         FontSize="11"
                                         Background="#20FFFFFF"
                                         Foreground="#F0FFFFFF"
                                         BorderBrush="#30FFFFFF"
                                         CornerRadius="5"
                                         Padding="8,4"
                                         Margin="0,0,0,4" />

                                <CheckBox x:Name="LauncherUseAppIconCheck"
                                          Grid.Row="3"
                                          Content="Use the site's or app's own icon"
                                          IsChecked="True"
                                          FontSize="10"
                                          Foreground="#C0FFFFFF"
                                          Margin="0,0,0,6" />

                                <StackPanel Grid.Row="4"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="6">
                                    <Button Content="Cancel"
                                            FontSize="11"
                                            Padding="10,3"
                                            CornerRadius="5"
                                            Style="{StaticResource TabButtonStyle}"
                                            Click="LauncherAddCancel_Click" />
                                    <Button x:Name="LauncherAddConfirmBtn"
                                            Content="Add"
                                            FontSize="11"
                                            Padding="14,3"
                                            CornerRadius="5"
                                            Background="#60CDFF"
                                            Foreground="#000000"
                                            FontWeight="SemiBold"
                                            Click="LauncherAddConfirm_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Clipboard tab -->
                    <Grid x:Name="ContentClipboard" Opacity="0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*"    />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Search + Clear row -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"    />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ClipboardSearch"
                                     Grid.Column="0"
                                     PlaceholderText="Search…"
                                     FontSize="11"
                                     Background="#20FFFFFF"
                                     Foreground="#F0FFFFFF"
                                     BorderBrush="#30FFFFFF"
                                     CornerRadius="6"
                                     Padding="8,4"
                                     TextChanged="ClipboardSearch_TextChanged" />
                            <Button x:Name="ClipboardClearBtn"
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Content="Clear"
                                    FontSize="10"
                                    Padding="8,4"
                                    CornerRadius="6"
                                    Click="ClipboardClear_Click"
                                    Style="{StaticResource TabButtonStyle}"
                                    ToolTipService.ToolTip="Clear clipboard history" />
                        </Grid>

                        <!-- Item list -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ClipboardList" Spacing="2" />
                        </ScrollViewer>

                        <!-- Footer hint -->
                        <TextBlock Grid.Row="2"
                                   Text="Click to paste · Shift+click to copy only"
                                   FontSize="9"
                                   Foreground="#50FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </Grid>

                    <!-- Shelf tab -->
                    <Grid x:Name="ContentShelf" Opacity="0" Visibility="Collapsed"
                          AllowDrop="True"
                          DragOver="ShelfGrid_DragOver"
                          Drop="ShelfGrid_Drop">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"    />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Drop hint overlay (shown when dragging over) -->
                        <Border x:Name="ShelfDropHint"
                                Grid.RowSpan="2"
                                Background="#15FFFFFF"
                                BorderBrush="#60CDFF"
                                BorderThickness="2"
                                CornerRadius="8"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <TextBlock Text="Drop files here"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#60CDFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <!-- File list or empty state -->
                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ShelfList" Spacing="4">
                                <TextBlock x:Name="ShelfEmptyText"
                                           Text="Drop app shortcuts, folders or files here."
                                           FontSize="11"
                                           Foreground="#50FFFFFF"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,16,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Clear all button -->
                        <Button x:Name="ShelfClearBtn"
                                Grid.Row="1"
                                Content="Clear all"
                                FontSize="10"
                                Padding="8,4"
                                CornerRadius="6"
                                HorizontalAlignment="Right"
                                Margin="0,4,0,0"
                                Click="ShelfClear_Click"
                                Style="{StaticResource TabButtonStyle}"
                                ToolTipService.ToolTip="Remove all shelf items" />
                    </Grid>

                    <!-- Text tab (Milestone 14: Text Tools & Transforms) -->
                    <Grid x:Name="ContentText" Opacity="0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*"    />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header / Quick Actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Text Helpers"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFFFF" />
                                <TextBlock x:Name="TextStatsSummaryText"
                                           Text="0 words · 0 chars"
                                           FontSize="11"
                                           Foreground="#80FFFFFF"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="TextPastePlainBtn"
                                        Click="TextPastePlainBtn_Click"
                                        ToolTipService.ToolTip="Paste as plain text to active app (strips formatting)"
                                        Height="26"
                                        Padding="8,2"
                                        CornerRadius="13"
                                        Background="#15FFFFFF"
                                        BorderBrush="#25FFFFFF"
                                        BorderThickness="1"
                                        Foreground="#E0FFFFFF">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE77F;" FontSize="11" />
                                        <TextBlock Text="Paste Plain" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TextDictationBtn"
                                        Click="TextDictationBtn_Click"
                                        ToolTipService.ToolTip="Trigger Windows Voice Typing (Win + H)"
                                        Height="26"
                                        Padding="8,2"
                                        CornerRadius="13"
                                        Background="#15FFFFFF"
                                        BorderBrush="#25FFFFFF"
                                        BorderThickness="1"
                                        Foreground="#E0FFFFFF">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE720;" FontSize="11" Foreground="#60CDFF" />
                                        <TextBlock Text="Dictation" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TextFetchClipboardBtn"
                                        Click="TextFetchClipboardBtn_Click"
                                        ToolTipService.ToolTip="Reload from current clipboard"
                                        Width="26" Height="26"
                                        Padding="0"
                                        CornerRadius="13"
                                        Background="#15FFFFFF"
                                        BorderBrush="#25FFFFFF"
                                        BorderThickness="1"
                                        Foreground="#C0FFFFFF">
                                    <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Transform Toolbar -->
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,0,0,6"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button x:Name="TextUpperBtn"
                                        Click="TextUpperBtn_Click"
                                        Content="UPPERCASE"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextLowerBtn"
                                        Click="TextLowerBtn_Click"
                                        Content="lowercase"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextTitleBtn"
                                        Click="TextTitleBtn_Click"
                                        Content="Title Case"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextTrimBtn"
                                        Click="TextTrimBtn_Click"
                                        Content="Trim"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextNoBreaksBtn"
                                        Click="TextNoBreaksBtn_Click"
                                        Content="No Breaks"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextSortBtn"
                                        Click="TextSortBtn_Click"
                                        Content="Sort Lines"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextClearBtn"
                                        Click="TextClearBtn_Click"
                                        Content="Clear"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#A0FFFFFF" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Text Editor / Preview -->
                        <Border Grid.Row="2"
                                Background="#181920"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="4">
                            <TextBox x:Name="TextInputBox"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontSize="11"
                                     Background="Transparent"
                                     Foreground="#E8FFFFFF"
                                     BorderThickness="0"
                                     Padding="4"
                                     PlaceholderText="Type or paste text here, or switch to this tab to load clipboard text..."
                                     TextChanged="TextInputBox_TextChanged" />
                        </Border>

                        <!-- Bottom Stats & Copy/Paste -->
                        <Grid Grid.Row="3" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TextStatsDetailedText"
                                       Grid.Column="0"
                                       Text="Lines: 0 · Words: 0 · Chars: 0 (no spaces: 0)"
                                       FontSize="10"
                                       Foreground="#80FFFFFF"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="TextCopyResultBtn"
                                        Click="TextCopyResultBtn_Click"
                                        Height="24"
                                        Padding="8,2"
                                        CornerRadius="12"
                                        Background="#15FFFFFF"
                                        BorderBrush="#25FFFFFF"
                                        BorderThickness="1"
                                        Foreground="#E0FFFFFF">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="10" />
                                        <TextBlock x:Name="TextCopyResultBtnText" Text="Copy" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TextPasteToAppBtn"
                                        Click="TextPasteToAppBtn_Click"
                                        Height="24"
                                        Padding="8,2"
                                        CornerRadius="12"
                                        Background="#2060CDFF"
                                        BorderBrush="#5060CDFF"
                                        BorderThickness="1"
                                        Foreground="#60CDFF">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE77F;" FontSize="10" />
                                        <TextBlock x:Name="TextPasteToAppBtnText" Text="Paste to App" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Chat tab (Milestone 13: WebView2 AI Assistants) -->
                    <Grid x:Name="ContentChat" Opacity="0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header strip: Sub-tabs and tool buttons -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Assistant Sub-Tabs list (ChatGPT, Claude, Copilot, etc.) -->
                            <ScrollViewer Grid.Column="0"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Enabled"
                                          VerticalScrollMode="Disabled">
                                <StackPanel x:Name="ChatSubTabsPanel"
                                            Orientation="Horizontal"
                                            Spacing="4" />
                            </ScrollViewer>

                            <!-- Tools: Add custom assistant, Popout to browser, Refresh -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        Margin="8,0,0,0">
                                <Button x:Name="ChatAddBtn"
                                        Click="ChatAddBtn_Click"
                                        ToolTipService.ToolTip="Add custom AI assistant"
                                        Width="28" Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="14">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="#C0FFFFFF" />
                                </Button>
                                <Button x:Name="ChatRefreshBtn"
                                        Click="ChatRefreshBtn_Click"
                                        ToolTipService.ToolTip="Reload active chat"
                                        Width="28" Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="14">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="#C0FFFFFF" />
                                </Button>
                                <Button x:Name="ChatPopoutBtn"
                                        Click="ChatPopoutBtn_Click"
                                        ToolTipService.ToolTip="Open in default browser"
                                        Width="28" Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="14">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="12" Foreground="#C0FFFFFF" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Content host (Skeleton / Fallback / WebView2) -->
                        <Border Grid.Row="1"
                                Background="#1A1A1A"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <!-- WebView2 Host -->
                                <Grid x:Name="ChatWebViewHost" />

                                <!-- Loading / Skeleton overlay -->
                                <StackPanel x:Name="ChatSkeletonPanel"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="10"
                                            Visibility="Collapsed">
                                    <ProgressBar IsIndeterminate="True" Width="140" />
                                    <TextBlock x:Name="ChatSkeletonText"
                                               Text="Loading AI Assistant..."
                                               FontSize="12"
                                               Foreground="#A0FFFFFF"
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Fallback overlay (when WebView2 runtime is missing) -->
                                <StackPanel x:Name="ChatFallbackPanel"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="12"
                                            MaxWidth="320"
                                            Visibility="Collapsed">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="28" Foreground="#FFCC00" HorizontalAlignment="Center" />
                                    <TextBlock Text="Microsoft Edge WebView2 Runtime is required to render AI chats inside Window Island."
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               FontSize="12"
                                               Foreground="#D0FFFFFF" />
                                    <Button x:Name="ChatDownloadWebView2Btn"
                                            Click="ChatDownloadWebView2_Click"
                                            Content="Download Runtime"
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Padding="12,6" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- In-island Add Custom Site Overlay -->
                        <Border x:Name="ChatAddOverlay"
                                Grid.RowSpan="2"
                                Background="#E6181920"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Width="300"
                                        Spacing="10">
                                <TextBlock Text="Add Custom AI Site"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFFFF" />
                                <TextBox x:Name="ChatNewNameBox"
                                         Header="Site Name"
                                         PlaceholderText="e.g. DeepSeek, Perplexity"
                                         FontSize="12" />
                                <TextBox x:Name="ChatNewUrlBox"
                                         Header="HTTPS URL"
                                         PlaceholderText="https://..."
                                         FontSize="12" />
                                <TextBlock x:Name="ChatAddErrorText"
                                           Foreground="#FFFF6B6B"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="8"
                                            Margin="0,6,0,0">
                                    <Button Content="Cancel"
                                            Click="ChatCancelAdd_Click"
                                            FontSize="12"
                                            Padding="12,4" />
                                    <Button Content="Add"
                                            Click="ChatConfirmAdd_Click"
                                            FontSize="12"
                                            Padding="16,4" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Note & Timer tab -->
                    <Grid x:Name="ContentNote" Opacity="0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"   /> <!-- Left: Notes editor -->
                            <ColumnDefinition Width="200" /> <!-- Right: Timer & Reminders -->
                        </Grid.ColumnDefinitions>

                        <!-- ── Left: Note Editor ── -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Note Tab Strip + actions -->
                                <RowDefinition Height="*"    /> <!-- Text editor -->
                            </Grid.RowDefinitions>

                            <!-- Note headers + tools -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"    />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Note tabs (horizontally scrollable) -->
                                <ScrollViewer Grid.Column="0"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollMode="Enabled">
                                    <StackPanel x:Name="NoteTabStrip"
                                                Orientation="Horizontal"
                                                Spacing="4" />
                                </ScrollViewer>

                                <!-- Add note, Copy note, Delete note -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="2">
                                    <Button x:Name="NoteAddBtn"
                                            Style="{StaticResource TabButtonStyle}"
                                            Width="24" Height="24"
                                            Padding="0"
                                            Click="NoteAddBtn_Click"
                                            ToolTipService.ToolTip="Add new note">
                                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                                    </Button>
                                    <Button x:Name="NoteCopyBtn"
                                            Style="{StaticResource TabButtonStyle}"
                                            Width="24" Height="24"
                                            Padding="0"
                                            Click="NoteCopyBtn_Click"
                                            ToolTipService.ToolTip="Copy note content">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                    </Button>
                                    <Button x:Name="NoteDeleteBtn"
                                            Style="{StaticResource TabButtonStyle}"
                                            Width="24" Height="24"
                                            Padding="0"
                                            Click="NoteDeleteBtn_Click"
                                            ToolTipService.ToolTip="Delete current note">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Multi-line text box -->
                            <TextBox x:Name="NoteContentBox"
                                     Grid.Row="1"
                                     PlaceholderText="Write anything here: an order number, a to-do list, a code snippet. It saves itself."
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontSize="11"
                                     Background="#15FFFFFF"
                                     Foreground="#F0FFFFFF"
                                     BorderBrush="#25FFFFFF"
                                     CornerRadius="6"
                                     Padding="8,6"
                                     TextChanged="NoteContentBox_TextChanged" />
                        </Grid>

                        <!-- ── Right: Timer & Reminders ── -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Timer panel -->
                                <RowDefinition Height="Auto" /> <!-- Divider -->
                                <RowDefinition Height="*"    /> <!-- Reminders panel -->
                            </Grid.RowDefinitions>

                            <!-- Timer Section -->
                            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"    />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE916;" FontSize="11" Foreground="#60CDFF" />
                                        <TextBlock Text="TIMER"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="#60FFFFFF"
                                                   CharacterSpacing="80" />
                                    </StackPanel>
                                    <TextBlock x:Name="TimerDisplay"
                                               Grid.Column="1"
                                               Text="05:00"
                                               FontFamily="Consolas"
                                               FontWeight="SemiBold"
                                               FontSize="15"
                                               Foreground="#60CDFF"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!-- Preset buttons row -->
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                                    <Button Content="5m" FontSize="9" Padding="6,2" CornerRadius="4" Style="{StaticResource TabButtonStyle}" Click="TimerPreset_Click" Tag="5" />
                                    <Button Content="10m" FontSize="9" Padding="6,2" CornerRadius="4" Style="{StaticResource TabButtonStyle}" Click="TimerPreset_Click" Tag="10" />
                                    <Button Content="15m" FontSize="9" Padding="6,2" CornerRadius="4" Style="{StaticResource TabButtonStyle}" Click="TimerPreset_Click" Tag="15" />
                                    <Button Content="25m" FontSize="9" Padding="6,2" CornerRadius="4" Style="{StaticResource TabButtonStyle}" Click="TimerPreset_Click" Tag="25" />
                                </StackPanel>

                                <!-- Timer control buttons -->
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <Button x:Name="TimerStartBtn"
                                            Content="Start"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Padding="10,2"
                                            CornerRadius="4"
                                            Background="#2560CDFF"
                                            Foreground="#60CDFF"
                                            Click="TimerStartBtn_Click" />
                                    <Button x:Name="TimerResetBtn"
                                            Content="Reset"
                                            FontSize="10"
                                            Padding="8,2"
                                            CornerRadius="4"
                                            Style="{StaticResource TabButtonStyle}"
                                            Click="TimerResetBtn_Click" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Grid.Row="1" Height="1" Background="#20FFFFFF" Margin="0,0,0,6" />

                            <!-- Reminders Section -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*"    />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                                    <FontIcon Glyph="&#xEA8F;" FontSize="10" Foreground="#FF8C00" />
                                    <TextBlock Text="REMINDERS"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="#60FFFFFF"
                                               CharacterSpacing="80" />
                                </StackPanel>

                                <!-- Quick add input box -->
                                <TextBox x:Name="ReminderQuickInput"
                                         Grid.Row="1"
                                         PlaceholderText="Call mum in 10m…"
                                         FontSize="10"
                                         Background="#15FFFFFF"
                                         Foreground="#F0FFFFFF"
                                         BorderBrush="#25FFFFFF"
                                         CornerRadius="5"
                                         Padding="6,3"
                                         Margin="0,0,0,4"
                                         KeyDown="ReminderQuickInput_KeyDown" />

                                <!-- Reminders List -->
                                <ScrollViewer Grid.Row="2"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="ReminderList" Spacing="2" />
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ═══════════════════════════════════════════════════════════
                         WEATHER TAB (Milestone 10)
                    ════════════════════════════════════════════════════════════ -->
                    <Grid x:Name="ContentWeather" Opacity="0" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="215"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Card: Current Conditions & Outlook -->
                            <Border Grid.Column="0"
                                    Background="#18FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10,12,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- City header + change button -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="WeatherCityText"
                                                   Text="No city set"
                                                   FontFamily="Segoe UI Variable Display"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#F0FFFFFF"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                x:Name="WeatherChangeCityBtn"
                                                Click="WeatherChangeCityBtn_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,2"
                                                Margin="4,0,0,0"
                                                ToolTipService.ToolTip="Change location">
                                            <FontIcon Glyph="&#xE70F;" FontSize="10" Foreground="#80FFFFFF"/>
                                        </Button>
                                    </Grid>

                                    <!-- Temperature & Condition Icon -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,2,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="WeatherBigTemp"
                                                   Text="--"
                                                   FontFamily="Segoe UI Variable Display"
                                                   FontWeight="SemiBold"
                                                   FontSize="36"
                                                   Foreground="#FFFFFFFF"
                                                   VerticalAlignment="Center"/>
                                        <FontIcon x:Name="WeatherConditionIcon"
                                                  Glyph="&#xE706;"
                                                  FontSize="24"
                                                  Foreground="#FFD700"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Condition & Feels Like -->
                                    <StackPanel Grid.Row="2" Spacing="1">
                                        <TextBlock x:Name="WeatherConditionText"
                                                   Text="Tap to set location"
                                                   FontFamily="Segoe UI Variable Small"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="#E0FFFFFF"/>
                                        <TextBlock x:Name="WeatherFeelsLikeText"
                                                   Text="Feels like -- · H: -- L: --"
                                                   FontFamily="Segoe UI Variable Small"
                                                   FontSize="11"
                                                   Foreground="#90FFFFFF"/>
                                    </StackPanel>

                                    <!-- Summary Outlook -->
                                    <TextBlock Grid.Row="3"
                                               x:Name="WeatherOutlookText"
                                               Text="Data from MET Norway. Tap location to configure."
                                               FontFamily="Segoe UI Variable Small"
                                               FontSize="10"
                                               Foreground="#80FFFFFF"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               Margin="0,4,0,0"/>

                                    <!-- Footer: Refresh + Attribution -->
                                    <Grid Grid.Row="5" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button x:Name="WeatherRefreshBtn"
                                                    Click="WeatherRefreshBtn_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="3"
                                                    ToolTipService.ToolTip="Refresh weather">
                                                <FontIcon Glyph="&#xE72C;" FontSize="10" Foreground="#A0FFFFFF"/>
                                            </Button>
                                            <TextBlock x:Name="WeatherUpdatedText"
                                                       Text="Updated just now"
                                                       FontFamily="Segoe UI Variable Small"
                                                       FontSize="9"
                                                       Foreground="#70FFFFFF"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="MET Norway"
                                                   FontFamily="Segoe UI Variable Small"
                                                   FontSize="9"
                                                   Foreground="#50FFFFFF"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Right Card: Hours/Week Forecast + Metric Tiles -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="74"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Hours / Week Tab Selector -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                                    <Button x:Name="WeatherBtnHours"
                                            Content="Hourly"
                                            Click="WeatherBtnHours_Click"
                                            Padding="10,2"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Background="#25FFFFFF"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            Foreground="#FFFFFFFF"/>
                                    <Button x:Name="WeatherBtnWeek"
                                            Content="7-Day"
                                            Click="WeatherBtnWeek_Click"
                                            Padding="10,2"
                                            FontSize="11"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            Foreground="#90FFFFFF"/>
                                </StackPanel>

                                <!-- Forecast View -->
                                <Grid Grid.Row="1">
                                    <!-- Hourly Scroll Strip -->
                                    <ScrollViewer x:Name="WeatherHoursScroll"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="WeatherHoursStack"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Padding="1,2,1,2"/>
                                    </ScrollViewer>

                                    <!-- 7-Day Outlook Strip -->
                                    <ScrollViewer x:Name="WeatherWeekScroll"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Visibility="Collapsed">
                                        <StackPanel x:Name="WeatherWeekStack"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Padding="1,2,1,2"/>
                                    </ScrollViewer>
                                </Grid>

                                <!-- 6 Metric Tiles -->
                                <Grid Grid.Row="2" Margin="0,6,0,0" RowSpacing="5" ColumnSpacing="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Wind Tile -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                        <StackPanel Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE728;" FontSize="10" Foreground="#60CDFF"/>
                                                <TextBlock Text="Wind" FontSize="9" Foreground="#80FFFFFF"/>
                                            </StackPanel>
                                            <TextBlock x:Name="WeatherWindText" Text="-- m/s" FontSize="11" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Humidity Tile -->
                                    <Border Grid.Row="0" Grid.Column="1" Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                        <StackPanel Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE958;" FontSize="10" Foreground="#60CDFF"/>
                                                <TextBlock Text="Humidity" FontSize="9" Foreground="#80FFFFFF"/>
                                            </StackPanel>
                                            <TextBlock x:Name="WeatherHumidityText" Text="-- %" FontSize="11" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pressure Tile -->
                                    <Border Grid.Row="0" Grid.Column="2" Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                        <StackPanel Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xEC4A;" FontSize="10" Foreground="#60CDFF"/>
                                                <TextBlock Text="Pressure" FontSize="9" Foreground="#80FFFFFF"/>
                                            </StackPanel>
                                            <TextBlock x:Name="WeatherPressureText" Text="-- hPa" FontSize="11" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Sun Tile (Sunrise/Sunset) -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                        <StackPanel Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE706;" FontSize="10" Foreground="#FFD700"/>
                                                <TextBlock Text="Sun" FontSize="9" Foreground="#80FFFFFF"/>
                                            </StackPanel>
                                            <TextBlock x:Name="WeatherSunText" Text="-- · --" FontSize="11" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Precipitation Tile -->
                                    <Border Grid.Row="1" Grid.Column="1" Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                        <StackPanel Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE754;" FontSize="10" Foreground="#60CDFF"/>
                                                <TextBlock Text="Rain Today" FontSize="9" Foreground="#80FFFFFF"/>
                                            </StackPanel>
                                            <TextBlock x:Name="WeatherPrecipText" Text="0.0 mm" FontSize="11" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- UV Index Tile -->
                                    <Border Grid.Row="1" Grid.Column="2" Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                        <StackPanel Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE706;" FontSize="10" Foreground="#FF9800"/>
                                                <TextBlock Text="UV Index" FontSize="9" Foreground="#80FFFFFF"/>
                                            </StackPanel>
                                            <TextBlock x:Name="WeatherUvText" Text="0 (Low)" FontSize="11" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        </StackPanel>
                                    </Border>

                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- ── City Search Overlay ──────────────────────────────── -->
                        <Border x:Name="WeatherCityOverlay"
                                Background="#F2181920"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Spacing="2">
                                    <TextBlock Text="Where should the weather be for?"
                                               FontFamily="Segoe UI Variable Display"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="#FFFFFFFF"/>
                                    <TextBlock Text="Type your city. Your location is never guessed from your IP address."
                                               FontFamily="Segoe UI Variable Small"
                                               FontSize="11"
                                               Foreground="#90FFFFFF"/>
                                </StackPanel>

                                <!-- Search row -->
                                <Grid Grid.Row="1" Margin="0,10,0,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WeatherSearchInput"
                                             PlaceholderText="e.g. London, Tokyo, New York, Oslo"
                                             KeyDown="WeatherSearchInput_KeyDown"
                                             CornerRadius="4"/>
                                    <Button Grid.Column="1"
                                            x:Name="WeatherSearchSubmit"
                                            Content="Search"
                                            Click="WeatherSearchSubmit_Click"
                                            CornerRadius="4"/>
                                    <Button Grid.Column="2"
                                            x:Name="WeatherSearchCancel"
                                            Content="Cancel"
                                            Click="WeatherSearchCancel_Click"
                                            CornerRadius="4"
                                            Background="Transparent"
                                            BorderThickness="0"/>
                                </Grid>

                                <TextBlock Grid.Row="2"
                                           x:Name="WeatherSearchFeedback"
                                           Text=""
                                           FontSize="11"
                                           Foreground="#80FFFFFF"
                                           Margin="0,0,0,4"
                                           Visibility="Collapsed"/>

                                <!-- Results list -->
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="WeatherSearchResultsStack" Spacing="4"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ═══════════════════════════════════════════════════════════
                         CONTROLS TAB (Milestone 11)
                    ════════════════════════════════════════════════════════════ -->
                    <Grid x:Name="ContentControls" Opacity="0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: 5 Control Tiles (Wi-Fi, Bluetooth, Dark Theme, Battery, VPN) -->
                        <Grid Grid.Row="0" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Wi-Fi Tile -->
                            <Button Grid.Column="0"
                                    x:Name="ControlsWifiBtn"
                                    Click="ControlsWifiBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="#15FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    ToolTipService.ToolTip="Toggle Wi-Fi">
                                <StackPanel Spacing="2">
                                    <FontIcon x:Name="ControlsWifiIcon" Glyph="&#xE701;" FontSize="14" Foreground="#60CDFF" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Wi-Fi" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                    <TextBlock x:Name="ControlsWifiStatus" Text="Connected" FontSize="9" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- Bluetooth Tile -->
                            <Button Grid.Column="1"
                                    x:Name="ControlsBtBtn"
                                    Click="ControlsBtBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="#15FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    ToolTipService.ToolTip="Toggle Bluetooth">
                                <StackPanel Spacing="2">
                                    <FontIcon x:Name="ControlsBtIcon" Glyph="&#xE702;" FontSize="14" Foreground="#60CDFF" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Bluetooth" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                    <TextBlock x:Name="ControlsBtStatus" Text="On" FontSize="9" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- Dark Theme Tile -->
                            <Button Grid.Column="2"
                                    x:Name="ControlsThemeBtn"
                                    Click="ControlsThemeBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="#15FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    ToolTipService.ToolTip="Toggle Windows dark theme">
                                <StackPanel Spacing="2">
                                    <FontIcon x:Name="ControlsThemeIcon" Glyph="&#xE790;" FontSize="14" Foreground="#60CDFF" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Dark Theme" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                    <TextBlock x:Name="ControlsThemeStatus" Text="Dark" FontSize="9" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- Battery Tile -->
                            <Button Grid.Column="3"
                                    x:Name="ControlsBatteryBtn"
                                    Click="ControlsBatteryBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="#15FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    ToolTipService.ToolTip="Battery &amp; power settings">
                                <StackPanel Spacing="2">
                                    <FontIcon x:Name="ControlsBatteryIcon" Glyph="&#xE83F;" FontSize="14" Foreground="#60CDFF" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Battery" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                    <TextBlock x:Name="ControlsBatteryStatus" Text="100%" FontSize="9" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- VPN Tile -->
                            <Button Grid.Column="4"
                                    x:Name="ControlsVpnBtn"
                                    Click="ControlsVpnBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="#15FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    ToolTipService.ToolTip="VPN connection">
                                <StackPanel Spacing="2">
                                    <FontIcon x:Name="ControlsVpnIcon" Glyph="&#xE705;" FontSize="14" Foreground="#80FFFFFF" HorizontalAlignment="Left"/>
                                    <TextBlock Text="VPN" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                    <TextBlock x:Name="ControlsVpnStatus" Text="Off" FontSize="9" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Row 1: Brightness Slider Row (compact sleek row) -->
                        <Border Grid.Row="1"
                                Margin="0,8,0,0"
                                Background="#12FFFFFF"
                                BorderBrush="#18FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE706;" FontSize="13" Foreground="#FFD700" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1"
                                        x:Name="ControlsBrightnessSlider"
                                        ValueChanged="ControlsBrightnessSlider_ValueChanged"
                                        VerticalAlignment="Center"
                                        Margin="0,-6,0,-6"/>
                                <TextBlock Grid.Column="2"
                                           x:Name="ControlsBrightnessText"
                                           Text="100%"
                                           FontSize="10"
                                           Foreground="#A0FFFFFF"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Row 2: 4 System Power Buttons (Lock, Sleep, Restart [confirming], Shut Down [confirming]) -->
                        <Grid Grid.Row="2" Margin="0,8,0,0" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Lock -->
                            <Button Grid.Column="0"
                                    x:Name="ControlsLockBtn"
                                    Click="ControlsLockBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="#18FFFFFF"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="4,6">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="#C0FFFFFF"/>
                                    <TextBlock Text="Lock" FontSize="11" Foreground="#F0FFFFFF"/>
                                </StackPanel>
                            </Button>

                            <!-- Sleep -->
                            <Button Grid.Column="1"
                                    x:Name="ControlsSleepBtn"
                                    Click="ControlsSleepBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="#18FFFFFF"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="4,6">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE708;" FontSize="12" Foreground="#C0FFFFFF"/>
                                    <TextBlock Text="Sleep" FontSize="11" Foreground="#F0FFFFFF"/>
                                </StackPanel>
                            </Button>

                            <!-- Restart (Double-tap safety) -->
                            <Button Grid.Column="2"
                                    x:Name="ControlsRestartBtn"
                                    Click="ControlsRestartBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="#18FFFFFF"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="4,6">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                    <FontIcon x:Name="ControlsRestartIcon" Glyph="&#xE777;" FontSize="12" Foreground="#C0FFFFFF"/>
                                    <TextBlock x:Name="ControlsRestartText" Text="Restart" FontSize="11" Foreground="#F0FFFFFF"/>
                                </StackPanel>
                            </Button>

                            <!-- Shut Down (Double-tap safety) -->
                            <Button Grid.Column="3"
                                    x:Name="ControlsShutdownBtn"
                                    Click="ControlsShutdownBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="#18FFFFFF"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="4,6">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                    <FontIcon x:Name="ControlsShutdownIcon" Glyph="&#xE7E8;" FontSize="12" Foreground="#FF6B6B"/>
                                    <TextBlock x:Name="ControlsShutdownText" Text="Shut down" FontSize="11" Foreground="#F0FFFFFF"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ── Frame stats overlay ──────────────────────────────────── -->
                <Grid Grid.Row="2">
                    <TextBlock x:Name="FrameStatsText"
                               Text=""
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="#4CC2FF"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="BenchStatusText"
                               Text=""
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="#6CCB5F"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</Window>
