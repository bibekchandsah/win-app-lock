<Window
    x:Class="AppLock.WindowIsland.Host.WindowIslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <Style x:Key="TabButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="#C0FFFFFF" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="6" />
                <!-- No FontFamily here: it leaked into every TextBlock inside these buttons and
                     turned the tile and tab labels into boxes. FontIcon brings its own glyph font. -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#20FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#30FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- Media play/pause: a white disc that stays white on hover. The stock button
                 template swaps in the theme's hover brush, which turned the disc dark and
                 swallowed the black glyph. -->
            <Style x:Key="MediaPlayButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#F2FFFFFF" />
                <Setter Property="Foreground" Value="#101010" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="19" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Disc"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Disc.Opacity" Value="0.88" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Disc.Opacity" Value="0.72" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Home tiles: same look as a tab button, but they fill their cell and hold two lines
                 of text (label plus a live reading), so the fixed 32 px height of a tab would clip. -->
            <Style x:Key="TileButtonStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="BorderBrush" Value="#16FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="9,4" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="QuietButtonStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="#30FFFFFF" />
                <Setter Property="Foreground" Value="#A0FFFFFF" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Height" Value="26" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#15FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#25FFFFFF" />
                                                <Setter Target="Root.BorderBrush" Value="#60CDFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PinButtonStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="#A0FFFFFF" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#20FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#20FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <!-- ═══════════════════════════════════════════════════════════════
             FOLDED LAYER — clock + battery (shown when island is collapsed)
        ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="FoldedLayer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Height="32"
              IsHitTestVisible="False">
            <StackPanel x:Name="FoldedContentStack"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">

                <!-- Folded media mini (left end: album art or music icon when media is playing) -->
                <StackPanel x:Name="FoldedMediaMini"
                            Orientation="Horizontal"
                            Spacing="5"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Border x:Name="FoldedArtBorder" Width="20" Height="20" CornerRadius="5" Background="#28FFFFFF">
                        <FontIcon x:Name="FoldedArtFallback" Glyph="&#xEC4F;" FontSize="11" Foreground="#E0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Folded timer mini (shows ring + countdown when timer is running) -->
                <StackPanel x:Name="FoldedTimerMini"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressRing x:Name="FoldedTimerRing"
                                  Width="13" Height="13"
                                  IsIndeterminate="False"
                                  Minimum="0" Maximum="100" Value="100"
                                  Background="#30FFFFFF"
                                  VerticalAlignment="Center" />
                    <TextBlock x:Name="FoldedTimerText"
                               Text="05:00"
                               FontFamily="Segoe UI Variable Small"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Foreground="#60CDFF"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Folded weather mini (shows temperature + weather icon) -->
                <StackPanel x:Name="FoldedWeatherMini"
                            Orientation="Horizontal"
                            Spacing="3"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <FontIcon x:Name="FoldedWeatherIcon" FontFamily="Segoe UI Symbol, Segoe Fluent Icons" Glyph="&#x2600;" FontSize="10" Foreground="#FFD700" />
                    <TextBlock x:Name="FoldedWeatherTemp"
                               Text="21°"
                               FontFamily="Segoe UI Variable Small"
                               FontSize="11"
                               Foreground="#D0FFFFFF"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Clock -->
                <StackPanel x:Name="ClockContainer"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="#99FFFFFF" />
                    <TextBlock x:Name="FoldedClockText"
                               Text="12:45"
                               FontFamily="Segoe UI Variable Display"
                               FontWeight="SemiBold"
                               FontSize="12"
                               CharacterSpacing="0"
                               Foreground="#F0FFFFFF"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Battery -->
                <StackPanel x:Name="BatteryContainer"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <FontIcon x:Name="BatteryIcon"
                              Glyph="&#xE83F;"
                              FontSize="12"
                              Foreground="#99FFFFFF" />
                    <TextBlock x:Name="FoldedBatteryText"
                               Text="100%"
                               FontFamily="Segoe UI Variable Small"
                               FontSize="11"
                               Foreground="#C0FFFFFF"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Connected Bluetooth device battery pill(s) -->
                <StackPanel x:Name="FoldedBtBatteryPanel"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />

                <!-- Milestone 12: Mic / Camera indicators -->
                <StackPanel x:Name="MicCamDotsContainer"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <FontIcon x:Name="MicDot"
                              Glyph="&#xE720;"
                              FontSize="11.5"
                              Foreground="#FFAA00"
                              Visibility="Collapsed"
                              VerticalAlignment="Center"
                              ToolTipService.ToolTip="Microphone in use" />
                        <!-- Glyph="&#xE714;" -->
                    <FontIcon x:Name="CamDot"
                              Glyph="&#xE722;"
                              FontSize="11.5"
                              Foreground="#22CC44"
                              Visibility="Collapsed"
                              VerticalAlignment="Center"
                              ToolTipService.ToolTip="Camera in use" />
                </StackPanel>

                <!-- Folded live music beat (right end) -->
                <StackPanel x:Name="FoldedEqMini"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Border x:Name="EqBar0" Width="2.5" Height="6"
                            Background="#60CDFF" CornerRadius="1.25"
                            VerticalAlignment="Center" />
                    <Border x:Name="EqBar1" Width="2.5" Height="12"
                            Background="#60CDFF" CornerRadius="1.25"
                            VerticalAlignment="Center" />
                    <Border x:Name="EqBar2" Width="2.5" Height="9"
                            Background="#60CDFF" CornerRadius="1.25"
                            VerticalAlignment="Center" />
                    <Border x:Name="EqBar3" Width="2.5" Height="5"
                            Background="#60CDFF" CornerRadius="1.25"
                            VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             LIVE CARD LAYER — temporary pop-out cards (Caps Lock, Volume, Copied, etc.)
        ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="CardLayer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Width="270"
              Height="38"
              Opacity="0"
              IsHitTestVisible="False">
            <Grid x:Name="CardContentGrid"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  ColumnSpacing="10"
                  Padding="14,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Border x:Name="CardIconBadge"
                            CornerRadius="17"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <FontIcon x:Name="CardIcon"
                                  Glyph="&#xE7BA;"
                                  FontSize="14"
                                  Foreground="#60CDFF"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="CardThumbBorder"
                            Width="44"
                            Height="34"
                            CornerRadius="6"
                            Visibility="Collapsed"
                            VerticalAlignment="Center" />
                </Grid>
                <StackPanel x:Name="CardStackedTextPanel"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            Spacing="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="CardStackedTitle"
                               Text="Copied"
                               FontFamily="Segoe UI Variable Display"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="#F5FFFFFF"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CardStackedDetail"
                               Text=""
                               FontFamily="Segoe UI Variable Small"
                               FontSize="10.5"
                               Foreground="#B0FFFFFF"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="CardTitle"
                           Grid.Column="1"
                           Text="Caps Lock"
                           FontFamily="Segoe UI Variable Display"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="#F0FFFFFF"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="CardDetail"
                           Grid.Column="2"
                           Text="On"
                           FontFamily="Segoe UI Variable Small"
                           FontSize="11"
                           Foreground="#C0FFFFFF"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="180"
                           VerticalAlignment="Center" />
                <!-- Optional Volume Progress Bar -->
                <ProgressBar x:Name="CardProgressBar"
                             Grid.Column="3"
                             HorizontalAlignment="Stretch"
                             Height="5"
                             CornerRadius="2.5"
                             Minimum="0"
                             Maximum="100"
                             Value="50"
                             Foreground="#60CDFF"
                             VerticalAlignment="Center"
                             Visibility="Collapsed" />
                <TextBlock x:Name="CardValueText"
                           Grid.Column="4"
                           Text="50%"
                           FontFamily="Segoe UI Variable Small"
                           FontWeight="SemiBold"
                           FontSize="11.5"
                           Foreground="#E8FFFFFF"
                           MinWidth="34"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
                <!-- Action buttons for interactive cards (Reminder / Timer) -->
                <StackPanel x:Name="CardActionPanel"
                            Grid.Column="4"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button x:Name="CardPrimaryActionBtn"
                            Content="+10 min"
                            Click="CardPrimaryActionBtn_Click"
                            Height="28"
                            Padding="12,0,12,0"
                            CornerRadius="14"
                            BorderThickness="0"
                            Background="#28FFFFFF"
                            Foreground="#F0FFFFFF"
                            FontSize="11"
                            FontWeight="SemiBold" />
                    <Button x:Name="CardDismissActionBtn"
                            Click="CardDismissActionBtn_Click"
                            Width="28" Height="28" MinWidth="28"
                            Padding="0"
                            CornerRadius="14"
                            BorderThickness="0"
                            Background="#FFFFFFFF"
                            ToolTipService.ToolTip="Dismiss">
                        <FontIcon x:Name="CardDismissActionIcon" Glyph="&#xE73E;" FontSize="12" Foreground="#FF000000" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             COMMAND BAR LAYER — Alt+Space or Command Tile
        ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="CommandLayer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Width="660"
              Height="380"
              Opacity="0"
              IsHitTestVisible="False">
            <Grid Margin="24,14,24,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Search Box -->
                    <RowDefinition Height="*"    /> <!-- Results list -->
                    <RowDefinition Height="Auto" /> <!-- Footer shortcuts -->
                </Grid.RowDefinitions>

                <!-- Search Input Box -->
                <Border Grid.Row="0"
                        Background="#14FFFFFF"
                        BorderBrush="#25FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,2,6,2"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*"    />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="CommandSearchIcon"
                                  Grid.Column="0"
                                  Glyph="&#xE721;"
                                  FontSize="13"
                                  Foreground="#60CDFF"
                                  VerticalAlignment="Center"
                                  Margin="4,0,8,0" />
                        <TextBox x:Name="CommandInput"
                                 Grid.Column="1"
                                 PlaceholderText="Search files, apps, math, or @command (e.g. @youtube, @google, @github)…"
                                 FontSize="12"
                                 Background="Transparent"
                                 BorderBrush="Transparent"
                                 BorderThickness="0"
                                 Foreground="#F0FFFFFF"
                                 Padding="2,5"
                                 TextChanged="CommandInput_TextChanged"
                                 KeyDown="CommandInput_KeyDown" />
                        <Button x:Name="CommandCloseBtn"
                                Grid.Column="2"
                                Style="{StaticResource TabButtonStyle}"
                                Width="26" Height="26"
                                Click="CommandClose_Click"
                                ToolTipService.ToolTip="Close (Esc)">
                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Results List -->
                <ScrollViewer Grid.Row="1"
                              Margin="0,0,0,8"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CommandResultList" Spacing="3" />
                </ScrollViewer>

                <!-- Footer Hints -->
                <Border Grid.Row="2"
                        Margin="0,2,0,0"
                        Padding="0,6,0,0"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="0,1,0,0">
                    <TextBlock Text="↵ Open  ·  Tab Auto-fill  ·  Ctrl+↵ In folder  ·  Alt+↵ Copy  ·  Type @ for web searches  ·  Esc Close"
                               FontSize="9.5"
                               Foreground="#85FFFFFF"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             OPEN LAYER — tab strip + content (shown when island is expanded)
        ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="OpenLayer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Width="700"
              Height="380"
              Opacity="0"
              IsHitTestVisible="False">

            <Grid Margin="16,10,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />  <!-- Tab bar row -->
                    <RowDefinition Height="*"  />  <!-- Content area -->
                    <RowDefinition Height="20" />  <!-- Frame stats row -->
                </Grid.RowDefinitions>

                <!-- ── Tab Bar ──────────────────────────────────────────────── -->
                <Grid Grid.Row="0">
                    <!-- Left: 8 tab buttons -->
                    <StackPanel x:Name="TabStrip"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">

                        <!-- Home -->
                        <Button x:Name="TabHome"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="0"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Home">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="TabHomeIcon" Glyph="&#xE80F;" FontSize="13" />
                                <TextBlock x:Name="TabHomeText" Text="Home" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Clipboard -->
                        <Button x:Name="TabClipboard"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="1"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Clipboard">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="TabClipboardIcon" Glyph="&#xF0E3;" FontSize="13" />
                                <TextBlock x:Name="TabClipboardText" Text="Clipboard" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <!-- Shelf -->
                        <Button x:Name="TabShelf"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="2"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Shelf">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="TabShelfIcon" Glyph="&#xE8F1;" FontSize="13" />
                                <TextBlock x:Name="TabShelfText" Text="Shelf" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <!-- Text -->
                        <Button x:Name="TabText"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="3"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Text tools">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="TabTextIcon" Glyph="&#xE8D2;" FontSize="13" />
                                <TextBlock x:Name="TabTextText" Text="Text" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <!-- Chat -->
                        <Button x:Name="TabChat"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="4"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Chat (AI)">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="TabChatIcon" Glyph="&#xE8BD;" FontSize="13" />
                                <TextBlock x:Name="TabChatText" Text="Chat" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <!-- Note -->
                        <Button x:Name="TabNote"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="5"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Note &amp; Timer">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="TabNoteIcon" Glyph="&#xE70B;" FontSize="13" />
                                <TextBlock x:Name="TabNoteText" Text="Note" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <!-- Weather -->
                        <Button x:Name="TabWeather"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="6"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Weather">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="TabWeatherIcon" FontFamily="Segoe UI Symbol, Segoe Fluent Icons" Glyph="&#x26C5;" FontSize="13" />
                                <TextBlock x:Name="TabWeatherText" Text="Weather" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <!-- Controls -->
                        <Button x:Name="TabControls"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="7"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Controls">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="TabControlsIcon" Glyph="&#xE9E9;" FontSize="13" />
                                <TextBlock x:Name="TabControlsText" Text="Controls" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: Mic mute/unmute + Quiet chip + Pin + Settings -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">

                        <!-- Microphone mute/unmute toggle (shown when mic is in use or muted) -->
                        <Button x:Name="HeaderMicMuteBtn"
                                Style="{StaticResource TabButtonStyle}"
                                Visibility="Collapsed"
                                Click="HeaderMicMuteBtn_Click"
                                ToolTipService.ToolTip="Microphone in use — Click to mute">
                            <FontIcon x:Name="HeaderMicMuteIcon" Glyph="&#xE720;" FontSize="13" />
                        </Button>

                        <!-- Camera in-use indicator (shown between mic and Quiet when camera is active) -->
                        <Button x:Name="HeaderCamBtn"
                                Style="{StaticResource TabButtonStyle}"
                                Visibility="Collapsed"
                                ToolTipService.ToolTip="Camera in use">
                            <FontIcon x:Name="HeaderCamIcon" Glyph="&#xE714;" FontSize="13" Foreground="#22CC44" />
                        </Button>

                        <!-- Quiet chip (hide cards temporarily) -->
                        <ToggleButton x:Name="QuietButton"
                                      Style="{StaticResource QuietButtonStyle}"
                                      ToolTipService.ToolTip="Quiet — pause live cards"
                                      Click="OnQuietClick">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <FontIcon Glyph="&#xE74F;" FontSize="11" />
                                <TextBlock Text="Quiet" FontSize="10" />
                            </StackPanel>
                        </ToggleButton>

                        <!-- Pin open -->
                        <ToggleButton x:Name="PinButton"
                                      Style="{StaticResource PinButtonStyle}"
                                      ToolTipService.ToolTip="Pin open"
                                      Click="OnPinClick">
                            <FontIcon Glyph="&#xE840;" FontSize="13" />
                        </ToggleButton>

                        <!-- Settings -->
                        <Button Style="{StaticResource TabButtonStyle}"
                                ToolTipService.ToolTip="Island settings"
                                Click="OnIslandSettingsClick">
                            <FontIcon Glyph="&#xE713;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ── Content Area ─────────────────────────────────────────── -->
                <Grid x:Name="ContentHost" Grid.Row="1">

                    <!-- Home tab — media player + volume + 8 tiles + launcher shortcuts -->
                        <!-- Home tab - media / recently-copied card, tiles, and a bottom bar with the
                             volume slider and the launcher. Cards and tiles share one radius and one surface so
                             the panel reads as a set of objects instead of loose text. -->
                        <!-- Home tab - the panel is a set of cards on one surface grid:
                               top left   media player, with the lyrics card beside it when the track has lyrics
                               top right  the 2x4 tile grid
                               below      the volume bar, then the launcher across the full width
                             Every card shares one radius, one fill and one border so the spacing reads evenly. -->
                        <Grid x:Name="ContentHome" Opacity="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"  />
                                <RowDefinition Height="8"  />
                                <RowDefinition Height="46" />
                            </Grid.RowDefinitions>

                            <!-- Upper block: player / lyrics / volume on the left, tiles on the right -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"   />
                                    <ColumnDefinition Width="8"   />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"  />
                                        <RowDefinition Height="8"  />
                                        <RowDefinition Height="38" />
                                    </Grid.RowDefinitions>

                                    <!-- Player card, with the lyrics card beside it -->
                                    <Grid Grid.Row="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="*"    />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="MediaCard"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                CornerRadius="14"
                                                Background="#10FFFFFF"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                Padding="12,11,12,11">
                                            <Grid>
                                                <Grid x:Name="MediaPlayerPanel"
                                                      RowSpacing="8"
                                                      Visibility="Collapsed">
                                                    <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*"    />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0" ColumnSpacing="11">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*"    />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Width="58" Height="58"
                                                                CornerRadius="9"
                                                                Background="#1AFFFFFF">
                                                            <Image x:Name="MediaArt" Stretch="UniformToFill" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock x:Name="MediaApp"
                                                                       Text=""
                                                                       FontSize="8.5"
                                                                       FontWeight="SemiBold"
                                                                       CharacterSpacing="90"
                                                                       Foreground="#70FFFFFF"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock x:Name="MediaTitle"
                                                                       Text="&#8212;"
                                                                       FontFamily="Segoe UI Variable Display"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="13"
                                                                       Foreground="#F5FFFFFF"
                                                                       TextWrapping="Wrap"
                                                                       MaxLines="2"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock x:Name="MediaArtist"
                                                                       Text=""
                                                                       FontSize="11"
                                                                       Foreground="#99FFFFFF"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Grid.Row="1" Spacing="2">
                                                        <!-- Seek surface: taller than the 3 px line so a click or drag lands -->
                                                        <Grid x:Name="MediaSeekArea"
                                                              Height="14"
                                                              Background="Transparent"
                                                              ToolTipService.ToolTip="Seek"
                                                              PointerPressed="MediaSeek_PointerPressed"
                                                              PointerMoved="MediaSeek_PointerMoved"
                                                              PointerReleased="MediaSeek_PointerReleased"
                                                              PointerCaptureLost="MediaSeek_PointerReleased">
                                                            <ProgressBar x:Name="MediaProgress"
                                                                         Minimum="0" Maximum="1" Value="0"
                                                                         Height="3"
                                                                         CornerRadius="1.5"
                                                                         Foreground="#D9A0E8"
                                                                         Background="#26FFFFFF"
                                                                         VerticalAlignment="Center"
                                                                         IsHitTestVisible="False"
                                                                         HorizontalAlignment="Stretch" />
                                                        </Grid>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"    />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="MediaElapsed"
                                                                       Grid.Column="0"
                                                                       Text="0:00"
                                                                       FontSize="10"
                                                                       Foreground="#77FFFFFF" />
                                                            <TextBlock x:Name="MediaRemaining"
                                                                       Grid.Column="1"
                                                                       Text="-0:00"
                                                                       FontSize="10"
                                                                       Foreground="#77FFFFFF" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <Grid Grid.Row="3">
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                Spacing="14">
                                                        <Button x:Name="MediaPrev"
                                                                Click="MediaPrev_Click"
                                                                Width="30" Height="30"
                                                                Style="{StaticResource TabButtonStyle}"
                                                                ToolTipService.ToolTip="Previous">
                                                            <FontIcon Glyph="&#xE892;" FontSize="13" />
                                                        </Button>
                                                        <Button x:Name="MediaPlayPause"
                                                                Click="MediaPlayPause_Click"
                                                                Width="38" Height="38"
                                                        Style="{StaticResource MediaPlayButtonStyle}"
                                                                ToolTipService.ToolTip="Play / Pause">
                                                            <FontIcon x:Name="MediaPlayPauseIcon"
                                                                      Glyph="&#xE768;"
                                                                      FontSize="16"
                                                                      Foreground="#101010" />
                                                        </Button>
                                                        <Button x:Name="MediaNext"
                                                                Click="MediaNext_Click"
                                                                Width="30" Height="30"
                                                                Style="{StaticResource TabButtonStyle}"
                                                                ToolTipService.ToolTip="Next">
                                                            <FontIcon Glyph="&#xE893;" FontSize="13" />
                                                        </Button>
                                                    </StackPanel>

                                                    <!-- Cycles through every app that has media (only with more than one) -->
                                                    <Button x:Name="MediaNextApp"
                                                            Click="MediaNextApp_Click"
                                                            Width="26" Height="26" MinWidth="26" Padding="0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Visibility="Collapsed"
                                                            Style="{StaticResource TabButtonStyle}"
                                                            ToolTipService.ToolTip="Show the next app that is playing">
                                                        <FontIcon Glyph="&#xE76C;" FontSize="11" />
                                                    </Button>
                                                    </Grid>
                                                </Grid>

                                                <Grid x:Name="RecentPanel" Visibility="Visible">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*"    />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0" Margin="1,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"    />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="RECENTLY COPIED"
                                                                   FontSize="8.5"
                                                                   FontWeight="SemiBold"
                                                                   CharacterSpacing="90"
                                                                   Foreground="#66FFFFFF"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="1"
                                                                Click="RecentChevron_Click"
                                                                Width="20" Height="20"
                                                                Padding="0"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                CornerRadius="5"
                                                                ToolTipService.ToolTip="Open clipboard history">
                                                            <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="#70FFFFFF" />
                                                        </Button>
                                                    </Grid>

                                                    <StackPanel x:Name="RecentList"
                                                                Grid.Row="1"
                                                                Spacing="2"
                                                                Margin="0,9,0,0"
                                                                VerticalAlignment="Top" />

                                                    <TextBlock x:Name="RecentEmptyText"
                                                               Grid.Row="1"
                                                               Text="Copy something and your latest items show up here; the player appears above once music is playing"
                                                               FontSize="10"
                                                               LineHeight="15"
                                                               Foreground="#5CFFFFFF"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Top"
                                                               Margin="1,13,0,0" />
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Lyrics card: shown beside the player while the track has lyrics -->
                                        <Border x:Name="LyricsPanel"
                                                Grid.Column="1"
                                                CornerRadius="14"
                                                Background="#10FFFFFF"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                Padding="12,11,10,9"
                                                Visibility="Collapsed">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*"    />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0"
                                                           Text="LYRICS"
                                                           FontSize="8.5"
                                                           FontWeight="SemiBold"
                                                           CharacterSpacing="90"
                                                           Foreground="#66FFFFFF"
                                                           Margin="0,0,0,7" />
                                                <ScrollViewer Grid.Row="1"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel x:Name="LyricsStack" Spacing="4" />
                                                </ScrollViewer>
                                                <TextBlock Grid.Row="2"
                                                           Text="LRCLIB"
                                                           FontSize="8"
                                                           CharacterSpacing="60"
                                                           Foreground="#44FFFFFF"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,6,0,0" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Volume bar, under the player: device / playing-app volume, mute and
                                         the output-device picker (same pieces as the volume mixer). -->
                                    <Border Grid.Row="2"
                                            CornerRadius="14"
                                            Background="#10FFFFFF"
                                            BorderBrush="#1AFFFFFF"
                                            BorderThickness="1"
                                            Padding="8,0,8,0">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*"    />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Device / playing-app switch, only while an app has audio -->
                                            <StackPanel x:Name="VolumeTargets"
                                                        Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        Spacing="2"
                                                        VerticalAlignment="Center"
                                                        Visibility="Collapsed">
                                                <Button x:Name="VolumeDeviceTarget"
                                                        Click="VolumeDeviceTarget_Click"
                                                        Width="26" Height="26" MinWidth="26" Padding="0"
                                                        Style="{StaticResource TabButtonStyle}"
                                                        ToolTipService.ToolTip="System volume">
                                                    <FontIcon Glyph="&#xE7F4;" FontSize="12" />
                                                </Button>
                                                <Button x:Name="VolumeAppTarget"
                                                        Click="VolumeAppTarget_Click"
                                                        Width="26" Height="26" MinWidth="26" Padding="0"
                                                        Style="{StaticResource TabButtonStyle}"
                                                        ToolTipService.ToolTip="Volume of the playing app">
                                                    <TextBlock Text="&#x266A;" FontSize="13" />
                                                </Button>
                                            </StackPanel>

                                            <!-- Mute toggle for the selected target -->
                                            <Button x:Name="VolumeMuteBtn"
                                                    Grid.Column="1"
                                                    Click="VolumeMute_Click"
                                                    Width="26" Height="26" MinWidth="26" Padding="0"
                                                    Style="{StaticResource TabButtonStyle}"
                                                    ToolTipService.ToolTip="Mute / unmute">
                                                <FontIcon x:Name="VolumeIcon"
                                                          Glyph="&#xE993;"
                                                          FontSize="13"
                                                          Foreground="#B0FFFFFF" />
                                            </Button>

                                            <Slider x:Name="VolumeSlider"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="VolumeSlider_ValueChanged"
                                                    PointerWheelChanged="VolumeSlider_PointerWheelChanged"
                                                    PointerPressed="VolumeSlider_PointerPressed"
                                                    PointerReleased="VolumeSlider_PointerReleased"
                                                    PointerCaptureLost="VolumeSlider_PointerReleased"
                                                    PointerCanceled="VolumeSlider_PointerReleased" />

                                            <TextBlock x:Name="VolumeText"
                                                       Grid.Column="3"
                                                       Text="&#8212;"
                                                       FontSize="10"
                                                       Foreground="#90FFFFFF"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right"
                                                       MinWidth="28" />

                                            <!-- Output device picker -->
                                            <Button x:Name="VolumeDevicePicker"
                                                    Grid.Column="4"
                                                    Click="VolumeDevicePicker_Click"
                                                    Height="26" Padding="6,0"
                                                    Style="{StaticResource TabButtonStyle}"
                                                    ToolTipService.ToolTip="Output device">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE7F4;" FontSize="11" Foreground="#B0FFFFFF" />
                                                    <TextBlock x:Name="VolumeDeviceName"
                                                               Text="Speakers"
                                                               FontSize="10"
                                                               Foreground="#D0FFFFFF"
                                                               MaxWidth="74"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <FontIcon Glyph="&#xE70D;" FontSize="7" Foreground="#80FFFFFF" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Output-device list, opened from the volume bar's device button.
                                         Right-aligned inside the volume bar's own column so it opens
                                         directly above that button, and kept inside the panel
                                         instead of a popup so the island's hover tracking never
                                         sees the pointer leave the island. -->
                                    <Border x:Name="VolumeDeviceOverlay"
                                            Grid.Row="0"
                                            Width="250"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,6"
                                            CornerRadius="12"
                                            Background="#F21A1A1A"
                                            BorderBrush="#2AFFFFFF"
                                            BorderThickness="1"
                                            Padding="6"
                                            Visibility="Collapsed">
                                        <StackPanel x:Name="VolumeDeviceList" Spacing="2" />
                                    </Border>
                                </Grid>

                                <!-- Tile grid: fills the right column top to bottom -->
                                <Grid x:Name="TileGrid"
                                      Grid.Column="2"
                                      RowSpacing="8"
                                      ColumnSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="TileArea"
                                            Grid.Row="0" Grid.Column="0"
                                            Click="TileArea_Click"
                                            Style="{StaticResource TileButtonStyle}"
                                            ToolTipService.ToolTip="Select an area to capture (Snipping Tool)">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7A8;" FontSize="14" />
                                            <TextBlock Text="Area" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TileFullScreen"
                                            Grid.Row="0" Grid.Column="1"
                                            Click="TileFullScreen_Click"
                                            Style="{StaticResource TileButtonStyle}"
                                            ToolTipService.ToolTip="Capture this monitor and copy it">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE722;" FontSize="14" />
                                            <TextBlock Text="Full screen" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TileScreenText"
                                            Grid.Row="1" Grid.Column="0"
                                            Click="TileScreenText_Click"
                                            Style="{StaticResource TileButtonStyle}"
                                            ToolTipService.ToolTip="Copy text from the screen (Snipping Tool)">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8D2;" FontSize="14" />
                                            <TextBlock Text="Screen text" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TileQR"
                                            Grid.Row="1" Grid.Column="1"
                                            Click="TileQR_Click"
                                            Style="{StaticResource TileButtonStyle}"
                                            ToolTipService.ToolTip="Scan a QR code on this monitor">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7EE;" FontSize="14" />
                                            <TextBlock Text="QR code" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TileNetwork"
                                            Grid.Row="2" Grid.Column="0"
                                            Click="TileNetwork_Click"
                                            Style="{StaticResource TileButtonStyle}"
                                            ToolTipService.ToolTip="Download and upload speed">
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE774;" FontSize="14" />
                                                <TextBlock Text="Network" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <TextBlock x:Name="TileNetDown" Text="&#x2193; &#8212;" FontSize="10" Foreground="#8FFFFFFF" />
                                                <TextBlock x:Name="TileNetUp" Text="&#x2191; &#8212;" FontSize="10" Foreground="#8FFFFFFF" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TileCpuRam"
                                            Grid.Row="2" Grid.Column="1"
                                            Click="TileCpuRam_Click"
                                            Style="{StaticResource TileButtonStyle}"
                                            ToolTipService.ToolTip="CPU and memory load (opens Task Manager)">
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE950;" FontSize="14" />
                                                <TextBlock Text="CPU &amp; RAM" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <TextBlock x:Name="TileCpuText" Text="CPU &#8212;" FontSize="10" Foreground="#8FFFFFFF" />
                                                <TextBlock x:Name="TileRamText" Text="RAM &#8212;" FontSize="10" Foreground="#8FFFFFFF" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TileRecord"
                                            Grid.Row="3" Grid.Column="0"
                                            Click="TileRecord_Click"
                                            Style="{StaticResource TileButtonStyle}"
                                            ToolTipService.ToolTip="Record the screen (Snipping Tool)">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7C8;" FontSize="14" />
                                            <TextBlock Text="Record screen" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TileCommand"
                                            Grid.Row="3" Grid.Column="1"
                                            Click="TileCommand_Click"
                                            Style="{StaticResource TileButtonStyle}"
                                            ToolTipService.ToolTip="Open the command bar">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE756;" FontSize="14" />
                                            <TextBlock Text="Command" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>

                                </Grid>
                            </Grid>

                            <!-- Launcher: full width at the bottom -->
                            <Border Grid.Row="2"
                                    CornerRadius="14"
                                    Background="#10FFFFFF"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    Padding="8,0,8,0"
                                    AllowDrop="True"
                                    DragOver="LauncherRow_DragOver"
                                    Drop="LauncherRow_Drop">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollMode="Enabled"
                                              VerticalScrollMode="Disabled">
                                    <StackPanel x:Name="LauncherList"
                                                Orientation="Horizontal"
                                                Spacing="7"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="LauncherEmptyText"
                                                   Text="Drop app shortcuts, folders or files here"
                                                   FontSize="10"
                                                   Foreground="#50FFFFFF"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,6,0" />
                                        <Button x:Name="LauncherAddBtn"
                                                Width="30" Height="30"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderBrush="#3DFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Click="LauncherAddBtn_Click"
                                                ToolTipService.ToolTip="Add shortcut">
                                            <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="#C0FFFFFF" />
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                        <!-- In-island add-shortcut dialog: a scrim over the panel and a card in the middle -->
                        <Grid x:Name="LauncherAddOverlay"
                              Grid.RowSpan="3" Grid.ColumnSpan="2"
                              Visibility="Collapsed">
                            <Border Background="#B3000000" CornerRadius="14" />

                            <Border Width="392"
                                    CornerRadius="14"
                                    Background="#FF1C1C1C"
                                    BorderBrush="#26FFFFFF"
                                    BorderThickness="1"
                                    Padding="18,16,18,14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Spacing="3">
                                        <TextBlock x:Name="LauncherAddTitle"
                                                   Text="A link for the launcher"
                                                   FontFamily="Segoe UI Variable Display"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#F0FFFFFF" />
                                        <TextBlock Text="Paste a URL, or drag an app, folder or file onto the launcher bar."
                                                   FontSize="10"
                                                   LineHeight="14"
                                                   Foreground="#80FFFFFF"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBox x:Name="LauncherTargetInput"
                                             Grid.Row="1"
                                             PlaceholderText="https://… or file/folder path"
                                             FontSize="12"
                                             MinHeight="0"
                                             Padding="11,6,11,6"
                                             VerticalContentAlignment="Center"
                                             Background="#14FFFFFF"
                                             Foreground="#F0FFFFFF"
                                             BorderBrush="#26FFFFFF"
                                             CornerRadius="8" />

                                    <TextBox x:Name="LauncherNameInput"
                                             Grid.Row="2"
                                             PlaceholderText="Name (optional)"
                                             FontSize="12"
                                             MinHeight="0"
                                             Padding="11,6,11,6"
                                             VerticalContentAlignment="Center"
                                             Background="#14FFFFFF"
                                             Foreground="#F0FFFFFF"
                                             BorderBrush="#26FFFFFF"
                                             CornerRadius="8" />

                                    <CheckBox x:Name="LauncherUseAppIconCheck"
                                              Grid.Row="3"
                                              Content="Use the site's or app's own icon"
                                              IsChecked="True"
                                              FontSize="11"
                                              Foreground="#C0FFFFFF"
                                              Margin="0,2,0,0" />

                                    <StackPanel Grid.Row="4"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Spacing="8"
                                                Margin="0,6,0,0">
                                        <Button Content="Cancel"
                                                Width="78" Height="32"
                                                FontSize="11"
                                                CornerRadius="8"
                                                Style="{StaticResource TabButtonStyle}"
                                                Click="LauncherAddCancel_Click" />
                                        <Button x:Name="LauncherAddConfirmBtn"
                                                Content="Add"
                                                Width="78" Height="32"
                                                FontSize="11"
                                                CornerRadius="8"
                                                Background="#60CDFF"
                                                Foreground="#000000"
                                                FontWeight="SemiBold"
                                                Click="LauncherAddConfirm_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        </Grid>

                    <!-- Clipboard tab -->
                    <Grid x:Name="ContentClipboard" Opacity="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*"    />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Search + Clear row -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"    />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ClipboardSearch"
                                     Grid.Column="0"
                                     PlaceholderText="Search…"
                                     FontSize="12"
                                     Height="32"
                                     MinHeight="32"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="#20FFFFFF"
                                     Foreground="#F0FFFFFF"
                                     BorderBrush="#30FFFFFF"
                                     CornerRadius="6"
                                     Padding="10,6,10,6"
                                     TextChanged="ClipboardSearch_TextChanged"
                                     KeyDown="ClipboardSearch_KeyDown" />
                            <Button x:Name="ClipboardClearBtn"
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Height="32"
                                    Padding="8,4"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Click="ClipboardClear_Click"
                                    Style="{StaticResource TabButtonStyle}"
                                    ToolTipService.ToolTip="Clear clipboard history">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            </Button>
                        </Grid>

                        <!-- Item list -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ClipboardList" Spacing="3" />
                        </ScrollViewer>

                        <!-- Footer hint -->
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <TextBlock Text="Click to paste · Shift+click to copy only"
                                       FontSize="9"
                                       Foreground="#50FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="↑↓ Enter"
                                       FontSize="9"
                                       Foreground="#60FFFFFF"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0" />
                        </Grid>
                    </Grid>

                    <!-- Shelf tab -->
                    <Grid x:Name="ContentShelf" Opacity="1" Visibility="Collapsed"
                          AllowDrop="True"
                          DragOver="ShelfGrid_DragOver"
                          Drop="ShelfGrid_Drop">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"    />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Drop hint overlay (shown when dragging over) -->
                        <Border x:Name="ShelfDropHint"
                                Grid.RowSpan="2"
                                Background="#15FFFFFF"
                                BorderBrush="#60CDFF"
                                BorderThickness="2"
                                CornerRadius="8"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <TextBlock Text="Drop files here"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#60CDFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <!-- File grid or empty state -->
                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="0,4,0,4">
                                <TextBlock x:Name="ShelfEmptyText"
                                           Text="Drop app shortcuts, folders or files here."
                                           FontSize="11"
                                           Foreground="#50FFFFFF"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,32,0,0" />
                                <Grid x:Name="ShelfItemsGrid"
                                      ColumnSpacing="8"
                                      RowSpacing="8" />
                            </Grid>
                        </ScrollViewer>

                        <!-- Clear all button -->
                        <Button x:Name="ShelfClearBtn"
                                Grid.Row="1"
                                Content="Clear all"
                                FontSize="10"
                                Padding="8,4"
                                CornerRadius="6"
                                HorizontalAlignment="Right"
                                Margin="0,4,0,0"
                                Click="ShelfClear_Click"
                                Style="{StaticResource TabButtonStyle}"
                                ToolTipService.ToolTip="Remove all shelf items" />
                    </Grid>

                    <!-- Text tab (Milestone 14: Text Tools & Transforms) -->
                    <Grid x:Name="ContentText" Opacity="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*"    />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header / Quick Actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Text Helpers"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFFFF" />
                                <TextBlock x:Name="TextStatsSummaryText"
                                           Text="0 words · 0 chars"
                                           FontSize="11"
                                           Foreground="#80FFFFFF"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="TextPastePlainBtn"
                                        Click="TextPastePlainBtn_Click"
                                        ToolTipService.ToolTip="Paste as plain text to active app (strips formatting)"
                                        Height="26"
                                        Padding="8,2"
                                        CornerRadius="13"
                                        Background="#15FFFFFF"
                                        BorderBrush="#25FFFFFF"
                                        BorderThickness="1"
                                        Foreground="#E0FFFFFF">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE77F;" FontSize="11" />
                                        <TextBlock Text="Paste Plain" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TextDictationBtn"
                                        Click="TextDictationBtn_Click"
                                        ToolTipService.ToolTip="Trigger Windows Voice Typing (Win + H)"
                                        Height="26"
                                        Padding="8,2"
                                        CornerRadius="13"
                                        Background="#15FFFFFF"
                                        BorderBrush="#25FFFFFF"
                                        BorderThickness="1"
                                        Foreground="#E0FFFFFF">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon x:Name="TextDictationIcon" Glyph="&#xE720;" FontSize="11" Foreground="#60CDFF" />
                                        <TextBlock Text="Dictation" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TextFetchClipboardBtn"
                                        Click="TextFetchClipboardBtn_Click"
                                        ToolTipService.ToolTip="Reload from current clipboard"
                                        Width="26" Height="26"
                                        Padding="0"
                                        CornerRadius="13"
                                        Background="#15FFFFFF"
                                        BorderBrush="#25FFFFFF"
                                        BorderThickness="1"
                                        Foreground="#C0FFFFFF">
                                    <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Transform Toolbar -->
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,0,0,6"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button x:Name="TextUpperBtn"
                                        Click="TextUpperBtn_Click"
                                        Content="UPPERCASE"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextLowerBtn"
                                        Click="TextLowerBtn_Click"
                                        Content="lowercase"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextTitleBtn"
                                        Click="TextTitleBtn_Click"
                                        Content="Title Case"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextTrimBtn"
                                        Click="TextTrimBtn_Click"
                                        Content="Trim"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextNoBreaksBtn"
                                        Click="TextNoBreaksBtn_Click"
                                        Content="No Breaks"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextSortBtn"
                                        Click="TextSortBtn_Click"
                                        Content="Sort Lines"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextClearBtn"
                                        Click="TextClearBtn_Click"
                                        Content="Clear"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#A0FFFFFF" />
                                <Button x:Name="TextQrBtn"
                                        Click="TextQrBtn_Click"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        ToolTipService.ToolTip="Generate QR Code from text">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon x:Name="TextQrBtnIcon" Glyph="&#xED14;" FontSize="11" Foreground="#60CDFF" />
                                        <TextBlock Text="QR Code" FontSize="10" Foreground="#D0FFFFFF" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Text Editor / Preview -->
                        <Border Grid.Row="2"
                                Background="#181920"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="4">
                            <TextBox x:Name="TextInputBox"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontSize="11"
                                     Background="Transparent"
                                     Foreground="#E8FFFFFF"
                                     BorderThickness="0"
                                     Padding="4"
                                     PlaceholderText="Type or paste text here, or switch to this tab to load clipboard text..."
                                     TextChanged="TextInputBox_TextChanged" />
                        </Border>

                        <!-- Bottom Stats & Copy/Paste -->
                        <Grid Grid.Row="3" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TextStatsDetailedText"
                                       Grid.Column="0"
                                       Text="Lines: 0 · Words: 0 · Chars: 0 (no spaces: 0)"
                                       FontSize="10"
                                       Foreground="#80FFFFFF"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="TextCopyResultBtn"
                                        Click="TextCopyResultBtn_Click"
                                        Height="24"
                                        Padding="8,2"
                                        CornerRadius="12"
                                        Background="#15FFFFFF"
                                        BorderBrush="#25FFFFFF"
                                        BorderThickness="1"
                                        Foreground="#E0FFFFFF">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="10" />
                                        <TextBlock x:Name="TextCopyResultBtnText" Text="Copy" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TextPasteToAppBtn"
                                        Click="TextPasteToAppBtn_Click"
                                        Height="24"
                                        Padding="8,2"
                                        CornerRadius="12"
                                        Background="#2060CDFF"
                                        BorderBrush="#5060CDFF"
                                        BorderThickness="1"
                                        Foreground="#60CDFF">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE77F;" FontSize="10" />
                                        <TextBlock x:Name="TextPasteToAppBtnText" Text="Paste to App" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- QR Code Generation Overlay -->
                        <Grid x:Name="TextQrOverlay"
                              Grid.RowSpan="4"
                              Background="#E6101216"
                              CornerRadius="8"
                              Visibility="Collapsed"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                            <Border Background="#1C1F26"
                                    BorderBrush="#35FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14,10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="380">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <!-- Header with Title and Close Button -->
                                    <Grid Width="220">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon x:Name="TextQrOverlayIcon" Glyph="&#xED14;" FontSize="13" Foreground="#60CDFF" />
                                            <TextBlock Text="QR Code" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFFFF" />
                                        </StackPanel>
                                        <Button x:Name="TextQrCloseBtn"
                                                HorizontalAlignment="Right"
                                                Width="24" Height="24" Padding="0"
                                                CornerRadius="12"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Click="TextQrClose_Click"
                                                ToolTipService.ToolTip="Close (Esc)">
                                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#A0FFFFFF" />
                                        </Button>
                                    </Grid>

                                    <!-- QR Code Visual Container -->
                                    <Border x:Name="TextQrContainer"
                                            Background="White"
                                            CornerRadius="8"
                                            Padding="10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <!-- QR Code Visual inserted dynamically -->
                                    </Border>

                                    <!-- Text snippet / hint -->
                                    <TextBlock x:Name="TextQrPreviewText"
                                               Text=""
                                               FontSize="10"
                                               Foreground="#90FFFFFF"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="220"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />

                                    <!-- Action buttons: Copy Image, Save Image -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <Button x:Name="TextQrCopyBtn"
                                                Click="TextQrCopy_Click"
                                                Height="26" Padding="10,2" CornerRadius="13"
                                                Background="#18FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1"
                                                Foreground="#E0FFFFFF"
                                                ToolTipService.ToolTip="Copy QR image to clipboard">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="10" />
                                                <TextBlock x:Name="TextQrCopyText" Text="Copy Image" FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="TextQrSaveBtn"
                                                Click="TextQrSave_Click"
                                                Height="26" Padding="10,2" CornerRadius="13"
                                                Background="#18FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1"
                                                Foreground="#E0FFFFFF"
                                                ToolTipService.ToolTip="Save QR code PNG to Pictures/Screenshots">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE74E;" FontSize="10" />
                                                <TextBlock x:Name="TextQrSaveText" Text="Save PNG" FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Chat tab (Milestone 13: WebView2 AI Assistants) -->
                    <Grid x:Name="ContentChat" Opacity="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header strip: Sub-tabs and tool buttons -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Assistant Sub-Tabs list (ChatGPT, Claude, Copilot, etc.) -->
                            <ScrollViewer Grid.Column="0"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Enabled"
                                          VerticalScrollMode="Disabled">
                                <StackPanel x:Name="ChatSubTabsPanel"
                                            Orientation="Horizontal"
                                            Spacing="4" />
                            </ScrollViewer>

                            <!-- Tools: Add custom assistant, Popout to browser, Refresh, and Height adjust -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                <Button x:Name="ChatAddBtn"
                                        Click="ChatAddBtn_Click"
                                        ToolTipService.ToolTip="Add custom AI assistant"
                                        Width="28" Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="14">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="#C0FFFFFF" />
                                </Button>
                                <Button x:Name="ChatRefreshBtn"
                                        Click="ChatRefreshBtn_Click"
                                        ToolTipService.ToolTip="Reload active chat"
                                        Width="28" Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="14">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="#C0FFFFFF" />
                                </Button>
                                <Button x:Name="ChatPopoutBtn"
                                        Click="ChatPopoutBtn_Click"
                                        ToolTipService.ToolTip="Open in default browser"
                                        Width="28" Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="14">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="12" Foreground="#C0FFFFFF" />
                                </Button>

                                <!-- Separately styled Height Adjust Pill -->
                                <Border x:Name="ChatHeightAdjustPill"
                                        Margin="6,0,0,0"
                                        Background="#18FFFFFF"
                                        BorderBrush="#25FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="2,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <!-- Decrease Height (-) -->
                                        <Button x:Name="ChatHeightDecreaseBtn"
                                                Click="ChatHeightDecreaseBtn_Click"
                                                ToolTipService.ToolTip="Decrease chat height (-40px)"
                                                Width="24" Height="24"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="12">
                                            <FontIcon Glyph="&#xE108;" FontSize="10" Foreground="#C0FFFFFF" />
                                        </Button>

                                        <!-- Preset / Current Height Selector -->
                                        <Button x:Name="ChatHeightPresetBtn"
                                                ToolTipService.ToolTip="Height presets (Compact, Standard, Tall, Full)"
                                                Height="24"
                                                Padding="6,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="12">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <FontIcon x:Name="ChatHeightGripIcon" Glyph="&#xE740;" FontSize="10" Foreground="#60CDFF" />
                                                <TextBlock x:Name="ChatHeightLabel" Text="Standard" FontSize="10" Foreground="#D0FFFFFF" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem x:Name="ChatPresetCompactItem"
                                                                    Text="Compact (340px)"
                                                                    Click="ChatPresetCompact_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE740;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Name="ChatPresetStandardItem"
                                                                    Text="Standard (440px)"
                                                                    Click="ChatPresetStandard_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE740;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Name="ChatPresetTallItem"
                                                                    Text="Tall (560px)"
                                                                    Click="ChatPresetTall_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE740;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Name="ChatPresetFullItem"
                                                                    Text="Full (680px)"
                                                                    Click="ChatPresetFull_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE740;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>

                                        <!-- Increase Height (+) -->
                                        <Button x:Name="ChatHeightIncreaseBtn"
                                                Click="ChatHeightIncreaseBtn_Click"
                                                ToolTipService.ToolTip="Increase chat height (+40px)"
                                                Width="24" Height="24"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="12">
                                            <FontIcon Glyph="&#xE109;" FontSize="10" Foreground="#C0FFFFFF" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Content host (Skeleton / Fallback / WebView2) -->
                        <Border Grid.Row="1"
                                Background="#1A1A1A"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <!-- WebView2 Host -->
                                <Grid x:Name="ChatWebViewHost" />

                                <!-- Loading / Skeleton overlay -->
                                <StackPanel x:Name="ChatSkeletonPanel"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="10"
                                            Visibility="Collapsed">
                                    <ProgressBar IsIndeterminate="True" Width="140" />
                                    <TextBlock x:Name="ChatSkeletonText"
                                               Text="Loading AI Assistant..."
                                               FontSize="12"
                                               Foreground="#A0FFFFFF"
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Fallback overlay (when WebView2 runtime is missing) -->
                                <StackPanel x:Name="ChatFallbackPanel"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="12"
                                            MaxWidth="320"
                                            Visibility="Collapsed">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="28" Foreground="#FFCC00" HorizontalAlignment="Center" />
                                    <TextBlock Text="Microsoft Edge WebView2 Runtime is required to render AI chats inside Window Island."
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               FontSize="12"
                                               Foreground="#D0FFFFFF" />
                                    <Button x:Name="ChatDownloadWebView2Btn"
                                            Click="ChatDownloadWebView2_Click"
                                            Content="Download Runtime"
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Padding="12,6" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- In-island Add / Edit Custom Site Overlay -->
                        <Grid x:Name="ChatAddOverlay"
                              Grid.RowSpan="2"
                              Background="#CC0B0D11"
                              CornerRadius="8"
                              Visibility="Collapsed"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                            <Border Background="#FF1E2128"
                                    BorderBrush="#38FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20,16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="340">
                                <StackPanel Spacing="12">
                                    <!-- Header Row -->
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon x:Name="ChatAddOverlayIcon" Glyph="&#xE8BD;" FontSize="13" Foreground="#60CDFF" />
                                            <TextBlock x:Name="ChatAddTitleText"
                                                       Text="Add Custom AI Site"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFFFF" />
                                        </StackPanel>
                                        <Button x:Name="ChatAddCloseBtn"
                                                HorizontalAlignment="Right"
                                                Width="24" Height="24" Padding="0"
                                                CornerRadius="12"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Click="ChatCancelAdd_Click"
                                                ToolTipService.ToolTip="Close (Esc)">
                                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#A0FFFFFF" />
                                        </Button>
                                    </Grid>

                                    <!-- Fields Stack -->
                                    <StackPanel Spacing="10">
                                        <!-- Site Name -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Site Name"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Foreground="#B0FFFFFF" />
                                            <TextBox x:Name="ChatNewNameBox"
                                                     PlaceholderText="e.g. DeepSeek, Perplexity, Claude"
                                                     FontSize="12"
                                                     Height="32"
                                                     Padding="10,6,10,6"
                                                     CornerRadius="6"
                                                     Background="#20FFFFFF"
                                                     BorderBrush="#30FFFFFF"
                                                     Foreground="#FFFFFFFF"
                                                     KeyDown="ChatBox_KeyDown" />
                                        </StackPanel>

                                        <!-- HTTPS URL -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="HTTPS URL"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Foreground="#B0FFFFFF" />
                                            <TextBox x:Name="ChatNewUrlBox"
                                                     PlaceholderText="https://..."
                                                     FontSize="12"
                                                     Height="32"
                                                     Padding="10,6,10,6"
                                                     CornerRadius="6"
                                                     Background="#20FFFFFF"
                                                     BorderBrush="#30FFFFFF"
                                                     Foreground="#FFFFFFFF"
                                                     KeyDown="ChatBox_KeyDown" />
                                        </StackPanel>

                                        <!-- Error Text -->
                                        <TextBlock x:Name="ChatAddErrorText"
                                                   Foreground="#FFFF6B6B"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Visibility="Collapsed" />
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Spacing="8"
                                                Margin="0,4,0,0">
                                        <Button Content="Cancel"
                                                Click="ChatCancelAdd_Click"
                                                FontSize="11"
                                                Height="28"
                                                Padding="14,2"
                                                CornerRadius="14"
                                                Background="#14FFFFFF"
                                                BorderBrush="#25FFFFFF"
                                                BorderThickness="1"
                                                Foreground="#D0FFFFFF" />
                                        <Button x:Name="ChatConfirmAddBtn"
                                                Click="ChatConfirmAdd_Click"
                                                Height="28"
                                                Padding="18,2"
                                                CornerRadius="14"
                                                Background="#60CDFF"
                                                BorderBrush="#60CDFF"
                                                BorderThickness="1"
                                                Foreground="#FF101216">
                                            <TextBlock x:Name="ChatConfirmAddBtnText"
                                                       Text="Add"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Note & Timer tab -->
                    <Grid x:Name="ContentNote" Opacity="1" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"   /> <!-- Left: Notes editor -->
                            <ColumnDefinition Width="200" /> <!-- Right: Timer & Reminders -->
                        </Grid.ColumnDefinitions>

                        <!-- ── Left: Note Editor ── -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Note Tab Strip + actions -->
                                <RowDefinition Height="Auto" /> <!-- Formatting toolbar -->
                                <RowDefinition Height="*"    /> <!-- Text editor -->
                            </Grid.RowDefinitions>

                            <!-- Note headers + tools -->
                            <Grid Grid.Row="0" Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"    />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Note tabs (horizontally scrollable) -->
                                <ScrollViewer Grid.Column="0"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollMode="Enabled">
                                    <StackPanel x:Name="NoteTabStrip"
                                                Orientation="Horizontal"
                                                Spacing="4" />
                                </ScrollViewer>

                                <!-- Add note, Copy note, Delete note -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="2">
                                    <Button x:Name="NoteAddBtn"
                                            Style="{StaticResource TabButtonStyle}"
                                            Width="24" Height="24"
                                            Padding="0"
                                            Click="NoteAddBtn_Click"
                                            ToolTipService.ToolTip="Add new note">
                                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                                    </Button>
                                    <Button x:Name="NoteCopyBtn"
                                            Style="{StaticResource TabButtonStyle}"
                                            Width="24" Height="24"
                                            Padding="0"
                                            Click="NoteCopyBtn_Click"
                                            ToolTipService.ToolTip="Copy note content">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                    </Button>
                                    <Button x:Name="NoteDeleteBtn"
                                            Style="{StaticResource TabButtonStyle}"
                                            MinWidth="24" Height="24"
                                            Padding="4,0"
                                            Click="NoteDeleteBtn_Click"
                                            ToolTipService.ToolTip="Delete current note">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Formatting Toolbar: Bold, Italic, Underline, Strike, Bullet, Numbered, Checklist, Color Highlighting -->
                            <Border Grid.Row="1"
                                    Background="#10FFFFFF"
                                    BorderBrush="#18FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="4,2"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <!-- Bold -->
                                    <Button x:Name="NoteFmtBold" Click="NoteFmtBold_Click" ToolTipService.ToolTip="Bold (**text** or Ctrl+B)" Style="{StaticResource TabButtonStyle}" Width="24" Height="22" Padding="0">
                                        <TextBlock Text="B" FontWeight="Bold" FontSize="11" Foreground="#FFFFFFFF"/>
                                    </Button>
                                    <!-- Italic -->
                                    <Button x:Name="NoteFmtItalic" Click="NoteFmtItalic_Click" ToolTipService.ToolTip="Italic (*text* or Ctrl+I)" Style="{StaticResource TabButtonStyle}" Width="24" Height="22" Padding="0">
                                        <TextBlock Text="I" FontStyle="Italic" FontFamily="Times New Roman" FontSize="11" Foreground="#FFFFFFFF"/>
                                    </Button>
                                    <!-- Underline -->
                                    <Button x:Name="NoteFmtUnderline" Click="NoteFmtUnderline_Click" ToolTipService.ToolTip="Underline (&lt;u&gt;text&lt;/u&gt; or Ctrl+U)" Style="{StaticResource TabButtonStyle}" Width="24" Height="22" Padding="0">
                                        <TextBlock Text="U" TextDecorations="Underline" FontSize="11" Foreground="#FFFFFFFF"/>
                                    </Button>
                                    <!-- Strikethrough -->
                                    <Button x:Name="NoteFmtStrike" Click="NoteFmtStrike_Click" ToolTipService.ToolTip="Strikethrough (~~text~~ or Ctrl+Shift+X)" Style="{StaticResource TabButtonStyle}" Width="24" Height="22" Padding="0">
                                        <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="11" Foreground="#D0FFFFFF"/>
                                    </Button>
                                    <Border Width="1" Height="14" Background="#25FFFFFF" Margin="3,0" VerticalAlignment="Center"/>
                                    <!-- Bullet list -->
                                    <Button x:Name="NoteFmtBullet" Click="NoteFmtBullet_Click" ToolTipService.ToolTip="Bullet list (- item)" Style="{StaticResource TabButtonStyle}" Width="24" Height="22" Padding="0">
                                        <FontIcon Glyph="&#xE8FD;" FontSize="11" Foreground="#FFFFFFFF"/>
                                    </Button>
                                    <!-- Numbered list -->
                                    <Button x:Name="NoteFmtNumbered" Click="NoteFmtNumbered_Click" ToolTipService.ToolTip="Numbered list (1. item)" Style="{StaticResource TabButtonStyle}" Width="24" Height="22" Padding="0">
                                        <TextBlock Text="1." FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                    </Button>
                                    <!-- Checklist -->
                                    <Button x:Name="NoteFmtChecklist" Click="NoteFmtChecklist_Click" ToolTipService.ToolTip="Checklist (- [ ] task)" Style="{StaticResource TabButtonStyle}" Width="24" Height="22" Padding="0">
                                        <FontIcon Glyph="&#xE73A;" FontSize="11" Foreground="#FFFFFFFF"/>
                                    </Button>
                                    <Border Width="1" Height="14" Background="#25FFFFFF" Margin="3,0" VerticalAlignment="Center"/>
                                    <!-- Highlight Colors -->
                                    <Button x:Name="NoteFmtColorYellow" Click="NoteFmtColor_Click" Tag="#FFE600" ToolTipService.ToolTip="Highlight Yellow" Style="{StaticResource TabButtonStyle}" Width="18" Height="18" Padding="0">
                                        <Border Width="11" Height="11" CornerRadius="5.5" Background="#FFE600"/>
                                    </Button>
                                    <Button x:Name="NoteFmtColorGreen" Click="NoteFmtColor_Click" Tag="#4CAF50" ToolTipService.ToolTip="Highlight Green" Style="{StaticResource TabButtonStyle}" Width="18" Height="18" Padding="0">
                                        <Border Width="11" Height="11" CornerRadius="5.5" Background="#4CAF50"/>
                                    </Button>
                                    <Button x:Name="NoteFmtColorPink" Click="NoteFmtColor_Click" Tag="#FF4081" ToolTipService.ToolTip="Highlight Pink" Style="{StaticResource TabButtonStyle}" Width="18" Height="18" Padding="0">
                                        <Border Width="11" Height="11" CornerRadius="5.5" Background="#FF4081"/>
                                    </Button>
                                    <Button x:Name="NoteFmtColorCyan" Click="NoteFmtColor_Click" Tag="#00E5FF" ToolTipService.ToolTip="Highlight Cyan" Style="{StaticResource TabButtonStyle}" Width="18" Height="18" Padding="0">
                                        <Border Width="11" Height="11" CornerRadius="5.5" Background="#00E5FF"/>
                                    </Button>
                                    <Button x:Name="NoteFmtColorNone" Click="NoteFmtColor_Click" Tag="none" ToolTipService.ToolTip="Remove highlight" Style="{StaticResource TabButtonStyle}" Width="18" Height="18" Padding="0">
                                        <FontIcon Glyph="&#xE75C;" FontSize="10" Foreground="#B0FFFFFF"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Multi-line rich text editor with live formatting preview -->
                            <RichEditBox x:Name="NoteContentBox"
                                         Grid.Row="2"
                                         PlaceholderText="Write anything here: an order number, a to-do list, formatted notes. It saves itself."
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         FontSize="11"
                                         Background="#15FFFFFF"
                                         Foreground="#F0FFFFFF"
                                         BorderBrush="#25FFFFFF"
                                         CornerRadius="6"
                                         Padding="8,6"
                                         PreviewKeyDown="NoteContentBox_PreviewKeyDown"
                                         TextChanged="NoteContentBox_TextChanged"
                                         SelectionChanged="NoteContentBox_SelectionChanged" />
                        </Grid>

                        <!-- ── Right: Timer & Reminders ── -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Timer panel -->
                                <RowDefinition Height="Auto" /> <!-- Divider -->
                                <RowDefinition Height="*"    /> <!-- Reminders panel -->
                            </Grid.RowDefinitions>

                            <!-- Timer Section: Circular Display + Start/Custom Pills + Presets / Custom Input -->
                            <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,6">
                                <!-- Timer Header -->
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,2">
                                    <FontIcon Glyph="&#xE916;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Timer"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#E0FFFFFF"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- Top row: Circular Ring on left, Start + Custom pills on right -->
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Circular Timer Ring with Display in center -->
                                    <Grid Width="64" Height="64" Margin="2,0,10,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Background track circle -->
                                        <Ellipse Width="62" Height="62"
                                                 Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                 StrokeThickness="4"
                                                 Opacity="0.25" />
                                        <!-- Active Accent Ring -->
                                        <ProgressRing x:Name="TimerCircleRing"
                                                      Width="62" Height="62"
                                                      IsIndeterminate="False"
                                                      Minimum="0" Maximum="100" Value="100"
                                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <!-- Time text -->
                                        <TextBlock x:Name="TimerDisplay"
                                                   Text="5:00"
                                                   FontFamily="Segoe UI"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Foreground="#FFFFFFFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Right Side: Start pill + Custom pill -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                        <!-- Start / Pause button -->
                                        <Button x:Name="TimerStartBtn"
                                                Height="28"
                                                CornerRadius="14"
                                                Padding="14,0"
                                                HorizontalAlignment="Stretch"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Foreground="White"
                                                Click="TimerStartBtn_Click">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                                <FontIcon x:Name="TimerStartIcon" Glyph="&#xE768;" FontSize="11" />
                                                <TextBlock x:Name="TimerStartText" Text="Start" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Custom / Reset buttons row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button x:Name="TimerCustomToggleBtn"
                                                    Height="26"
                                                    CornerRadius="13"
                                                    Padding="10,0"
                                                    HorizontalAlignment="Stretch"
                                                    Background="#25FFFFFF"
                                                    Foreground="#E0FFFFFF"
                                                    Click="TimerCustomToggleBtn_Click">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                                                    <FontIcon Glyph="&#xE70F;" FontSize="10" Foreground="#B0FFFFFF" />
                                                    <TextBlock Text="Custom" FontSize="10.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Reset icon button beside Custom -->
                                            <Button Grid.Column="1"
                                                    x:Name="TimerResetBtn"
                                                    Width="26" Height="26"
                                                    Padding="0"
                                                    Margin="4,0,0,0"
                                                    CornerRadius="13"
                                                    Style="{StaticResource TabButtonStyle}"
                                                    ToolTipService.ToolTip="Reset timer"
                                                    Click="TimerResetBtn_Click">
                                                <FontIcon Glyph="&#xE777;" FontSize="11" Foreground="#90FFFFFF" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Bottom: Presets Row (default) -->
                                <StackPanel x:Name="TimerPresetsPanel"
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Button Content="5"  FontSize="10" FontWeight="SemiBold" Width="26" Height="22" Padding="0" CornerRadius="11" Background="#20FFFFFF" Foreground="#E0FFFFFF" Click="TimerPreset_Click" Tag="5" />
                                    <Button Content="10" FontSize="10" FontWeight="SemiBold" Width="26" Height="22" Padding="0" CornerRadius="11" Background="#20FFFFFF" Foreground="#E0FFFFFF" Click="TimerPreset_Click" Tag="10" />
                                    <Button Content="15" FontSize="10" FontWeight="SemiBold" Width="26" Height="22" Padding="0" CornerRadius="11" Background="#20FFFFFF" Foreground="#E0FFFFFF" Click="TimerPreset_Click" Tag="15" />
                                    <Button Content="25" FontSize="10" FontWeight="SemiBold" Width="26" Height="22" Padding="0" CornerRadius="11" Background="#20FFFFFF" Foreground="#E0FFFFFF" Click="TimerPreset_Click" Tag="25" />
                                    <Button Content="45" FontSize="10" FontWeight="SemiBold" Width="26" Height="22" Padding="0" CornerRadius="11" Background="#20FFFFFF" Foreground="#E0FFFFFF" Click="TimerPreset_Click" Tag="45" />
                                    <TextBlock Text="min" FontSize="10" Foreground="#70FFFFFF" VerticalAlignment="Center" Margin="2,0,0,0" />
                                </StackPanel>

                                <!-- Custom Input Row (shown when user clicks Custom) -->
                                <Grid x:Name="TimerCustomPanel" Visibility="Collapsed" Margin="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TimerCustomInput"
                                             PlaceholderText="25, 1:30, 90 s, 2 h"
                                             FontSize="10"
                                             Height="28"
                                             MinHeight="28"
                                             Padding="8,5,8,5"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Center"
                                             TextAlignment="Center"
                                             Background="#25FFFFFF"
                                             Foreground="#FFFFFFFF"
                                             BorderBrush="#35FFFFFF"
                                             CornerRadius="14"
                                             KeyDown="TimerCustomInput_KeyDown" />
                                    <Button Grid.Column="1"
                                            x:Name="TimerCustomPlayBtn"
                                            Width="28" Height="28"
                                            Padding="0"
                                            Margin="4,0,0,0"
                                            CornerRadius="14"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Foreground="White"
                                            ToolTipService.ToolTip="Start custom timer"
                                            Click="TimerCustomPlayBtn_Click">
                                        <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="White" />
                                    </Button>
                                    <Button Grid.Column="2"
                                            x:Name="TimerCustomCloseBtn"
                                            Width="20" Height="28"
                                            Padding="0"
                                            Margin="2,0,0,0"
                                            Style="{StaticResource TabButtonStyle}"
                                            ToolTipService.ToolTip="Close"
                                            Click="TimerCustomCloseBtn_Click">
                                        <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="#90FFFFFF" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Grid.Row="1" Height="1" Background="#20FFFFFF" Margin="0,0,0,6" />

                            <!-- Reminders Section -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- 0: Header with count badge -->
                                    <RowDefinition Height="*"    /> <!-- 1: Reminders List (directly below header) -->
                                    <RowDefinition Height="Auto" /> <!-- 2: Input Box (at bottom) -->
                                    <RowDefinition Height="Auto" /> <!-- 3: Suggestions (below input box) -->
                                </Grid.RowDefinitions>

                                <!-- Reminders Header -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="5" Margin="0,0,0,4">
                                    <FontIcon Glyph="&#xEA8F;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Reminders"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#E0FFFFFF"
                                               VerticalAlignment="Center" />
                                    <Border x:Name="ReminderCountBadge"
                                            Background="#25FFFFFF"
                                            CornerRadius="8"
                                            Padding="6,1"
                                            Margin="3,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="ReminderCountText"
                                                   Text="0"
                                                   FontSize="8.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F0FFFFFF" />
                                    </Border>
                                </StackPanel>

                                <!-- Reminders List (directly below Reminders heading) -->
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Margin="0,0,0,4">
                                    <StackPanel x:Name="ReminderList" Spacing="4" />
                                </ScrollViewer>

                                <!-- Natural Language Input Box (at bottom) -->
                                <TextBox Grid.Row="2"
                                         x:Name="ReminderNaturalInput"
                                         PlaceholderText="What to remind... (e.g. call mum tomorrow at 9)"
                                         FontSize="10"
                                         Height="30"
                                         MinHeight="30"
                                         Padding="12,5,12,5"
                                         VerticalContentAlignment="Center"
                                         Background="#1C1C1E"
                                         Foreground="#FFFFFF"
                                         BorderBrush="#25FFFFFF"
                                         BorderThickness="1"
                                         CornerRadius="15"
                                         TextChanged="ReminderNaturalInput_TextChanged"
                                         KeyDown="ReminderNaturalInput_KeyDown" />

                                <!-- Suggestions (below the input box) -->
                                <StackPanel Grid.Row="3" Margin="0,5,0,0" Spacing="4">
                                    <!-- When? Presets (Visible when no time detected, horizontally scrollable) -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  HorizontalScrollMode="Enabled">
                                        <StackPanel x:Name="ReminderWhenPanel"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    HorizontalAlignment="Left">
                                            <TextBlock Text="When?"
                                                       FontSize="9"
                                                       Foreground="#60FFFFFF"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,2,0" />
                                            <Button Content="10 min" FontSize="8.5" Padding="7,2" CornerRadius="10" Style="{StaticResource TabButtonStyle}" Click="ReminderQuickPreset_Click" Tag="10m" />
                                            <Button Content="1 hour" FontSize="8.5" Padding="7,2" CornerRadius="10" Style="{StaticResource TabButtonStyle}" Click="ReminderQuickPreset_Click" Tag="1h" />
                                            <Button Content="Tomorrow" FontSize="8.5" Padding="7,2" CornerRadius="10" Style="{StaticResource TabButtonStyle}" Click="ReminderQuickPreset_Click" Tag="tomorrow" />
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Detected Time Pill + Stepper Panel in TWO ROWS (Visible when time detected) -->
                                    <StackPanel x:Name="ReminderDetectedContainer"
                                                Spacing="4"
                                                Visibility="Collapsed">
                                        <!-- Row 1: Detected Time Pill -->
                                        <Button x:Name="ReminderDetectedPill"
                                                Background="#332405"
                                                BorderBrush="#664600"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="10,2"
                                                Height="23"
                                                HorizontalAlignment="Left"
                                                Click="ReminderDetectedPill_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="&#x21B5;" FontSize="10.5" Foreground="#FFA726" FontWeight="Bold" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ReminderDetectedText"
                                                           Text="in 5 min"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFA726"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Row 2: Steppers Row -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                                            <!-- Day Stepper -->
                                            <Border Background="#252528" CornerRadius="10" Padding="2,0" Height="22">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="&#x2212;" FontSize="10" Padding="6,0" Background="Transparent" BorderThickness="0" Foreground="#A0FFFFFF" Style="{StaticResource TabButtonStyle}" Click="ReminderAdjust_Click" Tag="-day" />
                                                    <TextBlock Text="day" FontSize="8.5" Foreground="#80FFFFFF" VerticalAlignment="Center" Margin="2,0" />
                                                    <Button Content="+" FontSize="10" Padding="6,0" Background="Transparent" BorderThickness="0" Foreground="#A0FFFFFF" Style="{StaticResource TabButtonStyle}" Click="ReminderAdjust_Click" Tag="+day" />
                                                </StackPanel>
                                            </Border>

                                            <!-- 15 Min Stepper -->
                                            <Border Background="#252528" CornerRadius="10" Padding="2,0" Height="22">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="&#x2212;" FontSize="10" Padding="6,0" Background="Transparent" BorderThickness="0" Foreground="#A0FFFFFF" Style="{StaticResource TabButtonStyle}" Click="ReminderAdjust_Click" Tag="-15m" />
                                                    <TextBlock Text="15 min" FontSize="8.5" Foreground="#80FFFFFF" VerticalAlignment="Center" Margin="2,0" />
                                                    <Button Content="+" FontSize="10" Padding="6,0" Background="Transparent" BorderThickness="0" Foreground="#A0FFFFFF" Style="{StaticResource TabButtonStyle}" Click="ReminderAdjust_Click" Tag="+15m" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Modal Overlay: Enter New Note Title -->
                        <Border x:Name="NoteNewTitleOverlay"
                                Grid.ColumnSpan="2"
                                Visibility="Collapsed"
                                Background="#EE14171E"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,14"
                                Width="260"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <StackPanel Spacing="10">
                                <TextBlock Text="New Note" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFFFF"/>
                                <TextBox x:Name="NoteNewTitleBox"
                                         PlaceholderText="Enter note title..."
                                         FontSize="12"
                                         Height="32"
                                         MinHeight="32"
                                         Padding="10,6,10,6"
                                         VerticalContentAlignment="Center"
                                         Background="#20FFFFFF"
                                         Foreground="#FFFFFFFF"
                                         BorderBrush="#30FFFFFF"
                                         CornerRadius="6"
                                         KeyDown="NoteNewTitleBox_KeyDown"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                    <Button Content="Cancel"
                                            Click="NoteNewTitleCancel_Click"
                                            Style="{StaticResource TabButtonStyle}"
                                            FontSize="11"
                                            Padding="10,4"
                                            CornerRadius="5"/>
                                    <Button x:Name="NoteNewTitleCreateBtn"
                                            Content="Create"
                                            Click="NoteNewTitleCreate_Click"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Foreground="White"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Padding="14,4"
                                            CornerRadius="5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ═══════════════════════════════════════════════════════════
                         WEATHER TAB (Milestone 10)
                    ════════════════════════════════════════════════════════════ -->
                    <Grid x:Name="ContentWeather" Opacity="1" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="215"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Card: Current Conditions & Outlook (Day/Night Dynamic Gradient) -->
                            <Border x:Name="WeatherHeroCard"
                                    Grid.Column="0"
                                    BorderBrush="#35FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14,12,14,10"
                                    PointerWheelChanged="WeatherHeroCard_PointerWheelChanged"
                                    ToolTipService.ToolTip="Current weather conditions and daily summary. Scroll to cycle through saved cities.">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF2B7CE9" Offset="0.0"/>
                                        <GradientStop Color="#FF174381" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- City header -->
                                        <RowDefinition Height="Auto"/> <!-- Weather icon + temp -->
                                        <RowDefinition Height="Auto"/> <!-- Condition & feels like -->
                                        <RowDefinition Height="*"/>    <!-- Outlook summary card -->
                                        <RowDefinition Height="Auto"/> <!-- Attribution -->
                                    </Grid.RowDefinitions>

                                    <!-- City Header with Location Pin, Dropdown Chevron, and Refresh -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1">
                                            <Button x:Name="WeatherCitySelectBtn"
                                                    Click="WeatherChangeCityBtn_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Left"
                                                    ToolTipService.ToolTip="Select or add cities">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE707;" FontSize="11" Foreground="#FFFFFFFF"/>
                                                    <TextBlock x:Name="WeatherCityText"
                                                               Text="No city set"
                                                               FontFamily="Segoe UI Variable Display"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="#FFFFFFFF"
                                                               MaxWidth="145"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="#C0FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock x:Name="WeatherCityTimeText"
                                                       Text=""
                                                       FontFamily="Segoe UI Variable Small"
                                                       FontSize="10"
                                                       Foreground="#B0FFFFFF"
                                                       Margin="2,0,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                x:Name="WeatherRefreshBtn"
                                                Click="WeatherRefreshBtn_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4"
                                                VerticalAlignment="Top"
                                                ToolTipService.ToolTip="Refresh weather">
                                            <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="#FFFFFFFF"/>
                                        </Button>
                                    </Grid>

                                    <!-- Weather icon + Large Temperature -->
                                    <StackPanel Grid.Row="1" Spacing="0" Margin="0,4,0,0">
                                        <FontIcon x:Name="WeatherConditionIcon"
                                                  FontFamily="Segoe UI Symbol, Segoe Fluent Icons"
                                                  Glyph="&#x2600;"
                                                  FontSize="38"
                                                  Foreground="#FFEB3B"
                                                  HorizontalAlignment="Left"
                                                  Margin="2,0,0,2"/>
                                        <TextBlock x:Name="WeatherBigTemp"
                                                   Text="20°"
                                                   FontFamily="Segoe UI Variable Display"
                                                   FontWeight="SemiBold"
                                                   FontSize="44"
                                                   Foreground="#FFFFFFFF"
                                                   Margin="0,0,0,0"/>
                                    </StackPanel>

                                    <!-- Saved City Dots Indicator (Right side, vertically centered across whole card) -->
                                    <Border x:Name="WeatherCityDotsContainer"
                                            Grid.Row="0"
                                            Grid.RowSpan="5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="#24000000"
                                            BorderBrush="#20FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="3,5"
                                            Margin="0,0,-4,0">
                                        <StackPanel x:Name="WeatherCityDotsPanel"
                                                    Spacing="3"
                                                    HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Condition & Feels Like -->
                                    <StackPanel Grid.Row="2" Spacing="2" Margin="0,2,0,0">
                                        <TextBlock x:Name="WeatherConditionText"
                                                   Text="Clear"
                                                   FontFamily="Segoe UI Variable Small"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="#FFFFFFFF"/>
                                        <TextBlock x:Name="WeatherFeelsLikeText"
                                                   Text="Feels like 18° · Today 12°...20°"
                                                   FontFamily="Segoe UI Variable Small"
                                                   FontSize="11"
                                                   Foreground="#D0FFFFFF"/>
                                    </StackPanel>

                                    <!-- Summary Outlook Pill Card -->
                                    <Border Grid.Row="3"
                                            Background="#28000000"
                                            BorderBrush="#20FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            VerticalAlignment="Bottom"
                                            Margin="0,6,0,0">
                                        <TextBlock x:Name="WeatherOutlookText"
                                                   Text="Dry for the next day, up to 20° this afternoon"
                                                   FontFamily="Segoe UI Variable Small"
                                                   FontSize="10.5"
                                                   Foreground="#F0FFFFFF"
                                                   TextWrapping="Wrap"
                                                   MaxLines="3"/>
                                    </Border>

                                    <!-- Attribution Footer -->
                                    <Grid Grid.Row="4" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Data from MET Norway"
                                                   FontFamily="Segoe UI Variable Small"
                                                   FontSize="9"
                                                   Foreground="#80FFFFFF"/>
                                        <TextBlock Grid.Column="1"
                                                   x:Name="WeatherUpdatedText"
                                                   Text=""
                                                   FontFamily="Segoe UI Variable Small"
                                                   FontSize="9"
                                                   Foreground="#80FFFFFF"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Right Card: Hours/Week Forecast + Metric Tiles -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="68"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Hours / Week Tab Selector -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1"
                                            Background="#20FFFFFF"
                                            BorderBrush="#25FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="13"
                                            Padding="2">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button x:Name="WeatherBtnHours"
                                                    Content="Hours"
                                                    Click="WeatherBtnHours_Click"
                                                    Padding="12,2"
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Background="#40FFFFFF"
                                                    BorderThickness="0"
                                                    CornerRadius="11"
                                                    Foreground="#FFFFFFFF"/>
                                            <Button x:Name="WeatherBtnWeek"
                                                    Content="Week"
                                                    Click="WeatherBtnWeek_Click"
                                                    Padding="12,2"
                                                    FontSize="10"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    CornerRadius="11"
                                                    Foreground="#A0FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Forecast View -->
                                <Grid Grid.Row="1">
                                    <!-- Hourly Scroll Strip -->
                                    <ScrollViewer x:Name="WeatherHoursScroll"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="WeatherHoursStack"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Padding="1,2,1,2"/>
                                    </ScrollViewer>

                                    <!-- 7-Day Outlook Strip -->
                                    <ScrollViewer x:Name="WeatherWeekScroll"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Visibility="Collapsed">
                                        <StackPanel x:Name="WeatherWeekStack"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Padding="1,2,1,2"/>
                                    </ScrollViewer>
                                </Grid>

                                <!-- 6 Visual Metric Tiles -->
                                <Grid Grid.Row="2" Margin="0,6,0,0" RowSpacing="6" ColumnSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. WIND TILE with Compass Dial -->
                                    <Border x:Name="WeatherWindCard"
                                            Grid.Row="0" Grid.Column="0"
                                            Background="#14FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1"
                                            CornerRadius="10" Padding="8,6"
                                            ToolTipService.ToolTip="Wind speed, direction, and compass orientation">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="WIND" FontSize="9" FontWeight="SemiBold" Foreground="#80FFFFFF"/>
                                            <Grid Grid.Row="1" Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Compass Dial -->
                                                <Grid Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="38" Height="38" CornerRadius="19" BorderBrush="#35FFFFFF" BorderThickness="1"/>
                                                    <TextBlock Text="N" FontSize="7" FontWeight="Bold" Foreground="#90FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                    <TextBlock Text="S" FontSize="7" FontWeight="Bold" Foreground="#90FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                                    <TextBlock Text="W" FontSize="7" FontWeight="Bold" Foreground="#90FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                                    <TextBlock Text="E" FontSize="7" FontWeight="Bold" Foreground="#90FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0"/>
                                                    <!-- Arrow needle -->
                                                    <Path x:Name="WeatherWindNeedle"
                                                          Data="M 0,-12 L 3,3 L 0,1 L -3,3 Z"
                                                          Fill="#FFFFFFFF"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center">
                                                        <Path.RenderTransform>
                                                            <RotateTransform x:Name="WeatherWindRotate" Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                                <!-- Speed & Direction Name -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="4,0,0,0">
                                                    <TextBlock x:Name="WeatherWindSpeedText" Text="1 m/s" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                                    <TextBlock x:Name="WeatherWindDirText" Text="North" FontSize="10" Foreground="#A0FFFFFF"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- 2. HUMIDITY TILE with Progress Bar -->
                                    <Border x:Name="WeatherHumidityCard"
                                            Grid.Row="0" Grid.Column="1"
                                            Background="#14FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1"
                                            CornerRadius="10" Padding="8,6"
                                            ToolTipService.ToolTip="Relative humidity percentage and dew point">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="HUMIDITY" FontSize="9" FontWeight="SemiBold" Foreground="#80FFFFFF"/>
                                            <TextBlock x:Name="WeatherHumidityValText" Text="39%" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFFFF" Margin="0,2,0,0"/>
                                            <!-- Progress Track -->
                                            <Grid Height="4" CornerRadius="2" Background="#25FFFFFF" Margin="0,4,0,4">
                                                <Border x:Name="WeatherHumidityFill" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="#60CDFF" Width="40"/>
                                            </Grid>
                                            <TextBlock x:Name="WeatherDewText" Text="Dew point 6°" FontSize="10" Foreground="#90FFFFFF"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. PRESSURE TILE with Arc Gauge -->
                                    <Border x:Name="WeatherPressureCard"
                                            Grid.Row="0" Grid.Column="2"
                                            Background="#14FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1"
                                            CornerRadius="10" Padding="8,6"
                                            ToolTipService.ToolTip="Barometric pressure in hPa and rising/falling trend">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="PRESSURE" FontSize="9" FontWeight="SemiBold" Foreground="#80FFFFFF"/>
                                            <Grid Grid.Row="1" Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Arc Gauge -->
                                                <Grid Width="40" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="M 4,28 A 16,16 0 1,1 36,28"
                                                          Stroke="#30FFFFFF"
                                                          StrokeThickness="3"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"/>
                                                    <Path Data="M 4,28 A 16,16 0 1,1 36,28"
                                                          Stroke="#60CDFF"
                                                          StrokeThickness="3"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"/>
                                                    <Path x:Name="WeatherPressureNeedle"
                                                          Data="M 0,0 L 0,-13"
                                                          Stroke="#FFFFFFFF"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Bottom"
                                                          Margin="0,0,0,4">
                                                        <Path.RenderTransform>
                                                            <RotateTransform x:Name="WeatherPressureRotate" Angle="12"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="4,0,0,0">
                                                    <TextBlock x:Name="WeatherPressureValText" Text="1020 hPa" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                                    <TextBlock x:Name="WeatherPressureTrendText" Text="↓ falling" FontSize="10" Foreground="#A0FFFFFF"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- 4. SUN TILE with Trajectory Arc -->
                                    <Border x:Name="WeatherSunCard"
                                            Grid.Row="1" Grid.Column="0"
                                            Background="#14FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1"
                                            CornerRadius="10" Padding="8,6"
                                            ToolTipService.ToolTip="Sunrise, sunset times and current solar position">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="SUN" FontSize="9" FontWeight="SemiBold" Foreground="#80FFFFFF"/>
                                            <Grid Height="24" Margin="0,2,0,2">
                                                <Canvas x:Name="WeatherSunCanvas" Width="88" Height="22" HorizontalAlignment="Center">
                                                    <!-- Parabolic arc from (2, 18) to (86, 18) -->
                                                    <Path Data="M 2,18 Q 44,-2 86,18"
                                                          Stroke="#40FFFFFF"
                                                          StrokeDashArray="2,2"
                                                          StrokeThickness="1.5"/>
                                                    <!-- Horizon line -->
                                                    <Line X1="0" Y1="18" X2="88" Y2="18"
                                                          Stroke="#20FFFFFF"
                                                          StrokeThickness="1"/>
                                                    <!-- Sun dot -->
                                                    <Ellipse x:Name="WeatherSunDot"
                                                             Width="8" Height="8"
                                                             Fill="#FFD700"
                                                             Canvas.Left="40"
                                                             Canvas.Top="4"/>
                                                </Canvas>
                                            </Grid>
                                            <TextBlock x:Name="WeatherSunTimesText"
                                                       Text="↑ 6:30 AM  ↓ 5:09 PM"
                                                       FontSize="9"
                                                       Foreground="#C0FFFFFF"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 5. PRECIPITATION TILE -->
                                    <Border x:Name="WeatherPrecipCard"
                                            Grid.Row="1" Grid.Column="1"
                                            Background="#14FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1"
                                            CornerRadius="10" Padding="8,6"
                                            ToolTipService.ToolTip="Precipitation accumulation recorded today">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="PRECIPITATION" FontSize="9" FontWeight="SemiBold" Foreground="#80FFFFFF"/>
                                            <TextBlock x:Name="WeatherPrecipValText" Text="0 mm today" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF" Margin="0,2,0,0"/>
                                            <!-- Mini precipitation bar -->
                                            <Border Height="2" Background="#25FFFFFF" CornerRadius="1" Margin="0,6,0,4">
                                                <Border x:Name="WeatherPrecipFill" Height="2" Background="#60CDFF" CornerRadius="1" HorizontalAlignment="Left" Width="0"/>
                                            </Border>
                                            <TextBlock x:Name="WeatherPrecipSubText" Text="No rain expected today" FontSize="9" Foreground="#90FFFFFF"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 6. UV INDEX TILE with Spectrum Gradient Bar -->
                                    <Border x:Name="WeatherUvCard"
                                            Grid.Row="1" Grid.Column="2"
                                            Background="#14FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1"
                                            CornerRadius="10" Padding="8,6"
                                            ToolTipService.ToolTip="Ultraviolet radiation intensity and protection level">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="UV INDEX" FontSize="9" FontWeight="SemiBold" Foreground="#80FFFFFF"/>
                                            <TextBlock x:Name="WeatherUvValText" Text="5 moderate" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF" Margin="0,2,0,0"/>
                                            <!-- Spectrum Gradient -->
                                            <Grid Height="10" Margin="0,4,0,4" VerticalAlignment="Center">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#4CAF50" Offset="0.0"/>
                                                            <GradientStop Color="#FFEB3B" Offset="0.3"/>
                                                            <GradientStop Color="#FF9800" Offset="0.6"/>
                                                            <GradientStop Color="#F44336" Offset="0.8"/>
                                                            <GradientStop Color="#9C27B0" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Ellipse x:Name="WeatherUvThumb"
                                                         Width="8" Height="8"
                                                         Fill="White"
                                                         Stroke="#40000000"
                                                         StrokeThickness="1"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Center"
                                                         Margin="36,0,0,0"/>
                                            </Grid>
                                            <TextBlock x:Name="WeatherUvSubText" Text="Tomorrow up to 5" FontSize="9" Foreground="#90FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- ── Multiple Cities Management Overlay ────────────────── -->
                        <Border x:Name="WeatherCityOverlay"
                                Background="#E6101216"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,14"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Title + close -->
                                    <RowDefinition Height="Auto"/> <!-- Search box -->
                                    <RowDefinition Height="Auto"/> <!-- Search feedback -->
                                    <RowDefinition Height="*"/>    <!-- Saved cities list or search results -->
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon x:Name="WeatherLocationsHeaderIcon" Glyph="&#xE707;" FontSize="13" Foreground="#60CDFF"/>
                                        <TextBlock Text="Weather Locations"
                                                   FontFamily="Segoe UI Variable Display"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#FFFFFFFF"/>
                                    </StackPanel>
                                    <Button x:Name="WeatherCityCloseBtn"
                                            HorizontalAlignment="Right"
                                            Width="24" Height="24" Padding="0"
                                            CornerRadius="12"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Click="WeatherSearchCancel_Click"
                                            ToolTipService.ToolTip="Close (Esc)">
                                        <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#A0FFFFFF"/>
                                    </Button>
                                </Grid>

                                <!-- Search row -->
                                <Grid Grid.Row="1" Margin="0,2,0,8" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WeatherSearchInput"
                                             PlaceholderText="Search city to add (e.g. London, Tokyo, Pokhara)..."
                                             FontSize="12"
                                             Height="32"
                                             Padding="10,6,10,6"
                                             CornerRadius="6"
                                             Background="#20FFFFFF"
                                             BorderBrush="#30FFFFFF"
                                             Foreground="#FFFFFFFF"
                                             KeyDown="WeatherSearchInput_KeyDown"/>
                                    <Button Grid.Column="1"
                                            x:Name="WeatherSearchSubmit"
                                            Content="Search"
                                            Click="WeatherSearchSubmit_Click"
                                            Height="32"
                                            Padding="14,2"
                                            CornerRadius="6"
                                            Background="#25FFFFFF"
                                            BorderBrush="#35FFFFFF"
                                            BorderThickness="1"
                                            Foreground="#FFFFFFFF"/>
                                </Grid>

                                <TextBlock Grid.Row="2"
                                           x:Name="WeatherSearchFeedback"
                                           Text=""
                                           FontSize="11"
                                           Foreground="#80FFFFFF"
                                           Margin="0,0,0,6"
                                           Visibility="Collapsed"/>

                                <!-- Cities / Search Results Scroll Area -->
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="6">
                                        <!-- Search results container -->
                                        <StackPanel x:Name="WeatherSearchResultsStack" Spacing="3"/>

                                        <!-- Saved cities header and list -->
                                        <TextBlock x:Name="WeatherSavedCitiesHeader"
                                                   Text="SAVED CITIES"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="#70FFFFFF"
                                                   Margin="2,4,0,2"/>
                                        <StackPanel x:Name="WeatherSavedCitiesStack" Spacing="4"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ═══════════════════════════════════════════════════════════
                         CONTROLS TAB (Milestone 11)
                    ════════════════════════════════════════════════════════════ -->
                    <Grid x:Name="ContentControls" Opacity="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: 5 Control Tiles (Wi-Fi, Bluetooth, Dark Theme, Battery, VPN) -->
                        <Grid Grid.Row="0" ColumnSpacing="6" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Wi-Fi Tile with List Icon -->
                            <Grid Grid.Column="0">
                                <Button x:Name="ControlsWifiBtn"
                                        Click="ControlsWifiBtn_Click"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="#15FFFFFF"
                                        BorderBrush="#20FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,6"
                                        ToolTipService.ToolTip="Toggle Wi-Fi">
                                    <StackPanel Spacing="2">
                                        <FontIcon x:Name="ControlsWifiIcon" Glyph="&#xE701;" FontSize="14" Foreground="#60CDFF" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Wi-Fi" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                        <TextBlock x:Name="ControlsWifiStatus" Text="Connected" FontSize="9" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ControlsWifiListBtn"
                                        Click="ControlsWifiListBtn_Click"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Width="20" Height="20"
                                        Padding="0"
                                        Margin="0,3,3,0"
                                        CornerRadius="4"
                                        Style="{StaticResource TabButtonStyle}"
                                        ToolTipService.ToolTip="Wi-Fi networks list">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="9.5" Foreground="#A0FFFFFF"/>
                                </Button>
                            </Grid>

                            <!-- Bluetooth Tile with List Icon -->
                            <Grid Grid.Column="1">
                                <Button x:Name="ControlsBtBtn"
                                        Click="ControlsBtBtn_Click"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="#15FFFFFF"
                                        BorderBrush="#20FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,6"
                                        ToolTipService.ToolTip="Toggle Bluetooth">
                                    <StackPanel Spacing="2">
                                        <FontIcon x:Name="ControlsBtIcon" Glyph="&#xE702;" FontSize="14" Foreground="#60CDFF" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Bluetooth" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                        <TextBlock x:Name="ControlsBtStatus" Text="On" FontSize="9" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ControlsBtListBtn"
                                        Click="ControlsBtListBtn_Click"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Width="20" Height="20"
                                        Padding="0"
                                        Margin="0,3,3,0"
                                        CornerRadius="4"
                                        Style="{StaticResource TabButtonStyle}"
                                        ToolTipService.ToolTip="Bluetooth devices list">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="9.5" Foreground="#A0FFFFFF"/>
                                </Button>
                            </Grid>

                            <!-- Dark Theme Tile -->
                            <Button Grid.Column="2"
                                    x:Name="ControlsThemeBtn"
                                    Click="ControlsThemeBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="#15FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    ToolTipService.ToolTip="Toggle Windows dark theme">
                                <StackPanel Spacing="2">
                                    <FontIcon x:Name="ControlsThemeIcon" Glyph="&#xE790;" FontSize="14" Foreground="#60CDFF" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Dark Theme" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                    <TextBlock x:Name="ControlsThemeStatus" Text="Dark" FontSize="9" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- Battery Tile with Battery Saver icon in top-right -->
                            <Grid Grid.Column="3">
                                <Button x:Name="ControlsBatteryBtn"
                                        Click="ControlsBatteryBtn_Click"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="#15FFFFFF"
                                        BorderBrush="#20FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,6"
                                        ToolTipService.ToolTip="Battery &amp; power settings">
                                    <StackPanel Spacing="2">
                                        <FontIcon x:Name="ControlsBatteryIcon" Glyph="&#xE83F;" FontSize="14" Foreground="#4CAF50" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Battery" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                            <FontIcon x:Name="ControlsBatteryPlugIcon" Glyph="&#xE83E;" FontSize="9" Foreground="#4CAF50" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ControlsBatteryStatus" Text="100%" FontSize="9" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ControlsBatterySaverBtn"
                                        Click="ControlsBatterySaverBtn_Click"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Width="20" Height="20"
                                        Padding="0"
                                        Margin="0,3,3,0"
                                        CornerRadius="4"
                                        Style="{StaticResource TabButtonStyle}"
                                        ToolTipService.ToolTip="Battery saver">
                                    <FontIcon x:Name="ControlsBatterySaverIcon" Glyph="&#xEBC0;" FontSize="10.5" Foreground="#70FFFFFF"/>
                                </Button>
                            </Grid>

                            <!-- VPN Tile -->
                            <Button Grid.Column="4"
                                    x:Name="ControlsVpnBtn"
                                    Click="ControlsVpnBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="#15FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    ToolTipService.ToolTip="VPN connection">
                                <StackPanel Spacing="2">
                                    <FontIcon x:Name="ControlsVpnIcon" Glyph="&#xE705;" FontSize="14" Foreground="#80FFFFFF" HorizontalAlignment="Left"/>
                                    <TextBlock Text="VPN" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                    <TextBlock x:Name="ControlsVpnStatus" Text="Off" FontSize="9" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Row 1: Scrollable area (Bluetooth battery card + Quick cards grid) -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,0,0,6">
                            <StackPanel Spacing="8">
                                <!-- Bluetooth Battery Cards Grid -->
                                <Grid x:Name="ControlsBtBatteryContainer"
                                      ColumnSpacing="8"
                                      RowSpacing="8"
                                      Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ControlsBtBatteryCard"
                                            Tapped="ControlsBtBatteryCard_Tapped"
                                            Background="#16FFFFFF"
                                            BorderBrush="#20FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Grid.ColumnSpan="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon x:Name="ControlsBtBatteryCardIcon" Glyph="&#xE702;" FontSize="13" Foreground="#60CDFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" x:Name="ControlsBtBatteryCardTitle" Text="Bluetooth devices" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" x:Name="ControlsBtBatteryCardStatus" Text="No devices connected" FontSize="10" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Quick cards section header -->
                                <Grid Margin="2,2,2,0">
                                    <TextBlock Text="Quick cards" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                                    <Button x:Name="ControlsQuickCardsEditBtn"
                                            Click="ControlsQuickCardsEditBtn_Click"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource TabButtonStyle}"
                                            Padding="8,2"
                                            CornerRadius="4">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon x:Name="ControlsQuickCardsEditIcon" Glyph="&#xE70F;" FontSize="10" Foreground="#A0FFFFFF"/>
                                            <TextBlock x:Name="ControlsQuickCardsEditText" Text="Edit" FontSize="10" Foreground="#D0FFFFFF"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Quick cards grid (4 columns) -->
                                <Grid x:Name="ControlsQuickCardsGrid" ColumnSpacing="6" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Row 2: Brightness Slider Row (pinned) -->
                        <Border x:Name="ControlsBrightnessRow"
                                Grid.Row="2"
                                Margin="0,4,0,6"
                                Background="#12FFFFFF"
                                BorderBrush="#18FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE706;" FontSize="13" Foreground="#FFD700" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1"
                                        x:Name="ControlsBrightnessSlider"
                                        ValueChanged="ControlsBrightnessSlider_ValueChanged"
                                        PointerPressed="ControlsBrightnessSlider_PointerPressed"
                                        PointerReleased="ControlsBrightnessSlider_PointerReleased"
                                        PointerWheelChanged="ControlsBrightnessSlider_PointerWheelChanged"
                                        VerticalAlignment="Center"
                                        Margin="0,-6,0,-6"/>
                                <TextBlock Grid.Column="2"
                                           x:Name="ControlsBrightnessText"
                                           Text="100%"
                                           FontSize="10"
                                           Foreground="#A0FFFFFF"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Row 3: Microphone Dropdown + Volume Slider + Mute/Lock Button (pinned) -->
                        <Border x:Name="ControlsMicrophoneRow"
                                Grid.Row="3"
                                Margin="0,0,0,6"
                                Background="#12FFFFFF"
                                BorderBrush="#18FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,3">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ControlsMicCombo"
                                          Grid.Column="0"
                                          SelectionChanged="ControlsMicCombo_SelectionChanged"
                                          Width="138"
                                          FontSize="10.5"
                                          Padding="8,3,6,3"
                                          MinHeight="24"
                                          VerticalAlignment="Center"
                                          ToolTipService.ToolTip="Select microphone"/>
                                <Slider Grid.Column="1"
                                        x:Name="ControlsMicSlider"
                                        ValueChanged="ControlsMicSlider_ValueChanged"
                                        PointerPressed="ControlsMicSlider_PointerPressed"
                                        PointerReleased="ControlsMicSlider_PointerReleased"
                                        PointerWheelChanged="ControlsMicSlider_PointerWheelChanged"
                                        VerticalAlignment="Center"
                                        Margin="0,-6,0,-6"/>
                                <TextBlock Grid.Column="2"
                                           x:Name="ControlsMicText"
                                           Text="100%"
                                           FontSize="10"
                                           Foreground="#A0FFFFFF"
                                           MinWidth="28"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="3"
                                        x:Name="ControlsMicMuteBtn"
                                        Click="ControlsMicMuteBtn_Click"
                                        RightTapped="ControlsMicMuteBtn_RightTapped"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4"
                                        MinWidth="26"
                                        MinHeight="24"
                                        CornerRadius="5"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <FontIcon x:Name="ControlsMicMuteIcon"
                                                  Glyph="&#xE720;"
                                                  FontSize="13"
                                                  Foreground="#F0FFFFFF"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        <Border x:Name="ControlsMicLockBadge"
                                                Width="12"
                                                Height="12"
                                                CornerRadius="6"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                BorderBrush="#202020"
                                                BorderThickness="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,-4,-4"
                                                Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE72E;"
                                                      FontSize="6.5"
                                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Row 4: 4 System Power Buttons (Lock, Sleep, Restart [confirming], Shut Down [confirming]) (pinned) -->
                        <Grid x:Name="ControlsPowerRow" Grid.Row="4" Margin="0,0,0,0" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Lock -->
                            <Button Grid.Column="0"
                                    x:Name="ControlsLockBtn"
                                    Click="ControlsLockBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="#18FFFFFF"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="4,6">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="#C0FFFFFF"/>
                                    <TextBlock Text="Lock" FontSize="11" Foreground="#F0FFFFFF"/>
                                </StackPanel>
                            </Button>

                            <!-- Sleep -->
                            <Button Grid.Column="1"
                                    x:Name="ControlsSleepBtn"
                                    Click="ControlsSleepBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="#18FFFFFF"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="4,6">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE708;" FontSize="12" Foreground="#C0FFFFFF"/>
                                    <TextBlock Text="Sleep" FontSize="11" Foreground="#F0FFFFFF"/>
                                </StackPanel>
                            </Button>

                            <!-- Restart (Double-tap safety) -->
                            <Button Grid.Column="2"
                                    x:Name="ControlsRestartBtn"
                                    Click="ControlsRestartBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="#18FFFFFF"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="4,6">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                    <FontIcon x:Name="ControlsRestartIcon" Glyph="&#xE777;" FontSize="12" Foreground="#C0FFFFFF"/>
                                    <TextBlock x:Name="ControlsRestartText" Text="Restart" FontSize="11" Foreground="#F0FFFFFF"/>
                                </StackPanel>
                            </Button>

                            <!-- Shut Down (Double-tap safety) -->
                            <Button Grid.Column="3"
                                    x:Name="ControlsShutdownBtn"
                                    Click="ControlsShutdownBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="#18FFFFFF"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="4,6">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                    <FontIcon x:Name="ControlsShutdownIcon" Glyph="&#xE7E8;" FontSize="12" Foreground="#FF6B6B"/>
                                    <TextBlock x:Name="ControlsShutdownText" Text="Shut down" FontSize="11" Foreground="#F0FFFFFF"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Device List Overlay (for Wi-Fi networks & Bluetooth devices) -->
                        <Border x:Name="ControlsDeviceOverlay"
                                Grid.Row="0" Grid.RowSpan="2"
                                Visibility="Collapsed"
                                Background="#1C1C1F"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10,14,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock x:Name="ControlsDeviceOverlayTitle"
                                               Text="Bluetooth devices"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFFFF"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                        <Button x:Name="ControlsDeviceRefreshBtn"
                                                Click="ControlsDeviceRefreshBtn_Click"
                                                Style="{StaticResource TabButtonStyle}"
                                                Padding="8,3"
                                                CornerRadius="4"
                                                ToolTipService.ToolTip="Refresh list">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon x:Name="ControlsDeviceRefreshIcon" Glyph="&#xE72C;" FontSize="10.5" Foreground="#C0FFFFFF"/>
                                                <TextBlock Text="Refresh" FontSize="10" Foreground="#E0FFFFFF"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ControlsDeviceSettingsBtn"
                                                Click="ControlsDeviceSettingsBtn_Click"
                                                Style="{StaticResource TabButtonStyle}"
                                                Padding="8,3"
                                                CornerRadius="4"
                                                ToolTipService.ToolTip="Open Windows Settings">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE713;" FontSize="10.5" Foreground="#C0FFFFFF"/>
                                                <TextBlock Text="Settings" FontSize="10" Foreground="#E0FFFFFF"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ControlsDeviceCloseBtn"
                                                Click="ControlsDeviceCloseBtn_Click"
                                                Style="{StaticResource TabButtonStyle}"
                                                Width="24" Height="24"
                                                Padding="0"
                                                CornerRadius="4"
                                                ToolTipService.ToolTip="Close">
                                            <FontIcon Glyph="&#xE711;" FontSize="10.5" Foreground="#B0FFFFFF"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Scrollable Device List -->
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="ControlsDeviceList" Spacing="6"/>
                                </ScrollViewer>

                                <!-- Inline Wi-Fi Password Prompt -->
                                <Border x:Name="ControlsWifiPasswordOverlay"
                                        Grid.Row="0" Grid.RowSpan="2"
                                        Visibility="Collapsed"
                                        Background="#E6141418"
                                        CornerRadius="8"
                                        Padding="14">
                                    <Border VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Width="280"
                                            Background="#222226"
                                            BorderBrush="#28FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14">
                                        <StackPanel Spacing="10">
                                            <TextBlock x:Name="ControlsWifiPasswordTitle"
                                                       Text="Connect to Wi-Fi"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFFFF"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <PasswordBox x:Name="ControlsWifiPasswordBox"
                                                         PlaceholderText="Enter network security key"
                                                         KeyDown="ControlsWifiPasswordBox_KeyDown"/>
                                            <TextBlock x:Name="ControlsWifiPasswordError"
                                                       Visibility="Collapsed"
                                                       Text="Could not connect. Check the password and try again."
                                                       FontSize="10.5"
                                                       Foreground="#FFFF6B6B"
                                                       TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                                <Button x:Name="ControlsWifiPasswordCancelBtn"
                                                        Content="Cancel"
                                                        Click="ControlsWifiPasswordCancelBtn_Click"
                                                        Style="{StaticResource TabButtonStyle}"
                                                        Padding="12,5"
                                                        CornerRadius="6"/>
                                                <Button x:Name="ControlsWifiPasswordConnectBtn"
                                                        Content="Connect"
                                                        Click="ControlsWifiPasswordConnectBtn_Click"
                                                        Padding="14,5"
                                                        CornerRadius="6"
                                                        Foreground="#FFFFFFFF"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Quick Card Add / Edit Overlay -->
                        <Border x:Name="ControlsAddCardOverlay"
                                Grid.Row="0" Grid.RowSpan="2"
                                Visibility="Collapsed"
                                Background="#1C1C1F"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10,14,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock x:Name="ControlsAddCardTitle"
                                                   Text="Add card"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFFFF"
                                                   VerticalAlignment="Center"/>

                                        <!-- Tab Switcher (Built-in / Custom) -->
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button x:Name="ControlsCardTabBuiltInBtn"
                                                    Click="ControlsCardTabBuiltInBtn_Click"
                                                    Style="{StaticResource TabButtonStyle}"
                                                    Background="#25FFFFFF"
                                                    Padding="10,3"
                                                    CornerRadius="4">
                                                <TextBlock x:Name="ControlsCardTabBuiltInText" Text="Built-in" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                            </Button>
                                            <Button x:Name="ControlsCardTabCustomBtn"
                                                    Click="ControlsCardTabCustomBtn_Click"
                                                    Style="{StaticResource TabButtonStyle}"
                                                    Background="Transparent"
                                                    Padding="10,3"
                                                    CornerRadius="4">
                                                <TextBlock x:Name="ControlsCardTabCustomText" Text="Custom" FontSize="10" Foreground="#A0FFFFFF"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Close Button -->
                                    <Button x:Name="ControlsAddCardCloseBtn"
                                            Click="ControlsAddCardCloseBtn_Click"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource TabButtonStyle}"
                                            Width="24" Height="24"
                                            Padding="0"
                                            CornerRadius="4"
                                            ToolTipService.ToolTip="Close (Esc)">
                                        <FontIcon Glyph="&#xE711;" FontSize="10.5" Foreground="#B0FFFFFF"/>
                                    </Button>
                                </Grid>

                                <!-- Tab 1: Built-in Catalog List -->
                                <Grid x:Name="ControlsAddCardBuiltInPanel" Grid.Row="1" Visibility="Visible">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <Grid x:Name="ControlsBuiltInGrid" ColumnSpacing="6" RowSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>

                                <!-- Tab 2: Custom Card Form -->
                                <Grid x:Name="ControlsAddCardCustomPanel" Grid.Row="1" Visibility="Collapsed">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                                        <StackPanel Spacing="8">
                                            <!-- Row 1: Name and Admin Checkbox -->
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="Card name" FontSize="10" Foreground="#A0FFFFFF"/>
                                                    <TextBox x:Name="ControlsCardNameBox"
                                                             PlaceholderText="e.g. Steam, Discord, Music..."
                                                             MaxLength="24"
                                                             Height="30"
                                                             MinHeight="30"
                                                             FontSize="11"
                                                             CornerRadius="5"
                                                             Background="#20FFFFFF"
                                                             BorderBrush="#30FFFFFF"
                                                             Foreground="#FFFFFFFF"
                                                             Padding="10,5,10,5"
                                                             VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1"
                                                          x:Name="ControlsCardAdminCheck"
                                                          Content="Run as admin"
                                                          FontSize="10.5"
                                                          Foreground="#D0FFFFFF"
                                                          VerticalAlignment="Bottom"
                                                          Margin="0,0,0,2"/>
                                            </Grid>

                                            <!-- Row 2: Command & Browse button -->
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Command / URI / App path" FontSize="10" Foreground="#A0FFFFFF"/>
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="ControlsCardCommandBox"
                                                             PlaceholderText="e.g. ms-settings:sound or calc.exe or C:\app.exe"
                                                             Height="30"
                                                             MinHeight="30"
                                                             FontSize="11"
                                                             CornerRadius="5"
                                                             Background="#20FFFFFF"
                                                             BorderBrush="#30FFFFFF"
                                                             Foreground="#FFFFFFFF"
                                                             Padding="10,5,10,5"
                                                             VerticalContentAlignment="Center"/>
                                                    <Button Grid.Column="1"
                                                            x:Name="ControlsCardBrowseBtn"
                                                            Click="ControlsCardBrowseBtn_Click"
                                                            Height="30"
                                                            Padding="10,0"
                                                            Style="{StaticResource TabButtonStyle}"
                                                            Background="#25FFFFFF"
                                                            CornerRadius="5"
                                                            ToolTipService.ToolTip="Browse executable or file">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xEC50;" FontSize="11" Foreground="#C0FFFFFF"/>
                                                            <TextBlock Text="Browse" FontSize="10" Foreground="#E0FFFFFF"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Row 3: Arguments (optional) -->
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Arguments (optional)" FontSize="10" Foreground="#A0FFFFFF"/>
                                                <TextBox x:Name="ControlsCardArgsBox"
                                                         PlaceholderText="e.g. --profile Default"
                                                         Height="30"
                                                         MinHeight="30"
                                                         FontSize="11"
                                                         CornerRadius="5"
                                                         Background="#20FFFFFF"
                                                         BorderBrush="#30FFFFFF"
                                                         Foreground="#FFFFFFFF"
                                                         Padding="10,5,10,5"
                                                         VerticalContentAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Row 4: Icon Selection -->
                                            <StackPanel Spacing="3">
                                                <Grid>
                                                    <TextBlock Text="Icon" FontSize="10" Foreground="#A0FFFFFF" VerticalAlignment="Center"/>
                                                    <HyperlinkButton Content="Segoe Fluent Icons (e701, e704...)"
                                                                     Click="ControlsCardIconDocsLink_Click"
                                                                     HorizontalAlignment="Right"
                                                                     FontSize="9.5"
                                                                     Padding="0"
                                                                     Foreground="#60CDFF"
                                                                     ToolTipService.ToolTip="Browse Microsoft Segoe Fluent Icons list"/>
                                                </Grid>
                                                <Grid ColumnSpacing="8" Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Selected Icon Preview -->
                                                    <Border Width="30" Height="30"
                                                            CornerRadius="5"
                                                            Background="#25FFFFFF"
                                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                            BorderThickness="1">
                                                        <FontIcon x:Name="ControlsCardSelectedIcon"
                                                                  Glyph="&#xE71D;"
                                                                  FontSize="15"
                                                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Search Icons Input -->
                                                    <TextBox Grid.Column="1"
                                                             x:Name="ControlsCardIconSearchBox"
                                                             PlaceholderText="Search name or hex glyph (e.g. e701, e704, lock)..."
                                                             TextChanged="ControlsCardIconSearchBox_TextChanged"
                                                             Height="30"
                                                             MinHeight="30"
                                                             FontSize="10.5"
                                                             CornerRadius="5"
                                                             Background="#20FFFFFF"
                                                             BorderBrush="#30FFFFFF"
                                                             Foreground="#FFFFFFFF"
                                                             Padding="10,5,10,5"
                                                             VerticalContentAlignment="Center"/>
                                                </Grid>

                                                <!-- Icons Panel -->
                                                <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel x:Name="ControlsCardIconsPanel" Spacing="4"/>
                                                </ScrollViewer>
                                            </StackPanel>

                                            <!-- Validation Error Text -->
                                            <TextBlock x:Name="ControlsCardErrorText"
                                                       Foreground="#FFFF6B6B"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Visibility="Collapsed"/>

                                            <!-- Action Buttons -->
                                            <Grid Margin="0,4,0,0">
                                                <Button x:Name="ControlsCardTestBtn"
                                                        Click="ControlsCardTestBtn_Click"
                                                        HorizontalAlignment="Left"
                                                        Style="{StaticResource TabButtonStyle}"
                                                        Background="#20FFFFFF"
                                                        Padding="12,4"
                                                        CornerRadius="5">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE768;" FontSize="10.5" Foreground="#A0FFFFFF"/>
                                                        <TextBlock Text="Test" FontSize="10" Foreground="#E0FFFFFF"/>
                                                    </StackPanel>
                                                </Button>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                                    <Button x:Name="ControlsCardCancelBtn"
                                                            Click="ControlsAddCardCloseBtn_Click"
                                                            Style="{StaticResource TabButtonStyle}"
                                                            Padding="12,4"
                                                            CornerRadius="5">
                                                        <TextBlock Text="Cancel" FontSize="10" Foreground="#B0FFFFFF"/>
                                                    </Button>
                                                    <Button x:Name="ControlsCardSaveBtn"
                                                            Click="ControlsCardSaveBtn_Click"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            Padding="14,4"
                                                            CornerRadius="5">
                                                        <TextBlock x:Name="ControlsCardSaveBtnText" Text="Add card" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ── Frame stats overlay ──────────────────────────────────── -->
                <Grid x:Name="FrameStatsRow" Grid.Row="2">
                    <TextBlock x:Name="FrameStatsText"
                               Text=""
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="#4CC2FF"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="BenchStatusText"
                               Text=""
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="#6CCB5F"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</Window>
