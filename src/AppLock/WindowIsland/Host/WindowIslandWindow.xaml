<Window
    x:Class="AppLock.WindowIsland.Host.WindowIslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="Transparent" PointerWheelChanged="OnRootGridPointerWheelChanged">
        <Grid.Resources>
            <Style x:Key="TabButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="#C0FFFFFF" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="6" />
                <!-- No FontFamily here: it leaked into every TextBlock inside these buttons and
                     turned the tile and tab labels into boxes. FontIcon brings its own glyph font. -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#20FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#30FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- Media play/pause: a white disc that stays white on hover. The stock button
                 template swaps in the theme's hover brush, which turned the disc dark and
                 swallowed the black glyph. -->
            <Style x:Key="MediaPlayButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#F2FFFFFF" />
                <Setter Property="Foreground" Value="#101010" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="19" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Disc"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Disc.Opacity" Value="0.88" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Disc.Opacity" Value="0.72" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Home tiles: same look as a tab button, but they fill their cell and hold two lines
                 of text (label plus a live reading), so the fixed 32 px height of a tab would clip. -->
            <Style x:Key="TileButtonStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="BorderBrush" Value="#16FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="9,4" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="QuietButtonStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="#30FFFFFF" />
                <Setter Property="Foreground" Value="#A0FFFFFF" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Height" Value="26" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#15FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#25FFFFFF" />
                                                <Setter Target="Root.BorderBrush" Value="#60CDFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PinButtonStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="#A0FFFFFF" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#20FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#20FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <!-- ═══════════════════════════════════════════════════════════════
             FOLDED LAYER — clock + battery (shown when island is collapsed)
        ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="FoldedLayer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Height="32"
              IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">

                <!-- Folded media mini (shown when media is playing) -->
                <StackPanel x:Name="FoldedMediaMini"
                            Orientation="Horizontal"
                            Spacing="5"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Border Width="22" Height="22" CornerRadius="3" Background="#28FFFFFF">
                        <Image x:Name="FoldedArt" Stretch="UniformToFill" />
                    </Border>
                    <!-- Equalizer bars animated via code-behind -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Border x:Name="EqBar0" Width="3" Height="8"
                                Background="#60CDFF" CornerRadius="1"
                                VerticalAlignment="Bottom" />
                        <Border x:Name="EqBar1" Width="3" Height="12"
                                Background="#60CDFF" CornerRadius="1"
                                VerticalAlignment="Bottom" />
                        <Border x:Name="EqBar2" Width="3" Height="6"
                                Background="#60CDFF" CornerRadius="1"
                                VerticalAlignment="Bottom" />
                    </StackPanel>
                </StackPanel>

                <!-- Folded timer mini (shows countdown when timer is running) -->
                <StackPanel x:Name="FoldedTimerMini"
                            Orientation="Horizontal"
                            Spacing="3"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE916;" FontSize="10" Foreground="#60CDFF" />
                    <TextBlock x:Name="FoldedTimerText"
                               Text="05:00"
                               FontFamily="Segoe UI Variable Small"
                               FontSize="11"
                               Foreground="#60CDFF"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Folded weather mini (shows temperature + weather icon) -->
                <StackPanel x:Name="FoldedWeatherMini"
                            Orientation="Horizontal"
                            Spacing="3"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <FontIcon x:Name="FoldedWeatherIcon" Glyph="&#xE706;" FontSize="10" Foreground="#FFD700" />
                    <TextBlock x:Name="FoldedWeatherTemp"
                               Text="21°"
                               FontFamily="Segoe UI Variable Small"
                               FontSize="11"
                               Foreground="#D0FFFFFF"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Clock -->
                <StackPanel x:Name="ClockContainer"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="#99FFFFFF" />
                    <TextBlock x:Name="FoldedClockText"
                               Text="12:45"
                               FontFamily="Segoe UI Variable Display"
                               FontWeight="SemiBold"
                               FontSize="12"
                               CharacterSpacing="0"
                               Foreground="#F0FFFFFF"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Battery -->
                <StackPanel x:Name="BatteryContainer"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <FontIcon x:Name="BatteryIcon"
                              Glyph="&#xE83F;"
                              FontSize="12"
                              Foreground="#99FFFFFF" />
                    <TextBlock x:Name="FoldedBatteryText"
                               Text="100%"
                               FontFamily="Segoe UI Variable Small"
                               FontSize="11"
                               Foreground="#C0FFFFFF"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Milestone 12: Mic / Camera indicator dots -->
                <!-- Orange dot = microphone active, Green dot = camera active -->
                <StackPanel x:Name="MicCamDotsContainer"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Ellipse x:Name="MicDot"
                             Width="6" Height="6"
                             Fill="#FFAA00"
                             Visibility="Collapsed"
                             ToolTipService.ToolTip="Microphone in use" />
                    <Ellipse x:Name="CamDot"
                             Width="6" Height="6"
                             Fill="#22CC44"
                             Visibility="Collapsed"
                             ToolTipService.ToolTip="Camera in use" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             LIVE CARD LAYER — temporary pop-out cards (Caps Lock, Volume, Copied, etc.)
        ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="CardLayer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Height="38"
              Opacity="0"
              IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Padding="14,0,14,0">
                <FontIcon x:Name="CardIcon"
                          Glyph="&#xE7BA;"
                          FontSize="13"
                          Foreground="#60CDFF"
                          VerticalAlignment="Center" />
                <TextBlock x:Name="CardTitle"
                           Text="Caps Lock"
                           FontFamily="Segoe UI Variable Display"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="#F0FFFFFF"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="CardDetail"
                           Text="On"
                           FontFamily="Segoe UI Variable Small"
                           FontSize="11"
                           Foreground="#C0FFFFFF"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="180"
                           VerticalAlignment="Center" />
                <!-- Optional Volume Progress Bar -->
                <ProgressBar x:Name="CardProgressBar"
                             Width="56"
                             Height="4"
                             Minimum="0"
                             Maximum="100"
                             Value="50"
                             Foreground="#60CDFF"
                             VerticalAlignment="Center"
                             Visibility="Collapsed" />
                <TextBlock x:Name="CardValueText"
                           Text="50%"
                           FontFamily="Segoe UI Variable Small"
                           FontSize="11"
                           Foreground="#90FFFFFF"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             COMMAND BAR LAYER — Alt+Space or Command Tile
        ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="CommandLayer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Width="520"
              Height="270"
              Opacity="0"
              IsHitTestVisible="False">
            <Grid Margin="16,10,16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Search Box -->
                    <RowDefinition Height="*"    /> <!-- Results list -->
                    <RowDefinition Height="Auto" /> <!-- Footer shortcuts -->
                </Grid.RowDefinitions>

                <!-- Search Input Box -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*"    />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE721;"
                              FontSize="13"
                              Foreground="#60CDFF"
                              VerticalAlignment="Center"
                              Margin="4,0,8,0" />
                    <TextBox x:Name="CommandInput"
                             Grid.Column="1"
                             PlaceholderText="Search files, apps, commands, or calculate…"
                             FontSize="12"
                             Background="Transparent"
                             BorderBrush="Transparent"
                             Foreground="#F0FFFFFF"
                             Padding="2,4"
                             TextChanged="CommandInput_TextChanged"
                             KeyDown="CommandInput_KeyDown" />
                    <Button x:Name="CommandCloseBtn"
                            Grid.Column="2"
                            Style="{StaticResource TabButtonStyle}"
                            Width="26" Height="26"
                            Click="CommandClose_Click"
                            ToolTipService.ToolTip="Close (Esc)">
                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                    </Button>
                </Grid>

                <!-- Divider -->
                <Border Grid.Row="0"
                        Height="1"
                        Background="#20FFFFFF"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,-2" />

                <!-- Results List -->
                <ScrollViewer Grid.Row="1"
                              Margin="0,6,0,6"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CommandResultList" Spacing="2" />
                </ScrollViewer>

                <!-- Footer Hints -->
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <TextBlock Text="↵ Open  ·  Ctrl+↵ In folder  ·  Alt+↵ Copy  ·  Esc Close"
                               FontSize="9"
                               Foreground="#50FFFFFF"
                               HorizontalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             OPEN LAYER — tab strip + content (shown when island is expanded)
        ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="OpenLayer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Width="700"
              Height="380"
              Opacity="0"
              IsHitTestVisible="False">

            <Grid Margin="16,10,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />  <!-- Tab bar row -->
                    <RowDefinition Height="*"  />  <!-- Content area -->
                    <RowDefinition Height="20" />  <!-- Frame stats row -->
                </Grid.RowDefinitions>

                <!-- ── Tab Bar ──────────────────────────────────────────────── -->
                <Grid Grid.Row="0">
                    <!-- Left: 8 tab buttons -->
                    <StackPanel x:Name="TabStrip"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">

                        <!-- Home -->
                        <Button x:Name="TabHome"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="0"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Home">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="TabHomeIcon" Glyph="&#xE80F;" FontSize="13" />
                                <TextBlock x:Name="TabHomeText" Text="Home" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Clipboard -->
                        <Button x:Name="TabClipboard"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="1"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Clipboard">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="TabClipboardIcon" Glyph="&#xF0E3;" FontSize="13" />
                                <TextBlock x:Name="TabClipboardText" Text="Clipboard" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <!-- Shelf -->
                        <Button x:Name="TabShelf"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="2"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Shelf">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="TabShelfIcon" Glyph="&#xE8F1;" FontSize="13" />
                                <TextBlock x:Name="TabShelfText" Text="Shelf" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <!-- Text -->
                        <Button x:Name="TabText"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="3"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Text tools">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="TabTextIcon" Glyph="&#xE8D2;" FontSize="13" />
                                <TextBlock x:Name="TabTextText" Text="Text" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <!-- Chat -->
                        <Button x:Name="TabChat"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="4"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Chat (AI)">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="TabChatIcon" Glyph="&#xE8BD;" FontSize="13" />
                                <TextBlock x:Name="TabChatText" Text="Chat" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <!-- Note -->
                        <Button x:Name="TabNote"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="5"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Note &amp; Timer">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="TabNoteIcon" Glyph="&#xE70B;" FontSize="13" />
                                <TextBlock x:Name="TabNoteText" Text="Note" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <!-- Weather -->
                        <Button x:Name="TabWeather"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="6"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Weather">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="TabWeatherIcon" Glyph="&#xE9CA;" FontSize="13" />
                                <TextBlock x:Name="TabWeatherText" Text="Weather" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <!-- Controls -->
                        <Button x:Name="TabControls"
                                Style="{StaticResource TabButtonStyle}"
                                Tag="7"
                                Click="OnTabButtonClick"
                                ToolTipService.ToolTip="Controls">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="TabControlsIcon" Glyph="&#xE713;" FontSize="13" />
                                <TextBlock x:Name="TabControlsText" Text="Controls" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: Quiet chip + Pin + Settings -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">

                        <!-- Quiet chip (hide cards temporarily) -->
                        <ToggleButton x:Name="QuietButton"
                                      Style="{StaticResource QuietButtonStyle}"
                                      ToolTipService.ToolTip="Quiet — pause live cards"
                                      Click="OnQuietClick">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <FontIcon Glyph="&#xE74F;" FontSize="11" />
                                <TextBlock Text="Quiet" FontSize="10" />
                            </StackPanel>
                        </ToggleButton>

                        <!-- Pin open -->
                        <ToggleButton x:Name="PinButton"
                                      Style="{StaticResource PinButtonStyle}"
                                      ToolTipService.ToolTip="Pin open"
                                      Click="OnPinClick">
                            <FontIcon Glyph="&#xE840;" FontSize="13" />
                        </ToggleButton>

                        <!-- Settings -->
                        <Button Style="{StaticResource TabButtonStyle}"
                                ToolTipService.ToolTip="Island settings"
                                Click="OnIslandSettingsClick">
                            <FontIcon Glyph="&#xE713;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ── Content Area ─────────────────────────────────────────── -->
                <Grid x:Name="ContentHost" Grid.Row="1">

                    <!-- Tab indicator strip (1px line under tab buttons, slides to active tab) -->
                    <Border x:Name="TabIndicator"
                            Width="24" Height="2"
                            Background="#60CDFF"
                            CornerRadius="1"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Left"
                            Margin="0,-2,0,0" />

                    <!-- Home tab — media player + volume + 8 tiles + launcher shortcuts -->
                        <!-- Home tab - media / recently-copied card, tiles, and a bottom bar with the
                             volume slider and the launcher. Cards and tiles share one radius and one surface so
                             the panel reads as a set of objects instead of loose text. -->
                        <!-- Home tab - the panel is a set of cards on one surface grid:
                               top left   media player, with the lyrics card beside it when the track has lyrics
                               top right  the 2x4 tile grid
                               below      the volume bar, then the launcher across the full width
                             Every card shares one radius, one fill and one border so the spacing reads evenly. -->
                        <Grid x:Name="ContentHome" Opacity="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"  />
                                <RowDefinition Height="8"  />
                                <RowDefinition Height="46" />
                            </Grid.RowDefinitions>

                            <!-- Upper block: player / lyrics / volume on the left, tiles on the right -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"   />
                                    <ColumnDefinition Width="8"   />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"  />
                                        <RowDefinition Height="8"  />
                                        <RowDefinition Height="38" />
                                    </Grid.RowDefinitions>

                                    <!-- Player card, with the lyrics card beside it -->
                                    <Grid Grid.Row="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="*"    />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="MediaCard"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                CornerRadius="14"
                                                Background="#10FFFFFF"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                Padding="12,11,12,11">
                                            <Grid>
                                                <Grid x:Name="MediaPlayerPanel"
                                                      RowSpacing="8"
                                                      Visibility="Collapsed">
                                                    <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*"    />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0" ColumnSpacing="11">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*"    />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Width="58" Height="58"
                                                                CornerRadius="9"
                                                                Background="#1AFFFFFF">
                                                            <Image x:Name="MediaArt" Stretch="UniformToFill" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock x:Name="MediaApp"
                                                                       Text=""
                                                                       FontSize="8.5"
                                                                       FontWeight="SemiBold"
                                                                       CharacterSpacing="90"
                                                                       Foreground="#70FFFFFF"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock x:Name="MediaTitle"
                                                                       Text="&#8212;"
                                                                       FontFamily="Segoe UI Variable Display"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="13"
                                                                       Foreground="#F5FFFFFF"
                                                                       TextWrapping="Wrap"
                                                                       MaxLines="2"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock x:Name="MediaArtist"
                                                                       Text=""
                                                                       FontSize="11"
                                                                       Foreground="#99FFFFFF"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Grid.Row="1" Spacing="4">
                                                        <ProgressBar x:Name="MediaProgress"
                                                                     Minimum="0" Maximum="1" Value="0"
                                                                     Height="3"
                                                                     CornerRadius="1.5"
                                                                     Foreground="#D9A0E8"
                                                                     Background="#26FFFFFF"
                                                                     HorizontalAlignment="Stretch" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"    />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="MediaElapsed"
                                                                       Grid.Column="0"
                                                                       Text="0:00"
                                                                       FontSize="10"
                                                                       Foreground="#77FFFFFF" />
                                                            <TextBlock x:Name="MediaRemaining"
                                                                       Grid.Column="1"
                                                                       Text="-0:00"
                                                                       FontSize="10"
                                                                       Foreground="#77FFFFFF" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="3"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                Spacing="14">
                                                        <Button x:Name="MediaPrev"
                                                                Click="MediaPrev_Click"
                                                                Width="30" Height="30"
                                                                Style="{StaticResource TabButtonStyle}"
                                                                ToolTipService.ToolTip="Previous">
                                                            <FontIcon Glyph="&#xE892;" FontSize="13" />
                                                        </Button>
                                                        <Button x:Name="MediaPlayPause"
                                                                Click="MediaPlayPause_Click"
                                                                Width="38" Height="38"
                                                        Style="{StaticResource MediaPlayButtonStyle}"
                                                                ToolTipService.ToolTip="Play / Pause">
                                                            <FontIcon x:Name="MediaPlayPauseIcon"
                                                                      Glyph="&#xE768;"
                                                                      FontSize="16"
                                                                      Foreground="#101010" />
                                                        </Button>
                                                        <Button x:Name="MediaNext"
                                                                Click="MediaNext_Click"
                                                                Width="30" Height="30"
                                                                Style="{StaticResource TabButtonStyle}"
                                                                ToolTipService.ToolTip="Next">
                                                            <FontIcon Glyph="&#xE893;" FontSize="13" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid x:Name="RecentPanel" RowSpacing="9" Visibility="Visible">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*"    />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0" Margin="1,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"    />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="RECENTLY COPIED"
                                                                   FontSize="8.5"
                                                                   FontWeight="SemiBold"
                                                                   CharacterSpacing="90"
                                                                   Foreground="#66FFFFFF"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="1"
                                                                Click="RecentChevron_Click"
                                                                Width="20" Height="20"
                                                                Padding="0"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                CornerRadius="5"
                                                                ToolTipService.ToolTip="Open clipboard history">
                                                            <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="#70FFFFFF" />
                                                        </Button>
                                                    </Grid>

                        <Grid x:Name="RecentItem0" Grid.Row="1"
                              ColumnSpacing="10" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*"    />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Background="#16FFFFFF">
                                <FontIcon x:Name="RecentIcon0" Glyph="&#xE8C3;" FontSize="11" Foreground="#B3FFFFFF" />
                            </Border>
                            <TextBlock x:Name="RecentText0"
                                       Grid.Column="1"
                                       FontSize="11"
                                       Foreground="#E6FFFFFF"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="RecentAge0"
                                       Grid.Column="2"
                                       FontSize="9.5"
                                       Foreground="#70FFFFFF"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid x:Name="RecentItem1" Grid.Row="2"
                              ColumnSpacing="10" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*"    />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Background="#16FFFFFF">
                                <FontIcon x:Name="RecentIcon1" Glyph="&#xE8C3;" FontSize="11" Foreground="#B3FFFFFF" />
                            </Border>
                            <TextBlock x:Name="RecentText1"
                                       Grid.Column="1"
                                       FontSize="11"
                                       Foreground="#E6FFFFFF"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="RecentAge1"
                                       Grid.Column="2"
                                       FontSize="9.5"
                                       Foreground="#70FFFFFF"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid x:Name="RecentItem2" Grid.Row="3"
                              ColumnSpacing="10" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*"    />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Background="#16FFFFFF">
                                <FontIcon x:Name="RecentIcon2" Glyph="&#xE8C3;" FontSize="11" Foreground="#B3FFFFFF" />
                            </Border>
                            <TextBlock x:Name="RecentText2"
                                       Grid.Column="1"
                                       FontSize="11"
                                       Foreground="#E6FFFFFF"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="RecentAge2"
                                       Grid.Column="2"
                                       FontSize="9.5"
                                       Foreground="#70FFFFFF"
                                       VerticalAlignment="Center" />
                        </Grid>

                                                    <TextBlock x:Name="RecentEmptyText"
                                                               Grid.Row="4"
                                                               Text="Copy something and your latest items show up here; the player appears above once music is playing"
                                                               FontSize="10"
                                                               LineHeight="15"
                                                               Foreground="#5CFFFFFF"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Top"
                                                               Margin="1,4,0,0" />
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Lyrics card: shown beside the player while the track has lyrics -->
                                        <Border x:Name="LyricsPanel"
                                                Grid.Column="1"
                                                CornerRadius="14"
                                                Background="#10FFFFFF"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                Padding="12,11,10,9"
                                                Visibility="Collapsed">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*"    />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0"
                                                           Text="LYRICS"
                                                           FontSize="8.5"
                                                           FontWeight="SemiBold"
                                                           CharacterSpacing="90"
                                                           Foreground="#66FFFFFF"
                                                           Margin="0,0,0,7" />
                                                <ScrollViewer Grid.Row="1"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel x:Name="LyricsStack" Spacing="4" />
                                                </ScrollViewer>
                                                <TextBlock Grid.Row="2"
                                                           Text="LRCLIB"
                                                           FontSize="8"
                                                           CharacterSpacing="60"
                                                           Foreground="#44FFFFFF"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,6,0,0" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Volume bar, under the player -->
                                    <Border Grid.Row="2"
                                            CornerRadius="14"
                                            Background="#10FFFFFF"
                                            BorderBrush="#1AFFFFFF"
                                            BorderThickness="1"
                                            Padding="12,0,14,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*"    />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon x:Name="VolumeIcon"
                                                      Grid.Column="0"
                                                      Glyph="&#xE993;"
                                                      FontSize="13"
                                                      Foreground="#90FFFFFF"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0" />
                                            <Slider x:Name="VolumeSlider"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="VolumeSlider_ValueChanged" />
                                            <TextBlock x:Name="VolumeText"
                                                       Grid.Column="2"
                                                       Text="&#8212;"
                                                       FontSize="10"
                                                       Foreground="#90FFFFFF"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right"
                                                       Margin="10,0,0,0"
                                                       MinWidth="30" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Tile grid: fills the right column top to bottom -->
                                <Grid x:Name="TileGrid"
                                      Grid.Column="2"
                                      RowSpacing="8"
                                      ColumnSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="TileArea"
                                            Grid.Row="0" Grid.Column="0"
                                            Click="TileArea_Click"
                                            Style="{StaticResource TileButtonStyle}"
                                            ToolTipService.ToolTip="Select an area to capture (Snipping Tool)">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7A8;" FontSize="14" />
                                            <TextBlock Text="Area" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TileFullScreen"
                                            Grid.Row="0" Grid.Column="1"
                                            Click="TileFullScreen_Click"
                                            Style="{StaticResource TileButtonStyle}"
                                            ToolTipService.ToolTip="Capture this monitor and copy it">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE722;" FontSize="14" />
                                            <TextBlock Text="Full screen" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TileScreenText"
                                            Grid.Row="1" Grid.Column="0"
                                            Click="TileScreenText_Click"
                                            Style="{StaticResource TileButtonStyle}"
                                            ToolTipService.ToolTip="Copy text from the screen (Snipping Tool)">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8D2;" FontSize="14" />
                                            <TextBlock Text="Screen text" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TileQR"
                                            Grid.Row="1" Grid.Column="1"
                                            Click="TileQR_Click"
                                            Style="{StaticResource TileButtonStyle}"
                                            ToolTipService.ToolTip="Scan a QR code on this monitor">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7EE;" FontSize="14" />
                                            <TextBlock Text="QR code" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TileNetwork"
                                            Grid.Row="2" Grid.Column="0"
                                            Click="TileNetwork_Click"
                                            Style="{StaticResource TileButtonStyle}"
                                            ToolTipService.ToolTip="Download and upload speed">
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE774;" FontSize="14" />
                                                <TextBlock Text="Network" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <TextBlock x:Name="TileNetDown" Text="&#x2193; &#8212;" FontSize="10" Foreground="#8FFFFFFF" />
                                                <TextBlock x:Name="TileNetUp" Text="&#x2191; &#8212;" FontSize="10" Foreground="#8FFFFFFF" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TileCpuRam"
                                            Grid.Row="2" Grid.Column="1"
                                            Click="TileCpuRam_Click"
                                            Style="{StaticResource TileButtonStyle}"
                                            ToolTipService.ToolTip="CPU and memory load (opens Task Manager)">
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE950;" FontSize="14" />
                                                <TextBlock Text="CPU &amp; RAM" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <TextBlock x:Name="TileCpuText" Text="CPU &#8212;" FontSize="10" Foreground="#8FFFFFFF" />
                                                <TextBlock x:Name="TileRamText" Text="RAM &#8212;" FontSize="10" Foreground="#8FFFFFFF" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TileRecord"
                                            Grid.Row="3" Grid.Column="0"
                                            Click="TileRecord_Click"
                                            Style="{StaticResource TileButtonStyle}"
                                            ToolTipService.ToolTip="Record the screen (Snipping Tool)">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7C8;" FontSize="14" />
                                            <TextBlock Text="Record screen" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TileCommand"
                                            Grid.Row="3" Grid.Column="1"
                                            Click="TileCommand_Click"
                                            Style="{StaticResource TileButtonStyle}"
                                            ToolTipService.ToolTip="Open the command bar">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE756;" FontSize="14" />
                                            <TextBlock Text="Command" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>

                                </Grid>
                            </Grid>

                            <!-- Launcher: full width at the bottom -->
                            <Border Grid.Row="2"
                                    CornerRadius="14"
                                    Background="#10FFFFFF"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    Padding="8,0,8,0"
                                    AllowDrop="True"
                                    DragOver="LauncherRow_DragOver"
                                    Drop="LauncherRow_Drop">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollMode="Enabled"
                                              VerticalScrollMode="Disabled">
                                    <StackPanel x:Name="LauncherList"
                                                Orientation="Horizontal"
                                                Spacing="7"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="LauncherEmptyText"
                                                   Text="Drop app shortcuts, folders or files here"
                                                   FontSize="10"
                                                   Foreground="#50FFFFFF"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,6,0" />
                                        <Button x:Name="LauncherAddBtn"
                                                Width="30" Height="30"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderBrush="#3DFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Click="LauncherAddBtn_Click"
                                                ToolTipService.ToolTip="Add shortcut">
                                            <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="#C0FFFFFF" />
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                        <!-- In-island add-shortcut dialog: a scrim over the panel and a card in the middle -->
                        <Grid x:Name="LauncherAddOverlay"
                              Grid.RowSpan="3" Grid.ColumnSpan="2"
                              Visibility="Collapsed">
                            <Border Background="#B3000000" CornerRadius="14" />

                            <Border Width="392"
                                    CornerRadius="14"
                                    Background="#FF1C1C1C"
                                    BorderBrush="#26FFFFFF"
                                    BorderThickness="1"
                                    Padding="18,16,18,14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Spacing="3">
                                        <TextBlock x:Name="LauncherAddTitle"
                                                   Text="A link for the launcher"
                                                   FontFamily="Segoe UI Variable Display"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#F0FFFFFF" />
                                        <TextBlock Text="Paste a URL, or drag an app, folder or file onto the launcher bar."
                                                   FontSize="10"
                                                   LineHeight="14"
                                                   Foreground="#80FFFFFF"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBox x:Name="LauncherTargetInput"
                                             Grid.Row="1"
                                             PlaceholderText="https://… or file/folder path"
                                             FontSize="12"
                                             MinHeight="0"
                                             Padding="11,6,11,6"
                                             VerticalContentAlignment="Center"
                                             Background="#14FFFFFF"
                                             Foreground="#F0FFFFFF"
                                             BorderBrush="#26FFFFFF"
                                             CornerRadius="8" />

                                    <TextBox x:Name="LauncherNameInput"
                                             Grid.Row="2"
                                             PlaceholderText="Name (optional)"
                                             FontSize="12"
                                             MinHeight="0"
                                             Padding="11,6,11,6"
                                             VerticalContentAlignment="Center"
                                             Background="#14FFFFFF"
                                             Foreground="#F0FFFFFF"
                                             BorderBrush="#26FFFFFF"
                                             CornerRadius="8" />

                                    <CheckBox x:Name="LauncherUseAppIconCheck"
                                              Grid.Row="3"
                                              Content="Use the site's or app's own icon"
                                              IsChecked="True"
                                              FontSize="11"
                                              Foreground="#C0FFFFFF"
                                              Margin="0,2,0,0" />

                                    <StackPanel Grid.Row="4"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Spacing="8"
                                                Margin="0,6,0,0">
                                        <Button Content="Cancel"
                                                Width="78" Height="32"
                                                FontSize="11"
                                                CornerRadius="8"
                                                Style="{StaticResource TabButtonStyle}"
                                                Click="LauncherAddCancel_Click" />
                                        <Button x:Name="LauncherAddConfirmBtn"
                                                Content="Add"
                                                Width="78" Height="32"
                                                FontSize="11"
                                                CornerRadius="8"
                                                Background="#60CDFF"
                                                Foreground="#000000"
                                                FontWeight="SemiBold"
                                                Click="LauncherAddConfirm_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        </Grid>

                    <!-- Clipboard tab -->
                    <Grid x:Name="ContentClipboard" Opacity="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*"    />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Search + Clear row -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"    />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ClipboardSearch"
                                     Grid.Column="0"
                                     PlaceholderText="Search…"
                                     FontSize="11"
                                     Height="30"
                                     MinHeight="30"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="#20FFFFFF"
                                     Foreground="#F0FFFFFF"
                                     BorderBrush="#30FFFFFF"
                                     CornerRadius="6"
                                     Padding="10,5,10,5"
                                     TextChanged="ClipboardSearch_TextChanged"
                                     KeyDown="ClipboardSearch_KeyDown" />
                            <Button x:Name="ClipboardClearBtn"
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Height="30"
                                    Padding="8,4"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Click="ClipboardClear_Click"
                                    Style="{StaticResource TabButtonStyle}"
                                    ToolTipService.ToolTip="Clear clipboard history">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            </Button>
                        </Grid>

                        <!-- Item list -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ClipboardList" Spacing="2" />
                        </ScrollViewer>

                        <!-- Footer hint -->
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <TextBlock Text="Click to paste · Shift+click to copy only"
                                       FontSize="9"
                                       Foreground="#50FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="↑↓ Enter"
                                       FontSize="9"
                                       Foreground="#60FFFFFF"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0" />
                        </Grid>
                    </Grid>

                    <!-- Shelf tab -->
                    <Grid x:Name="ContentShelf" Opacity="1" Visibility="Collapsed"
                          AllowDrop="True"
                          DragOver="ShelfGrid_DragOver"
                          Drop="ShelfGrid_Drop">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"    />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Drop hint overlay (shown when dragging over) -->
                        <Border x:Name="ShelfDropHint"
                                Grid.RowSpan="2"
                                Background="#15FFFFFF"
                                BorderBrush="#60CDFF"
                                BorderThickness="2"
                                CornerRadius="8"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <TextBlock Text="Drop files here"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#60CDFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <!-- File grid or empty state -->
                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="0,4,0,4">
                                <TextBlock x:Name="ShelfEmptyText"
                                           Text="Drop app shortcuts, folders or files here."
                                           FontSize="11"
                                           Foreground="#50FFFFFF"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,32,0,0" />
                                <Grid x:Name="ShelfItemsGrid"
                                      ColumnSpacing="8"
                                      RowSpacing="8" />
                            </Grid>
                        </ScrollViewer>

                        <!-- Clear all button -->
                        <Button x:Name="ShelfClearBtn"
                                Grid.Row="1"
                                Content="Clear all"
                                FontSize="10"
                                Padding="8,4"
                                CornerRadius="6"
                                HorizontalAlignment="Right"
                                Margin="0,4,0,0"
                                Click="ShelfClear_Click"
                                Style="{StaticResource TabButtonStyle}"
                                ToolTipService.ToolTip="Remove all shelf items" />
                    </Grid>

                    <!-- Text tab (Milestone 14: Text Tools & Transforms) -->
                    <Grid x:Name="ContentText" Opacity="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*"    />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header / Quick Actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Text Helpers"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFFFF" />
                                <TextBlock x:Name="TextStatsSummaryText"
                                           Text="0 words · 0 chars"
                                           FontSize="11"
                                           Foreground="#80FFFFFF"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="TextPastePlainBtn"
                                        Click="TextPastePlainBtn_Click"
                                        ToolTipService.ToolTip="Paste as plain text to active app (strips formatting)"
                                        Height="26"
                                        Padding="8,2"
                                        CornerRadius="13"
                                        Background="#15FFFFFF"
                                        BorderBrush="#25FFFFFF"
                                        BorderThickness="1"
                                        Foreground="#E0FFFFFF">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE77F;" FontSize="11" />
                                        <TextBlock Text="Paste Plain" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TextDictationBtn"
                                        Click="TextDictationBtn_Click"
                                        ToolTipService.ToolTip="Trigger Windows Voice Typing (Win + H)"
                                        Height="26"
                                        Padding="8,2"
                                        CornerRadius="13"
                                        Background="#15FFFFFF"
                                        BorderBrush="#25FFFFFF"
                                        BorderThickness="1"
                                        Foreground="#E0FFFFFF">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE720;" FontSize="11" Foreground="#60CDFF" />
                                        <TextBlock Text="Dictation" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TextFetchClipboardBtn"
                                        Click="TextFetchClipboardBtn_Click"
                                        ToolTipService.ToolTip="Reload from current clipboard"
                                        Width="26" Height="26"
                                        Padding="0"
                                        CornerRadius="13"
                                        Background="#15FFFFFF"
                                        BorderBrush="#25FFFFFF"
                                        BorderThickness="1"
                                        Foreground="#C0FFFFFF">
                                    <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Transform Toolbar -->
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,0,0,6"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button x:Name="TextUpperBtn"
                                        Click="TextUpperBtn_Click"
                                        Content="UPPERCASE"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextLowerBtn"
                                        Click="TextLowerBtn_Click"
                                        Content="lowercase"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextTitleBtn"
                                        Click="TextTitleBtn_Click"
                                        Content="Title Case"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextTrimBtn"
                                        Click="TextTrimBtn_Click"
                                        Content="Trim"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextNoBreaksBtn"
                                        Click="TextNoBreaksBtn_Click"
                                        Content="No Breaks"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextSortBtn"
                                        Click="TextSortBtn_Click"
                                        Content="Sort Lines"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#D0FFFFFF" />
                                <Button x:Name="TextClearBtn"
                                        Click="TextClearBtn_Click"
                                        Content="Clear"
                                        Height="24" Padding="6,2" CornerRadius="12"
                                        Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        FontSize="10" Foreground="#A0FFFFFF" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Text Editor / Preview -->
                        <Border Grid.Row="2"
                                Background="#181920"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="4">
                            <TextBox x:Name="TextInputBox"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontSize="11"
                                     Background="Transparent"
                                     Foreground="#E8FFFFFF"
                                     BorderThickness="0"
                                     Padding="4"
                                     PlaceholderText="Type or paste text here, or switch to this tab to load clipboard text..."
                                     TextChanged="TextInputBox_TextChanged" />
                        </Border>

                        <!-- Bottom Stats & Copy/Paste -->
                        <Grid Grid.Row="3" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TextStatsDetailedText"
                                       Grid.Column="0"
                                       Text="Lines: 0 · Words: 0 · Chars: 0 (no spaces: 0)"
                                       FontSize="10"
                                       Foreground="#80FFFFFF"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="TextCopyResultBtn"
                                        Click="TextCopyResultBtn_Click"
                                        Height="24"
                                        Padding="8,2"
                                        CornerRadius="12"
                                        Background="#15FFFFFF"
                                        BorderBrush="#25FFFFFF"
                                        BorderThickness="1"
                                        Foreground="#E0FFFFFF">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="10" />
                                        <TextBlock x:Name="TextCopyResultBtnText" Text="Copy" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TextPasteToAppBtn"
                                        Click="TextPasteToAppBtn_Click"
                                        Height="24"
                                        Padding="8,2"
                                        CornerRadius="12"
                                        Background="#2060CDFF"
                                        BorderBrush="#5060CDFF"
                                        BorderThickness="1"
                                        Foreground="#60CDFF">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE77F;" FontSize="10" />
                                        <TextBlock x:Name="TextPasteToAppBtnText" Text="Paste to App" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Chat tab (Milestone 13: WebView2 AI Assistants) -->
                    <Grid x:Name="ContentChat" Opacity="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header strip: Sub-tabs and tool buttons -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Assistant Sub-Tabs list (ChatGPT, Claude, Copilot, etc.) -->
                            <ScrollViewer Grid.Column="0"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Enabled"
                                          VerticalScrollMode="Disabled">
                                <StackPanel x:Name="ChatSubTabsPanel"
                                            Orientation="Horizontal"
                                            Spacing="4" />
                            </ScrollViewer>

                            <!-- Tools: Add custom assistant, Popout to browser, Refresh -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        Margin="8,0,0,0">
                                <Button x:Name="ChatAddBtn"
                                        Click="ChatAddBtn_Click"
                                        ToolTipService.ToolTip="Add custom AI assistant"
                                        Width="28" Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="14">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="#C0FFFFFF" />
                                </Button>
                                <Button x:Name="ChatRefreshBtn"
                                        Click="ChatRefreshBtn_Click"
                                        ToolTipService.ToolTip="Reload active chat"
                                        Width="28" Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="14">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="#C0FFFFFF" />
                                </Button>
                                <Button x:Name="ChatPopoutBtn"
                                        Click="ChatPopoutBtn_Click"
                                        ToolTipService.ToolTip="Open in default browser"
                                        Width="28" Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="14">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="12" Foreground="#C0FFFFFF" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Content host (Skeleton / Fallback / WebView2) -->
                        <Border Grid.Row="1"
                                Background="#1A1A1A"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <!-- WebView2 Host -->
                                <Grid x:Name="ChatWebViewHost" />

                                <!-- Loading / Skeleton overlay -->
                                <StackPanel x:Name="ChatSkeletonPanel"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="10"
                                            Visibility="Collapsed">
                                    <ProgressBar IsIndeterminate="True" Width="140" />
                                    <TextBlock x:Name="ChatSkeletonText"
                                               Text="Loading AI Assistant..."
                                               FontSize="12"
                                               Foreground="#A0FFFFFF"
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Fallback overlay (when WebView2 runtime is missing) -->
                                <StackPanel x:Name="ChatFallbackPanel"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="12"
                                            MaxWidth="320"
                                            Visibility="Collapsed">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="28" Foreground="#FFCC00" HorizontalAlignment="Center" />
                                    <TextBlock Text="Microsoft Edge WebView2 Runtime is required to render AI chats inside Window Island."
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               FontSize="12"
                                               Foreground="#D0FFFFFF" />
                                    <Button x:Name="ChatDownloadWebView2Btn"
                                            Click="ChatDownloadWebView2_Click"
                                            Content="Download Runtime"
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Padding="12,6" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- In-island Add Custom Site Overlay -->
                        <Border x:Name="ChatAddOverlay"
                                Grid.RowSpan="2"
                                Background="#E6181920"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Width="300"
                                        Spacing="10">
                                <TextBlock Text="Add Custom AI Site"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFFFF" />
                                <TextBox x:Name="ChatNewNameBox"
                                         Header="Site Name"
                                         PlaceholderText="e.g. DeepSeek, Perplexity"
                                         FontSize="12" />
                                <TextBox x:Name="ChatNewUrlBox"
                                         Header="HTTPS URL"
                                         PlaceholderText="https://..."
                                         FontSize="12" />
                                <TextBlock x:Name="ChatAddErrorText"
                                           Foreground="#FFFF6B6B"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="8"
                                            Margin="0,6,0,0">
                                    <Button Content="Cancel"
                                            Click="ChatCancelAdd_Click"
                                            FontSize="12"
                                            Padding="12,4" />
                                    <Button Content="Add"
                                            Click="ChatConfirmAdd_Click"
                                            FontSize="12"
                                            Padding="16,4" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Note & Timer tab -->
                    <Grid x:Name="ContentNote" Opacity="1" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"   /> <!-- Left: Notes editor -->
                            <ColumnDefinition Width="200" /> <!-- Right: Timer & Reminders -->
                        </Grid.ColumnDefinitions>

                        <!-- ── Left: Note Editor ── -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Note Tab Strip + actions -->
                                <RowDefinition Height="*"    /> <!-- Text editor -->
                            </Grid.RowDefinitions>

                            <!-- Note headers + tools -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"    />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Note tabs (horizontally scrollable) -->
                                <ScrollViewer Grid.Column="0"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollMode="Enabled">
                                    <StackPanel x:Name="NoteTabStrip"
                                                Orientation="Horizontal"
                                                Spacing="4" />
                                </ScrollViewer>

                                <!-- Add note, Copy note, Delete note -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="2">
                                    <Button x:Name="NoteAddBtn"
                                            Style="{StaticResource TabButtonStyle}"
                                            Width="24" Height="24"
                                            Padding="0"
                                            Click="NoteAddBtn_Click"
                                            ToolTipService.ToolTip="Add new note">
                                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                                    </Button>
                                    <Button x:Name="NoteCopyBtn"
                                            Style="{StaticResource TabButtonStyle}"
                                            Width="24" Height="24"
                                            Padding="0"
                                            Click="NoteCopyBtn_Click"
                                            ToolTipService.ToolTip="Copy note content">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                    </Button>
                                    <Button x:Name="NoteDeleteBtn"
                                            Style="{StaticResource TabButtonStyle}"
                                            Width="24" Height="24"
                                            Padding="0"
                                            Click="NoteDeleteBtn_Click"
                                            ToolTipService.ToolTip="Delete current note">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Multi-line text box -->
                            <TextBox x:Name="NoteContentBox"
                                     Grid.Row="1"
                                     PlaceholderText="Write anything here: an order number, a to-do list, a code snippet. It saves itself."
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontSize="11"
                                     Background="#15FFFFFF"
                                     Foreground="#F0FFFFFF"
                                     BorderBrush="#25FFFFFF"
                                     CornerRadius="6"
                                     Padding="8,6"
                                     TextChanged="NoteContentBox_TextChanged" />
                        </Grid>

                        <!-- ── Right: Timer & Reminders ── -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Timer panel -->
                                <RowDefinition Height="Auto" /> <!-- Divider -->
                                <RowDefinition Height="*"    /> <!-- Reminders panel -->
                            </Grid.RowDefinitions>

                            <!-- Timer Section -->
                            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"    />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE916;" FontSize="11" Foreground="#60CDFF" />
                                        <TextBlock Text="TIMER"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="#60FFFFFF"
                                                   CharacterSpacing="80" />
                                    </StackPanel>
                                    <TextBlock x:Name="TimerDisplay"
                                               Grid.Column="1"
                                               Text="05:00"
                                               FontFamily="Consolas"
                                               FontWeight="SemiBold"
                                               FontSize="15"
                                               Foreground="#60CDFF"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!-- Preset buttons row -->
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                                    <Button Content="5m" FontSize="9" Padding="6,2" CornerRadius="4" Style="{StaticResource TabButtonStyle}" Click="TimerPreset_Click" Tag="5" />
                                    <Button Content="10m" FontSize="9" Padding="6,2" CornerRadius="4" Style="{StaticResource TabButtonStyle}" Click="TimerPreset_Click" Tag="10" />
                                    <Button Content="15m" FontSize="9" Padding="6,2" CornerRadius="4" Style="{StaticResource TabButtonStyle}" Click="TimerPreset_Click" Tag="15" />
                                    <Button Content="25m" FontSize="9" Padding="6,2" CornerRadius="4" Style="{StaticResource TabButtonStyle}" Click="TimerPreset_Click" Tag="25" />
                                </StackPanel>

                                <!-- Timer control buttons -->
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <Button x:Name="TimerStartBtn"
                                            Content="Start"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Padding="10,2"
                                            CornerRadius="4"
                                            Background="#2560CDFF"
                                            Foreground="#60CDFF"
                                            Click="TimerStartBtn_Click" />
                                    <Button x:Name="TimerResetBtn"
                                            Content="Reset"
                                            FontSize="10"
                                            Padding="8,2"
                                            CornerRadius="4"
                                            Style="{StaticResource TabButtonStyle}"
                                            Click="TimerResetBtn_Click" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Grid.Row="1" Height="1" Background="#20FFFFFF" Margin="0,0,0,6" />

                            <!-- Reminders Section -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*"    />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                                    <FontIcon Glyph="&#xEA8F;" FontSize="10" Foreground="#FF8C00" />
                                    <TextBlock Text="REMINDERS"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="#60FFFFFF"
                                               CharacterSpacing="80" />
                                </StackPanel>

                                <!-- Quick add input box -->
                                <TextBox x:Name="ReminderQuickInput"
                                         Grid.Row="1"
                                         PlaceholderText="Call mum in 10m…"
                                         FontSize="10"
                                         Background="#15FFFFFF"
                                         Foreground="#F0FFFFFF"
                                         BorderBrush="#25FFFFFF"
                                         CornerRadius="5"
                                         Padding="6,3"
                                         Margin="0,0,0,4"
                                         KeyDown="ReminderQuickInput_KeyDown" />

                                <!-- Reminders List -->
                                <ScrollViewer Grid.Row="2"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="ReminderList" Spacing="2" />
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ═══════════════════════════════════════════════════════════
                         WEATHER TAB (Milestone 10)
                    ════════════════════════════════════════════════════════════ -->
                    <Grid x:Name="ContentWeather" Opacity="1" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="215"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Card: Current Conditions & Outlook -->
                            <Border Grid.Column="0"
                                    Background="#18FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10,12,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- City header + change button -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="WeatherCityText"
                                                   Text="No city set"
                                                   FontFamily="Segoe UI Variable Display"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#F0FFFFFF"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                x:Name="WeatherChangeCityBtn"
                                                Click="WeatherChangeCityBtn_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,2"
                                                Margin="4,0,0,0"
                                                ToolTipService.ToolTip="Change location">
                                            <FontIcon Glyph="&#xE70F;" FontSize="10" Foreground="#80FFFFFF"/>
                                        </Button>
                                    </Grid>

                                    <!-- Temperature & Condition Icon -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,2,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="WeatherBigTemp"
                                                   Text="--"
                                                   FontFamily="Segoe UI Variable Display"
                                                   FontWeight="SemiBold"
                                                   FontSize="36"
                                                   Foreground="#FFFFFFFF"
                                                   VerticalAlignment="Center"/>
                                        <FontIcon x:Name="WeatherConditionIcon"
                                                  Glyph="&#xE706;"
                                                  FontSize="24"
                                                  Foreground="#FFD700"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Condition & Feels Like -->
                                    <StackPanel Grid.Row="2" Spacing="1">
                                        <TextBlock x:Name="WeatherConditionText"
                                                   Text="Tap to set location"
                                                   FontFamily="Segoe UI Variable Small"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="#E0FFFFFF"/>
                                        <TextBlock x:Name="WeatherFeelsLikeText"
                                                   Text="Feels like -- · H: -- L: --"
                                                   FontFamily="Segoe UI Variable Small"
                                                   FontSize="11"
                                                   Foreground="#90FFFFFF"/>
                                    </StackPanel>

                                    <!-- Summary Outlook -->
                                    <TextBlock Grid.Row="3"
                                               x:Name="WeatherOutlookText"
                                               Text="Data from MET Norway. Tap location to configure."
                                               FontFamily="Segoe UI Variable Small"
                                               FontSize="10"
                                               Foreground="#80FFFFFF"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               Margin="0,4,0,0"/>

                                    <!-- Footer: Refresh + Attribution -->
                                    <Grid Grid.Row="5" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button x:Name="WeatherRefreshBtn"
                                                    Click="WeatherRefreshBtn_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="3"
                                                    ToolTipService.ToolTip="Refresh weather">
                                                <FontIcon Glyph="&#xE72C;" FontSize="10" Foreground="#A0FFFFFF"/>
                                            </Button>
                                            <TextBlock x:Name="WeatherUpdatedText"
                                                       Text="Updated just now"
                                                       FontFamily="Segoe UI Variable Small"
                                                       FontSize="9"
                                                       Foreground="#70FFFFFF"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="MET Norway"
                                                   FontFamily="Segoe UI Variable Small"
                                                   FontSize="9"
                                                   Foreground="#50FFFFFF"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Right Card: Hours/Week Forecast + Metric Tiles -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="74"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Hours / Week Tab Selector -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                                    <Button x:Name="WeatherBtnHours"
                                            Content="Hourly"
                                            Click="WeatherBtnHours_Click"
                                            Padding="10,2"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Background="#25FFFFFF"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            Foreground="#FFFFFFFF"/>
                                    <Button x:Name="WeatherBtnWeek"
                                            Content="7-Day"
                                            Click="WeatherBtnWeek_Click"
                                            Padding="10,2"
                                            FontSize="11"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            Foreground="#90FFFFFF"/>
                                </StackPanel>

                                <!-- Forecast View -->
                                <Grid Grid.Row="1">
                                    <!-- Hourly Scroll Strip -->
                                    <ScrollViewer x:Name="WeatherHoursScroll"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="WeatherHoursStack"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Padding="1,2,1,2"/>
                                    </ScrollViewer>

                                    <!-- 7-Day Outlook Strip -->
                                    <ScrollViewer x:Name="WeatherWeekScroll"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Visibility="Collapsed">
                                        <StackPanel x:Name="WeatherWeekStack"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Padding="1,2,1,2"/>
                                    </ScrollViewer>
                                </Grid>

                                <!-- 6 Metric Tiles -->
                                <Grid Grid.Row="2" Margin="0,6,0,0" RowSpacing="5" ColumnSpacing="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Wind Tile -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                        <StackPanel Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE728;" FontSize="10" Foreground="#60CDFF"/>
                                                <TextBlock Text="Wind" FontSize="9" Foreground="#80FFFFFF"/>
                                            </StackPanel>
                                            <TextBlock x:Name="WeatherWindText" Text="-- m/s" FontSize="11" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Humidity Tile -->
                                    <Border Grid.Row="0" Grid.Column="1" Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                        <StackPanel Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE958;" FontSize="10" Foreground="#60CDFF"/>
                                                <TextBlock Text="Humidity" FontSize="9" Foreground="#80FFFFFF"/>
                                            </StackPanel>
                                            <TextBlock x:Name="WeatherHumidityText" Text="-- %" FontSize="11" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pressure Tile -->
                                    <Border Grid.Row="0" Grid.Column="2" Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                        <StackPanel Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xEC4A;" FontSize="10" Foreground="#60CDFF"/>
                                                <TextBlock Text="Pressure" FontSize="9" Foreground="#80FFFFFF"/>
                                            </StackPanel>
                                            <TextBlock x:Name="WeatherPressureText" Text="-- hPa" FontSize="11" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Sun Tile (Sunrise/Sunset) -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                        <StackPanel Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE706;" FontSize="10" Foreground="#FFD700"/>
                                                <TextBlock Text="Sun" FontSize="9" Foreground="#80FFFFFF"/>
                                            </StackPanel>
                                            <TextBlock x:Name="WeatherSunText" Text="-- · --" FontSize="11" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Precipitation Tile -->
                                    <Border Grid.Row="1" Grid.Column="1" Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                        <StackPanel Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE754;" FontSize="10" Foreground="#60CDFF"/>
                                                <TextBlock Text="Rain Today" FontSize="9" Foreground="#80FFFFFF"/>
                                            </StackPanel>
                                            <TextBlock x:Name="WeatherPrecipText" Text="0.0 mm" FontSize="11" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- UV Index Tile -->
                                    <Border Grid.Row="1" Grid.Column="2" Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                        <StackPanel Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE706;" FontSize="10" Foreground="#FF9800"/>
                                                <TextBlock Text="UV Index" FontSize="9" Foreground="#80FFFFFF"/>
                                            </StackPanel>
                                            <TextBlock x:Name="WeatherUvText" Text="0 (Low)" FontSize="11" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        </StackPanel>
                                    </Border>

                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- ── City Search Overlay ──────────────────────────────── -->
                        <Border x:Name="WeatherCityOverlay"
                                Background="#F2181920"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Spacing="2">
                                    <TextBlock Text="Where should the weather be for?"
                                               FontFamily="Segoe UI Variable Display"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="#FFFFFFFF"/>
                                    <TextBlock Text="Type your city. Your location is never guessed from your IP address."
                                               FontFamily="Segoe UI Variable Small"
                                               FontSize="11"
                                               Foreground="#90FFFFFF"/>
                                </StackPanel>

                                <!-- Search row -->
                                <Grid Grid.Row="1" Margin="0,10,0,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WeatherSearchInput"
                                             PlaceholderText="e.g. London, Tokyo, New York, Oslo"
                                             KeyDown="WeatherSearchInput_KeyDown"
                                             CornerRadius="4"/>
                                    <Button Grid.Column="1"
                                            x:Name="WeatherSearchSubmit"
                                            Content="Search"
                                            Click="WeatherSearchSubmit_Click"
                                            CornerRadius="4"/>
                                    <Button Grid.Column="2"
                                            x:Name="WeatherSearchCancel"
                                            Content="Cancel"
                                            Click="WeatherSearchCancel_Click"
                                            CornerRadius="4"
                                            Background="Transparent"
                                            BorderThickness="0"/>
                                </Grid>

                                <TextBlock Grid.Row="2"
                                           x:Name="WeatherSearchFeedback"
                                           Text=""
                                           FontSize="11"
                                           Foreground="#80FFFFFF"
                                           Margin="0,0,0,4"
                                           Visibility="Collapsed"/>

                                <!-- Results list -->
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="WeatherSearchResultsStack" Spacing="4"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ═══════════════════════════════════════════════════════════
                         CONTROLS TAB (Milestone 11)
                    ════════════════════════════════════════════════════════════ -->
                    <Grid x:Name="ContentControls" Opacity="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: 5 Control Tiles (Wi-Fi, Bluetooth, Dark Theme, Battery, VPN) -->
                        <Grid Grid.Row="0" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Wi-Fi Tile -->
                            <Button Grid.Column="0"
                                    x:Name="ControlsWifiBtn"
                                    Click="ControlsWifiBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="#15FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    ToolTipService.ToolTip="Toggle Wi-Fi">
                                <StackPanel Spacing="2">
                                    <FontIcon x:Name="ControlsWifiIcon" Glyph="&#xE701;" FontSize="14" Foreground="#60CDFF" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Wi-Fi" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                    <TextBlock x:Name="ControlsWifiStatus" Text="Connected" FontSize="9" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- Bluetooth Tile -->
                            <Button Grid.Column="1"
                                    x:Name="ControlsBtBtn"
                                    Click="ControlsBtBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="#15FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    ToolTipService.ToolTip="Toggle Bluetooth">
                                <StackPanel Spacing="2">
                                    <FontIcon x:Name="ControlsBtIcon" Glyph="&#xE702;" FontSize="14" Foreground="#60CDFF" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Bluetooth" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                    <TextBlock x:Name="ControlsBtStatus" Text="On" FontSize="9" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- Dark Theme Tile -->
                            <Button Grid.Column="2"
                                    x:Name="ControlsThemeBtn"
                                    Click="ControlsThemeBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="#15FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    ToolTipService.ToolTip="Toggle Windows dark theme">
                                <StackPanel Spacing="2">
                                    <FontIcon x:Name="ControlsThemeIcon" Glyph="&#xE790;" FontSize="14" Foreground="#60CDFF" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Dark Theme" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                    <TextBlock x:Name="ControlsThemeStatus" Text="Dark" FontSize="9" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- Battery Tile -->
                            <Button Grid.Column="3"
                                    x:Name="ControlsBatteryBtn"
                                    Click="ControlsBatteryBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="#15FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    ToolTipService.ToolTip="Battery &amp; power settings">
                                <StackPanel Spacing="2">
                                    <FontIcon x:Name="ControlsBatteryIcon" Glyph="&#xE83F;" FontSize="14" Foreground="#60CDFF" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Battery" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                    <TextBlock x:Name="ControlsBatteryStatus" Text="100%" FontSize="9" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- VPN Tile -->
                            <Button Grid.Column="4"
                                    x:Name="ControlsVpnBtn"
                                    Click="ControlsVpnBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="#15FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    ToolTipService.ToolTip="VPN connection">
                                <StackPanel Spacing="2">
                                    <FontIcon x:Name="ControlsVpnIcon" Glyph="&#xE705;" FontSize="14" Foreground="#80FFFFFF" HorizontalAlignment="Left"/>
                                    <TextBlock Text="VPN" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                    <TextBlock x:Name="ControlsVpnStatus" Text="Off" FontSize="9" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Row 1: Brightness Slider Row (compact sleek row) -->
                        <Border Grid.Row="1"
                                Margin="0,8,0,0"
                                Background="#12FFFFFF"
                                BorderBrush="#18FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE706;" FontSize="13" Foreground="#FFD700" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1"
                                        x:Name="ControlsBrightnessSlider"
                                        ValueChanged="ControlsBrightnessSlider_ValueChanged"
                                        VerticalAlignment="Center"
                                        Margin="0,-6,0,-6"/>
                                <TextBlock Grid.Column="2"
                                           x:Name="ControlsBrightnessText"
                                           Text="100%"
                                           FontSize="10"
                                           Foreground="#A0FFFFFF"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Row 2: 4 System Power Buttons (Lock, Sleep, Restart [confirming], Shut Down [confirming]) -->
                        <Grid Grid.Row="2" Margin="0,8,0,0" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Lock -->
                            <Button Grid.Column="0"
                                    x:Name="ControlsLockBtn"
                                    Click="ControlsLockBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="#18FFFFFF"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="4,6">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="#C0FFFFFF"/>
                                    <TextBlock Text="Lock" FontSize="11" Foreground="#F0FFFFFF"/>
                                </StackPanel>
                            </Button>

                            <!-- Sleep -->
                            <Button Grid.Column="1"
                                    x:Name="ControlsSleepBtn"
                                    Click="ControlsSleepBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="#18FFFFFF"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="4,6">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE708;" FontSize="12" Foreground="#C0FFFFFF"/>
                                    <TextBlock Text="Sleep" FontSize="11" Foreground="#F0FFFFFF"/>
                                </StackPanel>
                            </Button>

                            <!-- Restart (Double-tap safety) -->
                            <Button Grid.Column="2"
                                    x:Name="ControlsRestartBtn"
                                    Click="ControlsRestartBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="#18FFFFFF"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="4,6">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                    <FontIcon x:Name="ControlsRestartIcon" Glyph="&#xE777;" FontSize="12" Foreground="#C0FFFFFF"/>
                                    <TextBlock x:Name="ControlsRestartText" Text="Restart" FontSize="11" Foreground="#F0FFFFFF"/>
                                </StackPanel>
                            </Button>

                            <!-- Shut Down (Double-tap safety) -->
                            <Button Grid.Column="3"
                                    x:Name="ControlsShutdownBtn"
                                    Click="ControlsShutdownBtn_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="#18FFFFFF"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="4,6">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                    <FontIcon x:Name="ControlsShutdownIcon" Glyph="&#xE7E8;" FontSize="12" Foreground="#FF6B6B"/>
                                    <TextBlock x:Name="ControlsShutdownText" Text="Shut down" FontSize="11" Foreground="#F0FFFFFF"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ── Frame stats overlay ──────────────────────────────────── -->
                <Grid x:Name="FrameStatsRow" Grid.Row="2">
                    <TextBlock x:Name="FrameStatsText"
                               Text=""
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="#4CC2FF"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="BenchStatusText"
                               Text=""
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="#6CCB5F"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</Window>
