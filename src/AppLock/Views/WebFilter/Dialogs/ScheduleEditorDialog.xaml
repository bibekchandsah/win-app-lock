<ContentDialog
    x:Class="AppLock.Views.WebFilter.Dialogs.ScheduleEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Schedule"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8">

    <StackPanel Spacing="16" Width="440">
        <StackPanel Spacing="4">
            <TextBlock x:Name="TargetSubheader"
                       Text="Active hours"
                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBlock Text="The filter is active during these time periods. When no blocks are configured, the filter is active all day (Always)."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Container for TimeBlockCards -->
        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel x:Name="BlocksContainer" Spacing="10"/>
        </ScrollViewer>

        <!-- Empty state when no blocks -->
        <Border x:Name="EmptyStateBorder"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Visibility="Collapsed">
            <TextBlock Text="No active schedule blocks set. This category will be active 24/7 (Always)."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Add block button -->
        <Button x:Name="AddBlockButton"
                Click="AddBlockButton_Click"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                <TextBlock Text="Add time block"/>
            </StackPanel>
        </Button>
    </StackPanel>
</ContentDialog>
