<ContentDialog
    x:Class="AppLock.Views.WebFilter.Dialogs.ImportDomainsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Import Domains"
    PrimaryButtonText="Import"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    CornerRadius="8">

    <StackPanel Spacing="14" Width="440">
        <TextBlock Text="Paste one domain or URL per line. Lines starting with # are treated as comments."
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"/>

        <Button x:Name="BrowseFileButton"
                Content="Browse text file (.txt)..."
                Click="BrowseFileButton_Click"/>

        <TextBox x:Name="InputTextBox"
                 PlaceholderText="example.com&#x0a;*.another-site.org&#x0a;https://bad-domain.net/page # note"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="200"
                 FontFamily="Consolas, Cascadia Code, monospace"/>

        <TextBlock x:Name="PreviewCountText"
                   Text=""
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
    </StackPanel>
</ContentDialog>
