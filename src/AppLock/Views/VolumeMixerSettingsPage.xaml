<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AppLock.Views.VolumeMixerSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="VolumeMixerSettingsPage_Loaded"
    Unloaded="VolumeMixerSettingsPage_Unloaded"
    Background="Transparent">

    <Grid Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back Button and Breadcrumb -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Others"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="›"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Volume Mixer"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Page Header -->
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Volume Mixer Settings"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Configure the floating volume overlay and per-app mixer"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Tab View -->
        <TabView Grid.Row="2"
                 TabWidthMode="Equal"
                 IsAddTabButtonVisible="False"
                 CanDragTabs="False"
                 CanReorderTabs="False">

            <!-- ═══════════════════════════════════════════════════════════
                 APPEARANCE TAB
            ═══════════════════════════════════════════════════════════ -->
            <TabViewItem Header="Appearance" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE771;"/>
                </TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,16,16">
                    <StackPanel Spacing="8" MaxWidth="800" HorizontalAlignment="Left">

                        <!-- Enable Volume Mixer -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Enable Volume Mixer" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Toggle the floating volume overlay on or off"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="EnabledToggle"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              MinWidth="0"
                                              OffContent=""
                                              OnContent=""
                                              Toggled="EnabledToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <!-- Hotkey Configuration -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Header -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Toggle Hotkey" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Keyboard shortcut to show/hide Volume Mixer"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="HotkeyEnabledToggle"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  MinWidth="0"
                                                  OffContent=""
                                                  OnContent=""
                                                  Toggled="HotkeyEnabledToggle_Toggled"/>
                                </Grid>
                                
                                <!-- Hotkey Input -->
                                <Grid Grid.Row="1" Margin="0,12,0,0" Visibility="{x:Bind HotkeyEnabledToggle.IsOn, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Hotkey:" VerticalAlignment="Center" Margin="0,0,12,0"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <TextBox x:Name="HotkeyTextBox"
                                                 IsReadOnly="True"
                                                 MinWidth="120"
                                                 VerticalAlignment="Center"/>
                                        <Button Content="Change" Click="ChangeHotkeyButton_Click"/>
                                        <Button Content="Reset" Click="ResetHotkeyButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Icon Position -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Icon Position" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Where the floating speaker icon appears on screen"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ComboBox x:Name="IconPositionComboBox"
                                          Grid.Column="1"
                                          SelectedIndex="2"
                                          MinWidth="180"
                                          VerticalAlignment="Center"
                                          SelectionChanged="IconPositionComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Top Left"     Tag="top-left"/>
                                    <ComboBoxItem Content="Top Right"    Tag="top-right"/>
                                    <ComboBoxItem Content="Top Center"   Tag="top-center"/>
                                    <ComboBoxItem Content="Bottom Left"  Tag="bottom-left"/>
                                    <ComboBoxItem Content="Bottom Right" Tag="bottom-right"/>
                                    <ComboBoxItem Content="Bottom Center" Tag="bottom-center"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Icon Size -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Icon Size" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Size of the floating speaker button in pixels (16 – 64)"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <NumberBox x:Name="IconSizeNumberBox"
                                           Grid.Column="1"
                                           Value="32" Minimum="16" Maximum="64"
                                           SpinButtonPlacementMode="Inline"
                                           MinWidth="140"
                                           VerticalAlignment="Center"
                                           ValueChanged="IconSizeNumberBox_ValueChanged"/>
                            </Grid>
                        </Border>

                        <!-- Idle Opacity -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Idle Opacity" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind IdleOpacityText, Mode=OneWay}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                               MinWidth="44" TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Transparency of the icon when the pointer is not hovering"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Slider x:Name="IdleOpacitySlider"
                                        Minimum="10" Maximum="100" Value="50"
                                        TickFrequency="10"
                                        ValueChanged="IdleOpacitySlider_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Hover Opacity -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Hover Opacity" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind HoverOpacityText, Mode=OneWay}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                               MinWidth="44" TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Transparency of the icon when the pointer is hovering over it"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Slider x:Name="HoverOpacitySlider"
                                        Minimum="10" Maximum="100" Value="100"
                                        TickFrequency="10"
                                        ValueChanged="HoverOpacitySlider_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Slider Width -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Slider Width" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Width of the master volume slider in expanded state (100 – 400 px)"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <NumberBox x:Name="SliderWidthNumberBox"
                                           Grid.Column="1"
                                           Value="200" Minimum="100" Maximum="400"
                                           SpinButtonPlacementMode="Inline"
                                           MinWidth="140"
                                           VerticalAlignment="Center"
                                           ValueChanged="SliderWidthNumberBox_ValueChanged"/>
                            </Grid>
                        </Border>

                        <!-- Show Microphone Volume -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Show Microphone Volume" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Display microphone volume slider in the volume mixer overlay"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowMicrophoneVolumeToggle"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              MinWidth="0"
                                              OffContent=""
                                              OnContent=""
                                              Toggled="ShowMicrophoneVolumeToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <!-- Show Camera Brightness -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Show Camera Brightness" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Display camera brightness slider in the volume mixer overlay"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowCameraBrightnessToggle"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              MinWidth="0"
                                              OffContent=""
                                              OnContent=""
                                              Toggled="ShowCameraBrightnessToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <!-- Show Screen Brightness -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Show Screen Brightness" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Display monitor brightness slider in the volume mixer overlay"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowScreenBrightnessToggle"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              MinWidth="0"
                                              OffContent=""
                                              OnContent=""
                                              Toggled="ShowScreenBrightnessToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <!-- Restore Defaults -->
                        <Border BorderThickness="0" Padding="0,8,0,0">
                            <Button x:Name="RestoreAppearanceDefaultsButton"
                                    Content="Restore Appearance Defaults"
                                    Click="RestoreAppearanceDefaults_Click"
                                    HorizontalAlignment="Right">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE777;" FontSize="14"/>
                                            <TextBlock Text="Restore Appearance Defaults"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ═══════════════════════════════════════════════════════════
                 BEHAVIOR TAB
            ═══════════════════════════════════════════════════════════ -->
            <TabViewItem Header="Behavior" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE713;"/>
                </TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,16,16">
                    <StackPanel Spacing="8" MaxWidth="800" HorizontalAlignment="Left">

                        <!-- Section header: Timing -->
                        <TextBlock Text="Timing" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="4,4,0,4"/>

                        <!-- Hover Delay -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Hover Delay" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="How long the pointer must hover before the bar expands (0 – 3000 ms)"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <NumberBox x:Name="HoverDelayNumberBox"
                                           Grid.Column="1"
                                           Value="500" Minimum="0" Maximum="3000"
                                           SpinButtonPlacementMode="Inline"
                                           MinWidth="140"
                                           VerticalAlignment="Center"
                                           ValueChanged="HoverDelayNumberBox_ValueChanged"/>
                            </Grid>
                        </Border>

                        <!-- Mixer Hide Delay -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Mixer Hide Delay" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="How long after the pointer leaves before the overlay collapses (200 – 5000 ms)"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <NumberBox x:Name="MixerHideDelayNumberBox"
                                           Grid.Column="1"
                                           Value="1000" Minimum="200" Maximum="5000"
                                           SpinButtonPlacementMode="Inline"
                                           MinWidth="140"
                                           VerticalAlignment="Center"
                                           ValueChanged="MixerHideDelayNumberBox_ValueChanged"/>
                            </Grid>
                        </Border>

                        <!-- Animation Speed -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Animation Speed" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Duration of expand / collapse animations. Set to 0 to disable animations."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <NumberBox x:Name="AnimationSpeedNumberBox"
                                           Grid.Column="1"
                                           Value="250" Minimum="0" Maximum="1000"
                                           SpinButtonPlacementMode="Inline"
                                           MinWidth="140"
                                           VerticalAlignment="Center"
                                           ValueChanged="AnimationSpeedNumberBox_ValueChanged"/>
                            </Grid>
                        </Border>

                        <!-- Polling Interval -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Polling Interval" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="How often the app list is refreshed while the mixer is open (50 – 1000 ms)"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <NumberBox x:Name="PollingIntervalNumberBox"
                                           Grid.Column="1"
                                           Value="150" Minimum="50" Maximum="1000"
                                           SpinButtonPlacementMode="Inline"
                                           MinWidth="140"
                                           VerticalAlignment="Center"
                                           ValueChanged="PollingIntervalNumberBox_ValueChanged"/>
                            </Grid>
                        </Border>

                        <!-- Section header: Options -->
                        <TextBlock Text="Options" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="4,12,0,4"/>

                        <!-- Enable Drag Mode -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Enable Drag Mode" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Allow dragging the icon to any screen position. The position is saved."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="DragModeToggle"
                                             Grid.Column="1"
                                             MinWidth="0" OffContent="" OnContent=""
                                             Toggled="DragModeToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <!-- Show Only Active Apps -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Show Only Active Apps" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Only list apps that are currently playing audio"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="OnlyActiveAppsToggle"
                                             Grid.Column="1"
                                             MinWidth="0" OffContent="" OnContent=""
                                             Toggled="OnlyActiveAppsToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <!-- Start with Windows -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Start with Windows" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Launch the volume overlay automatically at login (no main window)"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="StartWithWindowsToggle"
                                             Grid.Column="1"
                                             MinWidth="0" OffContent="" OnContent=""
                                             Toggled="StartWithWindowsToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <!-- Restore Defaults -->
                        <Border BorderThickness="0" Padding="0,8,0,0">
                            <Button x:Name="RestoreBehaviorDefaultsButton"
                                    Content="Restore Behavior Defaults"
                                    Click="RestoreBehaviorDefaults_Click"
                                    HorizontalAlignment="Right">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE777;" FontSize="14"/>
                                            <TextBlock Text="Restore Behavior Defaults"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ═══════════════════════════════════════════════════════════
                 BLACKLIST TAB
            ═══════════════════════════════════════════════════════════ -->
            <TabViewItem Header="Blacklist" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE72E;"/>
                </TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,16,16">
                    <StackPanel Spacing="8" MaxWidth="800" HorizontalAlignment="Left">

                        <!-- Info card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Blocked Applications" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Apps listed here will never appear in the mixer. Enter the process name, e.g. chrome.exe"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- List + controls card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">

                                <!-- ListView -->
                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        MinHeight="180" MaxHeight="260">
                                    <ListView x:Name="BlacklistListView"
                                              SelectionMode="Single"
                                              SelectionChanged="BlacklistListView_SelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid Padding="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xE72E;"
                                                              FontSize="12"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              Margin="0,0,10,0"
                                                              VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind}"
                                                               FontFamily="Consolas"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>

                                <!-- Input row -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BlacklistInputTextBox"
                                             Grid.Column="0"
                                             PlaceholderText="e.g. chrome.exe"
                                             KeyDown="BlacklistInputTextBox_KeyDown"/>
                                    <Button x:Name="AddBlacklistButton"
                                            Grid.Column="1"
                                            Content="Add"
                                            Style="{StaticResource AccentButtonStyle}"
                                            MinWidth="80"
                                            Click="AddBlacklistButton_Click"/>
                                    <Button x:Name="RemoveBlacklistButton"
                                            Grid.Column="2"
                                            Content="Remove"
                                            IsEnabled="False"
                                            MinWidth="80"
                                            Click="RemoveBlacklistButton_Click"/>
                                </Grid>

                                <!-- Validation hint -->
                                <TextBlock x:Name="BlacklistHintTextBlock"
                                           Text=""
                                           FontSize="12"
                                           Foreground="{ThemeResource SystemErrorTextColor}"
                                           Visibility="Collapsed"/>

                            </StackPanel>
                        </Border>

                        <!-- Clear All -->
                        <Border BorderThickness="0" Padding="0,8,0,0">
                            <Button x:Name="ClearBlacklistButton"
                                    Click="ClearBlacklist_Click"
                                    HorizontalAlignment="Right">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                            <TextBlock Text="Clear All"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

        </TabView>
    </Grid>
</Page>
