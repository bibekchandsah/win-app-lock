<ContentDialog
    x:Class="AppLock.Views.ChooseVerificationMethodDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Security Questions"
    PrimaryButtonText="Verify via security question"
    SecondaryButtonText="Verify via admin password"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    CloseButtonClick="ContentDialog_CloseButtonClick">

    <ContentDialog.Resources>
        <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="8" MinWidth="480">
        <TextBlock Text="Choose verification method"
                   FontSize="14"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
</ContentDialog>
