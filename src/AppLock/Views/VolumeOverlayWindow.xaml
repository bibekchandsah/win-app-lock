<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AppLock.Views.VolumeOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Layout: RootGrid → StackPanel (vertical)
          ┌─────────────────────────────┐
          │  MixerPanel  (Collapsed)    │  ← appears above bar for bottom-* icon positions
          │  CardBorder  (pill bar)     │  ← always visible when enabled
          │  MixerPanel  (Collapsed)    │  ← appears below bar for top-* icon positions
          └─────────────────────────────┘
        Only one of the two MixerPanel slots is ever Visible at a time.
        Using a StackPanel means the mixer extends the window vertically without overlapping.
    -->

    <Grid x:Name="RootGrid"
          PointerEntered="RootGrid_PointerEntered"
          PointerExited="RootGrid_PointerExited"
          PointerPressed="RootGrid_PointerPressed"
          PointerMoved="RootGrid_PointerMoved"
          PointerReleased="RootGrid_PointerReleased"
          PointerCaptureLost="RootGrid_PointerCaptureLost"
          KeyDown="RootGrid_KeyDown"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Background="Transparent">

        <StackPanel x:Name="LayoutRoot"
                    Orientation="Vertical"
                    Spacing="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

            <!-- ══════════════════════════════════════════════════
                 MIXER PANEL — above the bar (bottom-* positions)
                 ══════════════════════════════════════════════════ -->
            <Border x:Name="MixerPanelAbove"
                    Visibility="Collapsed"
                    CornerRadius="16"
                    BorderThickness="0"
                    BorderBrush="Transparent"
                    Background="{ThemeResource OverlayCardBackgroundBrush}"
                    Padding="14,12,14,14"
                    HorizontalAlignment="Stretch"
                    MaxHeight="400"
                    PointerEntered="MixerPanel_PointerEntered"
                    PointerExited="MixerPanel_PointerExited">
                <!-- content injected by MixerPanelContent below — same x:Name trick via
                     a shared ContentPresenter won't work, so this slot uses a plain container
                     and code-behind picks the active panel. -->
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Header row: title + universal media controls -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Volume Mixer"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <!-- Prev / Play-Pause / Next -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="UniversalPrevAbove"
                                    Width="26" Height="26" Padding="0" CornerRadius="13"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Click="UniversalPrev_Click"
                                    ToolTipService.ToolTip="Previous">
                                <FontIcon Glyph="&#xE892;" FontSize="11"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                            <Button x:Name="UniversalPlayPauseAbove"
                                    Width="28" Height="28" Padding="0" CornerRadius="14"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Click="UniversalPlayPause_Click"
                                    ToolTipService.ToolTip="Play / Pause">
                                <FontIcon x:Name="UniversalPlayPauseIconAbove"
                                          Glyph="&#xE768;"
                                          FontSize="12"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                            <Button x:Name="UniversalNextAbove"
                                    Width="26" Height="26" Padding="0" CornerRadius="13"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Click="UniversalNext_Click"
                                    ToolTipService.ToolTip="Next">
                                <FontIcon Glyph="&#xE893;" FontSize="11"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Margin="0,2,0,0"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="320" Padding="0,0,2,0">
                        <StackPanel x:Name="AppRowsContainerAbove" Spacing="6">
                            <TextBlock x:Name="EmptyStateTextAbove"
                                       Text="No apps playing audio"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextAlignment="Center"
                                       Margin="0,24,0,24"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════
                 CONTROL BAR — the pill, always visible
                 ══════════════════════════════════════════════════ -->
            <Border x:Name="CardBorder"
                    CornerRadius="22"
                    BorderThickness="0"
                    BorderBrush="Transparent"
                    Background="{ThemeResource OverlayCardBackgroundBrush}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Padding="6">

                <Grid x:Name="ContentGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Column 0, Row 0: Speaker / mute button ── -->
                    <Button x:Name="SpeakerButton"
                            Grid.Row="0"
                            Grid.Column="0"
                            Click="SpeakerButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="32" Height="32"
                            Padding="0"
                            CornerRadius="16"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Master volume mute toggle"
                            AutomationProperties.HelpText="Click to mute or unmute system audio">
                        <FontIcon x:Name="SpeakerIcon"
                                  Glyph="&#xE767;"
                                  FontSize="16"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </Button>

                    <!-- ── Column 0, Row 1: Microphone icon buttons container (dynamic) ── -->
                    <StackPanel x:Name="MicrophoneIconsContainer"
                                Grid.Row="1"
                                Grid.Column="0"
                                Orientation="Vertical"
                                Spacing="4"
                                Visibility="Collapsed"/>

                    <!-- ── Column 0, Row 2: Active App Icon / Host button ── -->
                    <Grid x:Name="ActiveAppHost"
                          Grid.Row="2"
                          Grid.Column="0"
                          Width="32" Height="32"
                          Margin="0,4,0,0"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Button x:Name="ActiveAppIconButton"
                                Width="32" Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="16"
                                Click="ActiveAppIconButton_Click"
                                ToolTipService.ToolTip="Play / Pause"
                                AutomationProperties.Name="Active application icon">
                            <Grid x:Name="ActiveAppIconContainer" 
                                  Width="20" Height="20" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False">
                                <FontIcon x:Name="ActiveAppFallbackIcon"
                                          Glyph="&#xE8A5;"
                                          FontSize="16"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- ── Column 0, Row 3: Camera icon ── -->
                    <Grid x:Name="CameraIconHost"
                          Grid.Row="3"
                          Grid.Column="0"
                          Width="32" Height="32"
                          Margin="0,4,0,0"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Button x:Name="CameraButton"
                                Width="32" Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="16"
                                AutomationProperties.Name="Camera"
                                AutomationProperties.HelpText="Camera brightness control">
                            <FontIcon x:Name="CameraIcon"
                                      Glyph="&#xE8B8;"
                                      FontSize="16"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- ── Column 1: Expandable controls (fade in/out smoothly with width animation) ── -->
                    <Grid x:Name="ExpandableControlsGrid"
                          Grid.Row="0"
                          Grid.RowSpan="4"
                          Grid.Column="1"
                          Visibility="Collapsed"
                          Opacity="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: Master volume slider, percent label, mixer button -->
                        <Slider x:Name="MasterVolumeSlider"
                                Grid.Row="0"
                                Grid.Column="0"
                                Minimum="0" Maximum="100" Value="50"
                                Width="180"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                ValueChanged="MasterVolumeSlider_ValueChanged"
                                PointerWheelChanged="MasterVolumeSlider_PointerWheelChanged"
                                AutomationProperties.Name="Master volume"
                                AutomationProperties.HelpText="Adjust system volume. Use mouse wheel or arrow keys."/>

                        <TextBlock x:Name="PercentText"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Text="50%"
                                   FontSize="12"
                                   MinWidth="38"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.LiveSetting="Polite"/>

                        <Button x:Name="MixerButton"
                                Grid.Row="0"
                                Grid.Column="2"
                                Click="MixerButton_Click"
                                Width="28" Height="28"
                                Padding="0"
                                Margin="6,0,0,0"
                                CornerRadius="14"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Open volume mixer"
                                AutomationProperties.HelpText="Show per-application volume controls">
                            <FontIcon x:Name="MixerButtonIcon"
                                      Glyph="&#xE9E9;"
                                      FontSize="13"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Button>

                        <!-- Row 1: Microphone controls container (dynamic, spans all columns) -->
                        <StackPanel x:Name="MicrophoneControlsContainer"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Orientation="Vertical"
                                    Spacing="4"
                                    Visibility="Collapsed"/>

                        <!-- Row 2: Active App volume slider, percent label, mute button -->
                        <Slider x:Name="ActiveAppVolumeSlider"
                                Grid.Row="2"
                                Grid.Column="0"
                                Minimum="0" Maximum="100" Value="50"
                                Width="180"
                                VerticalAlignment="Center"
                                Margin="8,4,0,0"
                                Visibility="Collapsed"
                                ValueChanged="ActiveAppVolumeSlider_ValueChanged"
                                PointerWheelChanged="ActiveAppVolumeSlider_PointerWheelChanged"
                                AutomationProperties.Name="Active application volume"
                                AutomationProperties.HelpText="Adjust focused application volume."/>

                        <TextBlock x:Name="ActiveAppPercentText"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Text="50%"
                                   FontSize="12"
                                   MinWidth="38"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="6,4,0,0"
                                   Visibility="Collapsed"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.LiveSetting="Polite"/>

                        <Button x:Name="ActiveAppMuteButton"
                                Grid.Row="2"
                                Grid.Column="2"
                                Click="ActiveAppMuteButton_Click"
                                Width="28" Height="28"
                                Padding="0"
                                Margin="6,4,0,0"
                                CornerRadius="14"
                                Visibility="Collapsed"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Mute active application"
                                AutomationProperties.HelpText="Mute or unmute active application">
                            <FontIcon x:Name="ActiveAppMuteIcon"
                                      Glyph="&#xE767;"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Button>

                        <!-- Row 3: Camera brightness slider, percent label -->
                        <Slider x:Name="CameraBrightnessSlider"
                                Grid.Row="3"
                                Grid.Column="0"
                                Minimum="0" Maximum="100" Value="50"
                                Width="180"
                                VerticalAlignment="Center"
                                Margin="8,4,0,0"
                                Visibility="Collapsed"
                                ValueChanged="CameraBrightnessSlider_ValueChanged"
                                PointerWheelChanged="CameraBrightnessSlider_PointerWheelChanged"
                                AutomationProperties.Name="Camera brightness"
                                AutomationProperties.HelpText="Adjust webcam brightness. Use mouse wheel or arrow keys."/>

                        <TextBlock x:Name="CameraBrightnessPercentText"
                                   Grid.Row="3"
                                   Grid.Column="1"
                                   Text="50%"
                                   FontSize="12"
                                   MinWidth="38"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="6,4,0,0"
                                   Visibility="Collapsed"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.LiveSetting="Polite"/>

                        <!-- Empty space in column 2 to align with rows above -->
                        <Border Grid.Row="3" Grid.Column="2" Width="28" Margin="6,4,0,0" Visibility="Collapsed" x:Name="CameraBrightnessPlaceholder"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════
                 MIXER PANEL — below the bar (top-* positions)
                 ══════════════════════════════════════════════════ -->
            <Border x:Name="MixerPanelBelow"
                    Visibility="Collapsed"
                    CornerRadius="16"
                    BorderThickness="0"
                    BorderBrush="Transparent"
                    Background="{ThemeResource OverlayCardBackgroundBrush}"
                    Padding="14,12,14,14"
                    HorizontalAlignment="Stretch"
                    MaxHeight="400"
                    PointerEntered="MixerPanel_PointerEntered"
                    PointerExited="MixerPanel_PointerExited">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Header row: title + universal media controls -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Volume Mixer"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <!-- Prev / Play-Pause / Next -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="UniversalPrevBelow"
                                    Width="26" Height="26" Padding="0" CornerRadius="13"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Click="UniversalPrev_Click"
                                    ToolTipService.ToolTip="Previous">
                                <FontIcon Glyph="&#xE892;" FontSize="11"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                            <Button x:Name="UniversalPlayPauseBelow"
                                    Width="28" Height="28" Padding="0" CornerRadius="14"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Click="UniversalPlayPause_Click"
                                    ToolTipService.ToolTip="Play / Pause">
                                <FontIcon x:Name="UniversalPlayPauseIconBelow"
                                          Glyph="&#xE768;"
                                          FontSize="12"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                            <Button x:Name="UniversalNextBelow"
                                    Width="26" Height="26" Padding="0" CornerRadius="13"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Click="UniversalNext_Click"
                                    ToolTipService.ToolTip="Next">
                                <FontIcon Glyph="&#xE893;" FontSize="11"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Margin="0,2,0,0"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="320" Padding="0,0,2,0">
                        <StackPanel x:Name="AppRowsContainer" Spacing="6">
                            <TextBlock x:Name="EmptyStateText"
                                       Text="No apps playing audio"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextAlignment="Center"
                                       Margin="0,24,0,24"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

        </StackPanel>



    </Grid>
</Window>
