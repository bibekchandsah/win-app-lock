<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AppLock.Views.VolumeOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Layout: RootGrid → StackPanel (vertical)
          ┌─────────────────────────────┐
          │  MixerPanel  (Collapsed)    │  ← appears above bar for bottom-* icon positions
          │  CardBorder  (pill bar)     │  ← always visible when enabled
          │  MixerPanel  (Collapsed)    │  ← appears below bar for top-* icon positions
          └─────────────────────────────┘
        Only one of the two MixerPanel slots is ever Visible at a time.
        Using a StackPanel means the mixer extends the window vertically without overlapping.
    -->

    <Grid x:Name="RootGrid"
          PointerEntered="RootGrid_PointerEntered"
          PointerExited="RootGrid_PointerExited"
          PointerPressed="RootGrid_PointerPressed"
          PointerMoved="RootGrid_PointerMoved"
          PointerReleased="RootGrid_PointerReleased"
          KeyDown="RootGrid_KeyDown"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">

        <StackPanel x:Name="LayoutRoot"
                    Orientation="Vertical"
                    Spacing="0">

            <!-- ══════════════════════════════════════════════════
                 MIXER PANEL — above the bar (bottom-* positions)
                 ══════════════════════════════════════════════════ -->
            <Border x:Name="MixerPanelAbove"
                    Visibility="Collapsed"
                    CornerRadius="24"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="14,12,14,14"
                    MinWidth="320"
                    MaxHeight="400"
                    PointerEntered="MixerPanel_PointerEntered"
                    PointerExited="MixerPanel_PointerExited">
                <!-- content injected by MixerPanelContent below — same x:Name trick via
                     a shared ContentPresenter won't work, so this slot uses a plain container
                     and code-behind picks the active panel. -->
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Header row: title + universal media controls -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Volume Mixer"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <!-- Prev / Play-Pause / Next -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="UniversalPrevAbove"
                                    Width="26" Height="26" Padding="0" CornerRadius="13"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Click="UniversalPrev_Click"
                                    ToolTipService.ToolTip="Previous">
                                <FontIcon Glyph="&#xE892;" FontSize="11"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                            <Button x:Name="UniversalPlayPauseAbove"
                                    Width="28" Height="28" Padding="0" CornerRadius="14"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Click="UniversalPlayPause_Click"
                                    ToolTipService.ToolTip="Play / Pause">
                                <FontIcon x:Name="UniversalPlayPauseIconAbove"
                                          Glyph="&#xE768;"
                                          FontSize="12"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                            <Button x:Name="UniversalNextAbove"
                                    Width="26" Height="26" Padding="0" CornerRadius="13"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Click="UniversalNext_Click"
                                    ToolTipService.ToolTip="Next">
                                <FontIcon Glyph="&#xE893;" FontSize="11"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Margin="0,2,0,0"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="320" Padding="0,0,2,0">
                        <StackPanel x:Name="AppRowsContainerAbove" Spacing="6">
                            <TextBlock x:Name="EmptyStateTextAbove"
                                       Text="No apps playing audio"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextAlignment="Center"
                                       Margin="0,24,0,24"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════
                 CONTROL BAR — the pill, always visible
                 ══════════════════════════════════════════════════ -->
            <Border x:Name="CardBorder"
                    CornerRadius="24"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="10,6">

                <Grid x:Name="ContentGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Speaker / mute button -->
                    <Button x:Name="SpeakerButton"
                            Grid.Column="0"
                            Click="SpeakerButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="32" Height="32"
                            Padding="0"
                            CornerRadius="16"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Master volume mute toggle"
                            AutomationProperties.HelpText="Click to mute or unmute system audio">
                        <FontIcon x:Name="SpeakerIcon"
                                  Glyph="&#xE767;"
                                  FontSize="16"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </Button>

                    <!-- Volume slider (hidden when idle) -->
                    <Slider x:Name="MasterVolumeSlider"
                            Grid.Column="1"
                            Minimum="0" Maximum="100" Value="50"
                            Width="180"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Visibility="Collapsed"
                            ValueChanged="MasterVolumeSlider_ValueChanged"
                            PointerWheelChanged="MasterVolumeSlider_PointerWheelChanged"
                            AutomationProperties.Name="Master volume"
                            AutomationProperties.HelpText="Adjust system volume. Use mouse wheel or arrow keys."/>

                    <!-- Percent label (hidden when idle) -->
                    <TextBlock x:Name="PercentText"
                               Grid.Column="2"
                               Text="50%"
                               FontSize="12"
                               MinWidth="40"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               Visibility="Collapsed"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite"/>

                    <!-- Mixer-open button (hidden when idle) -->
                    <Button x:Name="MixerButton"
                            Grid.Column="3"
                            Click="MixerButton_Click"
                            Width="28" Height="28"
                            Padding="0"
                            Margin="6,0,0,0"
                            CornerRadius="14"
                            Visibility="Collapsed"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Open volume mixer"
                            AutomationProperties.HelpText="Show per-application volume controls">
                        <FontIcon x:Name="MixerButtonIcon"
                                  Glyph="&#xE9E9;"
                                  FontSize="13"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════
                 MIXER PANEL — below the bar (top-* positions)
                 ══════════════════════════════════════════════════ -->
            <Border x:Name="MixerPanelBelow"
                    Visibility="Collapsed"
                    CornerRadius="24"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="14,12,14,14"
                    MinWidth="320"
                    MaxHeight="400"
                    PointerEntered="MixerPanel_PointerEntered"
                    PointerExited="MixerPanel_PointerExited">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Header row: title + universal media controls -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Volume Mixer"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <!-- Prev / Play-Pause / Next -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="UniversalPrevBelow"
                                    Width="26" Height="26" Padding="0" CornerRadius="13"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Click="UniversalPrev_Click"
                                    ToolTipService.ToolTip="Previous">
                                <FontIcon Glyph="&#xE892;" FontSize="11"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                            <Button x:Name="UniversalPlayPauseBelow"
                                    Width="28" Height="28" Padding="0" CornerRadius="14"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Click="UniversalPlayPause_Click"
                                    ToolTipService.ToolTip="Play / Pause">
                                <FontIcon x:Name="UniversalPlayPauseIconBelow"
                                          Glyph="&#xE768;"
                                          FontSize="12"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                            <Button x:Name="UniversalNextBelow"
                                    Width="26" Height="26" Padding="0" CornerRadius="13"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Click="UniversalNext_Click"
                                    ToolTipService.ToolTip="Next">
                                <FontIcon Glyph="&#xE893;" FontSize="11"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Margin="0,2,0,0"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="320" Padding="0,0,2,0">
                        <StackPanel x:Name="AppRowsContainer" Spacing="6">
                            <TextBlock x:Name="EmptyStateText"
                                       Text="No apps playing audio"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextAlignment="Center"
                                       Margin="0,24,0,24"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

        </StackPanel>

        <!-- Drag outline accent ring (non-interactive) -->
        <Border x:Name="DragOutline"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="24"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Opacity="0.6"/>

    </Grid>
</Window>
