<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AppLock.Views.VolumeOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Root grid with backdrop and dynamic size -->
    <Grid x:Name="RootGrid"
          PointerEntered="RootGrid_PointerEntered"
          PointerExited="RootGrid_PointerExited"
          PointerPressed="RootGrid_PointerPressed"
          PointerMoved="RootGrid_PointerMoved"
          PointerReleased="RootGrid_PointerReleased"
          KeyDown="RootGrid_KeyDown"
          Background="Transparent">
        
        <!-- Main card container -->
        <Border x:Name="CardBorder"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="12,8">
            
            <Grid x:Name="ContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Speaker icon -->
                    <ColumnDefinition Width="Auto"/> <!-- Slider (hidden when idle) -->
                    <ColumnDefinition Width="Auto"/> <!-- Percent text (hidden when idle) -->
                    <ColumnDefinition Width="Auto"/> <!-- Mixer button (hidden when idle) -->
                </Grid.ColumnDefinitions>
                
                <!-- Speaker Icon -->
                <Button x:Name="SpeakerButton"
                        Grid.Column="0"
                        Click="SpeakerButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="32"
                        Height="32"
                        Padding="0"
                        CornerRadius="16"
                        AutomationProperties.Name="Master volume mute toggle"
                        AutomationProperties.HelpText="Click to mute or unmute system audio">
                    <FontIcon x:Name="SpeakerIcon"
                              Glyph="&#xE767;"
                              FontSize="20"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </Button>

                <!-- Master Volume Slider (expanded state) -->
                <Slider x:Name="MasterVolumeSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="100"
                        Value="50"
                        Width="200"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Visibility="Collapsed"
                        ValueChanged="MasterVolumeSlider_ValueChanged"
                        PointerWheelChanged="MasterVolumeSlider_PointerWheelChanged"
                        AutomationProperties.Name="Master volume"
                        AutomationProperties.HelpText="Adjust system volume level. Use mouse wheel or arrow keys."/>

                <!-- Percent Text -->
                <TextBlock x:Name="PercentText"
                           Grid.Column="2"
                           Text="50%"
                           FontSize="13"
                           MinWidth="44"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           AutomationProperties.LiveSetting="Polite"/>

                <!-- Mixer Button -->
                <Button x:Name="MixerButton"
                        Grid.Column="3"
                        Click="MixerButton_Click"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Margin="8,0,0,0"
                        CornerRadius="16"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Open volume mixer"
                        AutomationProperties.HelpText="Show per-application volume controls">
                    <FontIcon Glyph="&#xE9E9;"
                              FontSize="14"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Mixer Panel (popup) -->
        <Border x:Name="MixerPanel"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Visibility="Collapsed"
                MaxHeight="360"
                MinWidth="320"
                VerticalAlignment="Top"
                Margin="0,60,0,0"
                PointerEntered="MixerPanel_PointerEntered"
                PointerExited="MixerPanel_PointerExited">

            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9E9;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Volume Mixer" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <!-- Divider -->
                <Border Grid.Row="1"
                        Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- App Rows Container -->
                <ScrollViewer Grid.Row="2" 
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="300">
                    <StackPanel x:Name="AppRowsContainer" Spacing="8">
                        <!-- Empty state text -->
                        <TextBlock x:Name="EmptyStateText"
                                   Text="No apps playing audio"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextAlignment="Center"
                                   Margin="0,32,0,32"
                                   Visibility="Visible"/>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>

        <!-- Drag Mode Outline (shown when drag mode is enabled) -->
        <Border x:Name="DragOutline"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="20"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Opacity="0.5"/>
    </Grid>
</Window>
