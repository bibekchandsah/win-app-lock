<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AppLock.Views.PortWatchToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Port Alert">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="ToastSurfaceBrush" Color="#F21F1F1F"/>
                        <SolidColorBrush x:Key="ToastStrokeBrush" Color="#33FFFFFF"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="ToastSurfaceBrush" Color="#F2FAFAFA"/>
                        <SolidColorBrush x:Key="ToastStrokeBrush" Color="#22000000"/>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Border x:Name="Card"
                Background="{ThemeResource ToastSurfaceBrush}"
                BorderBrush="{ThemeResource ToastStrokeBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,14">
            <StackPanel Spacing="12">
                <!-- Header: Icon, Title & Close -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon x:Name="AlertIcon"
                              Grid.Column="0"
                              Glyph="&#xE7BA;"
                              FontSize="20"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}"
                              VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="New port open to your network"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubtitleText"
                                   Text="App · TCP Port 8080 (All interfaces)"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Click="CloseButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            CornerRadius="4"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Dismiss">
                        <FontIcon Glyph="&#xE711;" FontSize="10"/>
                    </Button>
                </Grid>

                <!-- Action Buttons: Block, Allow, Details -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BlockBtn"
                            Grid.Column="0"
                            Content="Block"
                            HorizontalAlignment="Stretch"
                            Click="BlockBtn_Click"
                            Padding="8,5"/>

                    <Button x:Name="AllowBtn"
                            Grid.Column="1"
                            Content="Allow"
                            ToolTipService.ToolTip="Allow and don't alert again"
                            HorizontalAlignment="Stretch"
                            Click="AllowBtn_Click"
                            Padding="8,5"/>

                    <Button x:Name="DetailsBtn"
                            Grid.Column="2"
                            Content="Details"
                            Click="DetailsBtn_Click"
                            Padding="12,5"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
