<Window
    x:Class="AppLock.Views.ClipboardPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AppLock.ViewModels"
    mc:Ignorable="d"
    Title="Clipboard">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Border BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                CornerRadius="8"
                Padding="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Search Box -->
                    <RowDefinition Height="Auto"/> <!-- Filter Chips -->
                    <RowDefinition Height="*"/>    <!-- Items List -->
                    <RowDefinition Height="Auto"/> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- Search Box -->
                <TextBox x:Name="SearchBox"
                         Grid.Row="0"
                         PlaceholderText="Search clipboard..."
                         TextChanged="SearchBox_TextChanged"
                         KeyDown="SearchBox_KeyDown">
                    <TextBox.Header>
                        <Grid/>
                    </TextBox.Header>
                </TextBox>

                <!-- Filter Chips -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="FilterAllButton" Content="All" Click="FilterButton_Click" Tag="All" Style="{StaticResource AccentButtonStyle}"/>
                    <Button x:Name="FilterTextButton" Content="Text" Click="FilterButton_Click" Tag="Text"/>
                    <Button x:Name="FilterImagesButton" Content="Images" Click="FilterButton_Click" Tag="Images"/>
                    <Button x:Name="FilterLinksButton" Content="Links" Click="FilterButton_Click" Tag="Links"/>
                    <Button x:Name="FilterPinnedButton" Content="Pinned" Click="FilterButton_Click" Tag="Pinned"/>
                </StackPanel>

                <!-- List Content -->
                <Grid Grid.Row="2">
                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyStatePanel"
                                Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <FontIcon Glyph="&#xE8C8;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock x:Name="EmptyStateText" Text="Nothing copied yet" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ListView x:Name="ItemsListView"
                              ItemsSource="{x:Bind Items}"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="ItemsListView_ItemClick"
                              KeyDown="ItemsListView_KeyDown">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0,2"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClipboardItemViewModel">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,2">
                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Meta Line -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE71D;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                <TextBlock Text="{x:Bind SourceProcess}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="•" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text="{x:Bind RelativeTime}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{x:Bind DimensionsText}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind ImageVisibility, Mode=OneWay}"/>
                                            </StackPanel>

                                            <!-- Row Action Buttons -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                <Button Click="ItemCopy_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Copy" Padding="4" Background="Transparent" BorderThickness="0">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11"/>
                                                </Button>
                                                <Button Click="ItemDelete_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Delete" Padding="4" Background="Transparent" BorderThickness="0">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Preview -->
                                        <Grid Grid.Row="1">
                                            <!-- Text Preview -->
                                            <TextBlock Text="{x:Bind PreviewText}"
                                                       FontSize="12"
                                                       MaxLines="3"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       LineHeight="16"
                                                       Visibility="{x:Bind TextVisibility, Mode=OneWay}"/>

                                            <!-- Image Preview -->
                                            <Border Visibility="{x:Bind ImageVisibility, Mode=OneWay}"
                                                    CornerRadius="4"
                                                    BorderThickness="1"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    HorizontalAlignment="Left"
                                                    MaxHeight="100">
                                                <Image Source="{x:Bind ThumbnailImage, Mode=OneWay}"
                                                       MaxHeight="100"
                                                       MaxWidth="200"
                                                       Stretch="Uniform"/>
                                            </Border>

                                            <!-- Files Preview -->
                                            <StackPanel Visibility="{x:Bind FilesVisibility, Mode=OneWay}" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                <TextBlock Text="{x:Bind PreviewText}" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="3" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="FooterStatsText" Text="0 / 100 items" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Enter: copy • Del: delete • Esc: close" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="FooterClearAllButton" Content="Clear" Click="FooterClearAll_Click" Padding="8,4" FontSize="11"/>
                        <Button x:Name="FooterSettingsButton" Content="Settings" Click="FooterSettings_Click" Padding="8,4" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

