<Window
    x:Class="AppLock.Views.ClipboardPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AppLock.ViewModels"
    mc:Ignorable="d"
    Title="Clipboard">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Border BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                CornerRadius="8"
                Padding="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <!-- Main Content Grid -->
                <Grid x:Name="MainContentGrid" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search Box -->
                        <RowDefinition Height="Auto"/> <!-- Filter Chips & Pause Status -->
                        <RowDefinition Height="*"/>    <!-- Items List -->
                        <RowDefinition Height="Auto"/> <!-- Multi-select Bar / Footer -->
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <TextBox x:Name="SearchBox"
                             Grid.Row="0"
                             PlaceholderText="Search clipboard (1-9 quick paste)..."
                             AutomationProperties.Name="Search clipboard history"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown">
                        <TextBox.Header>
                            <Grid/>
                        </TextBox.Header>
                    </TextBox>

                    <!-- Filter Chips & Status Bar -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,8,0">
                                <Button x:Name="FilterAllButton" Content="All" Click="FilterButton_Click" Tag="All" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Show all items" ToolTipService.ToolTip="Show all items"/>
                                <Button x:Name="FilterTextButton" Content="Text" Click="FilterButton_Click" Tag="Text" AutomationProperties.Name="Show text items" ToolTipService.ToolTip="Show text items"/>
                                <Button x:Name="FilterImagesButton" Content="Images" Click="FilterButton_Click" Tag="Images" AutomationProperties.Name="Show images" ToolTipService.ToolTip="Show images"/>
                                <Button x:Name="FilterLinksButton" Content="Links" Click="FilterButton_Click" Tag="Links" AutomationProperties.Name="Show links" ToolTipService.ToolTip="Show links"/>
                                <Button x:Name="FilterPinnedButton" Content="Pinned" Click="FilterButton_Click" Tag="Pinned" AutomationProperties.Name="Show pinned items" ToolTipService.ToolTip="Show pinned items"/>
                                <Button x:Name="FilterSnippetsButton" Content="Snippets" Click="FilterButton_Click" Tag="Snippets" AutomationProperties.Name="Show snippets" ToolTipService.ToolTip="Show snippets"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Right Actions: Pause Indicator & Multi-Select -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <!-- Paused indicator badge -->
                            <Border x:Name="PausedBadge"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE769;" FontSize="10" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                    <TextBlock x:Name="PausedBadgeText" Text="Paused" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Multi-select toggle button -->
                            <Button x:Name="MultiSelectToggleButton"
                                    Click="MultiSelectToggle_Click"
                                    AutomationProperties.Name="Toggle Multi-Select"
                                    ToolTipService.ToolTip="Toggle Multi-Select"
                                    Padding="6,4"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <FontIcon Glyph="&#xE762;" FontSize="13"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- List Content -->
                    <Grid Grid.Row="2">
                        <!-- Empty State -->
                        <StackPanel x:Name="EmptyStatePanel"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <FontIcon Glyph="&#xE8C8;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="EmptyStateText" Text="Nothing copied yet" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <ListView x:Name="ItemsListView"
                                  ItemsSource="{x:Bind Items}"
                                  SelectionMode="Extended"
                                  IsItemClickEnabled="True"
                                  ItemClick="ItemsListView_ItemClick"
                                  SelectionChanged="ItemsListView_SelectionChanged"
                                  KeyDown="ItemsListView_KeyDown">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0,2"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ClipboardItemViewModel">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,2">
                                        <Grid RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Meta Line -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <!-- Quick Paste Badge 1-9 -->
                                                    <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="5,1"
                                                            Visibility="{x:Bind QuickPasteVisibility, Mode=OneWay}">
                                                        <TextBlock Text="{x:Bind QuickPasteBadge, Mode=OneWay}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                    </Border>

                                                    <!-- Snippet Badge -->
                                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            CornerRadius="4"
                                                            Padding="5,1"
                                                            Visibility="{x:Bind SnippetBadgeVisibility, Mode=OneWay}">
                                                        <TextBlock Text="{x:Bind SnippetTitle, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                    </Border>

                                                    <!-- Source icon and title -->
                                                    <FontIcon Glyph="&#xE71D;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                    <TextBlock Text="{x:Bind SourceProcess}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                    <TextBlock Text="•" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{x:Bind RelativeTime}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{x:Bind DimensionsText}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind ImageVisibility, Mode=OneWay}"/>

                                                    <!-- Color Swatch -->
                                                    <Border Background="{x:Bind ColorBrush, Mode=OneWay}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Width="14"
                                                            Height="14"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind ColorSwatchVisibility, Mode=OneWay}"
                                                            ToolTipService.ToolTip="Color preview"/>

                                                    <!-- Link Icon -->
                                                    <FontIcon Glyph="&#xE71B;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind LinkVisibility, Mode=OneWay}" ToolTipService.ToolTip="Web link"/>

                                                    <!-- Sensitive Lock Icon & Expiry -->
                                                    <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind LockVisibility, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xE72E;"
                                                                  FontSize="10"
                                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                  ToolTipService.ToolTip="Sensitive item"/>
                                                        <TextBlock Text="{x:Bind ExpiresText, Mode=OneWay}"
                                                                   FontSize="10"
                                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                   Visibility="{x:Bind ExpiresVisibility, Mode=OneWay}"/>
                                                    </StackPanel>

                                                    <!-- Pinned Indicator Badge -->
                                                    <FontIcon Glyph="&#xE840;"
                                                              FontSize="10"
                                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                              Visibility="{x:Bind PinVisibility, Mode=OneWay}"
                                                              ToolTipService.ToolTip="Pinned"/>
                                                </StackPanel>

                                                <!-- Row Action Buttons -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                    <!-- Reveal / Hide button for sensitive items -->
                                                    <Button Click="ItemReveal_Click"
                                                            Tag="{x:Bind}"
                                                            ToolTipService.ToolTip="{x:Bind RevealToolTip, Mode=OneWay}"
                                                            AutomationProperties.Name="{x:Bind RevealToolTip, Mode=OneWay}"
                                                            Visibility="{x:Bind RevealButtonVisibility, Mode=OneWay}"
                                                            Padding="4"
                                                            Background="Transparent"
                                                            BorderThickness="0">
                                                        <FontIcon Glyph="{x:Bind RevealGlyph, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                    </Button>

                                                    <Button Click="ItemPin_Click" Tag="{x:Bind}" AutomationProperties.Name="Pin or unpin item" ToolTipService.ToolTip="{x:Bind PinToolTip, Mode=OneWay}" Padding="4" Background="Transparent" BorderThickness="0">
                                                        <FontIcon Glyph="{x:Bind PinGlyph, Mode=OneWay}" FontSize="11" Foreground="{x:Bind PinBrush, Mode=OneWay}"/>
                                                    </Button>
                                                    <Button Click="ItemCopy_Click" Tag="{x:Bind}" AutomationProperties.Name="Copy to clipboard" ToolTipService.ToolTip="Copy only (Ctrl+C)" Padding="4" Background="Transparent" BorderThickness="0">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="11"/>
                                                    </Button>

                                                    <!-- More Flyout (...) -->
                                                    <DropDownButton AutomationProperties.Name="More actions" ToolTipService.ToolTip="More actions" Padding="4" Background="Transparent" BorderThickness="0">
                                                        <DropDownButton.Content>
                                                            <FontIcon Glyph="&#xE712;" FontSize="11"/>
                                                        </DropDownButton.Content>
                                                        <DropDownButton.Flyout>
                                                            <MenuFlyout>
                                                                <!-- Text Actions -->
                                                                <MenuFlyoutSubItem Text="Text Actions">
                                                                    <MenuFlyoutItem Text="UPPERCASE" Click="TextAction_Click" Tag="upper"/>
                                                                    <MenuFlyoutItem Text="lowercase" Click="TextAction_Click" Tag="lower"/>
                                                                    <MenuFlyoutItem Text="Title Case" Click="TextAction_Click" Tag="title"/>
                                                                    <MenuFlyoutSeparator/>
                                                                    <MenuFlyoutItem Text="Trim Whitespace" Click="TextAction_Click" Tag="trim"/>
                                                                    <MenuFlyoutItem Text="Remove Line Breaks" Click="TextAction_Click" Tag="removelines"/>
                                                                    <MenuFlyoutSeparator/>
                                                                    <MenuFlyoutItem Text="URL Encode" Click="TextAction_Click" Tag="urlencode"/>
                                                                    <MenuFlyoutItem Text="URL Decode" Click="TextAction_Click" Tag="urldecode"/>
                                                                    <MenuFlyoutSeparator/>
                                                                    <MenuFlyoutItem Text="Base64 Encode" Click="TextAction_Click" Tag="b64encode"/>
                                                                    <MenuFlyoutItem Text="Base64 Decode" Click="TextAction_Click" Tag="b64decode"/>
                                                                </MenuFlyoutSubItem>

                                                                <MenuFlyoutItem Text="Edit Text before pasting (Ctrl+E)" Click="ItemEdit_Click"/>
                                                                <MenuFlyoutItem Text="Save as Snippet..." Click="ItemSaveAsSnippet_Click"/>
                                                                <MenuFlyoutItem Text="Open in Browser" Click="ItemOpenLink_Click"/>
                                                                <MenuFlyoutItem Text="Save Image As..." Click="ItemSaveImageAs_Click"/>
                                                                <MenuFlyoutItem Text="Copy as PNG" Click="ItemCopyPng_Click"/>
                                                                <MenuFlyoutSeparator/>
                                                                <MenuFlyoutItem Text="Pin / Unpin (Ctrl+P)" Click="ItemPin_Click"/>
                                                                <MenuFlyoutItem Text="Delete (Del)" Click="ItemDelete_Click"/>
                                                            </MenuFlyout>
                                                        </DropDownButton.Flyout>
                                                    </DropDownButton>

                                                    <Button Click="ItemDelete_Click" Tag="{x:Bind}" AutomationProperties.Name="Delete item" ToolTipService.ToolTip="Delete (Del)" Padding="4" Background="Transparent" BorderThickness="0">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Preview -->
                                            <Grid Grid.Row="1">
                                                <!-- Text Preview -->
                                                <TextBlock Text="{x:Bind PreviewText, Mode=OneWay}"
                                                           FontFamily="{x:Bind PreviewFontFamily, Mode=OneWay}"
                                                           FontSize="12"
                                                           MaxLines="3"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           LineHeight="16"
                                                           Visibility="{x:Bind TextVisibility, Mode=OneWay}"/>

                                                <!-- Image Preview with Rounded Corners -->
                                                <Border Visibility="{x:Bind ImageVisibility, Mode=OneWay}"
                                                        CornerRadius="8"
                                                        BorderThickness="1"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        HorizontalAlignment="Left"
                                                        MaxHeight="110"
                                                        Padding="2">
                                                    <Border CornerRadius="6">
                                                        <Image Source="{x:Bind ThumbnailImage, Mode=OneWay}"
                                                               MaxHeight="106"
                                                               MaxWidth="210"
                                                               Stretch="Uniform"/>
                                                    </Border>
                                                </Border>

                                                <!-- Files Preview -->
                                                <StackPanel Visibility="{x:Bind FilesVisibility, Mode=OneWay}" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                    <TextBlock Text="{x:Bind PreviewText}" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Multi-Select Action Bar (shown when multiple items selected) -->
                    <Border x:Name="MultiSelectBar"
                            Grid.Row="3"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE762;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <TextBlock x:Name="MultiSelectCountText" Text="2 items selected" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <DropDownButton x:Name="PasteMergedDropDown" Content="Paste Merged" Click="PasteMerged_Click" Style="{StaticResource AccentButtonStyle}" FontSize="11" Padding="8,4">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Merge with Newlines" Click="PasteMergedWithSeparator_Click" Tag="newline"/>
                                            <MenuFlyoutItem Text="Merge with Commas" Click="PasteMergedWithSeparator_Click" Tag="comma"/>
                                            <MenuFlyoutItem Text="Merge with Spaces" Click="PasteMergedWithSeparator_Click" Tag="space"/>
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <Button Content="Copy" Click="MultiCopy_Click" FontSize="11" Padding="8,4" ToolTipService.ToolTip="Copy merged text"/>
                                <Button Content="Delete" Click="MultiDelete_Click" FontSize="11" Padding="8,4" ToolTipService.ToolTip="Delete selected items"/>
                                <Button Content="Cancel" Click="MultiCancel_Click" FontSize="11" Padding="8,4"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Normal Footer -->
                    <Grid x:Name="NormalFooter" Grid.Row="3" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="FooterStatsText" Text="0 / 100 items" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Enter paste • Shift+Enter plain • Del delete • Ctrl+P pin" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Pause DropDown Button -->
                            <DropDownButton x:Name="FooterPauseButton" AutomationProperties.Name="Pause clipboard capture" ToolTipService.ToolTip="Pause capture" Padding="6,4">
                                <DropDownButton.Content>
                                    <FontIcon Glyph="&#xE769;" FontSize="11"/>
                                </DropDownButton.Content>
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Pause for 5 minutes" Click="FooterPause5_Click"/>
                                        <MenuFlyoutItem Text="Pause for 15 minutes" Click="FooterPause15_Click"/>
                                        <MenuFlyoutItem Text="Pause for 1 hour" Click="FooterPause60_Click"/>
                                        <MenuFlyoutItem Text="Pause until resumed" Click="FooterPauseIndefinite_Click"/>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem Text="Resume capture" Click="FooterResume_Click"/>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <Button x:Name="FooterClearAllButton" AutomationProperties.Name="Clear unpinned items" ToolTipService.ToolTip="Clear unpinned items" Content="Clear" Click="FooterClearAll_Click" Padding="8,4" FontSize="11"/>
                            <Button x:Name="FooterSettingsButton" AutomationProperties.Name="Open clipboard settings" ToolTipService.ToolTip="Open settings" Content="Settings" Click="FooterSettings_Click" Padding="8,4" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Inline Edit Text Overlay -->
                <Grid x:Name="EditItemOverlay"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      Visibility="Collapsed"
                      Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Edit Text Before Pasting" FontSize="14" FontWeight="SemiBold"/>

                        <TextBox x:Name="EditTextTextBox"
                                 Grid.Row="1"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Paste Now" Click="EditOverlayPaste_Click" Style="{StaticResource AccentButtonStyle}"/>
                            <Button Content="Save &amp; Copy" Click="EditOverlaySaveCopy_Click"/>
                            <Button Content="Cancel" Click="EditOverlayCancel_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Save Snippet Overlay -->
                <Grid x:Name="SaveSnippetOverlay"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      Visibility="Collapsed"
                      Padding="16">
                    <StackPanel VerticalAlignment="Center" Spacing="12">
                        <TextBlock Text="Save as Snippet" FontSize="15" FontWeight="SemiBold"/>
                        <TextBox x:Name="SnippetTitleTextBox" Header="Title" PlaceholderText="e.g. Greeting or SQL Template"/>
                        <TextBox x:Name="SnippetAbbrevTextBox" Header="Abbreviation (optional)" PlaceholderText="e.g. /greet"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Save Snippet" Click="SaveSnippetConfirm_Click" Style="{StaticResource AccentButtonStyle}"/>
                            <Button Content="Cancel" Click="SaveSnippetCancel_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Windows Hello Lock Overlay -->
                <Grid x:Name="HelloLockOverlay"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="320">
                        <FontIcon Glyph="&#xE8D7;" FontSize="44" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Clipboard Locked" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Windows Hello authentication is required to access your clipboard history."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                        <Button x:Name="HelloUnlockButton"
                                Content="Unlock with Windows Hello"
                                Click="HelloUnlock_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0"/>
                        <TextBlock x:Name="HelloErrorText"
                                   Text=""
                                   FontSize="11"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
