<Page
    x:Class="AppLock.Views.BrightnessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:AppLock.Views.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <!-- String empty to collapsed converter -->
            <x:String x:Key="EmptyString"></x:String>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back Button and Breadcrumb -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Others" 
                           FontSize="14" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="›" 
                           FontSize="14" 
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Brightness" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Page Header -->
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="Brightness" 
                       FontSize="28" 
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Control screen brightness with shortcuts and a blur overlay" 
                       FontSize="14" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8" MaxWidth="800">

                <!-- InfoBar for software dimming -->
                <InfoBar x:Name="SoftwareDimmingInfo"
                         Severity="Informational"
                         IsOpen="False"
                         Title="Using software dimming"
                         Message="This display doesn't support hardware brightness control. A dark overlay will be used instead."
                         IsClosable="True"
                         Margin="0,0,0,8"/>
                
                <!-- Current Brightness Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <!-- Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="Brightness" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            
                            <TextBlock Grid.Column="1"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}">
                                <Run Text="{Binding CurrentBrightness, Mode=OneWay}"/><Run Text="%"/>
                            </TextBlock>
                        </Grid>

                        <!-- Slider -->
                        <Slider Minimum="0" 
                                Maximum="100" 
                                Value="{Binding CurrentBrightness, Mode=TwoWay}"
                                StepFrequency="1"
                                TickFrequency="10"
                                TickPlacement="Outside"
                                HorizontalAlignment="Stretch"/>

                        <!-- Display Selector -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0"
                                       Text="Display"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Displays}"
                                      SelectedValue="{Binding SelectedDisplayId, Mode=TwoWay}"
                                      SelectedValuePath="Id"
                                      HorizontalAlignment="Stretch"
                                      MinWidth="300">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            
                                            <!-- Control Method Chip -->
                                            <Border Grid.Column="1"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="8,3"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ControlMethod}"
                                                           FontSize="11"
                                                           FontWeight="Medium"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Keyboard Shortcuts Expander -->
                <Expander Header="Keyboard Shortcuts"
                          IsExpanded="True"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <Expander.Content>
                        <StackPanel Spacing="16">
                            <!-- Master Toggle for Brightness Hotkeys -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Enable Brightness Hotkeys"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="When disabled, all brightness hotkeys will be ignored"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <ToggleSwitch Grid.Column="1"
                                              x:Name="BrightnessHotkeysToggle"
                                              OnContent="Enabled"
                                              OffContent="Disabled"
                                              Toggled="BrightnessHotkeysToggle_Toggled"
                                              VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Separator -->
                            <Border Height="1" 
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            
                            <!-- Presets List -->
                            <ItemsControl ItemsSource="{Binding Presets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="12,8">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Percent NumberBox -->
                                                <NumberBox Grid.Column="0"
                                                           Value="{Binding Percent, Mode=TwoWay}"
                                                           Minimum="0"
                                                           Maximum="100"
                                                           SpinButtonPlacementMode="Inline"
                                                           MinWidth="100"
                                                           VerticalAlignment="Center"
                                                           Header="Brightness %"/>

                                                <!-- Hotkey Display -->
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="8"
                                                            VerticalAlignment="Center"
                                                            Margin="0,22,0,0">
                                                    <TextBlock Text="Shortcut:"
                                                               FontSize="13"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding HotkeyDisplay}"
                                                               FontSize="13"
                                                               FontWeight="Medium"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Edit Button -->
                                                <Button Grid.Column="2"
                                                        Content="Edit"
                                                        Click="EditHotkey_Click"
                                                        Tag="{Binding}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,22,0,0"/>

                                                <!-- Delete Button -->
                                                <Button Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        Margin="0,22,0,0"
                                                        Click="DeletePreset_Click"
                                                        Tag="{Binding}">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Footer Buttons -->
                            <Grid ColumnSpacing="8" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Add Preset"
                                        Click="AddPreset_Click"
                                        HorizontalAlignment="Left"/>

                                <Button Grid.Column="1"
                                        Content="Reset to Defaults"
                                        Click="ResetDefaults_Click"
                                        HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!-- General Options -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="General Options"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <!-- Show OSD -->
                        <CheckBox x:Name="ShowOsdCheckBox"
                                  Content="Show on-screen display when brightness changes"
                                  IsChecked="True"
                                  Checked="ShowOsd_Changed"
                                  Unchecked="ShowOsd_Changed"/>

                        <!-- Press again restores previous -->
                        <CheckBox x:Name="PressAgainCheckBox"
                                  Content="Pressing a preset's shortcut again returns to the previous brightness"
                                  IsChecked="False"
                                  Checked="PressAgain_Changed"
                                  Unchecked="PressAgain_Changed"/>

                        <!-- Restore on exit -->
                        <CheckBox x:Name="RestoreOnExitCheckBox"
                                  Content="Restore the original brightness when AppLock exits"
                                  IsChecked="False"
                                  Checked="RestoreOnExit_Changed"
                                  Unchecked="RestoreOnExit_Changed"/>

                        <!-- Remember brightness -->
                        <CheckBox x:Name="RememberBrightnessCheckBox"
                                  Content="Remember brightness and apply at startup"
                                  IsChecked="False"
                                  Checked="RememberBrightness_Changed"
                                  Unchecked="RememberBrightness_Changed"/>

                        <!-- Minimum software dimming brightness -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Minimum software dimming brightness (prevents unreadable screen)"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <NumberBox x:Name="MinBrightnessNumberBox"
                                       Value="10"
                                       Minimum="0"
                                       Maximum="50"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="MinBrightness_Changed"
                                       MinWidth="120"
                                       HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Reset Display button -->
                        <Button Content="Reset Display (Ctrl+Alt+Shift+R)"
                                Click="ResetDisplay_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Blur Overlay Expander -->
                <Expander Header="Blur Overlay"
                          IsExpanded="True"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <Expander.Content>
                        <StackPanel Spacing="16">
                            <!-- Toggle Switch and Hotkey -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Blur Overlay Hotkey"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Hotkey:"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="BlurHotkeyText"
                                                   Text="Ctrl+Shift+B"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="Change"
                                                FontSize="11"
                                                Padding="8,4"
                                                Click="ChangeBlurHotkey_Click"
                                                VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <ToggleSwitch Grid.Column="1"
                                              x:Name="BlurHotkeyToggle"
                                              OnContent="Enabled"
                                              OffContent="Disabled"
                                              Toggled="BlurHotkeyToggle_Toggled"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Blur Level Slider -->
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Blur Level"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               x:Name="BlurLevelText"
                                               Text="0%"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                </Grid>
                                <Slider x:Name="BlurLevelSlider"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="0"
                                        StepFrequency="1"
                                        TickFrequency="10"
                                        TickPlacement="Outside"
                                        ValueChanged="BlurLevel_Changed"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <!-- Dim Amount Slider -->
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Dim Amount"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               x:Name="DimAmountText"
                                               Text="0%"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                </Grid>
                                <Slider x:Name="DimAmountSlider"
                                        Minimum="0"
                                        Maximum="60"
                                        Value="0"
                                        StepFrequency="5"
                                        ValueChanged="DimAmount_Changed"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <!-- Live Preview -->
                            <controls:ScreenBlurPreview x:Name="BlurPreview" 
                                                       Margin="0,8,0,0"/>

                            <!-- Info Note -->
                            <Border Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
                                    BorderBrush="{ThemeResource InfoBarInformationalSeverityIconBackground}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Note:"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="The blur overlay is click-through and can be toggled using the hotkey (Ctrl+Shift+B by default). Enable/disable the hotkey using the toggle switch above."
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Overlay Options -->
                            <StackPanel Spacing="12" Margin="0,8,0,0">
                                <TextBlock Text="Overlay Options"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <!-- Keep on after restart -->
                                <CheckBox x:Name="KeepOnAfterRestartCheckBox"
                                          Content="Keep overlay on after restarting AppLock"
                                          IsChecked="False"
                                          Checked="KeepOnAfterRestart_Changed"
                                          Unchecked="KeepOnAfterRestart_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!-- Hotkey Diagnostics Expander -->
                <Expander Header="Hotkey Diagnostics"
                          IsExpanded="False"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <Expander.Content>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Registered Hotkeys"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                            <!-- Diagnostics Info -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Brightness Hotkeys:"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DiagnosticsText"
                                               FontSize="11"
                                               FontFamily="Consolas"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Button Content="Refresh Diagnostics"
                                    Click="RefreshDiagnostics_Click"
                                    HorizontalAlignment="Left"/>

                            <Border Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
                                    BorderBrush="{ThemeResource InfoBarInformationalSeverityIconBackground}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="12">
                                <TextBlock Text="Hotkeys are registered when this page is open. If a hotkey fails to register, it may be in use by another application."
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!-- Placeholder for more settings -->
                <TextBlock Text="More settings coming in next milestones..."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Margin="16,16,16,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
