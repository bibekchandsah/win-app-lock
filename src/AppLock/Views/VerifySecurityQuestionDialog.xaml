<ContentDialog
    x:Class="AppLock.Views.VerifySecurityQuestionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Verify identity"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">


    <StackPanel Spacing="16" MinWidth="340">
        <TextBlock x:Name="QuestionTextBlock"
                   FontWeight="SemiBold"
                   FontSize="15"
                   TextWrapping="Wrap"/>

        <TextBox x:Name="AnswerBox"
                 CornerRadius="4"
                 PlaceholderText="Enter your answer"
                 KeyDown="AnswerBox_KeyDown"/>

        <TextBlock x:Name="ErrorText"
                   Foreground="{ThemeResource SystemErrorTextColor}"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>
