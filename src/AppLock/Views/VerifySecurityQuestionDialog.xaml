<ContentDialog
    x:Class="AppLock.Views.VerifySecurityQuestionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Verify identity"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" MinWidth="340">
        <TextBlock x:Name="QuestionTextBlock"
                   FontWeight="SemiBold"
                   FontSize="15"
                   TextWrapping="Wrap"/>

        <TextBox x:Name="AnswerBox"
                 CornerRadius="4"
                 PlaceholderText="Enter your answer"
                 KeyDown="AnswerBox_KeyDown"/>

        <TextBlock x:Name="ErrorText"
                   Foreground="{ThemeResource SystemErrorTextColor}"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>
