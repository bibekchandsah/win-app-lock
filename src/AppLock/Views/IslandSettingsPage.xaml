<Page
    x:Class="AppLock.Views.IslandSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Island" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="A notch at the top of the screen: the clock and battery while idle, quick controls when you hover it."
                TextWrapping="Wrap"
                Opacity="0.7" />

            <ToggleSwitch
                x:Name="EnabledToggle"
                Header="Show the island"
                Toggled="OnSettingChanged" />

            <ToggleSwitch
                x:Name="HardwareAccelerationToggle"
                Header="Hardware acceleration"
                OnContent="On"
                OffContent="Off"
                Toggled="OnSettingChanged" />
            <TextBlock
                Text="Turn this off only if the island flickers or the GPU is busy. Takes effect the next time AppLock starts."
                TextWrapping="Wrap"
                FontSize="12"
                Opacity="0.6" />

            <ComboBox x:Name="PositionBox" Header="Position" SelectionChanged="OnSelectionChanged" Width="240">
                <ComboBoxItem Content="Top center" Tag="TopCenter" />
                <ComboBoxItem Content="Top left" Tag="TopLeft" />
                <ComboBoxItem Content="Top right" Tag="TopRight" />
            </ComboBox>

            <ComboBox x:Name="ShapeBox" Header="Shape" SelectionChanged="OnSelectionChanged" Width="240">
                <ComboBoxItem Content="Notch" Tag="Notch" />
                <ComboBoxItem Content="Capsule" Tag="Capsule" />
            </ComboBox>

            <ComboBox x:Name="ThemeBox" Header="Theme" SelectionChanged="OnSelectionChanged" Width="240">
                <ComboBoxItem Content="System default" Tag="System" />
                <ComboBoxItem Content="Light" Tag="Light" />
                <ComboBoxItem Content="Dark" Tag="Dark" />
            </ComboBox>

            <Slider
                x:Name="SizeSlider"
                Header="Size"
                Minimum="70"
                Maximum="150"
                StepFrequency="10"
                TickFrequency="10"
                Width="320"
                ValueChanged="OnSliderChanged" />

            <Slider
                x:Name="OpacitySlider"
                Header="Opacity"
                Minimum="40"
                Maximum="100"
                StepFrequency="5"
                TickFrequency="5"
                Width="320"
                ValueChanged="OnSliderChanged" />

            <TextBox
                x:Name="HotkeyBox"
                Header="Show/hide hotkey"
                PlaceholderText="Ctrl+Alt+I"
                Width="240"
                LostFocus="OnHotkeyChanged" />

            <ToggleSwitch
                x:Name="ClockToggle"
                Header="Show the clock"
                Toggled="OnSettingChanged" />

            <ToggleSwitch
                x:Name="BatteryToggle"
                Header="Show the battery"
                Toggled="OnSettingChanged" />

            <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.6" />
        </StackPanel>
    </ScrollViewer>
</Page>
