<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AppLock.Views.ConnectionToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Connection alert">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="ToastSurfaceBrush" Color="#F21F1F1F"/>
                        <SolidColorBrush x:Key="ToastStrokeBrush" Color="#33FFFFFF"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="ToastSurfaceBrush" Color="#F2FAFAFA"/>
                        <SolidColorBrush x:Key="ToastStrokeBrush" Color="#22000000"/>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Border x:Name="Card"
                Background="{ThemeResource ToastSurfaceBrush}"
                BorderBrush="{ThemeResource ToastStrokeBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <FontIcon x:Name="StatusIcon"
                          Grid.Column="0"
                          Glyph="&#xE783;"
                          FontSize="20"
                          VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="Connection lost"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubtitleText"
                               Text=""
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Click="CloseButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6"
                        CornerRadius="4"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Dismiss">
                    <FontIcon Glyph="&#xE711;" FontSize="10"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
