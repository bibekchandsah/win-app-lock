<Page
    x:Class="AppLock.Views.ProtectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AppLock.Models"
    xmlns:local="using:AppLock.Views"
    mc:Ignorable="d"
    Background="Transparent">
    
    <Page.Resources>
        <local:FirstLetterConverter x:Key="FirstLetterConverter"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <local:LockGlyphConverter x:Key="LockGlyphConverter"/>
        <local:LockTextConverter x:Key="LockTextConverter"/>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status Card -->
        <Border Grid.Row="0" 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="LimeGreen"/>
                    <TextBlock x:Name="StatusText" 
                               Text="AppLock protection is ready" 
                               VerticalAlignment="Center"
                               FontSize="15"/>
                </StackPanel>

                <!-- Master Toggle -->
                <ToggleSwitch x:Name="MasterToggle" 
                              Grid.Column="2"
                              OnContent="Protection ON" 
                              OffContent="Protection OFF"
                              IsOn="False"
                              Toggled="MasterToggle_Toggled"
                              VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabView Grid.Row="1" 
                 x:Name="MainTabView"
                 SelectionChanged="MainTabView_SelectionChanged"
                 CanDragTabs="False"
                 CanReorderTabs="False"
                 TabWidthMode="Equal">
            
            <!-- Running Programs Tab -->
            <TabView.TabItems>
                <TabViewItem Header="Running programs" IsClosable="False">
                    <Grid Padding="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search and Controls -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="SearchBox" 
                                     Grid.Column="0"
                                     PlaceholderText="Search programs..." 
                                     Text="{x:Bind RunningViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0"/>

                            <Border Grid.Column="1"
                                    Background="{ThemeResource SystemAccentColorLight1}"
                                    CornerRadius="10"
                                    Padding="8,4"
                                    MinWidth="30"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                                <TextBlock Text="{x:Bind RunningViewModel.RunningCount, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <Button Grid.Column="2" 
                                    Command="{x:Bind RunningViewModel.RefreshWindowsCommand}"
                                    Margin="0,0,8,0"
                                    MinWidth="90">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                    <TextBlock Text="Refresh"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3" 
                                    Command="{x:Bind RunningViewModel.PickWindowCommand}"
                                    MinWidth="140">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7C4;" FontSize="14"/>
                                    <TextBlock Text="Pick a window"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Programs List -->
                        <Border Grid.Row="1" 
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ListView x:Name="RunningProgramsList"
                                      ItemsSource="{x:Bind RunningViewModel.FilteredWindows, Mode=OneWay}"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:RunningWindow">
                                        <Grid Padding="12,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon or First Letter -->
                                            <Grid Grid.Column="0" 
                                                  Width="32" Height="32">
                                                <!-- First letter fallback -->
                                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="4">
                                                    <TextBlock Text="{x:Bind ProcessName, Converter={StaticResource FirstLetterConverter}}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="White"/>
                                                </Border>
                                                <!-- Icon overlay (if available) -->
                                                <Image x:Name="AppIcon"
                                                       Source="{x:Bind Icon, Mode=OneWay}"
                                                       Stretch="UniformToFill"/>
                                            </Grid>

                                            <!-- Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind WindowTitle}" 
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind ProcessName}" 
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>

                                            <!-- Lock Button -->
                                            <Button Grid.Column="2"
                                                    x:Name="LockBtn"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    Click="LockButton_Click"
                                                    Tag="{x:Bind}"
                                                    IsEnabled="{x:Bind IsLocked, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                                    Padding="8,6"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon x:Name="LockIcon" 
                                                              Glyph="{x:Bind IsLocked, Mode=OneWay, Converter={StaticResource LockGlyphConverter}}" 
                                                              FontSize="14"/>
                                                    <TextBlock x:Name="LockText" 
                                                               Text="{x:Bind IsLocked, Mode=OneWay, Converter={StaticResource LockTextConverter}}"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Border>
                    </Grid>
                </TabViewItem>

                <!-- Locked Programs Tab -->
                <TabViewItem Header="Locked programs" IsClosable="False">
                    <Grid Padding="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search and Count -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="LockedSearchBox" 
                                     Grid.Column="0"
                                     PlaceholderText="Search locked programs..." 
                                     Text="{x:Bind LockedViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0"/>

                            <Border Grid.Column="1"
                                    Background="{ThemeResource SystemAccentColorLight1}"
                                    CornerRadius="10"
                                    Padding="8,4"
                                    MinWidth="30"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind LockedViewModel.LockedCount, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ListView x:Name="LockedProgramsList"
                                      ItemsSource="{x:Bind LockedViewModel.FilteredRules, Mode=OneWay}"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:LockRule">
                                        <Grid Padding="12,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DisplayName}" 
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Type}" 
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" 
                                                    Click="UnlockButton_Click"
                                                    Tag="{x:Bind}"
                                                    Padding="8,6"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE785;" FontSize="14"/>
                                                    <TextBlock Text="Unlock"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Border>
                    </Grid>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>
    </Grid>
</Page>
