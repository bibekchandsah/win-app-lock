<UserControl
    x:Class="AppLock.Views.Controls.SpeedWidgetControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" Background="Transparent"
          AutomationProperties.Name="Speed meter widget"
          PointerEntered="Root_PointerEntered"
          PointerExited="Root_PointerExited">
        <Border x:Name="Card"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="14"
                BorderThickness="0"
                Padding="14,8">
            <StackPanel x:Name="CardStack" Spacing="5">
                <StackPanel x:Name="Row" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                    <!-- Download -->
                    <StackPanel x:Name="DownBlock" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="DownLabel"
                                   Text="DL"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Visibility="Collapsed"
                                   VerticalAlignment="Center"/>
                        <FontIcon x:Name="DownIcon"
                                  Glyph="&#xE896;"
                                  FontSize="12"
                                  VerticalAlignment="Center"/>
                        <TextBlock x:Name="DownText"
                                   AutomationProperties.Name="Download speed"
                                   Text="0 B/s"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Upload -->
                    <StackPanel x:Name="UpBlock" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="UpLabel"
                                   Text="UL"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Visibility="Collapsed"
                                   VerticalAlignment="Center"/>
                        <FontIcon x:Name="UpIcon"
                                  Glyph="&#xE898;"
                                  FontSize="12"
                                  VerticalAlignment="Center"/>
                        <TextBlock x:Name="UpText"
                                   AutomationProperties.Name="Upload speed"
                                   Text="0 B/s"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Date and time under the speeds; the layout follows the speeds' orientation -->
                <StackPanel x:Name="ClockPanel"
                            AutomationProperties.Name="Date and time"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="ClockDateText"
                               FontSize="11"
                               Opacity="0.75"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ClockTimeText"
                               FontSize="12"
                               Opacity="0.9"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Hairline between the speed header and everything below it -->
                <Border x:Name="HeaderDivider"
                        Height="1"
                        HorizontalAlignment="Stretch"
                        Visibility="Collapsed"/>

                <!-- Mini sparkline (off by default) -->
                <Canvas x:Name="SparkCanvas" Height="22" Visibility="Collapsed">
                    <Polyline x:Name="DownSpark" StrokeThickness="1.5"/>
                    <Polyline x:Name="UpSpark" StrokeThickness="1.5"/>
                </Canvas>

                <!-- Top app lines: one line per enabled metric (off by default) -->
                <StackPanel x:Name="TopAppsPanel"
                            AutomationProperties.Name="Top apps"
                            Spacing="1"
                            Opacity="0.85"
                            Visibility="Collapsed"/>

                <!-- Status badges: metered connection and VPN adapter -->
                <StackPanel x:Name="BadgesPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="MeteredBadge"
                               AutomationProperties.Name="Metered connection"
                               Text="metered"
                               FontSize="9"
                               Opacity="0.75"
                               Visibility="Collapsed"/>
                    <StackPanel x:Name="VpnBadge" Orientation="Horizontal" Spacing="3" Visibility="Collapsed"
                                AutomationProperties.Name="VPN connection">
                        <FontIcon Glyph="&#xE72E;" FontSize="9" Opacity="0.75"/>
                        <TextBlock Text="VPN" FontSize="9" Opacity="0.75"/>
                    </StackPanel>
                </StackPanel>

                <!-- CPU / RAM / disk / GPU / battery rows, built in code -->
                <StackPanel x:Name="ExtraPanel" Spacing="2" Visibility="Collapsed" AutomationProperties.Name="Additional stats"/>

                <!-- ── Carousel: top-N process list for one metric ── -->
                <!-- Shown when the user clicks the nav pill chevron   -->
                <StackPanel x:Name="CarouselPanel"
                            Spacing="2"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Top processes carousel"/>

                <!-- ── Nav pill: appears on hover when carousel metrics are enabled ── -->
                <!-- The pill sits at the bottom of the card; chevrons cycle the view  -->
                <Border x:Name="NavPill"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        CornerRadius="8"
                        Padding="6,2"
                        Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="NavPrevBtn"
                                Content="&#xE76B;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="9"
                                Padding="4,2"
                                MinWidth="0" MinHeight="0"
                                Click="NavPrevBtn_Click"
                                AutomationProperties.Name="Previous metric"/>
                        <TextBlock x:Name="NavLabel"
                                   FontSize="9"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   MinWidth="28"
                                   TextAlignment="Center"
                                   Opacity="0.85"/>
                        <Button x:Name="NavNextBtn"
                                Content="&#xE76C;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="9"
                                Padding="4,2"
                                MinWidth="0" MinHeight="0"
                                Click="NavNextBtn_Click"
                                AutomationProperties.Name="Next metric"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
