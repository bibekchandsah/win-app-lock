<UserControl
    x:Class="AppLock.Views.Controls.UsageBarChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Labels and neutral marks are styled so their brushes follow the theme; a brush read in
         code from Application.Resources would stay in the theme it was read in. -->
    <UserControl.Resources>
        <Style x:Key="ChartAxisLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ChartNeutralBar" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
            <Setter Property="CornerRadius" Value="1"/>
        </Style>
        <Style x:Key="ChartWarningBar" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBrush}"/>
            <Setter Property="CornerRadius" Value="1"/>
        </Style>
        <Style x:Key="ChartAverageLine" TargetType="Line">
            <Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeDashArray" Value="4,4"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="ChartRoot" MinHeight="140" SizeChanged="ChartRoot_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AxisPanel"
              Grid.Column="0"
              Margin="0,0,6,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="AxisTop" FontSize="10"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Right"/>
            <TextBlock x:Name="AxisMiddle" Grid.Row="1" FontSize="10"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="0" FontSize="10"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Right"/>
        </Grid>

        <Grid x:Name="PlotHost" Grid.Column="1"/>
        <Canvas x:Name="Overlay" Grid.Column="1" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
