<UserControl
    x:Class="AppLock.Views.Controls.UsageBarChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="ChartRoot" MinHeight="140" SizeChanged="ChartRoot_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AxisPanel"
              Grid.Column="0"
              Margin="0,0,6,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="AxisTop" FontSize="10"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Right"/>
            <TextBlock x:Name="AxisMiddle" Grid.Row="1" FontSize="10"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="0" FontSize="10"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Right"/>
        </Grid>

        <Grid x:Name="PlotHost" Grid.Column="1"/>
        <Canvas x:Name="Overlay" Grid.Column="1" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
