<UserControl
    x:Class="AppLock.Views.Controls.ScreenBlurPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="Live Preview"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,8"/>

            <!-- Canvas Preview -->
            <Border Grid.Row="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="4"
                    MinHeight="200"
                    MaxHeight="300">
                <Grid>
                    <!-- Win2D Canvas -->
                    <canvas:CanvasControl x:Name="PreviewCanvas"
                                         Draw="PreviewCanvas_Draw"
                                         CreateResources="PreviewCanvas_CreateResources"
                                         Loaded="PreviewCanvas_Loaded"
                                         Unloaded="PreviewCanvas_Unloaded"/>

                    <!-- Fallback message -->
                    <Border x:Name="FallbackPanel"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Spacing="8">
                            <FontIcon Glyph="&#xE8B7;"
                                     FontSize="32"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="FallbackText"
                                      Text="Preview unavailable"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Loading indicator -->
                    <ProgressRing x:Name="LoadingRing"
                                 Width="40"
                                 Height="40"
                                 IsActive="True"
                                 Visibility="Visible"/>
                </Grid>
            </Border>

            <!-- Footer info -->
            <TextBlock Grid.Row="2"
                       x:Name="InfoText"
                       Text="Preview shows your desktop wallpaper with blur effect. Adjust the slider to see blur intensity changes."
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
        </Grid>
    </Border>
</UserControl>
