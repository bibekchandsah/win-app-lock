<UserControl
    x:Class="AppLock.Views.Controls.ClipboardCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="12">
        <!-- Enable / Disable Toggle -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Clipboard History"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="StatusText"
                           Text="Disabled"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <ToggleSwitch Grid.Column="1"
                          x:Name="EnableToggle"
                          Toggled="EnableToggle_Toggled"
                          MinWidth="0"
                          OffContent=""
                          OnContent=""/>
        </Grid>

        <!-- Stats: Item count & Storage used -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4"
                    Padding="8,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="Items" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="ItemCountText" Text="0 / 100" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4"
                    Padding="8,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="Storage" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="StorageText" Text="0 KB" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Action Buttons -->
        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Open history -->
            <Button Grid.Column="0"
                    x:Name="OpenHistoryButton"
                    Click="OpenHistoryButton_Click"
                    HorizontalAlignment="Stretch"
                    ToolTipService.ToolTip="Open clipboard history popup">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE81C;" FontSize="12"/>
                    <TextBlock Text="Open" FontSize="12"/>
                </StackPanel>
            </Button>

            <!-- Pause -->
            <DropDownButton Grid.Column="1"
                            x:Name="PauseButton"
                            ToolTipService.ToolTip="Pause capturing">
                <DropDownButton.Content>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE769;" FontSize="12"/>
                        <TextBlock Text="Pause" FontSize="12"/>
                    </StackPanel>
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="5 minutes" Click="Pause5_Click"/>
                        <MenuFlyoutItem Text="15 minutes" Click="Pause15_Click"/>
                        <MenuFlyoutItem Text="1 hour" Click="Pause60_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Until resumed" Click="PauseIndefinite_Click"/>
                        <MenuFlyoutItem Text="Resume now" Click="Resume_Click" x:Name="ResumeItem"/>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!-- Settings -->
            <Button Grid.Column="2"
                    x:Name="SettingsButton"
                    Click="SettingsButton_Click"
                    ToolTipService.ToolTip="Clipboard settings">
                <FontIcon Glyph="&#xE713;" FontSize="12"/>
            </Button>
        </Grid>

        <!-- Milestone 1 Debug Button -->
        <Button x:Name="DebugAddItemsButton"
                Click="DebugAddItemsButton_Click"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                ToolTipService.ToolTip="Milestone 1 preview: adds 5 test items to SQLite store">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                <TextBlock Text="Add 5 test items (Debug)" FontSize="11"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>

