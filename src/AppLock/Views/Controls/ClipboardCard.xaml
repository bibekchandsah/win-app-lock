<UserControl
    x:Class="AppLock.Views.Controls.ClipboardCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Enable / Disable Toggle Only -->
    <Grid Margin="0,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Clipboard History"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Border x:Name="CardPauseBadge"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,1"
                    Visibility="Collapsed"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE769;" FontSize="9" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <TextBlock x:Name="CardPauseText" Text="Paused" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <ToggleSwitch Grid.Column="1"
                      x:Name="EnableToggle"
                      Toggled="EnableToggle_Toggled"
                      MinWidth="0"
                      OffContent=""
                      OnContent=""/>
    </Grid>
</UserControl>

