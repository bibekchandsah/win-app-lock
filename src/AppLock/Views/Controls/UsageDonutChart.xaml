<UserControl
    x:Class="AppLock.Views.Controls.UsageDonutChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" MinHeight="120" MinWidth="120">
        <Canvas x:Name="SliceHost" IsHitTestVisible="False"/>
        <!-- The ring is stroked, so its middle is naturally empty; painting a hole here would
             show a second translucent layer over the card. -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="0"
                    IsHitTestVisible="False">
            <TextBlock x:Name="CenterValue"
                       Text="0m"
                       FontSize="17"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="CenterLabel"
                       Text="screen time"
                       FontSize="10"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
