<UserControl
    x:Class="AppLock.Views.Controls.EyeCareCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="800"
    MaxWidth="800">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="20">
        <StackPanel Spacing="16">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <FontIcon Grid.Column="0" 
                          Glyph="&#xE7B3;" 
                          FontSize="24"
                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Eye Care Reminder" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Periodic reminders to rest your eyes" 
                               FontSize="13" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                
                <ToggleSwitch Grid.Column="2"
                              IsOn="{Binding Enabled, Mode=TwoWay}"
                              OnContent="Enabled"
                              OffContent="Disabled"
                              MinWidth="0"/>
            </Grid>

            <!-- Separator -->
            <Border Height="1" 
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" 
                    Margin="0,8,0,8"/>

            <!-- Reminder Interval -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                           Text="Reminder Interval" 
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <DropDownButton x:Name="IntervalDropDown" MinWidth="140">
                        <DropDownButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="IntervalText" Text="20 minutes"/>
                                <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                            </StackPanel>
                        </DropDownButton.Content>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <ToggleMenuFlyoutItem Text="1 minute" Click="Interval1_Click" x:Name="Interval1Item"/>
                                <ToggleMenuFlyoutItem Text="20 minutes" Click="Interval20_Click" x:Name="Interval20Item" IsChecked="True"/>
                                <ToggleMenuFlyoutItem Text="25 minutes" Click="Interval25_Click" x:Name="Interval25Item"/>
                                <ToggleMenuFlyoutItem Text="30 minutes" Click="Interval30_Click" x:Name="Interval30Item"/>
                                <ToggleMenuFlyoutItem Text="60 minutes" Click="Interval60_Click" x:Name="Interval60Item"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Custom..." Click="IntervalCustom_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    
                    <TextBlock x:Name="CustomIntervalHint"
                               Text="(Custom interval active)"
                               FontSize="12"
                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- Reminder Message -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" 
                           Text="Reminder Message" 
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,8"/>
                
                <TextBox Grid.Row="1"
                         Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Leave empty for default message"
                         MaxLength="200"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"/>
            </Grid>

            <!-- Schedule -->
            <StackPanel Spacing="12">
                <CheckBox Content="Enable schedule" 
                          IsChecked="{Binding ScheduleEnabled, Mode=TwoWay}"
                          FontSize="14"/>
                
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                               Text="Start time" 
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    
                    <TimePicker Grid.Column="1"
                                Time="{Binding StartTime, Mode=TwoWay}"
                                ClockIdentifier="24HourClock"
                                MinuteIncrement="15"
                                IsEnabled="{Binding ScheduleEnabled}"/>
                    
                    <TextBlock Grid.Column="2" 
                               Text="End time" 
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    
                    <TimePicker Grid.Column="3"
                                Time="{Binding EndTime, Mode=TwoWay}"
                                ClockIdentifier="24HourClock"
                                MinuteIncrement="15"
                                IsEnabled="{Binding ScheduleEnabled}"/>
                </Grid>
                
                <TextBlock Text="24-hour format. Reminders only fire during this window."
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,-8,0,0"/>
            </StackPanel>

            <!-- Duration -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                           Text="Overlay Duration (s)" 
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                
                <NumberBox Grid.Column="1"
                           Value="{Binding Duration, Mode=TwoWay}"
                           Minimum="5"
                           Maximum="300"
                           SpinButtonPlacementMode="Inline"
                           MinWidth="120"
                           HorizontalAlignment="Left"/>
            </Grid>

            <!-- Overlay Template -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" 
                           Text="Overlay Template" 
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,8"/>
                
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AvailableTemplates}"
                              SelectedIndex="{Binding SelectedTemplateIndex, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>
                    
                    <Button Grid.Column="1" 
                            Content="Browse..." 
                            Click="BrowseTemplate_Click"/>
                    
                    <Button Grid.Column="2" 
                            Content="Open folder" 
                            Click="OpenTemplatesFolder_Click"/>
                </Grid>
            </Grid>

            <!-- Preview Button -->
            <Button Click="Preview_Click"
                    HorizontalAlignment="Left"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="16"/>
                    <TextBlock Text="Preview" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Info -->
            <InfoBar Severity="Informational"
                     IsOpen="True"
                     IsClosable="False"
                     Message="Custom templates support {{REMINDER_MESSAGE}} and {{DURATION}} placeholders. Press Esc or right-click to close the overlay."/>
        </StackPanel>
    </Border>
</UserControl>
