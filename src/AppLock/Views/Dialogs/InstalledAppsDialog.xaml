<ContentDialog
    x:Class="AppLock.Views.Dialogs.InstalledAppsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AppLock.ViewModels"
    xmlns:local="using:AppLock.Views"
    Title="Add from installed apps"
    PrimaryButtonText="Add selected"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">

    <ContentDialog.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </ContentDialog.Resources>

    <Grid RowSpacing="12" MinWidth="600" MinHeight="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search box -->
        <AutoSuggestBox
            Grid.Row="0"
            PlaceholderText="Search installed apps..."
            QueryIcon="Find"
            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Margin="0,0,0,8"/>

        <!-- Apps list -->
        <ListView
            x:Name="AppsList"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.FilteredApps, Mode=OneWay}"
            SelectionMode="Multiple"
            SelectionChanged="AppsList_SelectionChanged"
            Loaded="AppsList_Loaded">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:InstalledAppViewModel">
                    <Grid ColumnSpacing="12" Padding="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon with fallback -->
                        <Grid Grid.Column="0" Width="32" Height="32">
                            <!-- Fallback icon (shown when no icon loaded) -->
                            <Border
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4"
                                Visibility="{x:Bind Icon, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                                <FontIcon
                                    Glyph="&#xE8A7;"
                                    FontSize="16"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>
                            <!-- Actual icon (shown when loaded) -->
                            <Image
                                Source="{x:Bind Icon, Mode=OneWay}"
                                Width="32"
                                Height="32"
                                Stretch="Uniform"
                                Visibility="{x:Bind Icon, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </Grid>

                        <!-- Name and path -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock
                                Text="{x:Bind DisplayName}"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock
                                Text="{x:Bind PathOrPackage}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Text="{x:Bind Publisher}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="{x:Bind HasPublisher, Mode=OneWay}"/>
                        </StackPanel>

                        <!-- Type badge -->
                        <Border
                            Grid.Column="2"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="8,4"
                            Visibility="{x:Bind IsUwpVisible, Mode=OneWay}">
                            <TextBlock
                                Text="Store"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
            <ProgressRing
                Width="16"
                Height="16"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
            <TextBlock
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                VerticalAlignment="Center"/>
            <Button
                Content="Load all icons"
                Click="LoadAllIcons_Click"
                Style="{StaticResource AccentButtonStyle}"
                Padding="16,6"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</ContentDialog>
