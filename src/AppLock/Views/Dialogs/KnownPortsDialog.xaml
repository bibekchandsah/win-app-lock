<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AppLock.Views.Dialogs.KnownPortsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AppLock.Models"
    mc:Ignorable="d"
    Title="Known &amp; Allowed Ports"
    CloseButtonText="Close"
    DefaultButton="Close">

    <Grid MinWidth="480" MaxWidth="560" MaxHeight="520" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Description -->
            <RowDefinition Height="Auto"/> <!-- Add Port Form -->
            <RowDefinition Height="*"/>    <!-- List of Ports -->
            <RowDefinition Height="Auto"/> <!-- Export/Import toolbar -->
        </Grid.RowDefinitions>

        <!-- Description -->
        <TextBlock Grid.Row="0"
                   Text="Ports in this list are considered safe and will not trigger Port Watch alerts when opened."
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"/>

        <!-- Add Port Section -->
        <Border Grid.Row="1"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10">
            <StackPanel Spacing="8">
                <TextBlock Text="Add Known Port" FontWeight="SemiBold" FontSize="12"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="AddProtocolCombo" Grid.Column="0" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="TCP"/>
                        <ComboBoxItem Content="UDP"/>
                    </ComboBox>

                    <TextBox x:Name="AddPortBox" Grid.Column="1" PlaceholderText="Port #" MaxLength="5"/>

                    <TextBox x:Name="AddAppPathBox" Grid.Column="2" PlaceholderText="App path (optional)"/>

                    <Button x:Name="AddButton" Grid.Column="3" Content="Add" Click="AddButton_Click"/>
                </Grid>
                <TextBlock x:Name="AddErrorText" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="11" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- List of Known Ports -->
        <Grid Grid.Row="2" MinHeight="160">
            <!-- Empty state -->
            <StackPanel x:Name="EmptyStatePanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="No known ports configured"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Mark your baseline ports or add trusted ports above."
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ListView -->
            <ListView x:Name="KnownPortsListView"
                      SelectionMode="None"
                      Padding="0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:KnownPort">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,6"
                                Padding="12,8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Protocol badge -->
                                    <ColumnDefinition Width="*"/>    <!-- Port & App Details -->
                                    <ColumnDefinition Width="Auto"/> <!-- Date Added -->
                                    <ColumnDefinition Width="Auto"/> <!-- Delete Button -->
                                </Grid.ColumnDefinitions>

                                <!-- Protocol -->
                                <Border Grid.Column="0"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Protocol}" FontWeight="SemiBold" FontSize="11"/>
                                </Border>

                                <!-- Port & App Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Port" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{x:Bind Port}" FontWeight="Bold" FontSize="13"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind AppPath}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Date Added -->
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind AddedDisplay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"/>

                                <!-- Delete button -->
                                <Button Grid.Column="3"
                                        Click="DeleteButton_Click"
                                        Tag="{x:Bind}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="6"
                                        ToolTipService.ToolTip="Remove known port"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Import / Export Toolbar -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="ExportJson_Click" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDE1;" FontSize="12"/>
                        <TextBlock Text="Export JSON..."/>
                    </StackPanel>
                </Button>
                <Button Click="ImportJson_Click" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B5;" FontSize="12"/>
                        <TextBlock Text="Import JSON..."/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
