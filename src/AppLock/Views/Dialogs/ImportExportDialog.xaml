<ContentDialog
    x:Class="AppLock.Views.Dialogs.ImportExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AppLock.Models"
    Title="Import Firewall Rules"
    PrimaryButtonText="Import selected"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind HasSelection, Mode=OneWay}">

    <Grid RowSpacing="12" MinWidth="600" MinHeight="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with stats -->
        <InfoBar
            Grid.Row="0"
            Severity="Informational"
            IsOpen="True"
            IsClosable="False">
            <InfoBar.Content>
                <StackPanel Spacing="4">
                    <TextBlock>
                        <Run Text="{x:Bind NewCount, Mode=OneWay}"/>
                        <Run Text="new rules,"/>
                        <Run Text="{x:Bind ConflictCount, Mode=OneWay}"/>
                        <Run Text="conflicts"/>
                    </TextBlock>
                    <TextBlock 
                        Text="Conflicts are rules for apps already in your list and will be skipped."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <!-- Rules list -->
        <ListView
            x:Name="RulesList"
            Grid.Row="1"
            SelectionMode="Multiple"
            SelectionChanged="RulesList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:NetworkRuleEntry">
                    <Grid ColumnSpacing="12" Padding="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- App info -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold"/>
                            <TextBlock 
                                Text="{x:Bind ExePath}" 
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Direction badges -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Border
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                Visibility="{x:Bind BlockOutbound}">
                                <TextBlock Text="Out" Style="{ThemeResource CaptionTextBlockStyle}"/>
                            </Border>
                            <Border
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                Visibility="{x:Bind BlockInbound}">
                                <TextBlock Text="In" Style="{ThemeResource CaptionTextBlockStyle}"/>
                            </Border>
                        </StackPanel>

                        <!-- Status -->
                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind ImportStatus, Mode=OneWay}"
                            Style="{ThemeResource CaptionTextBlockStyle}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Selection status -->
        <TextBlock
            Grid.Row="2"
            Style="{ThemeResource CaptionTextBlockStyle}">
            <Run Text="{x:Bind SelectedCount, Mode=OneWay}"/>
            <Run Text="selected"/>
        </TextBlock>
    </Grid>
</ContentDialog>
