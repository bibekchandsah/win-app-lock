<Page
    x:Class="AppLock.Views.ClipboardSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:AppLock.Views.Controls"
    xmlns:vm="using:AppLock.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back Button and Breadcrumb -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Others" 
                           FontSize="14" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="›" 
                           FontSize="14" 
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Clipboard" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Page Header -->
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Clipboard Settings" 
                       FontSize="28" 
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Configure persistent clipboard history, limits, capture rules, and privacy" 
                       FontSize="14" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Tabs -->
        <TabView Grid.Row="2"
                 x:Name="SettingsTabView"
                 CanDragTabs="False"
                 CanReorderTabs="False"
                 IsAddTabButtonVisible="False"
                 TabWidthMode="Equal">
            <TabView.TabItems>
                <!-- General Tab -->
                <TabViewItem Header="General" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE713;"/>
                    </TabViewItem.IconSource>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,16,16">
                        <StackPanel Spacing="12" MaxWidth="800" HorizontalAlignment="Left">
                            <!-- Pause / Status Banner -->
                            <Border x:Name="SettingsPauseBanner"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon x:Name="SettingsPauseIcon" Glyph="&#xE769;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                        <TextBlock x:Name="SettingsPauseText" Text="Clipboard capture is temporarily paused" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                    </StackPanel>
                                    <Button x:Name="SettingsResumeButton"
                                            Grid.Column="1"
                                            Content="Resume Now"
                                            Click="ResumeFromSettings_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Padding="12,4"
                                            FontSize="12"/>
                                </Grid>
                            </Border>

                            <!-- Enable Switch -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Enable Clipboard History" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Record copied text, images, and items across reboots" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  x:Name="EnableClipboardToggle"
                                                  Toggled="EnableClipboardToggle_Toggled"
                                                  MinWidth="0"
                                                  OffContent=""
                                                  OnContent=""/>
                                </Grid>
                            </Border>

                            <!-- History Limit -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="History Limit" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Maximum unpinned items to keep. Oldest unpinned items are trimmed first." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  x:Name="HistoryLimitCombo"
                                                  SelectionChanged="HistoryLimitCombo_SelectionChanged"
                                                  MinWidth="160"
                                                  VerticalAlignment="Center">
                                            <ComboBoxItem Content="25 items" Tag="25"/>
                                            <ComboBoxItem Content="50 items" Tag="50"/>
                                            <ComboBoxItem Content="100 items" Tag="100"/>
                                            <ComboBoxItem Content="250 items" Tag="250"/>
                                            <ComboBoxItem Content="500 items" Tag="500"/>
                                            <ComboBoxItem Content="1000 items" Tag="1000"/>
                                            <ComboBoxItem Content="Custom..." Tag="custom"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Custom Limit Box (Visible when Custom is selected) -->
                                    <Grid x:Name="CustomLimitRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Custom limit (10 to 5000):" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        <NumberBox Grid.Column="1"
                                                   x:Name="CustomLimitNumberBox"
                                                   Minimum="10"
                                                   Maximum="5000"
                                                   SpinButtonPlacementMode="Inline"
                                                   ValueChanged="CustomLimitNumberBox_ValueChanged"
                                                   MinWidth="160"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Global Hotkey -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Shortcut to Open History" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Global hotkey to display the clipboard history popup" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <controls:HotkeyRecorder x:Name="ClipboardHotkeyRecorder"
                                                                 Grid.Column="1"
                                                                 MinWidth="260"
                                                                 VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Win+V override option -->
                                    <CheckBox x:Name="OverrideWinVCheckBox"
                                              Content="Use Win + V (experimental)"
                                              Checked="OverrideWinVCheckBox_Changed"
                                              Unchecked="OverrideWinVCheckBox_Changed"/>
                                    <TextBlock Text="Windows' own clipboard history may still open on some systems. You can turn it off in Windows Settings > System > Clipboard."
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <HyperlinkButton Content="Open Windows clipboard settings"
                                                     Click="OpenWindowsClipboardSettings_Click"
                                                     Padding="0"/>
                                </StackPanel>
                            </Border>

                            <!-- Popup Position -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Popup Position" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Where the clipboard history window should appear when invoked" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              x:Name="PopupPositionCombo"
                                              SelectionChanged="PopupPositionCombo_SelectionChanged"
                                              MinWidth="160"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Content="At cursor" Tag="cursor"/>
                                        <ComboBoxItem Content="Center of screen" Tag="center"/>
                                        <ComboBoxItem Content="At caret (text cursor)" Tag="caret"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Paste Behavior -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Paste Behavior" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Automatically paste into the previous app or copy to clipboard only" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              x:Name="PasteBehaviorCombo"
                                              SelectionChanged="PasteBehaviorCombo_SelectionChanged"
                                              MinWidth="160"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Content="Auto paste (default)" Tag="auto"/>
                                        <ComboBoxItem Content="Copy only" Tag="copy"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Start with Windows -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Start with Windows" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Run clipboard engine automatically when your computer starts" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  x:Name="StartWithWindowsToggle"
                                                  Toggled="StartWithWindowsToggle_Toggled"
                                                  MinWidth="0"
                                                  OffContent=""
                                                  OnContent=""/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- Capture Tab -->
                <TabViewItem Header="Capture" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE8C8;"/>
                    </TabViewItem.IconSource>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,16,16">
                        <StackPanel Spacing="12" MaxWidth="800" HorizontalAlignment="Left">
                            <!-- Capture Text -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Capture Text" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Save copied text snippets and plain text" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  x:Name="CaptureTextToggle"
                                                  Toggled="CaptureToggle_Toggled"
                                                  MinWidth="0"
                                                  OffContent=""
                                                  OnContent=""/>
                                </Grid>
                            </Border>

                            <!-- Capture Images -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Capture Images" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Save screenshots and copied bitmap/PNG images" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  x:Name="CaptureImagesToggle"
                                                  Toggled="CaptureToggle_Toggled"
                                                  MinWidth="0"
                                                  OffContent=""
                                                  OnContent=""/>
                                </Grid>
                            </Border>

                            <!-- Capture Files -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Capture File Lists" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Save paths of files copied from File Explorer" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  x:Name="CaptureFilesToggle"
                                                  Toggled="CaptureToggle_Toggled"
                                                  MinWidth="0"
                                                  OffContent=""
                                                  OnContent=""/>
                                </Grid>
                            </Border>

                            <!-- Keep Rich Text -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Keep Rich Text Formatting" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Retain HTML/formatting so text can be pasted with styling intact" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  x:Name="KeepRichTextToggle"
                                                  Toggled="CaptureToggle_Toggled"
                                                  MinWidth="0"
                                                  OffContent=""
                                                  OnContent=""/>
                                </Grid>
                            </Border>

                            <!-- Max Text Size -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Max Text Size (KB)" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Skip text items larger than this threshold (default 1024 KB)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <NumberBox Grid.Column="1"
                                               x:Name="MaxTextKbNumberBox"
                                               Minimum="1"
                                               Maximum="1048576"
                                               SpinButtonPlacementMode="Inline"
                                               ValueChanged="LimitsNumberBox_ValueChanged"
                                               MinWidth="160"/>
                                </Grid>
                            </Border>

                            <!-- Max Image Size -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Max Image Size (MB)" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Skip image items larger than this threshold (default 10 MB)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <NumberBox Grid.Column="1"
                                               x:Name="MaxImageMbNumberBox"
                                               Minimum="1"
                                               Maximum="1000"
                                               SpinButtonPlacementMode="Inline"
                                               ValueChanged="LimitsNumberBox_ValueChanged"
                                               MinWidth="160"/>
                                </Grid>
                            </Border>

                            <!-- Storage Cap -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Storage Cap (MB)" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Maximum disk storage allocated for database and images (default 500 MB)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <NumberBox Grid.Column="1"
                                               x:Name="StorageCapMbNumberBox"
                                               Minimum="10"
                                               Maximum="50000"
                                               SpinButtonPlacementMode="Inline"
                                               ValueChanged="LimitsNumberBox_ValueChanged"
                                               MinWidth="160"/>
                                </Grid>
                            </Border>

                            <!-- Auto-delete Days -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Auto-delete after N days" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Automatically delete items older than N days (0 = never delete; pinned items are exempt)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <NumberBox Grid.Column="1"
                                               x:Name="AutoDeleteDaysNumberBox"
                                               Minimum="0"
                                               Maximum="3650"
                                               SpinButtonPlacementMode="Inline"
                                               ValueChanged="LimitsNumberBox_ValueChanged"
                                               MinWidth="160"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- Privacy Tab -->
                <TabViewItem Header="Privacy" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE72E;"/>
                    </TabViewItem.IconSource>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,16,16">
                        <StackPanel Spacing="12" MaxWidth="800" HorizontalAlignment="Left">
                            <!-- Encrypt History -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Encrypt History on Disk" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Protect stored data using Windows Data Protection (DPAPI) for the current user" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  x:Name="EncryptHistoryToggle"
                                                  Toggled="PrivacyToggle_Toggled"
                                                  MinWidth="0"
                                                  OffContent=""
                                                  OnContent=""/>
                                </Grid>
                            </Border>

                            <!-- Require Windows Hello -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Require Windows Hello / PIN" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Require authentication before opening the clipboard popup" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  x:Name="RequireHelloToggle"
                                                  Toggled="PrivacyToggle_Toggled"
                                                  MinWidth="0"
                                                  OffContent=""
                                                  OnContent=""/>
                                </Grid>
                            </Border>

                            <!-- Detect Sensitive Data -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Detect Sensitive Data" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Detect card numbers, tokens, and passwords; masks preview until revealed" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      x:Name="DetectSensitiveToggle"
                                                      Toggled="PrivacyToggle_Toggled"
                                                      MinWidth="0"
                                                      OffContent=""
                                                      OnContent=""/>
                                    </Grid>

                                    <!-- Auto expire seconds -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Auto-expire sensitive items (seconds)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="0 = never expire; default 60 seconds" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <NumberBox Grid.Column="1"
                                                   x:Name="SensitiveExpireSecondsNumberBox"
                                                   Minimum="0"
                                                   Maximum="86400"
                                                   SpinButtonPlacementMode="Inline"
                                                   ValueChanged="LimitsNumberBox_ValueChanged"
                                                   MinWidth="160"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Ignored Apps -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Ignored Applications" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Never capture clipboard data from these applications (e.g. password managers):" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <!-- Quick add suggestions -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Quick add:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        <Button Content="+ KeePass" Click="QuickAddApp_Click" Tag="keepass.exe"/>
                                        <Button Content="+ Bitwarden" Click="QuickAddApp_Click" Tag="bitwarden.exe"/>
                                        <Button Content="+ 1Password" Click="QuickAddApp_Click" Tag="1password.exe"/>
                                        <Button Content="+ LastPass" Click="QuickAddApp_Click" Tag="lastpass.exe"/>
                                    </StackPanel>

                                    <!-- List of ignored apps -->
                                    <ListView x:Name="IgnoredAppsListView"
                                              MaxHeight="150"
                                              BorderThickness="1"
                                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                              CornerRadius="4"/>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="NewAppTextBox" PlaceholderText="e.g. keepass.exe"/>
                                        <Button Grid.Column="1" Content="Add" Click="AddIgnoredApp_Click"/>
                                        <Button Grid.Column="2" Content="Remove selected" Click="RemoveIgnoredApp_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Exclude from screen capture -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Exclude From Screen Capture" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Hide clipboard preview popup from screen recording and screenshots" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  x:Name="ExcludeScreenCaptureToggle"
                                                  Toggled="PrivacyToggle_Toggled"
                                                  MinWidth="0"
                                                  OffContent=""
                                                  OnContent=""/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- Snippets Tab -->
                <TabViewItem Header="Snippets" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE8D2;"/>
                    </TabViewItem.IconSource>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,16,16">
                        <StackPanel Spacing="14" MaxWidth="800" HorizontalAlignment="Left">
                            <!-- Snippets Header Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="8"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <FontIcon Glyph="&#xE8D2;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Reusable Snippets" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock x:Name="SnippetsCountText" Text="0 snippets saved" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Save frequently used text templates with titles and quick abbreviation triggers."
                                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="AddSnippet_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                            <TextBlock Text="Add Snippet"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Snippets List -->
                            <ListView x:Name="SnippetsListView"
                                      SelectionMode="None"
                                      IsItemClickEnabled="False">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0,4"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ClipboardItemViewModel">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,12">
                                            <Grid RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Top Row: Icon, Title, Abbreviation, and Action Buttons -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Title & Abbreviation pill -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE8D2;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{x:Bind SnippetTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                Visibility="{x:Bind AbbreviationVisibility, Mode=OneWay}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind SnippetAbbreviation}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Right: Edit & Delete Buttons -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Button Click="EditSnippet_Click"
                                                                Tag="{x:Bind}"
                                                                AutomationProperties.Name="Edit snippet"
                                                                ToolTipService.ToolTip="Edit snippet"
                                                                Padding="6,4"
                                                                Background="Transparent"
                                                                BorderThickness="0">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon Glyph="&#xE70F;" FontSize="11"/>
                                                                <TextBlock Text="Edit" FontSize="11"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Click="DeleteSnippet_Click"
                                                                Tag="{x:Bind}"
                                                                AutomationProperties.Name="Delete snippet"
                                                                ToolTipService.ToolTip="Delete snippet"
                                                                Padding="6,4"
                                                                Background="Transparent"
                                                                BorderThickness="0">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="Delete" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Bottom Row: Preview content box -->
                                                <Border Grid.Row="1"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,8">
                                                    <TextBlock Text="{x:Bind PreviewText}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               MaxLines="4"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Empty state panel -->
                            <Border x:Name="SnippetsEmptyPanel"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="32,28">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D2;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No snippets yet" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Create reusable text templates for quick pasting across your favorite applications."
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               MaxWidth="420"/>
                                    <Button Content="+ Create Your First Snippet"
                                            Click="AddSnippet_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Center"
                                            Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- Data Tab -->
                <TabViewItem Header="Data" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xEDA2;"/>
                    </TabViewItem.IconSource>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,16,16">
                        <StackPanel Spacing="12" MaxWidth="800" HorizontalAlignment="Left">
                            <!-- Storage Path & Usage -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Storage &amp; Usage" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Storage Directory:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="StoragePathText" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="StorageUsageText" Text="Calculating storage..." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Open folder"
                                                Click="OpenFolderButton_Click"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Clear History -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Clear History" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Delete saved clipboard items and images from database and disk." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <CheckBox x:Name="IncludePinnedCheckBox" Content="Include pinned items (delete everything)"/>
                                    <Button x:Name="ClearHistoryButton"
                                            Content="Clear clipboard history"
                                            Click="ClearHistoryButton_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Export / Import -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Export / Import Backup" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Export all clipboard items and images to a ZIP archive or restore from a previous backup." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Export history (ZIP)" Click="ExportHistory_Click"/>
                                        <Button Content="Import history (ZIP)" Click="ImportHistory_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="BackupStatusText" Text="" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>
    </Grid>
</Page>

