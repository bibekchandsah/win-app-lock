<Page
    x:Class="AppLock.Views.EyeCarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back Button and Breadcrumb -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Others" 
                           FontSize="14" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="›" 
                           FontSize="14" 
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Eye Care" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Page Header -->
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="Eye Care Reminder" 
                       FontSize="28" 
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Periodic reminders to rest your eyes with fullscreen overlays" 
                       FontSize="14" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="800">
                
                <!-- Enable/Disable Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <FontIcon Grid.Column="0" 
                                  Glyph="&#xE7B3;" 
                                  FontSize="24"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Eye Care Reminders" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Show periodic reminders to rest your eyes" 
                                       FontSize="13" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        
                        <ToggleSwitch Grid.Column="2"
                                      IsOn="{Binding Enabled, Mode=TwoWay}"
                                      OnContent="Enabled"
                                      OffContent="Disabled"
                                      MinWidth="0"/>
                    </Grid>
                </Border>

                <!-- Interval Settings Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left: Title and Description -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Reminder Interval" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="How often to show the eye care reminder" 
                                       FontSize="13" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="CustomIntervalHint"
                                       Text="Custom interval active"
                                       FontSize="12"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       Margin="0,4,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                        
                        <!-- Right: Interval Dropdown -->
                        <DropDownButton Grid.Column="1" 
                                        VerticalAlignment="Center"
                                        MinWidth="140">
                            <DropDownButton.Content>
                                <TextBlock x:Name="IntervalText" Text="20 minutes"/>
                            </DropDownButton.Content>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="1 minute" Click="Interval1_Click" x:Name="Interval1Item">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon x:Name="Interval1Check" Glyph="&#xE73E;" Visibility="Collapsed" FontSize="14"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="20 minutes" Click="Interval20_Click" x:Name="Interval20Item">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon x:Name="Interval20Check" Glyph="&#xE73E;" FontSize="14"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="25 minutes" Click="Interval25_Click" x:Name="Interval25Item">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon x:Name="Interval25Check" Glyph="&#xE73E;" Visibility="Collapsed" FontSize="14"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="30 minutes" Click="Interval30_Click" x:Name="Interval30Item">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon x:Name="Interval30Check" Glyph="&#xE73E;" Visibility="Collapsed" FontSize="14"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="60 minutes" Click="Interval60_Click" x:Name="Interval60Item">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon x:Name="Interval60Check" Glyph="&#xE73E;" Visibility="Collapsed" FontSize="14"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Custom..." Click="IntervalCustom_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                </Border>

                <!-- Message Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Reminder Message" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        
                        <TextBox Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Leave empty for default message"
                                 MaxLength="200"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="False"
                                 Header="Custom message to display on the overlay"/>
                    </StackPanel>
                </Border>

                <!-- Schedule Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Schedule" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        
                        <CheckBox Content="Enable schedule" 
                                  IsChecked="{Binding ScheduleEnabled, Mode=TwoWay}"
                                  FontSize="14"/>
                        
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="Start time" 
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            
                            <TimePicker Grid.Column="1"
                                        Time="{Binding StartTime, Mode=TwoWay}"
                                        ClockIdentifier="24HourClock"
                                        MinuteIncrement="15"
                                        IsEnabled="{Binding ScheduleEnabled}"/>
                            
                            <TextBlock Grid.Column="2" 
                                       Text="End time" 
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            
                            <TimePicker Grid.Column="3"
                                        Time="{Binding EndTime, Mode=TwoWay}"
                                        ClockIdentifier="24HourClock"
                                        MinuteIncrement="15"
                                        IsEnabled="{Binding ScheduleEnabled}"/>
                        </Grid>
                        
                        <TextBlock Text="24-hour format. Reminders only fire during this window. Supports cross-midnight schedules."
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Overlay Settings Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Overlay Settings" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        
                        <!-- Duration -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="Duration (seconds)" 
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            
                            <NumberBox Grid.Column="1"
                                       Value="{Binding Duration, Mode=TwoWay}"
                                       Minimum="5"
                                       Maximum="300"
                                       SpinButtonPlacementMode="Inline"
                                       MinWidth="120"
                                       HorizontalAlignment="Left"/>
                        </Grid>

                        <!-- Template -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Overlay Template" 
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AvailableTemplates}"
                                          SelectedIndex="{Binding SelectedTemplateIndex, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>
                                
                                <Button Grid.Column="1" 
                                        Content="Browse..." 
                                        Click="BrowseTemplate_Click"/>
                                
                                <Button Grid.Column="2" 
                                        Content="Open folder" 
                                        Click="OpenTemplatesFolder_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- Preview Button -->
                        <Button Click="Preview_Click"
                                HorizontalAlignment="Left"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="16"/>
                                <TextBlock Text="Preview Overlay" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Info Card -->
                <InfoBar Severity="Informational"
                         IsOpen="True"
                         IsClosable="False"
                         Title="Custom Template Tips"
                         Message="Custom templates support {{REMINDER_MESSAGE}} and {{DURATION}} placeholders. Press Esc or right-click to close the overlay. The overlay appears fullscreen on all monitors."/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
