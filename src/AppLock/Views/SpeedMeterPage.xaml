<Page
    x:Class="AppLock.Views.SpeedMeterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:AppLock.Views.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back Button and Breadcrumb -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Others"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="›"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Speed Meter"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Page Header -->
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="Speed Meter"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Live download and upload speed in a floating widget"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Left">

                <!-- Master toggle -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xEC4A;"
                                  FontSize="20"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Show speed meter"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="StatusText"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="MasterToggle"
                                      Grid.Column="2"
                                      MinWidth="0"
                                      OnContent=""
                                      OffContent=""
                                      Toggled="MasterToggle_Toggled"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Start with AppLock -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Start with AppLock"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Bring the widget back automatically when AppLock starts"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="StartWithAppLockToggle"
                                      Grid.Column="1"
                                      MinWidth="0"
                                      OnContent=""
                                      OffContent=""
                                      Toggled="StartWithAppLockToggle_Toggled"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Live preview -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Preview"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="The real widget, updated live with every setting below"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="180">
                            <Grid>
                                <!-- Faint window shapes so the preview reads as a desktop -->
                                <StackPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="20"
                                            Spacing="8"
                                            Opacity="0.35">
                                    <Border Height="10" Width="150" CornerRadius="4"
                                            Background="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <Border Height="10" Width="220" CornerRadius="4"
                                            Background="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <Border Height="10" Width="180" CornerRadius="4"
                                            Background="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>

                                <controls:SpeedWidgetControl x:Name="PreviewWidget"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Bottom"
                                                             Margin="0,0,28,24"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Appearance"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Independent of the app theme unless you choose Follow Windows"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Theme preset -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Theme preset"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel x:Name="PresetPanel" Orientation="Horizontal" Spacing="8">
                                <ToggleButton Tag="Transparent" Content="Transparent" Click="PresetButton_Click"/>
                                <ToggleButton Tag="Glass" Content="Glass" Click="PresetButton_Click"/>
                                <ToggleButton Tag="Solid" Content="Solid" Click="PresetButton_Click"/>
                                <ToggleButton Tag="FollowWindows" Content="Follow Windows" Click="PresetButton_Click"/>
                                <ToggleButton Tag="Custom" Content="Custom" Click="PresetButton_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Background -->
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Background color"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                            <ColorPicker x:Name="BackgroundColorPicker"
                                         Grid.Column="1"
                                         Width="220"
                                         IsAlphaEnabled="False"
                                         IsAlphaSliderVisible="False"
                                         IsAlphaTextInputVisible="False"
                                         IsColorChannelTextInputVisible="False"
                                         IsHexInputVisible="False"
                                         IsMoreButtonVisible="False"
                                         ColorSpectrumShape="Box"
                                         ColorChanged="BackgroundColorPicker_ColorChanged"/>

                            <TextBox x:Name="BackgroundHexBox"
                                     Grid.Column="2"
                                     Width="110"
                                     VerticalAlignment="Center"
                                     FontFamily="Consolas"
                                     TextChanged="BackgroundHexBox_TextChanged"/>
                        </Grid>

                        <!-- Opacity -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Background opacity"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                            <Slider x:Name="OpacitySlider"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    ValueChanged="OpacitySlider_ValueChanged"/>

                            <TextBlock x:Name="OpacityValueText"
                                       Grid.Column="2"
                                       Width="48"
                                       FontSize="12"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>

                        <!-- Colors -->
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Text color"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <ColorPicker x:Name="TextColorPicker"
                                         Grid.Row="0" Grid.Column="1"
                                         Width="220"
                                         IsAlphaEnabled="False"
                                         IsAlphaSliderVisible="False"
                                         IsAlphaTextInputVisible="False"
                                         IsColorChannelTextInputVisible="False"
                                         IsHexInputVisible="False"
                                         IsMoreButtonVisible="False"
                                         ColorSpectrumShape="Box"
                                         ColorChanged="TextColorPicker_ColorChanged"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Download color"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <ColorPicker x:Name="DownColorPicker"
                                         Grid.Row="1" Grid.Column="1"
                                         Width="220"
                                         IsAlphaEnabled="False"
                                         IsAlphaSliderVisible="False"
                                         IsAlphaTextInputVisible="False"
                                         IsColorChannelTextInputVisible="False"
                                         IsHexInputVisible="False"
                                         IsMoreButtonVisible="False"
                                         ColorSpectrumShape="Box"
                                         ColorChanged="DownColorPicker_ColorChanged"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Upload color"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <ColorPicker x:Name="UpColorPicker"
                                         Grid.Row="2" Grid.Column="1"
                                         Width="220"
                                         IsAlphaEnabled="False"
                                         IsAlphaSliderVisible="False"
                                         IsAlphaTextInputVisible="False"
                                         IsColorChannelTextInputVisible="False"
                                         IsHexInputVisible="False"
                                         IsMoreButtonVisible="False"
                                         ColorSpectrumShape="Box"
                                         ColorChanged="UpColorPicker_ColorChanged"/>
                        </Grid>

                        <!-- Scale -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Size / scale"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                            <Slider x:Name="ScaleSlider"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    ValueChanged="ScaleSlider_ValueChanged"/>

                            <TextBlock x:Name="ScaleValueText"
                                       Grid.Column="2" Width="48" FontSize="12" TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>

                        <!-- Font -->
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Font"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <ComboBox x:Name="FontCombo"
                                      Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="FontCombo_SelectionChanged"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Font weight"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <ComboBox x:Name="WeightCombo"
                                      Grid.Row="1" Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="WeightCombo_SelectionChanged"/>
                            <ToggleSwitch x:Name="ShowIconsToggle"
                                          Grid.Row="1" Grid.Column="2"
                                          Header="Show arrows"
                                          OnContent="Arrows"
                                          OffContent="DL / UL"
                                          Toggled="ShowIconsToggle_Toggled"/>
                        </Grid>

                        <!-- Corners / border -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Corner radius"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                            <Slider x:Name="RadiusSlider"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    ValueChanged="RadiusSlider_ValueChanged"/>

                            <TextBlock x:Name="RadiusValueText"
                                       Grid.Column="2" Width="48" FontSize="12" TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <ToggleSwitch x:Name="BorderToggle"
                                          Grid.Column="3"
                                          Header="Border"
                                          Margin="16,0,0,0"
                                          OffContent=""
                                          OnContent=""
                                          Toggled="BorderToggle_Toggled"/>
                        </Grid>

                        <!-- Layout -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Layout"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                            <ComboBox x:Name="LayoutCombo"
                                      Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="LayoutCombo_SelectionChanged"/>

                            <ToggleSwitch x:Name="CompactToggle"
                                          Grid.Column="2"
                                          Header="Compact"
                                          Margin="16,0,0,0"
                                          OffContent=""
                                          OnContent=""
                                          Toggled="CompactToggle_Toggled"/>
                        </Grid>

                        <!-- Units / decimals / interval -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Units"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                            <ComboBox x:Name="UnitsCombo"
                                      Grid.Column="1"
                                      Header="Speed units"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="UnitsCombo_SelectionChanged"/>

                            <NumberBox x:Name="DecimalsBox"
                                       Grid.Column="2"
                                       Header="Decimals"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="DecimalsBox_ValueChanged"/>

                            <ComboBox x:Name="IntervalCombo"
                                      Grid.Column="3"
                                      Header="Update interval"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="IntervalCombo_SelectionChanged"/>
                        </Grid>

                        <Button Content="Reset appearance"
                                Click="ResetAppearance_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Behavior -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Behavior"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Lock position" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="The widget cannot be dragged while locked"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="LockPositionToggle" Grid.Column="1"
                                          MinWidth="0" OffContent="" OnContent=""
                                          Toggled="LockPositionToggle_Toggled"/>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Snap to screen edges" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Release near an edge and it docks with an 8 px margin"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="SnapToggle" Grid.Column="1"
                                          MinWidth="0" OffContent="" OnContent=""
                                          Toggled="SnapToggle_Toggled"/>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Click-through" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Mouse clicks pass through the widget. Hold Alt to grab it again"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="ClickThroughToggle" Grid.Column="1"
                                          MinWidth="0" OffContent="" OnContent=""
                                          Toggled="ClickThroughToggle_Toggled"/>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Hide in full-screen apps" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Steps out of the way for games, videos and presentations"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="HideFullscreenToggle" Grid.Column="1"
                                          MinWidth="0" OffContent="" OnContent=""
                                          Toggled="HideFullscreenToggle_Toggled"/>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Hide from screen sharing" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Excluded from screenshots and screen recording"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="HideFromCaptureToggle" Grid.Column="1"
                                          MinWidth="0" OffContent="" OnContent=""
                                          Toggled="HideFromCaptureToggle_Toggled"/>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Show / hide shortcut" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="ToggleHotkeyText" FontSize="11"
                                           Text="Ctrl+Alt+N"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Change" Click="ChangeHotkey_Click"/>
                        </Grid>

                        <Button Content="Reset position"
                                Click="ResetPosition_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Extra stats -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Extra stats"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Additional rows inside the widget. Each one is read only while it is on."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnSpacing="24" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ToggleSwitch x:Name="ShowCpuToggle" Grid.Row="0" Grid.Column="0"
                                          Header="CPU usage" OffContent="" OnContent=""
                                          Toggled="ExtraStatToggle_Toggled"/>
                            <ToggleSwitch x:Name="ShowRamToggle" Grid.Row="0" Grid.Column="1"
                                          Header="RAM usage" OffContent="" OnContent=""
                                          Toggled="ExtraStatToggle_Toggled"/>
                            <ToggleSwitch x:Name="ShowDiskToggle" Grid.Row="1" Grid.Column="0"
                                          Header="Disk activity" OffContent="" OnContent=""
                                          Toggled="ExtraStatToggle_Toggled"/>
                            <ToggleSwitch x:Name="ShowGpuToggle" Grid.Row="1" Grid.Column="1"
                                          Header="GPU usage" OffContent="" OnContent=""
                                          Toggled="ExtraStatToggle_Toggled"/>
                            <ToggleSwitch x:Name="ShowBatteryToggle" Grid.Row="2" Grid.Column="0"
                                          Header="Battery" OffContent="" OnContent=""
                                          Toggled="ExtraStatToggle_Toggled"/>
                            <ToggleSwitch x:Name="ShowSparklineToggle" Grid.Row="2" Grid.Column="1"
                                          Header="Mini graph" OffContent="" OnContent=""
                                          Toggled="ExtraStatToggle_Toggled"/>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="RamFormatCombo"
                                      Grid.Column="0"
                                      Header="RAM format"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="RamFormatCombo_SelectionChanged"/>

                            <NumberBox x:Name="WarnCpuBox"
                                       Grid.Column="1"
                                       Header="Warn CPU above %"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="WarnBox_ValueChanged"/>

                            <NumberBox x:Name="WarnRamBox"
                                       Grid.Column="2"
                                       Header="Warn RAM above %"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="WarnBox_ValueChanged"/>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Row order"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel x:Name="RowOrderPanel" Spacing="4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Privacy note -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE72E;"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Top"/>

                        <TextBlock Grid.Column="1"
                                   Text="The speed meter reads Windows network counters on this PC only. It makes no network requests."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
