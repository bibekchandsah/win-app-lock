<Page
    x:Class="AppLock.Views.SpeedMeterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:AppLock.Views.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back Button and Breadcrumb -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Others"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="›"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Speed Meter"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Page Header -->
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="Speed Meter"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Live download and upload speed in a floating widget"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Left">

                <!-- Master toggle -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xEC4A;"
                                  FontSize="20"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Show speed meter"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="The floating widget appears on your desktop and comes back with AppLock"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="MasterToggle"
                                      Grid.Column="2"
                                      MinWidth="0"
                                      OnContent=""
                                      OffContent=""
                                      Toggled="MasterToggle_Toggled"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Live preview -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Preview"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="The real widget, updated live with every setting below"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                MinHeight="180"
                                Padding="0,12">
                            <Grid>
                                <!-- Faint window shapes so the preview reads as a desktop -->
                                <StackPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="20"
                                            Spacing="8"
                                            Opacity="0.35">
                                    <Border Height="10" Width="150" CornerRadius="4"
                                            Background="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <Border Height="10" Width="220" CornerRadius="4"
                                            Background="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <Border Height="10" Width="180" CornerRadius="4"
                                            Background="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>

                                <controls:SpeedWidgetControl x:Name="PreviewWidget"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Bottom"
                                                             Margin="0,0,28,24"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Appearance"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Independent of the app theme unless you choose Follow Windows"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Theme preset -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Theme preset"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel x:Name="PresetPanel" Orientation="Horizontal" Spacing="8">
                                <ToggleButton Tag="Transparent" Content="Transparent" Click="PresetButton_Click"/>
                                <ToggleButton Tag="Glass" Content="Glass" Click="PresetButton_Click"/>
                                <ToggleButton Tag="Solid" Content="Solid" Click="PresetButton_Click"/>
                                <ToggleButton Tag="FollowWindows" Content="Follow Windows" Click="PresetButton_Click"/>
                                <ToggleButton Tag="Custom" Content="Custom" Click="PresetButton_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Colors: the swatch opens the picker and the hex value stays on one line -->
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Background color"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Button x:Name="BackgroundColorButton" Grid.Row="0" Grid.Column="1"
                                    Width="64" Height="30" Padding="2" CornerRadius="4"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    AutomationProperties.Name="Pick background color"
                                    ToolTipService.ToolTip="Pick the background color">
                                <Border x:Name="BackgroundSwatch" CornerRadius="3" Width="56" Height="22"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        Background="#202020"/>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <ColorPicker x:Name="BackgroundColorPicker"
                                                     Width="300"
                                                     IsAlphaEnabled="False"
                                                     IsAlphaSliderVisible="False"
                                                     IsAlphaTextInputVisible="False"
                                                     IsColorChannelTextInputVisible="False"
                                                     IsHexInputVisible="True"
                                                     IsMoreButtonVisible="False"
                                                     ColorSpectrumShape="Box"
                                                     ColorChanged="BackgroundColorPicker_ColorChanged"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <TextBox x:Name="BackgroundHexBox" Grid.Row="0" Grid.Column="2"
                                     VerticalAlignment="Center" FontFamily="Consolas"
                                     TextChanged="BackgroundHexBox_TextChanged"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Text color"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Button x:Name="TextColorButton" Grid.Row="1" Grid.Column="1"
                                    Width="64" Height="30" Padding="2" CornerRadius="4"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    AutomationProperties.Name="Pick text color"
                                    ToolTipService.ToolTip="Pick the text color">
                                <Border x:Name="TextSwatch" CornerRadius="3" Width="56" Height="22"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        Background="#FFFFFF"/>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <ColorPicker x:Name="TextColorPicker"
                                                     Width="300"
                                                     IsAlphaEnabled="False"
                                                     IsAlphaSliderVisible="False"
                                                     IsAlphaTextInputVisible="False"
                                                     IsColorChannelTextInputVisible="False"
                                                     IsHexInputVisible="True"
                                                     IsMoreButtonVisible="False"
                                                     ColorSpectrumShape="Box"
                                                     ColorChanged="TextColorPicker_ColorChanged"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <TextBox x:Name="TextHexBox" Grid.Row="1" Grid.Column="2"
                                     VerticalAlignment="Center" FontFamily="Consolas"
                                     TextChanged="TextHexBox_TextChanged"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Download color"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Button x:Name="DownColorButton" Grid.Row="2" Grid.Column="1"
                                    Width="64" Height="30" Padding="2" CornerRadius="4"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    AutomationProperties.Name="Pick download color"
                                    ToolTipService.ToolTip="Pick the download color">
                                <Border x:Name="DownSwatch" CornerRadius="3" Width="56" Height="22"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        Background="#4ADE80"/>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <ColorPicker x:Name="DownColorPicker"
                                                     Width="300"
                                                     IsAlphaEnabled="False"
                                                     IsAlphaSliderVisible="False"
                                                     IsAlphaTextInputVisible="False"
                                                     IsColorChannelTextInputVisible="False"
                                                     IsHexInputVisible="True"
                                                     IsMoreButtonVisible="False"
                                                     ColorSpectrumShape="Box"
                                                     ColorChanged="DownColorPicker_ColorChanged"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <TextBox x:Name="DownHexBox" Grid.Row="2" Grid.Column="2"
                                     VerticalAlignment="Center" FontFamily="Consolas"
                                     TextChanged="DownHexBox_TextChanged"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Upload color"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Button x:Name="UpColorButton" Grid.Row="3" Grid.Column="1"
                                    Width="64" Height="30" Padding="2" CornerRadius="4"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    AutomationProperties.Name="Pick upload color"
                                    ToolTipService.ToolTip="Pick the upload color">
                                <Border x:Name="UpSwatch" CornerRadius="3" Width="56" Height="22"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        Background="#60A5FA"/>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <ColorPicker x:Name="UpColorPicker"
                                                     Width="300"
                                                     IsAlphaEnabled="False"
                                                     IsAlphaSliderVisible="False"
                                                     IsAlphaTextInputVisible="False"
                                                     IsColorChannelTextInputVisible="False"
                                                     IsHexInputVisible="True"
                                                     IsMoreButtonVisible="False"
                                                     ColorSpectrumShape="Box"
                                                     ColorChanged="UpColorPicker_ColorChanged"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <TextBox x:Name="UpHexBox" Grid.Row="3" Grid.Column="2"
                                     VerticalAlignment="Center" FontFamily="Consolas"
                                     TextChanged="UpHexBox_TextChanged"/>
                        </Grid>

                        <!-- Opacity -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Background opacity"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                            <Slider x:Name="OpacitySlider"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    ValueChanged="OpacitySlider_ValueChanged"/>

                            <TextBlock x:Name="OpacityValueText"
                                       Grid.Column="2"
                                       Width="48"
                                       FontSize="12"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>

                        <!-- Blur (Custom preset only) -->
                        <Grid x:Name="BlurRow" ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Background blur"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                            <Slider x:Name="BlurSlider"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    ValueChanged="BlurSlider_ValueChanged"/>

                            <TextBlock x:Name="BlurValueText"
                                       Grid.Column="2"
                                       Width="48"
                                       FontSize="12"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>


                        <!-- Scale -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Size / scale"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                            <Slider x:Name="ScaleSlider"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    ValueChanged="ScaleSlider_ValueChanged"/>

                            <TextBlock x:Name="ScaleValueText"
                                       Grid.Column="2" Width="48" FontSize="12" TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>

                        <!-- Font -->
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Font"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <ComboBox x:Name="FontCombo"
                                      Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="FontCombo_SelectionChanged"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Font weight"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <ComboBox x:Name="WeightCombo"
                                      Grid.Row="1" Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="WeightCombo_SelectionChanged"/>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                                        Margin="8,0,0,0" VerticalAlignment="Bottom">
                                <TextBlock Text="Show arrows" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <ToggleSwitch x:Name="ShowIconsToggle" Margin="10,0,0,0"
                                              MinWidth="0" OffContent="" OnContent=""
                                              Toggled="ShowIconsToggle_Toggled"/>
                            </StackPanel>
                        </Grid>

                        <!-- Corners / border -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Corner radius"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                            <Slider x:Name="RadiusSlider"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    ValueChanged="RadiusSlider_ValueChanged"/>

                            <TextBlock x:Name="RadiusValueText"
                                       Grid.Column="2" Width="48" FontSize="12" TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                        Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Border" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <ToggleSwitch x:Name="BorderToggle" Margin="10,0,0,0"
                                              MinWidth="0" OffContent="" OnContent=""
                                              Toggled="BorderToggle_Toggled"/>
                            </StackPanel>
                        </Grid>

                        <!-- Layout -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Layout"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                            <ComboBox x:Name="LayoutCombo"
                                      Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="LayoutCombo_SelectionChanged"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Compact" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <ToggleSwitch x:Name="CompactToggle" Margin="10,0,0,0"
                                              MinWidth="0" OffContent="" OnContent=""
                                              Toggled="CompactToggle_Toggled"/>
                            </StackPanel>
                        </Grid>

                        <!-- Units / decimals / interval -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Units"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                            <ComboBox x:Name="UnitsCombo"
                                      Grid.Column="1"
                                      Header="Speed units"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="UnitsCombo_SelectionChanged"/>

                            <NumberBox x:Name="DecimalsBox"
                                       Grid.Column="2"
                                       Header="Decimals"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="DecimalsBox_ValueChanged"/>

                            <ComboBox x:Name="IntervalCombo"
                                      Grid.Column="3"
                                      Header="Update interval"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="IntervalCombo_SelectionChanged"/>
                        </Grid>

                        <Button Content="Reset appearance"
                                Click="ResetAppearance_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Behavior -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Behavior"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Lock position" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="The widget cannot be dragged while locked"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="LockPositionToggle" Grid.Column="1"
                                          MinWidth="0" OffContent="" OnContent=""
                                          Toggled="LockPositionToggle_Toggled"/>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Snap to screen edges" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Release near an edge and it docks with an 8 px margin"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="SnapToggle" Grid.Column="1"
                                          MinWidth="0" OffContent="" OnContent=""
                                          Toggled="SnapToggle_Toggled"/>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Click-through" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Mouse clicks pass through the widget. Hold Alt to grab it again"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="ClickThroughToggle" Grid.Column="1"
                                          MinWidth="0" OffContent="" OnContent=""
                                          Toggled="ClickThroughToggle_Toggled"/>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Hide in full-screen apps" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Steps out of the way for games, videos and presentations"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="HideFullscreenToggle" Grid.Column="1"
                                          MinWidth="0" OffContent="" OnContent=""
                                          Toggled="HideFullscreenToggle_Toggled"/>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Hide from screen sharing" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Excluded from screenshots and screen recording"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="HideFromCaptureToggle" Grid.Column="1"
                                          MinWidth="0" OffContent="" OnContent=""
                                          Toggled="HideFromCaptureToggle_Toggled"/>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Hide when idle" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Hides after the speed stays below the threshold; move the mouse into its spot to peek"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="HideIdleToggle" Grid.Column="1"
                                          MinWidth="0" OffContent="" OnContent=""
                                          Toggled="HideIdleToggle_Toggled"/>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <NumberBox x:Name="IdleThresholdBox"
                                       Grid.Column="0"
                                       Header="Idle below (KB/s)"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="IdleNumber_ValueChanged"/>
                            <NumberBox x:Name="IdleSecondsBox"
                                       Grid.Column="1"
                                       Header="For (seconds)"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="IdleNumber_ValueChanged"/>
                            <ToggleSwitch x:Name="HideDisconnectedToggle"
                                          Grid.Column="2"
                                          Header="Hide while disconnected"
                                          OffContent="" OnContent=""
                                          Toggled="HideDisconnectedToggle_Toggled"/>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Show / hide shortcut" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="ToggleHotkeyText" FontSize="11"
                                           Text="Ctrl+Alt+N"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="Change" Click="ChangeHotkey_Click"/>
                                <Button Content="Reset" Click="ResetHotkey_Click"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="Reset position"
                                Click="ResetPosition_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Extra stats -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Extra stats"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Additional rows inside the widget. Each one is read only while it is on."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CPU usage" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <ToggleSwitch x:Name="ShowCpuToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="ExtraStatToggle_Toggled"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="RAM usage" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <ToggleSwitch x:Name="ShowRamToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="ExtraStatToggle_Toggled"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Disk activity" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <ToggleSwitch x:Name="ShowDiskToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="ExtraStatToggle_Toggled"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="GPU usage" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <ToggleSwitch x:Name="ShowGpuToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="ExtraStatToggle_Toggled"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Battery" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <ToggleSwitch x:Name="ShowBatteryToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="ExtraStatToggle_Toggled"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Mini graph" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Last 60 samples, full width of the widget"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowSparklineToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="ExtraStatToggle_Toggled"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Total data used today" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <ToggleSwitch x:Name="ShowTodayTotalToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="ExtraStatToggle_Toggled"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Date and time" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Shown below the speeds; follows the horizontal or vertical layout"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowClockToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="ExtraStatToggle_Toggled"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Show the date" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <ToggleSwitch x:Name="ShowClockDateToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="ExtraStatToggle_Toggled"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Seconds" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Ticks every second instead of every minute"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowClockSecondsToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="ExtraStatToggle_Toggled"/>
                            </Grid>
                        </StackPanel>

                        <!-- Warning thresholds -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Warnings"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <NumberBox x:Name="WarnCpuBox" Grid.Row="0" Grid.Column="0"
                                           Header="Warn CPU above %" SpinButtonPlacementMode="Inline"
                                           ValueChanged="WarnBox_ValueChanged"/>
                                <NumberBox x:Name="WarnRamBox" Grid.Row="0" Grid.Column="1"
                                           Header="Warn RAM above %" SpinButtonPlacementMode="Inline"
                                           ValueChanged="WarnBox_ValueChanged"/>
                                <NumberBox x:Name="WarnDiskBox" Grid.Row="0" Grid.Column="2"
                                           Header="Warn disk above %" SpinButtonPlacementMode="Inline"
                                           ValueChanged="WarnBox_ValueChanged"/>
                                <NumberBox x:Name="WarnDownBox" Grid.Row="1" Grid.Column="0"
                                           Header="Warn download above Mbps" SpinButtonPlacementMode="Inline"
                                           ValueChanged="WarnBox_ValueChanged"/>
                                <NumberBox x:Name="WarnUpBox" Grid.Row="1" Grid.Column="1"
                                           Header="Warn upload above Mbps" SpinButtonPlacementMode="Inline"
                                           ValueChanged="WarnBox_ValueChanged"/>
                                <ComboBox x:Name="RamFormatCombo" Grid.Row="1" Grid.Column="2"
                                          Header="RAM format"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="RamFormatCombo_SelectionChanged"/>
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Notify when a warning is crossed" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="A toast names the app that is using the most CPU, RAM or disk"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="WarnToastsToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="WarnOption_Toggled"/>
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Battery alerts" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Charging, discharging and plug in / unplug toasts, in the speed meter toast style"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="BatteryAlertsToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="WarnOption_Toggled"/>
                            </Grid>

                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BatteryLowBox" Grid.Column="0"
                                             Header="Notify at these % (on battery)"
                                             PlaceholderText="30, 20, 10"
                                             TextChanged="BatteryBox_TextChanged"/>
                                    <TextBox x:Name="BatteryHighBox" Grid.Column="1"
                                             Header="Notify at these % (charging)"
                                             PlaceholderText="50, 70, 100"
                                             TextChanged="BatteryBox_TextChanged"/>
                                </Grid>
                                <TextBlock Text="Comma separated percentages. Each one toasts once when the battery crosses it, for example &quot;Battery charged 70%&quot; or &quot;Battery discharged to 20%&quot;."
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Top apps -->
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Top apps line" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="A line inside the widget that cycles through the busiest apps"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowTopAppsToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="TopAppsToggle_Toggled"/>
                            </Grid>

                            <Grid ColumnSpacing="24" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Top CPU app" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <ToggleSwitch x:Name="TopCpuToggle" Grid.Column="1" HorizontalAlignment="Right"
                                                  MinWidth="0" OffContent="" OnContent=""
                                                  Toggled="TopAppsMetric_Toggled"/>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Top RAM app" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <ToggleSwitch x:Name="TopRamToggle" Grid.Column="1" HorizontalAlignment="Right"
                                                  MinWidth="0" OffContent="" OnContent=""
                                                  Toggled="TopAppsMetric_Toggled"/>
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="0" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Top disk app" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <ToggleSwitch x:Name="TopDiskToggle" Grid.Column="1" HorizontalAlignment="Right"
                                                  MinWidth="0" OffContent="" OnContent=""
                                                  Toggled="TopAppsMetric_Toggled"/>
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Top GPU app" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <ToggleSwitch x:Name="TopGpuToggle" Grid.Column="1" HorizontalAlignment="Right"
                                                  MinWidth="0" OffContent="" OnContent=""
                                                  Toggled="TopAppsMetric_Toggled"/>
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Row order"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel x:Name="RowOrderPanel" Spacing="4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Connection alerts -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Connection alerts"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="AppLock's own toast when the internet drops or comes back"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnSpacing="24" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                        </Grid>

                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Notify when the connection is lost" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <ToggleSwitch x:Name="NotifyLostToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="AlertToggle_Toggled"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Notify when it comes back" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <ToggleSwitch x:Name="NotifyRestoredToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="AlertToggle_Toggled"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sound" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <ToggleSwitch x:Name="AlertSoundToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="AlertToggle_Toggled"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Stay quiet in full-screen apps" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <ToggleSwitch x:Name="SuppressFullscreenToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="AlertToggle_Toggled"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Check for real internet access" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <ToggleSwitch x:Name="RealInternetToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="AlertToggle_Toggled"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Active probe (opt-in, sends requests)" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                <ToggleSwitch x:Name="ActiveProbeToggle" Grid.Column="1" MinWidth="0"
                                              OffContent="" OnContent="" Toggled="AlertToggle_Toggled"/>
                            </Grid>
                        </StackPanel>

                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ComboBox x:Name="AlertStyleCombo" Grid.Row="0" Grid.Column="0"
                                      Header="Style" HorizontalAlignment="Stretch"
                                      SelectionChanged="AlertCombo_SelectionChanged"/>
                            <ComboBox x:Name="AnchorCombo" Grid.Row="0" Grid.Column="1"
                                      Header="Position" HorizontalAlignment="Stretch"
                                      SelectionChanged="AlertCombo_SelectionChanged"/>
                            <ComboBox x:Name="ToastThemeCombo" Grid.Row="0" Grid.Column="2"
                                      Header="Toast theme" HorizontalAlignment="Stretch"
                                      SelectionChanged="AlertCombo_SelectionChanged"/>
                            <ComboBox x:Name="AnimationCombo" Grid.Row="0" Grid.Column="3"
                                      Header="Animation" HorizontalAlignment="Stretch"
                                      SelectionChanged="AlertCombo_SelectionChanged"/>

                            <NumberBox x:Name="DurationBox" Grid.Row="1" Grid.Column="0"
                                       Header="Duration (s)" SpinButtonPlacementMode="Inline"
                                       ValueChanged="AlertNumber_ValueChanged"/>
                            <NumberBox x:Name="MarginBox" Grid.Row="1" Grid.Column="1"
                                       Header="Margin (px)" SpinButtonPlacementMode="Inline"
                                       ValueChanged="AlertNumber_ValueChanged"/>
                            <NumberBox x:Name="DebounceBox" Grid.Row="1" Grid.Column="2"
                                       Header="Debounce (s)" SpinButtonPlacementMode="Inline"
                                       ValueChanged="AlertNumber_ValueChanged"/>
                            <NumberBox x:Name="MinOutageBox" Grid.Row="1" Grid.Column="3"
                                       Header="Min outage to announce (s)" SpinButtonPlacementMode="Inline"
                                       ValueChanged="AlertNumber_ValueChanged"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Preview &quot;Disconnected&quot;" Click="PreviewLost_Click"/>
                            <Button Content="Preview &quot;Back online&quot;" Click="PreviewRestored_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Presets and settings file -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Presets and settings file"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Presets change the look and the extra rows only — never the shortcut, alerts or usage data."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="PresetCombo"
                                      Grid.Column="0"
                                      Header="Preset"
                                      HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="1" Content="Apply" Click="ApplyPreset_Click" VerticalAlignment="Bottom"/>
                            <Button Grid.Column="2" Content="Delete" Click="DeletePreset_Click" VerticalAlignment="Bottom"/>
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="NewPresetNameBox"
                                     Grid.Column="0"
                                     Header="Save the current look as"
                                     PlaceholderText="Preset name"/>
                            <Button Grid.Column="1" Content="Save preset" Click="SavePreset_Click" VerticalAlignment="Bottom"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Export settings…" Click="ExportSettings_Click"/>
                            <Button Content="Import settings…" Click="ImportSettings_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Data usage -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Data usage"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Daily totals are kept on this PC for 12 months. Nothing is uploaded."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Track data usage" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <ToggleSwitch x:Name="TrackUsageToggle" Grid.Column="1" MinWidth="0"
                                          OffContent="" OnContent="" Toggled="UsageSetting_Changed"/>
                        </Grid>

                        <TextBlock x:Name="UsageSummaryText"
                                   Text="Today —"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <NumberBox x:Name="DailyCapBox"
                                       Grid.Column="0"
                                       Header="Daily cap (GB)"
                                       PlaceholderText="No cap"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="UsageNumber_ValueChanged"/>

                            <NumberBox x:Name="MonthlyCapBox"
                                       Grid.Column="1"
                                       Header="Monthly cap (GB)"
                                       PlaceholderText="No cap"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="UsageNumber_ValueChanged"/>

                            <NumberBox x:Name="ResetDayBox"
                                       Grid.Column="2"
                                       Header="Monthly reset day"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="UsageNumber_ValueChanged"/>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Count only the active adapter" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <ToggleSwitch x:Name="CapActiveToggle" Grid.Column="1" MinWidth="0"
                                          OffContent="" OnContent="" Toggled="UsageSetting_Changed"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="View history" Click="ViewUsageHistory_Click"/>
                            <Button Content="Reset statistics" Click="ResetUsage_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Privacy note -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE72E;"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Top"/>

                        <TextBlock Grid.Column="1"
                                   Text="The speed meter reads Windows network counters on this PC only. It makes no network requests."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
