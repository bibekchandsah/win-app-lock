<Page
    x:Class="AppLock.Views.OthersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AppLock.Views"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Brightness Card Template -->
        <DataTemplate x:Key="BrightnessTemplate" x:DataType="local:UtilityCard">
            <StackPanel Spacing="12" Margin="0,8,0,0">
                <!-- Brightness Hotkeys Toggle -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Brightness Hotkeys"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Enable/disable all brightness shortcuts"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsOn="{x:Bind BrightnessHotkeysEnabled, Mode=OneWay}"
                                  Toggled="BrightnessHotkeysToggle_Toggled"
                                  MinWidth="0"
                                  OffContent=""
                                  OnContent=""/>
                </Grid>

                <!-- Blur Hotkey Toggle -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Blur Overlay Hotkey"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Enable/disable blur overlay shortcut"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsOn="{x:Bind BlurHotkeyEnabled, Mode=OneWay}"
                                  Toggled="BlurHotkeyToggle_Toggled"
                                  MinWidth="0"
                                  OffContent=""
                                  OnContent=""/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Eye Care Card Template -->
        <DataTemplate x:Key="EyeCareTemplate" x:DataType="local:UtilityCard">
            <StackPanel Spacing="12" Margin="0,8,0,0">
                <!-- Eye Care Toggle -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Eye Care Reminders"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Enable/disable periodic eye care reminders"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsOn="{x:Bind EyeCareEnabled, Mode=TwoWay}"
                                  Toggled="EyeCareToggle_Toggled"
                                  MinWidth="0"
                                  OffContent=""
                                  OnContent=""/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Template Selector -->
        <local:CardContentTemplateSelector x:Key="CardContentSelector"
                                           BrightnessTemplate="{StaticResource BrightnessTemplate}"
                                           EyeCareTemplate="{StaticResource EyeCareTemplate}"/>
    </Page.Resources>

    <Grid Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="Others" 
                       FontSize="28" 
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Additional utilities and tools" 
                       FontSize="14" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Cards Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind Cards, Mode=OneTime}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="16"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:UtilityCard">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,16,16"
                                Width="320"
                                VerticalAlignment="Top"
                                x:Name="CardBorder">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Main Card Content (Clickable) -->
                                <Button Grid.Row="0"
                                        Click="UtilityCard_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="20"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Top">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Icon -->
                                        <FontIcon Grid.Row="0"
                                                  Glyph="{Binding Icon}"
                                                  FontSize="32"
                                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                  Margin="0,0,0,12"/>
                                        
                                        <!-- Title and Description -->
                                        <StackPanel Grid.Row="1" Spacing="6">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       LineHeight="18"
                                                       MaxLines="3"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        
                                        <!-- Status -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Status}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Margin="0,12,0,0"
                                                   Visibility="{Binding StatusVisibility}"/>
                                    </Grid>
                                </Button>

                                <!-- Expander for Quick Settings -->
                                <Expander Grid.Row="1"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Margin="12,0,12,12"
                                          IsExpanded="False"
                                          Loaded="CardExpander_Loaded"
                                          Expanding="CardExpander_Expanding"
                                          Collapsed="CardExpander_Collapsed">
                                    <Expander.Header>
                                        <TextBlock Text="Quick Settings"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Expander.Header>
                                    <Expander.Content>
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplateSelector="{StaticResource CardContentSelector}"
                                                        HorizontalContentAlignment="Stretch"/>
                                    </Expander.Content>
                                </Expander>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
