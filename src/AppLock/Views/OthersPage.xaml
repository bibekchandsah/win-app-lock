<Page
    x:Class="AppLock.Views.OthersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AppLock.Views"
    xmlns:controls="using:AppLock.Views.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Brightness Card Template -->
        <DataTemplate x:Key="BrightnessTemplate" x:DataType="local:UtilityCard">
            <StackPanel Spacing="12" Margin="0,8,0,0">
                <!-- Brightness Hotkeys Toggle -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Brightness Hotkeys"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Enable/disable all brightness shortcuts"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsOn="{x:Bind BrightnessHotkeysEnabled, Mode=OneWay}"
                                  Toggled="BrightnessHotkeysToggle_Toggled"
                                  MinWidth="0"
                                  OffContent=""
                                  OnContent=""/>
                </Grid>

                <!-- Blur Hotkey Toggle -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Blur Overlay Hotkey"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Enable/disable blur overlay shortcut"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsOn="{x:Bind BlurHotkeyEnabled, Mode=OneWay}"
                                  Toggled="BlurHotkeyToggle_Toggled"
                                  MinWidth="0"
                                  OffContent=""
                                  OnContent=""/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Eye Care Card Template -->
        <DataTemplate x:Key="EyeCareTemplate" x:DataType="local:UtilityCard">
            <StackPanel Spacing="12" Margin="0,8,0,0">
                <!-- Eye Care Toggle -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Eye Care Reminders"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Enable/disable periodic eye care reminders"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsOn="{x:Bind EyeCareEnabled, Mode=TwoWay}"
                                  Toggled="EyeCareToggle_Toggled"
                                  MinWidth="0"
                                  OffContent=""
                                  OnContent=""/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Clipboard Card Template -->
        <DataTemplate x:Key="ClipboardTemplate" x:DataType="local:UtilityCard">
            <controls:ClipboardCard Margin="0,4,0,0"/>
        </DataTemplate>

        <!-- Ring Light Card Template -->
        <DataTemplate x:Key="RingLightTemplate" x:DataType="local:UtilityCard">
            <StackPanel Spacing="12" Margin="0,8,0,0">
                <!-- Ring Light Toggle -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Ring Light"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Enable/disable edge ring light"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsOn="{x:Bind RingLightEnabled, Mode=TwoWay}"
                                  Toggled="RingLightToggle_Toggled"
                                  MinWidth="0"
                                  OffContent=""
                                  OnContent=""/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Volume Mixer Card Template -->
        <DataTemplate x:Key="VolumeMixerTemplate" x:DataType="local:UtilityCard">
            <StackPanel Spacing="12" Margin="0,8,0,0">
                <!-- Volume Mixer Toggle -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Floating Volume Overlay"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Enable/disable the volume mixer overlay"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsOn="{x:Bind VolumeMixerEnabled, Mode=TwoWay}"
                                  Toggled="VolumeMixerToggle_Toggled"
                                  MinWidth="0"
                                  OffContent=""
                                  OnContent=""/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Notifications Card Template -->
        <DataTemplate x:Key="NotificationsTemplate" x:DataType="local:UtilityCard">
            <StackPanel Spacing="12" Margin="0,8,0,0">
                <!-- Notifications Toggle -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Notification Customization"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Enable/disable custom notification positioning"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsOn="{x:Bind NotificationsEnabled, Mode=TwoWay}"
                                  Toggled="NotificationsToggle_Toggled"
                                  MinWidth="0"
                                  OffContent=""
                                  OnContent=""/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Keyboard Card Template -->
        <DataTemplate x:Key="KeyboardTemplate" x:DataType="local:UtilityCard">
            <StackPanel Spacing="12" Margin="0,8,0,0">
                <!-- Keyboard Toggle -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Enable Keyboard"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Enable/disable integrated keyboard"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsOn="{x:Bind KeyboardEnabled, Mode=TwoWay}"
                                  Toggled="KeyboardToggle_Toggled"
                                  MinWidth="0"
                                  OffContent=""
                                  OnContent=""/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Template Selector -->
        <local:CardContentTemplateSelector x:Key="CardContentSelector"
                                           BrightnessTemplate="{StaticResource BrightnessTemplate}"
                                           EyeCareTemplate="{StaticResource EyeCareTemplate}"
                                           ClipboardTemplate="{StaticResource ClipboardTemplate}"
                                           RingLightTemplate="{StaticResource RingLightTemplate}"
                                           VolumeMixerTemplate="{StaticResource VolumeMixerTemplate}"
                                           NotificationsTemplate="{StaticResource NotificationsTemplate}"
                                           KeyboardTemplate="{StaticResource KeyboardTemplate}"/>
    </Page.Resources>

    <Grid Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Others" 
                           FontSize="28" 
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Additional utilities and tools" 
                           FontSize="14" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Filters the cards below by their name or description -->
            <TextBox x:Name="SearchBox"
                     Grid.Column="1"
                     Width="260"
                     VerticalAlignment="Center"
                     PlaceholderText="Search utilities..."
                     TextChanged="SearchBox_TextChanged"/>
        </Grid>

        <!-- Responsive Cards Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind VisibleCards}">
                <!-- Cards filtered in by the search box fade/slide in instead of popping. -->
                <ItemsControl.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="16" IsStaggeringEnabled="True"/>
                    </TransitionCollection>
                </ItemsControl.ItemContainerTransitions>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:WrapPanel HorizontalSpacing="16" VerticalSpacing="16"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:UtilityCard">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,16,16"
                                Width="320"
                                VerticalAlignment="Top"
                                x:Name="CardBorder">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Main Card Content (Clickable) -->
                                <Button Grid.Row="0"
                                        Click="UtilityCard_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        Padding="20"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Top">
                                    <!-- The stock hover fill is almost white on a light card, so the card
                                         showed no hover at all in light mode. Literal colours per theme. -->
                                    <Button.Resources>
                                        <ResourceDictionary>
                                            <ResourceDictionary.ThemeDictionaries>
                                                <ResourceDictionary x:Key="Dark">
                                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26D9A0E8"/>
                                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3DD9A0E8"/>
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="Light">
                                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26B79BE8"/>
                                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3DB79BE8"/>
                                                </ResourceDictionary>
                                            </ResourceDictionary.ThemeDictionaries>
                                        </ResourceDictionary>
                                    </Button.Resources>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Icon -->
                                        <FontIcon Grid.Row="0"
                                                  Glyph="{Binding Icon}"
                                                  FontSize="32"
                                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                  Margin="0,0,0,12"/>
                                        
                                        <!-- Title and Description -->
                                        <StackPanel Grid.Row="1" Spacing="6">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       LineHeight="18"
                                                       MaxLines="3"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        
                                        <!-- Status -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Status}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Margin="0,12,0,0"
                                                   Visibility="{Binding StatusVisibility}"/>
                                    </Grid>
                                </Button>

                                <!-- Quick Settings opens as a floating panel, so the card grid never reflows -->
                                <Button Grid.Row="1"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Margin="12,0,12,12"
                                        Padding="12,8"
                                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        Click="QuickSettingsButton_Click">
                                    <Grid>
                                        <TextBlock Text="Quick Settings"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <FontIcon Glyph="&#xE70D;"
                                                  FontSize="10"
                                                  HorizontalAlignment="Right"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="NoResultsText"
                   Grid.Row="1"
                   Text="No utilities match your search"
                   FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Page>
