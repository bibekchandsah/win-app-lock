<ContentDialog
    x:Class="AppLock.Views.ResetPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Reset Admin Password"
    PrimaryButtonText="Reset Password"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" MinWidth="340">
        <TextBlock Text="Your identity has been verified. Enter a new admin password."
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <PasswordBox x:Name="NewPasswordBox"
                     Header="New Password"
                     PlaceholderText="Enter new password (min. 6 characters)"
                     PasswordRevealMode="Peek"
                     CornerRadius="4"
                     PasswordChanged="PasswordBox_PasswordChanged"/>

        <PasswordBox x:Name="ConfirmPasswordBox"
                     Header="Confirm New Password"
                     PlaceholderText="Re-enter new password"
                     PasswordRevealMode="Peek"
                     CornerRadius="4"
                     PasswordChanged="PasswordBox_PasswordChanged"/>

        <!-- Password strength indicator -->
        <StackPanel Spacing="4">
            <TextBlock Text="Password Strength:" FontSize="12"/>
            <ProgressBar x:Name="StrengthBar"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         CornerRadius="2"
                         Height="4"/>
            <TextBlock x:Name="StrengthText"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Foreground="{ThemeResource SystemErrorTextColor}"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>
