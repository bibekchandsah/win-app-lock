<Page
    x:Class="AppLock.Views.KeyboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Breadcrumb and title stay in place; only the cards scroll. -->
        <StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,16">
            <!-- Breadcrumb Navigation (same pattern as the Volume Mixer page) -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    TabIndex="0"
                    ToolTipService.ToolTip="Back"
                    AutomationProperties.Name="Back to Others">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Others"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="›"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Keyboard"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock 
                    Text="Keyboard" 
                    Style="{StaticResource TitleTextBlockStyle}"
                    FontWeight="SemiBold"/>
                <TextBlock 
                    Text="Control integrated laptop keyboard" 
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" MaxWidth="880" HorizontalAlignment="Left">
                <!-- Administrator Privileges Card (top of page, with a restart action) -->
                <Border 
                    x:Name="WarningCard"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Visibility="Collapsed">
                    <Grid ColumnDefinitions="Auto,*">
                        <FontIcon 
                            Grid.Column="0"
                            Glyph="&#xE7BA;"
                            FontSize="20"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Margin="0,0,16,0"
                            VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock 
                                x:Name="WarningTitle"
                                Text="Administrator Privileges Required"
                                Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock 
                                x:Name="WarningMessage"
                                Text="This feature requires administrator privileges. Please restart AppLock as administrator to enable or disable the keyboard."
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"/>
                            <Button 
                                Content="Restart as administrator" 
                                Click="RestartAsAdminButton_Click"
                                TabIndex="4"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Restart AppLock as administrator"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Master Toggle Card -->
                <Border 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock 
                                Text="Enable Keyboard" 
                                Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock 
                                Text="Enable or disable the integrated keyboard"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch 
                            x:Name="KeyboardToggle"
                            Grid.Column="1"
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            Toggled="KeyboardToggle_Toggled"
                            VerticalAlignment="Center"
                            TabIndex="1"
                            AutomationProperties.Name="Enable or disable the integrated keyboard"/>
                    </Grid>
                </Border>

                <!-- Lock Key Indicator Toggle Card -->
                <Border 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock 
                                Text="Lock Key Indicators" 
                                Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock 
                                Text="Show on-screen popup when you press Caps Lock, Num Lock, or Scroll Lock"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch 
                            x:Name="LockKeyIndicatorToggle"
                            Grid.Column="1"
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            Toggled="LockKeyIndicatorToggle_Toggled"
                            VerticalAlignment="Center"
                            TabIndex="2"
                            AutomationProperties.Name="Lock key indicators"/>
                    </Grid>
                </Border>

                <!-- About Card -->
                <Border 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock 
                            Text="About this feature" 
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock 
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}">
                            <Run Text="This feature allows you to instantly enable or disable all keyboard and mouse input. Useful when cleaning your keyboard or when you need to prevent accidental input."/>
                        </TextBlock>
                        <TextBlock 
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}">
                            <Run Text="• Works instantly without system restart"/>
                            <LineBreak/>
                            <Run Text="• Requires administrator privileges to use"/>
                            <LineBreak/>
                            <Run Text="• Blocks both keyboard and mouse input"/>
                            <LineBreak/>
                            <Run Text="• Re-enable by toggling the switch again"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Status Card -->
                <Border 
                    x:Name="StatusCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <FontIcon 
                            Grid.Column="0"
                            x:Name="StatusIcon"
                            Glyph="&#xE9F3;"
                            FontSize="20"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock 
                                Text="Current Status" 
                                Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock 
                                x:Name="StatusText"
                                Text="Checking..."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            x:Name="RefreshButton"
                            TabIndex="3"
                            AutomationProperties.Name="Refresh keyboard status"
                            Click="RefreshButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="4"
                            Padding="8"
                            VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Manual fallback when the toggle cannot apply the change -->
                <Border 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock 
                            Text="Manual method" 
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock 
                            Text="If the toggle above does not work, disable or enable the internal keyboard through the keyboard driver's start mode, then restart the PC."
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"/>

                        <StackPanel Spacing="6" Margin="0,6,0,0">
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}">
                                <Run Text="1. Press "/><Run Text="Win + R" FontWeight="SemiBold"/><Run Text=", type "/><Run Text="regedit" FontWeight="SemiBold"/><Run Text=" and press Enter."/>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}">
                                <Run Text="2. Navigate to"/>
                            </TextBlock>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Padding="10,6"
                                    HorizontalAlignment="Left">
                                <TextBlock 
                                    Text="Computer\HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\i8042prt"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}">
                                <Run Text="3. Set "/><Run Text="Start" FontWeight="SemiBold"/><Run Text=" to "/><Run Text="4" FontWeight="SemiBold"/><Run Text=" to disable the internal keyboard, or "/><Run Text="3" FontWeight="SemiBold"/><Run Text=" to enable it."/>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}">
                                <Run Text="4. Restart the PC for the change to take effect."/>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock 
                            Text="Note: disabling the driver turns off the built-in keyboard only. Keep a USB keyboard or the on-screen keyboard (Settings › Accessibility › Keyboard) available so you can turn it back on."
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
