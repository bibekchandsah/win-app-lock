<Page
    x:Class="AppLock.Views.KeyboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Spacing="16" Margin="40,24,40,40">
            <!-- Breadcrumb Navigation -->
            <Button 
                Click="BackButton_Click"
                Style="{StaticResource SubtleButtonStyle}"
                Padding="8,6"
                Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="12"/>
                    <TextBlock Text="Others" FontSize="13"/>
                    <TextBlock Text="/" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Keyboard" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Button>

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock 
                    Text="Keyboard" 
                    Style="{StaticResource TitleTextBlockStyle}"
                    FontWeight="SemiBold"/>
                <TextBlock 
                    Text="Control integrated laptop keyboard" 
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"/>
            </StackPanel>

            <!-- Master Toggle Card -->
            <Border 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock 
                            Text="Enable Keyboard" 
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock 
                            Text="Enable or disable the integrated keyboard"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch 
                        x:Name="KeyboardToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        OnContent=""
                        OffContent=""
                        Toggled="KeyboardToggle_Toggled"
                        VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- About Card -->
            <Border 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock 
                        Text="About this feature" 
                        Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock 
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}">
                        <Run Text="This feature allows you to instantly enable or disable all keyboard and mouse input. Useful when cleaning your keyboard or when you need to prevent accidental input."/>
                    </TextBlock>
                    <TextBlock 
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}">
                        <Run Text="• Works instantly without system restart"/>
                        <LineBreak/>
                        <Run Text="• Requires administrator privileges to use"/>
                        <LineBreak/>
                        <Run Text="• Blocks both keyboard and mouse input"/>
                        <LineBreak/>
                        <Run Text="• Re-enable by toggling the switch again"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Status Card -->
            <Border 
                x:Name="StatusCard"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <FontIcon 
                        Grid.Column="0"
                        x:Name="StatusIcon"
                        Glyph="&#xE9F3;"
                        FontSize="20"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock 
                            Text="Current Status" 
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock 
                            x:Name="StatusText"
                            Text="Checking..."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        x:Name="RefreshButton"
                        Click="RefreshButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="8"
                        VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Warning Card -->
            <Border 
                x:Name="WarningCard"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Visibility="Collapsed">
                <Grid ColumnDefinitions="Auto,*">
                    <FontIcon 
                        Grid.Column="0"
                        Glyph="&#xE7BA;"
                        FontSize="20"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Margin="0,0,16,0"
                        VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock 
                            x:Name="WarningTitle"
                            Text="Administrator Privileges Required"
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock 
                            x:Name="WarningMessage"
                            Text="This feature requires administrator privileges. Please restart AppLock as administrator to enable or disable the keyboard."
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
