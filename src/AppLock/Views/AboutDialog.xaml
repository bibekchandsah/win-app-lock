<ContentDialog
    x:Class="AppLock.Views.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About AppLock"
    CloseButtonText="Close"
    DefaultButton="Close"
    CornerRadius="8">

    <ContentDialog.Resources>
        <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="20" MinWidth="400" Padding="0,8">
        <!-- App Icon and Name -->
        <StackPanel HorizontalAlignment="Center" Spacing="12">
            <Border Width="80" Height="80"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="16">
                <FontIcon Glyph="&#xE72E;" FontSize="48" Foreground="White"/>
            </Border>
            
            <TextBlock Text="AppLock"
                       Style="{StaticResource TitleTextBlockStyle}"
                       HorizontalAlignment="Center"/>
            
            <TextBlock x:Name="VersionText"
                       Text="Version 1.0.0"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Description -->
        <TextBlock TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
            A Windows desktop app that locks selected applications and windows behind a password or Windows Hello.
        </TextBlock>

        <!-- Links -->
        <StackPanel Spacing="8">
            <HyperlinkButton Content="GitHub Repository"
                             Click="GitHubButton_Click"
                             HorizontalAlignment="Center"/>
            
            <HyperlinkButton Content="Documentation"
                             HorizontalAlignment="Center"
                             IsEnabled="False"/>
        </StackPanel>

        <!-- Copyright -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel Spacing="8">
                <TextBlock Text="© 2024 AppLock"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                
                <TextBlock Text="Licensed under MIT License"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Credits -->
        <StackPanel Spacing="4">
            <TextBlock Text="Built with:"
                       FontWeight="SemiBold"
                       FontSize="12"/>
            <TextBlock Text="• WinUI 3 / Windows App SDK"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="• Community Toolkit MVVM"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="• CsWin32 for native interop"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>
