<Page
    x:Class="AppLock.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Left">
                <TextBlock x:Name="PageTitle"
                           Text="Settings" 
                           Style="{ThemeResource TitleTextBlockStyle}"
                           Margin="0,0,0,8"/>

                <!-- General Section -->
                <Expander x:Name="ExpanderGeneral"
                          Header="General" 
                          IsExpanded="True" 
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <Expander.Content>
                        <StackPanel Spacing="16" Padding="16,12" HorizontalAlignment="Stretch">
                            <!-- Language -->
                            <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtLanguage" Grid.Column="0" Text="Language" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          x:Name="LanguageComboBox"
                                          ItemsSource="{x:Bind ViewModel.Languages}"
                                          SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                                          MinWidth="140"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Theme -->
                            <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtTheme" Grid.Column="0" Text="Theme" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          x:Name="ThemeComboBox"
                                          ItemsSource="{x:Bind ViewModel.Themes}"
                                          SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                                          MinWidth="140"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Start with Windows -->
                            <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtStartWithWindows" Grid.Column="0" Text="Start with Windows" VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Mute Notifications -->
                            <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtMuteNotifications" Text="Mute notifications"/>
                                    <TextBlock x:Name="TxtMuteNotificationsDesc" 
                                               Text="When on, in-app tips are silenced."
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.MuteNotifications, Mode=TwoWay}"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Expand Navigation Pane -->
                            <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtNavPane" Text="Navigation pane"/>
                                    <TextBlock x:Name="TxtNavPaneDesc" 
                                               Text="Expand navigation pane with text labels."
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.IsNavPaneExpanded, Mode=TwoWay}"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!-- Security Section -->
                <Expander x:Name="ExpanderSecurity"
                          Header="Security &amp; Authentication" 
                          IsExpanded="True" 
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <Expander.Content>
                        <StackPanel Spacing="16" Padding="16,12" HorizontalAlignment="Stretch">
                            <!-- Change Password -->
                            <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtAdminPassword" Grid.Column="0" Text="Admin password" VerticalAlignment="Center"/>
                                <Button x:Name="BtnChangePassword"
                                        Grid.Column="1"
                                        Content="Change admin password"
                                        Click="ChangePasswordButton_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Security Questions -->
                            <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtSecurityQuestions" Grid.Column="0" Text="Security Questions" VerticalAlignment="Center"/>
                                <Button x:Name="BtnSecurityQuestions"
                                        Grid.Column="1"
                                        Content="Security Questions"
                                        Click="SecurityQuestionsButton_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Lockout Duration -->
                            <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtLockoutDuration" Text="Lockout duration (minutes)"/>
                                    <TextBlock x:Name="TxtLockoutDurationDesc" 
                                               Text="Lockout duration after exceeding max attempts."
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <NumberBox Grid.Column="1"
                                           x:Name="LockoutDurationBox"
                                           Value="{x:Bind ViewModel.LockoutDuration, Mode=TwoWay}"
                                           Minimum="1"
                                           Maximum="60"
                                           SpinButtonPlacementMode="Inline"
                                           MinWidth="110"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Windows Hello -->
                            <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtWindowsHello" Text="Windows Hello unlock"/>
                                    <TextBlock x:Name="TxtWindowsHelloDesc" 
                                               Text="Use fingerprint or face recognition instead of the admin password (device support required)."
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.WindowsHelloEnabled, Mode=TwoWay}"
                                              IsEnabled="{x:Bind ViewModel.WindowsHelloAvailable, Mode=OneWay}"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Windows Hello: open the prompt automatically -->
                            <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAutoHello" Text="Open Windows Hello automatically"/>
                                    <TextBlock x:Name="TxtAutoHelloDesc"
                                               Text="Start the fingerprint or face prompt as soon as AppLock asks for your password, so you don't have to type it."
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.AutoPromptWindowsHello, Mode=TwoWay}"
                                              IsEnabled="{x:Bind ViewModel.WindowsHelloEnabled, Mode=OneWay}"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!-- Auto & Emergency Lock Section -->
                <Expander x:Name="ExpanderAutoLock"
                          Header="Auto &amp; Emergency Lock" 
                          IsExpanded="True" 
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <Expander.Content>
                        <StackPanel Spacing="16" Padding="16,12" HorizontalAlignment="Stretch">
                            <!-- Auto-lock when idle -->
                            <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAutoLockIdle" Text="Auto-lock when idle"/>
                                    <TextBlock x:Name="TxtAutoLockIdleDesc" 
                                               Text="Hide the main window and require the admin password again after this period without keyboard/mouse activity. Set to 0 to disable."
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumberBox Grid.Column="1"
                                           x:Name="AutoLockIdleBox"
                                           Value="{x:Bind ViewModel.AutoLockIdleMinutes, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="120"
                                           SpinButtonPlacementMode="Inline"
                                           MinWidth="110"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Emergency Hotkey -->
                            <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtEmergencyHotkey" Text="Emergency lock hotkey"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,2">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10,4">
                                            <TextBlock Text="{x:Bind ViewModel.EmergencyHotkey, Mode=OneWay}"
                                                       FontFamily="Consolas"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                        <Button Content="Change"
                                                Click="ChangeHotkeyButton_Click"
                                                IsEnabled="{x:Bind ViewModel.EmergencyHotkeyEnabled, Mode=OneWay}"
                                                Padding="12,4"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtEmergencyHotkeyDesc" 
                                               Text="Press this combination to lock all protected apps instantly; rebind it if it clashes with another program."
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.EmergencyHotkeyEnabled, Mode=TwoWay}"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Top"
                                              Margin="0,4,0,0"/>
                            </Grid>

                            <!-- Keep lock screen on top -->
                            <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtKeepOnTop" Text="Keep lock screen on top"/>
                                    <TextBlock x:Name="TxtKeepOnTopDesc" 
                                               Text="On: the lock screen stays above every other window. Off: it only covers the locked window, so other apps can be placed over it."
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.KeepLockScreenOnTop, Mode=TwoWay}"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!-- About Section -->
                <Expander x:Name="ExpanderAbout"
                          Header="About" 
                          IsExpanded="True" 
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <Expander.Content>
                        <StackPanel Spacing="16" Padding="16,12" HorizontalAlignment="Stretch">
                            <!-- About AppLock -->
                            <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAbout" Text="About AppLock"/>
                                    <TextBlock x:Name="TxtAboutDesc" 
                                               Text="Version, developer details, project inspiration, and links."
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <Button x:Name="BtnAbout"
                                        Grid.Column="1"
                                        Content="About AppLock"
                                        Click="AboutButton_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Expander.Content>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
