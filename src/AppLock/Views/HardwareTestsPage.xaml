<Page
    x:Class="AppLock.Views.HardwareTestsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24,20,24,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Breadcrumb and title -->
        <StackPanel Grid.Row="0" Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackButton"
                        Click="BackButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        TabIndex="0"
                        ToolTipService.ToolTip="Back"
                        AutomationProperties.Name="Back to PC Checker">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Others"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="›"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="PC Checker"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="›"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Hardware tests"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="Hardware tests"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Check what each part of this PC actually does, not just what it reports"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <TabView Grid.Row="1" IsAddTabButtonVisible="False" TabWidthMode="SizeToContent">
            <!-- ══ CPU & RAM ══ -->
            <TabViewItem IsClosable="False" Header="CPU &amp; RAM">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE950;"/>
                </TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left" Padding="0,16,0,0">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Processor and memory"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="Runs arithmetic on one thread and then on every core, and measures how fast memory can be copied. The numbers are relative to this PC — compare them with a run from another machine, or with an earlier run, to see whether something slowed down."/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="RunCpuButton" Content="Run CPU &amp; RAM test" Click="RunCpuTest_Click"/>
                                    <ProgressRing x:Name="CpuRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="CpuResultText"
                                           Text="Not run yet."
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ══ Disk ══ -->
            <TabViewItem IsClosable="False" Header="Disk">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xEDA2;"/>
                </TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left" Padding="0,16,0,0">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Read and write speed"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Writes a temporary 256 MB file to the selected drive, reads it back, then deletes it. Pick the drive with the disk you want to check."/>
                                <ComboBox x:Name="DiskDriveBox" Width="360" HorizontalAlignment="Left"
                                          Header="Drive" AutomationProperties.Name="Drive to test"
                                          SelectionChanged="DiskDriveBox_SelectionChanged"/>
                                <TextBlock x:Name="DiskTypeDetailsText"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,-4,0,4"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="RunDiskButton" Content="Run disk test" Click="RunDiskTest_Click"/>
                                    <ProgressBar x:Name="DiskProgress" Width="220" Minimum="0" Maximum="1" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="DiskResultText"
                                           Text="Not run yet."
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           IsTextSelectionEnabled="True"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ══ Network ══ -->
            <TabViewItem IsClosable="False" Header="Network">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE774;"/>
                </TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left" Padding="0,16,0,0">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Internet speed"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Downloads a 25 MB test file and reports the real throughput of the whole path — router, line and server included. Needs an internet connection; on a metered connection this uses data."/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="RunNetworkButton" Content="Run speed test" Click="RunNetworkTest_Click"/>
                                    <ProgressBar x:Name="NetworkProgress" Width="220" Minimum="0" Maximum="1" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="NetworkResultText"
                                           Text="Not run yet."
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           IsTextSelectionEnabled="True"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ══ Speaker ══ -->
            <TabViewItem IsClosable="False" Header="Speaker">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE767;"/>
                </TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left" Padding="0,16,0,0">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Play a test tone"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Plays a short tone through the chosen speaker. If you hear it, that speaker and its volume are working; if the tone plays but you hear nothing, check the cable and the Windows volume mixer."/>
                                <ComboBox x:Name="SpeakerBox" Width="360" HorizontalAlignment="Left"
                                          Header="Speaker" AutomationProperties.Name="Speaker to test"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="PlayToneButton" Content="Play tone" Click="PlayTone_Click"/>
                                    <Button x:Name="StopToneButton" Content="Stop" Click="StopTone_Click" IsEnabled="False"/>
                                </StackPanel>
                                <TextBlock x:Name="SpeakerStatusText"
                                           Text="Idle."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ══ Microphone ══ -->
            <TabViewItem IsClosable="False" Header="Microphone">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE720;"/>
                </TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left" Padding="0,16,0,0">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Check the microphone level"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Records for as long as you keep the test running and shows how loud the chosen microphone hears you. Speak normally: the bar should move. Nothing is saved or sent anywhere."/>
                                <ComboBox x:Name="MicrophoneBox" Width="360" HorizontalAlignment="Left"
                                          Header="Microphone" AutomationProperties.Name="Microphone to test"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="StartMicButton" Content="Start microphone test" Click="StartMicTest_Click"/>
                                    <Button x:Name="StopMicButton" Content="Stop" Click="StopMicTest_Click" IsEnabled="False"/>
                                </StackPanel>
                                <ProgressBar x:Name="MicLevelBar" Minimum="0" Maximum="100" Height="10" Width="420" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="MicStatusText"
                                           Text="Idle."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ══ Keyboard & mouse ══ -->
            <TabViewItem IsClosable="False" Header="Keyboard &amp; mouse">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE765;"/>
                </TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left" Padding="0,16,0,0">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Press keys and click inside the pad"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Click inside the pad, then type any keys and click the mouse buttons. Each input is echoed here, so a key or button that never appears is a key or button that is not reaching Windows."/>
                                <Border x:Name="InputPad"
                                        IsTabStop="True"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        KeyDown="InputPad_KeyDown"
                                        KeyUp="InputPad_KeyUp"
                                        LostFocus="InputPad_LostFocus"
                                        PointerPressed="InputPad_PointerPressed"
                                        PointerMoved="InputPad_PointerMoved"
                                        PointerReleased="InputPad_PointerReleased"
                                        PointerCaptureLost="InputPad_PointerCaptureLost"
                                        AutomationProperties.Name="Keyboard and mouse test pad">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="InputPadHint"
                                                   Text="Click anywhere in this pad, then press keys or mouse buttons — each key and button lights up while it is held."
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <!-- Laid out like a real keyboard and mouse, built in code so every cap can be looked up -->
                                        <!-- Scrolls sideways on a narrow window instead of clipping the layout -->
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                      HorizontalScrollMode="Auto"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      VerticalScrollMode="Disabled">
                                            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Left">
                                                <StackPanel x:Name="KeyboardLayoutHost"
                                                            Orientation="Horizontal"
                                                            Spacing="10"
                                                            VerticalAlignment="Top"/>
                                                <StackPanel x:Name="MouseDiagramHost"
                                                            Spacing="6"
                                                            VerticalAlignment="Top"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="LastInputText"
                                           Text="No input yet."
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           IsTextSelectionEnabled="True"/>
                                <TextBlock x:Name="InputCountText"
                                           Text="Keys: 0 left clicks: 0 right clicks: 0 other buttons: 0"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="HeldKeysText"
                                           Text="Keys held: none"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="CoverageText"
                                           Text="Keys tested: 0 of 0 — faint keys have not been pressed yet"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button Content="Reset counters" Click="ResetInput_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ══ Camera ══ -->
            <TabViewItem IsClosable="False" Header="Camera">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE722;"/>
                </TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left" Padding="0,16,0,0">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Camera preview"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Starts the selected camera and shows its picture. Nothing is recorded or saved — the frames only live in memory while the preview runs."/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="StartCameraButton" Content="Start camera" Click="StartCamera_Click"/>
                                    <Button x:Name="StopCameraButton" Content="Stop" Click="StopCamera_Click" IsEnabled="False"/>
                                </StackPanel>
                                <Border Height="320" Background="#11000000" CornerRadius="6">
                                    <MediaPlayerElement x:Name="CameraPreview"
                                                        AreTransportControlsEnabled="False"
                                                        Stretch="Uniform"
                                                        AutomationProperties.Name="Camera preview"/>
                                </Border>
                                <TextBlock x:Name="CameraStatusText"
                                           Text="Idle."
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ══ Touch & pen ══ -->
            <TabViewItem IsClosable="False" Header="Touch &amp; pen">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE7C9;"/>
                </TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left" Padding="0,16,0,0">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Display and input capabilities"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Whether this PC's display takes touch, whether a pen or stylus is present, and how many fingers it can track at once."/>
                                <TextBlock x:Name="TouchSummaryText"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           IsTextSelectionEnabled="True"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
