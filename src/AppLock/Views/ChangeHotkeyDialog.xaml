<ContentDialog
    x:Class="AppLock.Views.ChangeHotkeyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Change Emergency Hotkey"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" MinWidth="400">
        <TextBlock Text="Set a new emergency lock hotkey"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <StackPanel Spacing="8">
            <TextBlock Text="Current Hotkey:" FontWeight="SemiBold"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8">
                <TextBlock x:Name="CurrentHotkeyText" FontFamily="Consolas"/>
            </Border>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="New Hotkey:" FontWeight="SemiBold"/>
            <!-- Recorded hotkey display (shown in record mode) -->
            <Border x:Name="RecordedHotkeyDisplay"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    MinHeight="40">
                <TextBlock x:Name="NewHotkeyText" 
                           FontFamily="Consolas"
                           VerticalAlignment="Center"/>
            </Border>
            <!-- Manual text input (shown in manual mode) -->
            <TextBox x:Name="ManualHotkeyBox"
                     FontFamily="Consolas"
                     PlaceholderText="e.g. Ctrl+Alt+L or Ctrl+Shift+F10"
                     Visibility="Collapsed"
                     TextChanged="ManualHotkeyBox_TextChanged"/>
        </StackPanel>

        <!-- Record mode controls -->
        <StackPanel x:Name="RecordModePanel" Spacing="8">
            <Button x:Name="RecordButton"
                    Content="Record Hotkey"
                    Click="RecordButton_Click"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}"/>
            <TextBlock x:Name="InstructionText"
                       Text="Click 'Record Hotkey' to set a new emergency hotkey"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Toggle between modes -->
        <HyperlinkButton x:Name="ToggleModeButton"
                         Content="Can't capture Ctrl+Alt combos? Type it manually →"
                         Click="ToggleModeButton_Click"
                         HorizontalAlignment="Left"
                         FontSize="12"/>

        <!-- Invisible element to capture keyboard input -->
        <Border x:Name="CaptureElement"
                Height="0"
                Width="0"
                IsTabStop="True"
                PreviewKeyDown="CaptureElement_PreviewKeyDown"
                PreviewKeyUp="CaptureElement_PreviewKeyUp"/>

        <InfoBar Severity="Informational"
                 IsOpen="True"
                 IsClosable="False"
                 Message="Must include at least one modifier (Ctrl, Alt, Shift, Win) + a key. Ctrl+Alt may conflict with AltGr — use manual entry if needed."/>

        <TextBlock x:Name="ErrorText"
                   Foreground="{ThemeResource SystemErrorTextColor}"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>
