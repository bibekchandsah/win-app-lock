<UserControl
    x:Class="AppLock.Views.ScreenTimeTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AppLock.Views"
    xmlns:controls="using:AppLock.Views.Controls"
    xmlns:vm="using:AppLock.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBoolConverter x:Key="InverseBool"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Range bar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <RadioButtons x:Name="RangeSelector"
                          Grid.Column="0"
                          MaxColumns="3"
                          SelectedIndex="0"
                          SelectionChanged="RangeSelector_SelectionChanged">
                <RadioButton Content="Today"/>
                <RadioButton Content="Week"/>
                <RadioButton Content="Month"/>
            </RadioButtons>

            <TextBlock x:Name="RangeTitleText"
                       Grid.Column="1"
                       Text="{x:Bind ViewModel.RangeTitle, Mode=OneWay}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <Button x:Name="PreviousButton"
                    Grid.Column="2"
                    Click="PreviousButton_Click"
                    Padding="8,6"
                    ToolTipService.ToolTip="Previous period">
                <FontIcon Glyph="&#xE76B;" FontSize="12"/>
            </Button>

            <Button x:Name="NextButton"
                    Grid.Column="3"
                    Click="NextButton_Click"
                    Padding="8,6"
                    ToolTipService.ToolTip="Next period">
                <FontIcon Glyph="&#xE76C;" FontSize="12"/>
            </Button>

            <Button x:Name="MoreButton"
                    Grid.Column="4"
                    Padding="8,6"
                    ToolTipService.ToolTip="More options">
                <FontIcon Glyph="&#xE712;" FontSize="12"/>
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="Export CSV…" Click="ExportCsv_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE896;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Settings…" Click="Settings_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE713;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <ToggleMenuFlyoutItem x:Name="ShowHiddenMenuItem"
                                              Text="Show hidden apps"
                                              Click="ShowHidden_Click">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7B3;"/>
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Clear all screen time data…" Click="ClearData_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Info bars -->
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar x:Name="TrackingOffBar"
                     Severity="Warning"
                     IsOpen="False"
                     IsClosable="False"
                     Title="Screen time tracking is off"
                     Message="Apps with a daily limit are still enforced, but no history is being recorded.">
                <InfoBar.ActionButton>
                    <Button Content="Turn on" Click="TurnOnTracking_Click"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="ProtectionOffBar"
                     Severity="Informational"
                     IsOpen="False"
                     IsClosable="False"
                     Title="Protection is off"
                     Message="Limits are paused; screen time is still being recorded."/>
        </StackPanel>

        <!-- Summary cards -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Total screen time"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalText, Mode=OneWay}"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.DeltaText, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind ViewModel.ShowDelta, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- How often the PC was unlocked: the wellbeing "pickups" number, from session events. -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Unlocks"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind ViewModel.UnlockValue, Mode=OneWay}"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.UnlockSubtext, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.SecondTitle, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind ViewModel.SecondValue, Mode=OneWay}"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.SecondSubtext, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border x:Name="MostUsedTile"
                                CornerRadius="6"
                                Visibility="{x:Bind ViewModel.MostUsedIcon, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
                            <TextBlock x:Name="MostUsedInitial"
                                       Text="—"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Image Source="{x:Bind ViewModel.MostUsedIcon, Mode=OneWay}"
                               Width="32" Height="32"
                               Stretch="Uniform"
                               Visibility="{x:Bind ViewModel.MostUsedIcon, Mode=OneWay, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="Most used app"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind ViewModel.MostUsedName, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind ViewModel.MostUsedTime, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Chart and donut sit side by side and share the width, so neither is clipped when the window shrinks -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Activity"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="ChartSubtitle"
                                   Grid.Column="1"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- The chart grows with the card, so the donut beside it does not leave an empty gap -->
                    <Grid Grid.Row="1">
                        <controls:UsageBarChart x:Name="BarChart" MinHeight="190"/>
                        <controls:UsageCalendarHeat x:Name="MonthHeat" MinHeight="200" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="App share"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1"
                                   Text="Most used first"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <controls:UsageDonutChart x:Name="DonutChart" Width="200" Height="200" HorizontalAlignment="Center"/>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.DonutLegend, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DonutLegendItem">
                                <Grid ColumnSpacing="8" Padding="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            Background="{x:Bind Brush}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Label}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind ShareText}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- App list header -->
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     PlaceholderText="Search apps"
                     TextChanged="SearchBox_TextChanged"/>

            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.RowCountText, Mode=OneWay}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <Button Grid.Column="2"
                    Content="{x:Bind ViewModel.ShowAllText, Mode=OneWay}"
                    Click="ShowAll_Click"
                    Visibility="{x:Bind ViewModel.ShowAllButton, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- App list -->
        <Border Grid.Row="5"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <ListView x:Name="AppList"
                          ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="AppList_ItemClick"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.BringIntoViewOnFocusChange="False"
                          Visibility="{x:Bind ViewModel.HasData, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <!-- Only added/removed rows animate, so a refresh updates numbers without
                         replaying an entrance animation over the whole list. -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition/>
                            <ReorderThemeTransition/>
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppUsageRowViewModel">
                            <Grid Padding="12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="34" Height="34" VerticalAlignment="Center">
                                    <Border CornerRadius="6"
                                            Background="{x:Bind ColorBrush}"
                                            Visibility="{x:Bind Icon, Converter={StaticResource NullToVisibility}}">
                                        <TextBlock Text="{x:Bind Initial}"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Image Source="{x:Bind Icon}"
                                           Width="32" Height="32"
                                           Stretch="Uniform"
                                           Visibility="{x:Bind Icon, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind DisplayName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind TimeText, Mode=OneWay}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind OpensText, Mode=OneWay}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                    Visibility="{x:Bind HasLimit, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <FontIcon Glyph="&#xE916;"
                                                      FontSize="10"
                                                      Foreground="{x:Bind LimitBrush, Mode=OneWay}"/>
                                            <TextBlock Text="{x:Bind LimitStateText, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{x:Bind LimitBrush, Mode=OneWay}"/>
                                            <TextBlock Text="{x:Bind ExtraText, Mode=OneWay}"
                                                       FontSize="10"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind HasExtra, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                    <ProgressBar Value="{x:Bind SharePercent, Mode=OneWay}"
                                                 Maximum="100"
                                                 Height="3"
                                                 Foreground="{x:Bind ColorBrush}"/>
                                    <ProgressBar Value="{x:Bind LimitProgress, Mode=OneWay}"
                                                 Maximum="100"
                                                 Height="3"
                                                 Foreground="{x:Bind LimitBrush, Mode=OneWay}"
                                                 Visibility="{x:Bind HasLimit, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>

                                <Button Grid.Column="3"
                                        Padding="6,4"
                                        Tag="{x:Bind}"
                                        Click="RowMenu_Click"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="App actions">
                                    <FontIcon Glyph="&#xE712;" FontSize="12"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <StackPanel x:Name="EmptyState"
                            Spacing="10"
                            MaxWidth="420"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.HasData, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <FontIcon Glyph="&#xE9D9;" FontSize="30"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="Screen time will appear here as you use your PC."
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Only the app in front counts, and only while you are active."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <Button Content="Turn on tracking"
                            HorizontalAlignment="Center"
                            Click="TurnOnTracking_Click"
                            Visibility="{x:Bind ViewModel.IsTrackingEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status line -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>

            <HyperlinkButton Grid.Column="1"
                             Content="Settings"
                             Click="Settings_Click"
                             Padding="4,0"/>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
