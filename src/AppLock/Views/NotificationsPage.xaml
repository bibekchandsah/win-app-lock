<Page
    x:Class="AppLock.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AppLock.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <local:AnchorToBoolConverter x:Key="AnchorToBoolConverter"/>
    </Page.Resources>

    <Grid Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back Button and Breadcrumb -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Others" 
                           FontSize="14" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="›" 
                           FontSize="14" 
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Notifications" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Page Header -->
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="Notifications" 
                       FontSize="28" 
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Customize where notifications appear and how they animate" 
                       FontSize="14" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
                
                <!-- Master Toggle Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE91C;"
                                  FontSize="20"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"/>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Customize notification position and animation"
                                       FontWeight="SemiBold"
                                       FontSize="14"/>
                            <TextBlock Text="Override Windows default notification placement"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <ToggleSwitch Grid.Column="2"
                                      IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}"
                                      MinWidth="0"
                                      OnContent=""
                                      OffContent=""
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- About this feature Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE946;"
                                  FontSize="20"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"/>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="About this feature"
                                       FontWeight="SemiBold"
                                       FontSize="14"/>
                            <TextBlock Text="This feature repositions Windows notification toasts. It relies on undocumented shell behavior and may break with Windows updates. Only toast banners are affected, not the Notification Center."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status and Test Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE7E8;"
                                      FontSize="20"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,0"/>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Test Notifications"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>
                                <TextBlock Text="Send test notifications and view detected toast windows"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Status -->
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <!-- Test Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Send Test Notification"
                                    Command="{x:Bind ViewModel.SendTestNotificationCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsSending, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
                            <Button Content="Send After 3 Seconds"
                                    Command="{x:Bind ViewModel.SendDelayedTestNotificationCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsSending, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
                            <Button Content="Refresh"
                                    Command="{x:Bind ViewModel.RefreshCandidatesCommand}"/>
                            <Button Content="Check Service"
                                    Command="{x:Bind ViewModel.CheckServiceStatusCommand}"
                                    Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>

                        <!-- Diagnostics List -->
                        <TextBlock Text="Candidate Toast Windows:"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,8,0,4"/>

                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                MaxHeight="400">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Candidates, Mode=OneWay}"
                                              Padding="8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:ToastCandidateViewModel">
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="12"
                                                    Margin="0,0,0,8">
                                                <StackPanel Spacing="4">
                                                    <TextBlock FontSize="12">
                                                        <Run Text="HWND: " FontWeight="SemiBold"/>
                                                        <Run Text="{x:Bind Hwnd}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="Class: " FontWeight="SemiBold"/>
                                                        <Run Text="{x:Bind ClassName}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="Title: " FontWeight="SemiBold"/>
                                                        <Run Text="{x:Bind WindowTitle}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="Process: " FontWeight="SemiBold"/>
                                                        <Run Text="{x:Bind ProcessName}"/>
                                                        <Run Text=" (PID: "/>
                                                        <Run Text="{x:Bind ProcessId}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="Rect: " FontWeight="SemiBold"/>
                                                        <Run Text="{x:Bind Rect}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="Size: " FontWeight="SemiBold"/>
                                                        <Run Text="{x:Bind Size}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="Styles: " FontWeight="SemiBold"/>
                                                        <Run Text="{x:Bind Styles}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="ExStyles: " FontWeight="SemiBold"/>
                                                        <Run Text="{x:Bind ExStyles}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

<!-- Position Settings (Milestone 2) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Visibility="{x:Bind ViewModel.Enabled, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE81D;"
                                      FontSize="20"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,0"/>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Position Settings"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>
                                <TextBlock Text="Choose where notifications appear on screen"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Anchor Selection -->
                        <TextBlock Text="Anchor Position:"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,8,0,4"/>
                        
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: 3x3 Anchor Grid -->
                            <Grid Grid.Column="0" Width="200">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 1 -->
                                <RadioButton Grid.Row="0" Grid.Column="0" Content="TL" GroupName="Anchor" Tag="TopLeft"
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=OneWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=TopLeft}"
                                             Checked="AnchorRadio_Checked"
                                             HorizontalAlignment="Stretch" Margin="2"/>
                                <RadioButton Grid.Row="0" Grid.Column="1" Content="TC" GroupName="Anchor" Tag="TopCenter"
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=OneWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=TopCenter}"
                                             Checked="AnchorRadio_Checked"
                                             HorizontalAlignment="Stretch" Margin="2"/>
                                <RadioButton Grid.Row="0" Grid.Column="2" Content="TR" GroupName="Anchor" Tag="TopRight"
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=OneWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=TopRight}"
                                             Checked="AnchorRadio_Checked"
                                             HorizontalAlignment="Stretch" Margin="2"/>

                                <!-- Row 2 -->
                                <RadioButton Grid.Row="1" Grid.Column="0" Content="ML" GroupName="Anchor" Tag="MiddleLeft"
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=OneWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=MiddleLeft}"
                                             Checked="AnchorRadio_Checked"
                                             HorizontalAlignment="Stretch" Margin="2"/>
                                <RadioButton Grid.Row="1" Grid.Column="1" Content="C" GroupName="Anchor" Tag="Center"
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=OneWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=Center}"
                                             Checked="AnchorRadio_Checked"
                                             HorizontalAlignment="Stretch" Margin="2"/>
                                <RadioButton Grid.Row="1" Grid.Column="2" Content="MR" GroupName="Anchor" Tag="MiddleRight"
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=OneWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=MiddleRight}"
                                             Checked="AnchorRadio_Checked"
                                             HorizontalAlignment="Stretch" Margin="2"/>

                                <!-- Row 3 -->
                                <RadioButton Grid.Row="2" Grid.Column="0" Content="BL" GroupName="Anchor" Tag="BottomLeft"
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=OneWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=BottomLeft}"
                                             Checked="AnchorRadio_Checked"
                                             HorizontalAlignment="Stretch" Margin="2"/>
                                <RadioButton Grid.Row="2" Grid.Column="1" Content="BC" GroupName="Anchor" Tag="BottomCenter"
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=OneWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=BottomCenter}"
                                             Checked="AnchorRadio_Checked"
                                             HorizontalAlignment="Stretch" Margin="2"/>
                                <RadioButton Grid.Row="2" Grid.Column="2" Content="BR" GroupName="Anchor" Tag="BottomRight"
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=OneWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=BottomRight}"
                                             Checked="AnchorRadio_Checked"
                                             HorizontalAlignment="Stretch" Margin="2"/>
                            </Grid>

                            <!-- Right: Desktop Preview with Frame -->
                            <Border Grid.Column="1" 
                                    x:Name="DesktopPreviewContainer"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="16,0,0,0"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Live Preview"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    
                                    <Border x:Name="DesktopPreviewBorder"
                                            Width="400" 
                                            Height="225"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid>
                                            <!-- Wallpaper background -->
                                            <Image x:Name="WallpaperImage" 
                                                   Stretch="UniformToFill"
                                                   Source="{x:Bind ViewModel.WallpaperImageSource, Mode=OneWay}"/>
                                            
                                            <!-- Overlay showing toast position -->
                                            <Canvas x:Name="ToastPreviewCanvas">
                                                <Border x:Name="ToastPreviewRect"
                                                        Background="#40FFFFFF"
                                                        BorderBrush="#FFFFFFFF"
                                                        BorderThickness="2"
                                                        CornerRadius="6"
                                                        Width="120"
                                                        Height="32"
                                                        Opacity="{x:Bind ViewModel.PreviewOpacity, Mode=OneWay}"
                                                        Canvas.Left="{x:Bind ViewModel.PreviewToastLeft, Mode=OneWay}"
                                                        Canvas.Top="{x:Bind ViewModel.PreviewToastTop, Mode=OneWay}">
                                                    <!-- Inner content to show it's a notification -->
                                                    <Grid Padding="4">
                                                        <TextBlock Text="Toast"
                                                                   FontSize="8"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </Canvas>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Custom Position Button -->
                        <Button Content="Pick Custom Position on Screen"
                                Command="{x:Bind ViewModel.PickCustomPositionCommand}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"/>
                        
                        <TextBlock Text="{x:Bind ViewModel.AnchorDisplayText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0"/>

                        <!-- Margin -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Edge Margin:"
                                       VerticalAlignment="Center"
                                       FontSize="13"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.MarginText, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>

                        <CheckBox Content="Respect taskbar"
                                  IsChecked="{x:Bind ViewModel.RespectTaskbar, Mode=TwoWay}"
                                  FontSize="13"/>

                        <!-- Opacity Control -->
                        <TextBlock Text="Notification Transparency:"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,12,0,4"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Slider Grid.Column="0"
                                    Minimum="10"
                                    Maximum="100"
                                    Value="{x:Bind ViewModel.OpacityPercent, Mode=TwoWay}"
                                    StepFrequency="5"
                                    TickFrequency="10"
                                    TickPlacement="Outside"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"/>
                            
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.OpacityText, Mode=OneWay}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center"
                                       MinWidth="50"
                                       TextAlignment="Right"/>
                        </Grid>
                        
                        <TextBlock Text="Lower values make notifications more transparent"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Margin="0,4,0,0"/>

                        <!-- Click-through -->
                        <CheckBox x:Name="ClickThroughCheckBox"
                                  Content="Click-through (notifications don't capture mouse clicks)"
                                  IsChecked="False"
                                  Checked="ClickThroughCheckBox_Changed"
                                  Unchecked="ClickThroughCheckBox_Changed"
                                  Margin="0,12,0,0"
                                  FontSize="13"/>

                        <CheckBox x:Name="AltToInteractCheckBox"
                                  Content="Hold Alt key to interact with click-through notifications"
                                  IsChecked="True"
                                  Checked="AltToInteractCheckBox_Changed"
                                  Unchecked="AltToInteractCheckBox_Changed"
                                  IsEnabled="{x:Bind ClickThroughCheckBox.IsChecked.Value, Mode=OneWay, FallbackValue=False}"
                                  Margin="24,4,0,0"
                                  FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Animation Settings (Milestone 4) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Visibility="{x:Bind ViewModel.Enabled, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE945;"
                                      FontSize="20"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,0"/>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Animation Settings"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>
                                <TextBlock Text="Control how notifications animate in and out"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Reduce Motion InfoBar -->
                        <InfoBar x:Name="ReduceMotionInfoBar"
                                 Severity="Informational"
                                 IsOpen="False"
                                 IsClosable="False"
                                 Title="Accessibility: Reduce Motion Enabled"
                                 Message="Windows Animation effects are disabled. Animations will default to fade for better accessibility. You can still override these defaults."
                                 Margin="0,0,0,8"/>

                        <!-- Enter Animation -->
                        <TextBlock Text="Enter from:"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,8,0,4"/>
                        
                        <ComboBox x:Name="EnterFromComboBox"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="EnterFromComboBox_SelectionChanged">
                            <ComboBoxItem Content="Automatic (nearest edge)" Tag="Auto" IsSelected="True"/>
                            <ComboBoxItem Content="From top" Tag="Top"/>
                            <ComboBoxItem Content="From bottom" Tag="Bottom"/>
                            <ComboBoxItem Content="From left" Tag="Left"/>
                            <ComboBoxItem Content="From right" Tag="Right"/>
                            <ComboBoxItem Content="Fade only" Tag="Fade"/>
                            <ComboBoxItem Content="Scale + fade" Tag="ScaleFade"/>
                            <ComboBoxItem Content="None (instant)" Tag="None"/>
                        </ComboBox>

                        <!-- Distance Mode -->
                        <TextBlock Text="Distance:"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,8,0,4"/>
                        
                        <RadioButtons x:Name="DistanceModeRadio" 
                                      SelectionChanged="DistanceModeRadio_SelectionChanged">
                            <RadioButton Content="From screen edge" Tag="Edge" IsChecked="True"/>
                            <RadioButton Content="Short slide" Tag="Short"/>
                        </RadioButtons>

                        <!-- Short Distance Slider (only visible when Short is selected) -->
                        <StackPanel x:Name="ShortDistancePanel" 
                                    Visibility="Collapsed"
                                    Spacing="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0"
                                           Text="Slide distance:"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="ShortDistanceText"
                                           Text="60 px"
                                           FontSize="12"
                                           Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Slider x:Name="ShortDistanceSlider"
                                    Minimum="40"
                                    Maximum="200"
                                    Value="60"
                                    StepFrequency="10"
                                    ValueChanged="ShortDistanceSlider_ValueChanged"/>
                        </StackPanel>

                        <!-- Enter Duration -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0"
                                       Text="Enter duration:"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="EnterDurationText"
                                       Text="300 ms"
                                       FontSize="12"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Slider x:Name="EnterDurationSlider"
                                Minimum="100"
                                Maximum="1500"
                                Value="300"
                                StepFrequency="50"
                                TickFrequency="200"
                                ValueChanged="EnterDurationSlider_ValueChanged"/>

                        <!-- Easing -->
                        <TextBlock Text="Easing:"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,8,0,4"/>
                        
                        <ComboBox x:Name="EasingComboBox"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="EasingComboBox_SelectionChanged">
                            <ComboBoxItem Content="Ease out (smooth deceleration)" Tag="EaseOut" IsSelected="True"/>
                            <ComboBoxItem Content="Ease in-out (smooth acceleration and deceleration)" Tag="EaseInOut"/>
                            <ComboBoxItem Content="Linear (constant speed)" Tag="Linear"/>
                            <ComboBoxItem Content="Spring (slight overshoot)" Tag="Spring"/>
                            <ComboBoxItem Content="Bounce (bouncy effect)" Tag="Bounce"/>
                        </ComboBox>

                        <!-- Exit Animation -->
                        <TextBlock Text="Exit to:"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,12,0,4"/>
                        
                        <ComboBox x:Name="ExitToComboBox"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="ExitToComboBox_SelectionChanged">
                            <ComboBoxItem Content="Same as enter (reverse)" Tag="Reverse" IsSelected="True"/>
                            <ComboBoxItem Content="To top" Tag="Top"/>
                            <ComboBoxItem Content="To bottom" Tag="Bottom"/>
                            <ComboBoxItem Content="To left" Tag="Left"/>
                            <ComboBoxItem Content="To right" Tag="Right"/>
                            <ComboBoxItem Content="Fade only" Tag="Fade"/>
                            <ComboBoxItem Content="None (instant)" Tag="None"/>
                        </ComboBox>

                        <!-- Exit Duration -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0"
                                       Text="Exit duration:"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="ExitDurationText"
                                       Text="250 ms"
                                       FontSize="12"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Slider x:Name="ExitDurationSlider"
                                Minimum="100"
                                Maximum="1500"
                                Value="250"
                                StepFrequency="50"
                                TickFrequency="200"
                                ValueChanged="ExitDurationSlider_ValueChanged"/>

                    </StackPanel>
                </Border>

                <!-- Hotkey and Shortcuts (Milestone 6) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE92E;"
                                      FontSize="20"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,0"/>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Shortcuts"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>
                                <TextBlock Text="Keyboard shortcut to enable/disable notification"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Toggle Hotkey -->
                        <TextBlock Text="Toggle customization on/off:"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,8,0,4"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind ViewModel.ToggleHotkeyText, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="Change"
                                        Command="{x:Bind ViewModel.ChangeToggleHotkeyCommand}"
                                        FontSize="12"/>
                                <Button Content="Reset"
                                        Command="{x:Bind ViewModel.ResetToggleHotkeyCommand}"
                                        FontSize="12"/>
                            </StackPanel>
                        </Grid>


                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
