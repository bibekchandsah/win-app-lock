<Page
    x:Class="AppLock.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AppLock.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <local:AnchorToBoolConverter x:Key="AnchorToBoolConverter"/>
    </Page.Resources>

    <Grid Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back Button and Breadcrumb -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Others" 
                           FontSize="14" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="›" 
                           FontSize="14" 
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Notifications" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Page Header -->
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="Notifications" 
                       FontSize="28" 
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Customize where notifications appear and how they animate" 
                       FontSize="14" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="12">
                
                <!-- Master Toggle Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE91C;"
                                  FontSize="20"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"/>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Customize notification position and animation"
                                       FontWeight="SemiBold"
                                       FontSize="14"/>
                            <TextBlock Text="Override Windows default notification placement"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <ToggleSwitch Grid.Column="2"
                                      IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}"
                                      OnContent="On"
                                      OffContent="Off"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Status and Test Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE7E8;"
                                      FontSize="20"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,0"/>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Test Notifications"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>
                                <TextBlock Text="Send test notifications and view detected toast windows"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Status -->
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <!-- Test Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Send Test Notification"
                                    Command="{x:Bind ViewModel.SendTestNotificationCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsSending, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
                            <Button Content="Send After 3 Seconds"
                                    Command="{x:Bind ViewModel.SendDelayedTestNotificationCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsSending, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
                            <Button Content="Refresh"
                                    Command="{x:Bind ViewModel.RefreshCandidatesCommand}"/>
                            <Button Content="Check Service"
                                    Command="{x:Bind ViewModel.CheckServiceStatusCommand}"
                                    Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>

                        <!-- Diagnostics List -->
                        <TextBlock Text="Candidate Toast Windows:"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,8,0,4"/>

                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                MaxHeight="400">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Candidates, Mode=OneWay}"
                                              Padding="8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:ToastCandidateViewModel">
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="12"
                                                    Margin="0,0,0,8">
                                                <StackPanel Spacing="4">
                                                    <TextBlock FontSize="12">
                                                        <Run Text="HWND: " FontWeight="SemiBold"/>
                                                        <Run Text="{x:Bind Hwnd}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="Class: " FontWeight="SemiBold"/>
                                                        <Run Text="{x:Bind ClassName}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="Title: " FontWeight="SemiBold"/>
                                                        <Run Text="{x:Bind WindowTitle}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="Process: " FontWeight="SemiBold"/>
                                                        <Run Text="{x:Bind ProcessName}"/>
                                                        <Run Text=" (PID: "/>
                                                        <Run Text="{x:Bind ProcessId}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="Rect: " FontWeight="SemiBold"/>
                                                        <Run Text="{x:Bind Rect}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="Size: " FontWeight="SemiBold"/>
                                                        <Run Text="{x:Bind Size}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="Styles: " FontWeight="SemiBold"/>
                                                        <Run Text="{x:Bind Styles}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="ExStyles: " FontWeight="SemiBold"/>
                                                        <Run Text="{x:Bind ExStyles}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Help Text -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE946;"
                                  FontSize="20"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"/>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="About this feature"
                                       FontWeight="SemiBold"
                                       FontSize="14"/>
                            <TextBlock Text="This feature repositions Windows notification toasts. It relies on undocumented shell behavior and may break with Windows updates. Only toast banners are affected, not the Notification Center."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Position Settings (Milestone 2) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Visibility="{x:Bind ViewModel.Enabled, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE81D;"
                                      FontSize="20"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,0"/>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Position Settings"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>
                                <TextBlock Text="Choose where notifications appear on screen"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Anchor Selection -->
                        <TextBlock Text="Anchor Position:"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,8,0,4"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: 3x3 Anchor Grid -->
                            <Grid Grid.Column="0" MaxWidth="300">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 1 -->
                                <RadioButton Grid.Row="0" Grid.Column="0" Content="TL" GroupName="Anchor" 
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=TwoWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=TopLeft}"
                                             HorizontalAlignment="Stretch" Margin="2"/>
                                <RadioButton Grid.Row="0" Grid.Column="1" Content="TC" GroupName="Anchor"
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=TwoWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=TopCenter}"
                                             HorizontalAlignment="Stretch" Margin="2"/>
                                <RadioButton Grid.Row="0" Grid.Column="2" Content="TR" GroupName="Anchor"
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=TwoWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=TopRight}"
                                             HorizontalAlignment="Stretch" Margin="2"/>

                                <!-- Row 2 -->
                                <RadioButton Grid.Row="1" Grid.Column="0" Content="ML" GroupName="Anchor"
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=TwoWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=MiddleLeft}"
                                             HorizontalAlignment="Stretch" Margin="2"/>
                                <RadioButton Grid.Row="1" Grid.Column="1" Content="C" GroupName="Anchor"
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=TwoWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=Center}"
                                             HorizontalAlignment="Stretch" Margin="2"/>
                                <RadioButton Grid.Row="1" Grid.Column="2" Content="MR" GroupName="Anchor"
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=TwoWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=MiddleRight}"
                                             HorizontalAlignment="Stretch" Margin="2"/>

                                <!-- Row 3 -->
                                <RadioButton Grid.Row="2" Grid.Column="0" Content="BL" GroupName="Anchor"
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=TwoWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=BottomLeft}"
                                             HorizontalAlignment="Stretch" Margin="2"/>
                                <RadioButton Grid.Row="2" Grid.Column="1" Content="BC" GroupName="Anchor"
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=TwoWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=BottomCenter}"
                                             HorizontalAlignment="Stretch" Margin="2"/>
                                <RadioButton Grid.Row="2" Grid.Column="2" Content="BR" GroupName="Anchor"
                                             IsChecked="{x:Bind ViewModel.SelectedAnchor, Mode=TwoWay, Converter={StaticResource AnchorToBoolConverter}, ConverterParameter=BottomRight}"
                                             HorizontalAlignment="Stretch" Margin="2"/>
                            </Grid>

                            <!-- Right: Desktop Preview with Frame -->
                            <Border Grid.Column="1" 
                                    x:Name="DesktopPreviewContainer"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="24,0,0,0"
                                    HorizontalAlignment="Left">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Live Preview"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    
                                    <Border x:Name="DesktopPreviewBorder"
                                            Width="320" 
                                            Height="180"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid>
                                            <!-- Wallpaper background -->
                                            <Image x:Name="WallpaperImage" 
                                                   Stretch="UniformToFill"
                                                   Source="{x:Bind ViewModel.WallpaperImageSource, Mode=OneWay}"/>
                                            
                                            <!-- Overlay showing toast position -->
                                            <Canvas x:Name="ToastPreviewCanvas">
                                                <Border x:Name="ToastPreviewRect"
                                                        Background="#40FFFFFF"
                                                        BorderBrush="#FFFFFFFF"
                                                        BorderThickness="2"
                                                        CornerRadius="6"
                                                        Width="120"
                                                        Height="32"
                                                        Opacity="{x:Bind ViewModel.PreviewOpacity, Mode=OneWay}"
                                                        Canvas.Left="{x:Bind ViewModel.PreviewToastLeft, Mode=OneWay}"
                                                        Canvas.Top="{x:Bind ViewModel.PreviewToastTop, Mode=OneWay}">
                                                    <!-- Inner content to show it's a notification -->
                                                    <Grid Padding="4">
                                                        <TextBlock Text="Toast"
                                                                   FontSize="8"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </Canvas>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Custom Position Button -->
                        <Button Content="Pick Custom Position on Screen"
                                Command="{x:Bind ViewModel.PickCustomPositionCommand}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"/>
                        
                        <TextBlock Text="{x:Bind ViewModel.AnchorDisplayText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0"/>

                        <!-- Margin -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Edge Margin:"
                                       VerticalAlignment="Center"
                                       FontSize="13"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.MarginText, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>

                        <CheckBox Content="Respect taskbar"
                                  IsChecked="{x:Bind ViewModel.RespectTaskbar, Mode=TwoWay}"
                                  FontSize="13"/>

                        <!-- Opacity Control -->
                        <TextBlock Text="Notification Transparency:"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,12,0,4"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Slider Grid.Column="0"
                                    Minimum="10"
                                    Maximum="100"
                                    Value="{x:Bind ViewModel.OpacityPercent, Mode=TwoWay}"
                                    StepFrequency="5"
                                    TickFrequency="10"
                                    TickPlacement="Outside"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"/>
                            
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.OpacityText, Mode=OneWay}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center"
                                       MinWidth="50"
                                       TextAlignment="Right"/>
                        </Grid>
                        
                        <TextBlock Text="Lower values make notifications more transparent"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
