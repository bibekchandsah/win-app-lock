<ContentDialog
    x:Class="AppLock.Views.ChangePasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Change Admin Password"
    PrimaryButtonText="Change Password"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" MinWidth="360">
        <!-- 1. Change Password View -->
        <StackPanel x:Name="ChangePasswordPanel" Spacing="16" Visibility="Visible">
            <TextBlock x:Name="InstructionText"
                       Text="Enter your current password and choose a new password"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <PasswordBox x:Name="CurrentPasswordBox"
                         Header="Current Password"
                         PlaceholderText="Enter current password"
                         CornerRadius="4"
                         PasswordRevealMode="Peek"/>

            <PasswordBox x:Name="NewPasswordBox"
                         Header="New Password"
                         PlaceholderText="Enter new password (min. 6 characters)"
                         PasswordRevealMode="Peek"
                         CornerRadius="4"
                         PasswordChanged="PasswordBox_PasswordChanged"/>

            <PasswordBox x:Name="ConfirmPasswordBox"
                         Header="Confirm New Password"
                         PlaceholderText="Re-enter new password"
                         PasswordRevealMode="Peek"
                         CornerRadius="4"
                         PasswordChanged="PasswordBox_PasswordChanged"/>

            <!-- Password strength indicator -->
            <StackPanel Spacing="4">
                <TextBlock Text="Password Strength:" FontSize="12"/>
                <ProgressBar x:Name="StrengthBar"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             CornerRadius="2"
                             Height="4"/>
                <TextBlock x:Name="StrengthText"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <HyperlinkButton x:Name="ForgotCurrentPasswordButton"
                             Content="Forgot current password? Reset via security question"
                             Click="ForgotCurrentPasswordButton_Click"
                             HorizontalAlignment="Center"
                             FontSize="12"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="{ThemeResource SystemErrorTextColor}"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 2. Security Question Verification View -->
        <StackPanel x:Name="SecurityQuestionPanel" Spacing="16" Visibility="Collapsed">
            <TextBlock Text="Answer your security question to reset admin password"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="SecurityQuestionText"
                       FontWeight="SemiBold"
                       FontSize="15"
                       TextWrapping="Wrap"/>

            <TextBox x:Name="SecurityAnswerBox"
                     PlaceholderText="Enter your answer"
                     CornerRadius="4"
                     KeyDown="SecurityAnswerBox_KeyDown"/>

            <TextBlock x:Name="QuestionErrorText"
                       Foreground="{ThemeResource SystemErrorTextColor}"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"/>

            <HyperlinkButton Content="Back to change password"
                             Click="BackToChangePassword_Click"
                             HorizontalAlignment="Center"
                             FontSize="12"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>
