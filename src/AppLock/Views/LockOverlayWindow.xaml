<Window
    x:Class="AppLock.Views.LockOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Full-window semi-transparent gray overlay — syncs with theme -->
    <Grid x:Name="RootGrid"
          Background="#99202020"
          SizeChanged="RootGrid_SizeChanged">

        <!-- Card shadow layer (simulated drop shadow) -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="14"
                MaxWidth="522"
                MaxHeight="602"
                Margin="0,4,0,0"
                Opacity="0.25"
                Background="Black"/>

        <!-- Centered card — ScrollViewer handles very small windows -->
        <Border x:Name="CardBorder"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                MaxWidth="520"
                MaxHeight="600"
                Padding="32,28">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ContentPanel" Spacing="20" MinWidth="280">

                    <!-- Lock icon badge -->
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="16"
                            Width="64" Height="64"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE72E;"
                                  FontSize="28"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title block -->
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="Program is already locked."
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="420"/>
                        <TextBlock Text="Enter the app password to resume"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Password field -->
                    <PasswordBox x:Name="PasswordBox"
                                 PlaceholderText="Enter password to unlock"
                                 KeyDown="PasswordBox_KeyDown"
                                 CornerRadius="6"
                                 BorderThickness="1.5"
                                 Padding="12,10"
                                 FontSize="14"
                                 HorizontalAlignment="Stretch"/>

                    <!-- Error message -->
                    <TextBlock x:Name="ErrorText"
                               Foreground="{ThemeResource SystemErrorTextColor}"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Margin="0,-10,0,0"/>

                    <!-- Duration section -->
                    <StackPanel Spacing="10">
                        <!-- Duration label row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Time allowed for this unlock"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="AutoRelockHint"
                                       Grid.Column="1"
                                       Text="Auto-relocks when time is up"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Visibility="Collapsed"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Duration pill buttons: wrapped in a pill-track border -->
                        <Border x:Name="DurationGrid"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="24"
                                Padding="4,4">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnNoLimit"
                                        Grid.Column="0"
                                        Content="No limit"
                                        Click="DurationButton_Click"
                                        Tag="0"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        CornerRadius="20"
                                        HorizontalAlignment="Stretch"
                                        Padding="4,7"
                                        FontSize="12"
                                        FontWeight="SemiBold"/>
                                <Button x:Name="Btn15Min"
                                        Grid.Column="1"
                                        Content="15 min"
                                        Click="DurationButton_Click"
                                        Tag="15"
                                        CornerRadius="20"
                                        HorizontalAlignment="Stretch"
                                        Padding="4,7"
                                        FontSize="12"/>
                                <Button x:Name="Btn30Min"
                                        Grid.Column="2"
                                        Content="30 min"
                                        Click="DurationButton_Click"
                                        Tag="30"
                                        CornerRadius="20"
                                        HorizontalAlignment="Stretch"
                                        Padding="4,7"
                                        FontSize="12"/>
                                <Button x:Name="Btn60Min"
                                        Grid.Column="3"
                                        Content="60 min"
                                        Click="DurationButton_Click"
                                        Tag="60"
                                        CornerRadius="20"
                                        HorizontalAlignment="Stretch"
                                        Padding="4,7"
                                        FontSize="12"/>
                                <Button x:Name="BtnCustom"
                                        Grid.Column="4"
                                        Content="Custom"
                                        Click="DurationButton_Click"
                                        Tag="-1"
                                        CornerRadius="20"
                                        HorizontalAlignment="Stretch"
                                        Padding="4,7"
                                        FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- Small window: 2-row pill track -->
                        <Border x:Name="DurationGridSmall"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="3,3"
                                Visibility="Collapsed">
                            <Grid RowSpacing="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Button x:Name="BtnNoLimitS"
                                        Grid.Row="0" Grid.Column="0"
                                        Content="No limit"
                                        Click="DurationButton_Click"
                                        Tag="0"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        CornerRadius="17"
                                        HorizontalAlignment="Stretch"
                                        Padding="3,6"
                                        FontSize="11"
                                        FontWeight="SemiBold"/>
                                <Button x:Name="Btn15MinS"
                                        Grid.Row="0" Grid.Column="1"
                                        Content="15 min"
                                        Click="DurationButton_Click"
                                        Tag="15"
                                        CornerRadius="17"
                                        HorizontalAlignment="Stretch"
                                        Padding="3,6"
                                        FontSize="11"/>
                                <Button x:Name="Btn30MinS"
                                        Grid.Row="0" Grid.Column="2"
                                        Content="30 min"
                                        Click="DurationButton_Click"
                                        Tag="30"
                                        CornerRadius="17"
                                        HorizontalAlignment="Stretch"
                                        Padding="3,6"
                                        FontSize="11"/>
                                <Button x:Name="Btn60MinS"
                                        Grid.Row="1" Grid.Column="0"
                                        Content="60 min"
                                        Click="DurationButton_Click"
                                        Tag="60"
                                        CornerRadius="17"
                                        HorizontalAlignment="Stretch"
                                        Padding="3,6"
                                        FontSize="11"/>
                                <Button x:Name="BtnCustomS"
                                        Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                        Content="Custom"
                                        Click="DurationButton_Click"
                                        Tag="-1"
                                        CornerRadius="17"
                                        HorizontalAlignment="Stretch"
                                        Padding="3,6"
                                        FontSize="11"/>
                            </Grid>
                        </Border>

                        <!-- Custom duration input -->
                        <StackPanel x:Name="CustomDurationPanel"
                                    Visibility="Collapsed"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center">
                            <NumberBox x:Name="CustomMinutesBox"
                                       PlaceholderText="Minutes"
                                       Minimum="1"
                                       Maximum="1440"
                                       Value="60"
                                       SpinButtonPlacementMode="Compact"
                                       Width="90"
                                       CornerRadius="6"
                                       BorderThickness="1"/>
                            <TextBlock Text="minutes"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Action buttons -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                x:Name="UnlockButton"
                                Content="Unlock"
                                Click="UnlockButton_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                CornerRadius="6"
                                FontSize="14"
                                FontWeight="SemiBold"/>
                        <Button Grid.Column="1"
                                Content="Cancel"
                                Click="CancelButton_Click"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                CornerRadius="6"
                                FontSize="14"/>
                    </Grid>

                    <!-- Windows Hello button -->
                    <Button x:Name="WindowsHelloButton"
                            HorizontalAlignment="Center"
                            Click="WindowsHelloButton_Click"
                            CornerRadius="20"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="14"/>
                            <TextBlock Text="Windows Hello" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- Divider -->
                    <Border Height="1"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                            Margin="0,0,0,0"/>

                    <!-- Footer — centered emergency lock -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="Emergency lock:"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2">
                            <TextBlock Text="Ctrl+Alt+L"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       FontFamily="Consolas"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>
