<Page
    x:Class="AppLock.Views.WifiPasswordsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AppLock.Views"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Breadcrumb and title stay in place; only the cards scroll. -->
        <StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,16">
            <!-- Breadcrumb Navigation (same pattern as the Volume Mixer page) -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    TabIndex="0"
                    ToolTipService.ToolTip="Back"
                    AutomationProperties.Name="Back to Others">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Others"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="›"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Wi-Fi Passwords"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock
                    Text="Wi-Fi Passwords"
                    Style="{StaticResource TitleTextBlockStyle}"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Text="Every wireless network saved on this PC, with its password"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" MaxWidth="880" HorizontalAlignment="Left">
                <!-- Elevation request (same pattern as the BitLocker page) -->
                <InfoBar x:Name="ElevationInfoBar"
                         Severity="Warning"
                         Title="Administrator rights are needed to read every saved Wi-Fi password."
                         Message="Run AppLock as administrator to load passwords that Windows hides from standard user accounts."
                         IsClosable="False"
                         CornerRadius="8"
                         IsOpen="False">
                    <InfoBar.ActionButton>
                        <Button Content="Restart as administrator"
                                Click="RestartAsAdminButton_Click"
                                AutomationProperties.Name="Restart AppLock as administrator"/>
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar x:Name="StatusBar"
                         IsOpen="False"
                         IsClosable="True"
                         CornerRadius="8"/>

                <!-- Saved networks -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <Grid Padding="20,16,20,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Saved networks" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CountText"
                                           Text="0 networks"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressRing x:Name="LoadingRing"
                                              Width="18" Height="18"
                                              IsActive="False"
                                              Visibility="Collapsed"/>
                                <Button Click="RefreshButton_Click"
                                        x:Name="RefreshButton"
                                        TabIndex="1"
                                        AutomationProperties.Name="Refresh saved networks">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                        <TextBlock Text="Refresh"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>

                        <!-- Arrow keys move between rows, Enter/Space reveals, Ctrl+C copies; the
                             focus rectangle follows the selected row. -->
                        <ListView x:Name="NetworksList"
                                  ItemsSource="{x:Bind Networks}"
                                  SelectionMode="Single"
                                  SingleSelectionFollowsFocus="True"
                                  IsItemClickEnabled="True"
                                  ItemClick="NetworksList_ItemClick"
                                  KeyDown="NetworksList_KeyDown"
                                  TabIndex="2"
                                  Padding="8"
                                  AutomationProperties.Name="Saved Wi-Fi networks">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="4,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:WifiProfileViewModel">
                                    <Grid Padding="12,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0"
                                                  Glyph="&#xE701;"
                                                  FontSize="18"
                                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                  VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Ssid}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind DisplayPassword, Mode=OneWay}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       IsTextSelectionEnabled="True"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind ActionsVisibility}">
                                            <Button Click="RevealButton_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    CornerRadius="4"
                                                    ToolTipService.ToolTip="{x:Bind RevealToolTip, Mode=OneWay}">
                                                <FontIcon Glyph="{x:Bind RevealGlyph, Mode=OneWay}" FontSize="14"/>
                                            </Button>
                                            <Button Click="CopyButton_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    CornerRadius="4"
                                                    ToolTipService.ToolTip="Copy password"
                                                    AutomationProperties.Name="Copy password">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                                            </Button>
                                            <Button Click="QrButton_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    CornerRadius="4"
                                                    ToolTipService.ToolTip="Show QR code to join this network"
                                                    AutomationProperties.Name="Show QR code">
                                                <TextBlock Text="QR" FontSize="11" FontWeight="SemiBold"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty state -->
                        <StackPanel x:Name="EmptyPanel"
                                    Spacing="8"
                                    Padding="32"
                                    Visibility="Collapsed">
                            <FontIcon Glyph="&#xE701;"
                                      FontSize="30"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="No saved Wi-Fi networks"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                            <TextBlock Text="Connect to a wireless network once and it will appear here together with its saved password."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="420"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Passwords are read locally from this PC's saved Wi-Fi profiles. Nothing is uploaded or logged."
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
