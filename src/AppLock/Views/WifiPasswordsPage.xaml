<Page
    x:Class="AppLock.Views.WifiPasswordsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AppLock.Views"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Spacing="16" Margin="40,24,40,40">
            <!-- Breadcrumb Navigation -->
            <Button
                Click="BackButton_Click"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="4"
                Padding="8,6"
                Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="12"/>
                    <TextBlock Text="Others" FontSize="13"/>
                    <TextBlock Text="/" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Wi-Fi Passwords" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Button>

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock
                    Text="Wi-Fi Passwords"
                    Style="{StaticResource TitleTextBlockStyle}"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Text="Every wireless network saved on this PC, with its password"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"/>
            </StackPanel>

            <!-- Administrator Privileges Card (shown when AppLock is not elevated) -->
            <Border
                x:Name="ElevationCard"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Visibility="Collapsed">
                <Grid ColumnDefinitions="Auto,*">
                    <FontIcon
                        Grid.Column="0"
                        Glyph="&#xE7BA;"
                        FontSize="20"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Margin="0,0,16,0"
                        VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock
                            Text="Administrator Privileges Required"
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock
                            Text="AppLock is running without administrator rights, so some saved Wi-Fi passwords may not be readable. Restart AppLock as administrator to load all of them."
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"/>
                        <Button
                            Content="Restart as administrator"
                            Click="RestartAsAdminButton_Click"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Restart AppLock as administrator"/>
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar x:Name="StatusBar"
                     IsOpen="False"
                     IsClosable="True"
                     CornerRadius="8"/>

            <!-- Saved networks -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Padding="20,16,20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Saved networks" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CountText"
                                       Text="0 networks"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing x:Name="LoadingRing"
                                          Width="18" Height="18"
                                          IsActive="False"
                                          Visibility="Collapsed"/>
                            <Button Click="RefreshButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                    <TextBlock Text="Refresh"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>

                    <ListView x:Name="NetworksList"
                              ItemsSource="{x:Bind Networks}"
                              SelectionMode="None"
                              Padding="8">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:WifiProfileViewModel">
                                <Grid Padding="12,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              Glyph="&#xE701;"
                                              FontSize="18"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                              VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Ssid}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind DisplayPassword, Mode=OneWay}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   IsTextSelectionEnabled="True"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind ActionsVisibility}">
                                        <Button Click="RevealButton_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="8"
                                                CornerRadius="4"
                                                ToolTipService.ToolTip="{x:Bind RevealToolTip, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind RevealGlyph, Mode=OneWay}" FontSize="14"/>
                                        </Button>
                                        <Button Click="CopyButton_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="8"
                                                CornerRadius="4"
                                                ToolTipService.ToolTip="Copy password">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyPanel"
                                Spacing="8"
                                Padding="32"
                                Visibility="Collapsed">
                        <FontIcon Glyph="&#xE701;"
                                  FontSize="30"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="No saved Wi-Fi networks"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                        <TextBlock Text="Connect to a wireless network once and it will appear here together with its saved password."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="420"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Passwords are read locally from this PC's saved Wi-Fi profiles. Nothing is uploaded or logged."
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
