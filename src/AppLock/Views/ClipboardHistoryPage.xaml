<Page
    x:Class="AppLock.Views.ClipboardHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AppLock.ViewModels"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back Button and Breadcrumb -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Others" 
                           FontSize="14" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="›" 
                           FontSize="14" 
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Clipboard History" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Page Header & Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Clipboard History" 
                           FontSize="28" 
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="StatsSubtext"
                           Text="Persistent clipboard items across app restarts and reboots" 
                           FontSize="14" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Top Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="SettingsButton"
                        Click="SettingsButton_Click"
                        ToolTipService.ToolTip="Clipboard settings">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE713;" FontSize="13"/>
                        <TextBlock Text="Settings"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ClearAllButton"
                        Click="ClearAllButton_Click"
                        ToolTipService.ToolTip="Clear history">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        <TextBlock Text="Clear all"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Status Banner (Shown when paused or disabled) -->
        <Border x:Name="StatusBanner"
                Grid.Row="2"
                Margin="0,0,0,16"
                CornerRadius="8"
                Padding="14,10"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon x:Name="StatusBannerIcon" Glyph="&#xE769;" FontSize="14"/>
                    <TextBlock x:Name="StatusBannerText" Text="Clipboard capture is temporarily paused" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <Button x:Name="StatusBannerActionButton"
                        Grid.Column="1"
                        Content="Resume Capture"
                        Click="StatusBannerActionButton_Click"
                        Padding="12,4"
                        FontSize="12"/>
            </Grid>
        </Border>

        <!-- Search and Filter Bar -->
        <Grid Grid.Row="3" Margin="0,0,0,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     PlaceholderText="Search clipboard history (text, app name)..."
                     TextChanged="SearchBox_TextChanged">
                <TextBox.Header>
                    <Grid/>
                </TextBox.Header>
            </TextBox>

            <ComboBox x:Name="FilterComboBox"
                      Grid.Column="1"
                      SelectedIndex="0"
                      MinWidth="130"
                      SelectionChanged="FilterComboBox_SelectionChanged">
                <ComboBoxItem Content="All Items" Tag="All"/>
                <ComboBoxItem Content="Text Only" Tag="Text"/>
                <ComboBoxItem Content="Images" Tag="Images"/>
                <ComboBoxItem Content="Files" Tag="Files"/>
                <ComboBoxItem Content="Links" Tag="Links"/>
                <ComboBoxItem Content="Pinned" Tag="Pinned"/>
            </ComboBox>
        </Grid>

        <!-- Main Items List -->
        <Grid Grid.Row="4">
            <!-- Empty State -->
            <StackPanel x:Name="EmptyStatePanel"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <FontIcon Glyph="&#xE8C8;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyStateTitle"
                           Text="No clipboard history yet"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="EmptyStateMessage"
                           Text="Copy text, images, or files in any application to see them appear here."
                           FontSize="12"
                           TextWrapping="Wrap"
                           MaxWidth="360"
                           TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>

            <!-- Items ListView -->
            <ListView x:Name="HistoryListView"
                      ItemsSource="{x:Bind Items}"
                      SelectionMode="None"
                      HorizontalAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,4"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClipboardItemViewModel">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10"
                                Margin="0,2,0,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Meta line: Source App + Relative Time + Actions -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Source App Info -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE71D;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                        <TextBlock Text="{x:Bind SourceProcess}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="{x:Bind RelativeTime}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="{x:Bind FormattedSize}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="{x:Bind DimensionsText}" 
                                                   FontSize="11" 
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Visibility="{x:Bind ImageVisibility, Mode=OneWay}"/>
                                    </StackPanel>

                                    <!-- Action buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                        <Button ToolTipService.ToolTip="Copy back to clipboard"
                                                Click="CopyItemButton_Click"
                                                Tag="{x:Bind}"
                                                Padding="6,4"
                                                Background="Transparent"
                                                BorderThickness="0">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                                        </Button>
                                        <Button ToolTipService.ToolTip="Delete item"
                                                Click="DeleteItemButton_Click"
                                                Tag="{x:Bind}"
                                                Padding="6,4"
                                                Background="Transparent"
                                                BorderThickness="0">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Content by Type -->
                                <Grid Grid.Row="1">
                                    <!-- 1. Text Content -->
                                    <TextBlock Text="{x:Bind PreviewText}"
                                               FontSize="13"
                                               MaxLines="3"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               LineHeight="18"
                                               IsTextSelectionEnabled="True"
                                               Visibility="{x:Bind TextVisibility, Mode=OneWay}"/>

                                    <!-- 2. Image Content -->
                                    <StackPanel Visibility="{x:Bind ImageVisibility, Mode=OneWay}" Spacing="6">
                                        <!-- Normal Thumbnail -->
                                        <Border CornerRadius="4" 
                                                BorderThickness="1" 
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                HorizontalAlignment="Left"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                                            <Image Source="{x:Bind ThumbnailImage, Mode=OneWay}"
                                                   MaxHeight="120"
                                                   MaxWidth="240"
                                                   Stretch="Uniform"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- 3. Files Content -->
                                    <StackPanel Visibility="{x:Bind FilesVisibility, Mode=OneWay}" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                        <TextBlock Text="{x:Bind PreviewText}" FontSize="13" FontWeight="Normal" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
