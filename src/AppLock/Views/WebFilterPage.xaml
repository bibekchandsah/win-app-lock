<Page
    x:Class="AppLock.Views.WebFilterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AppLock.ViewModels"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <!-- Card surface follows the Light/Dark/System theme; no fixed colours. -->
        <Style x:Key="WebFilterCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Category card template -->
        <DataTemplate x:Key="CategoryCardTemplate" x:DataType="vm:CategoryCardViewModel">
            <Border Style="{StaticResource WebFilterCard}" Margin="0,0,0,10">
                <StackPanel Spacing="10">
                    <!-- Header row: icon, name, domain count, toggle -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0"
                                Width="36" Height="36"
                                CornerRadius="6"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind IconGlyph}"
                                      FontSize="16"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <!-- Name + description + domain count -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Name}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind Description}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind DomainCountLabel, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind AvailableVisible, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind UnavailableReason, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                       Visibility="{x:Bind UnavailableVisible, Mode=OneWay}"/>
                        </StackPanel>

                        <!-- Toggle (disabled when list unavailable) -->
                        <ToggleSwitch Grid.Column="2"
                                      IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                      IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                      OnContent="On"
                                      OffContent="Off"
                                      MinWidth="0"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <!-- First-enable inline hint -->
                    <InfoBar Severity="Informational"
                             Title=""
                             Message="Blocked sites will show 'This site can't be reached' in your browser."
                             IsOpen="{x:Bind FirstEnableHintVisible, Mode=TwoWay}"
                             IsClosable="True"/>

                    <!-- Limits tooltip (caption) -->
                    <TextBlock Text="{x:Bind Limits}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Padding="24,24,24,12" Spacing="8">
            <TextBlock Text="Web Filter"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Block whole categories of websites or a single site for every browser on this PC"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Master switch and pause -->
        <Border Grid.Row="1" Margin="24,0,24,12" Style="{StaticResource WebFilterCard}" Padding="20,16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0"
                          Glyph="&#xE774;"
                          FontSize="20"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="StatusDot"
                                 Width="8" Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock x:Name="StatusTitle"
                                   Text="Web Filter is Off"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusDetail"
                               Text="No websites are blocked. The filter isn't set up yet."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ToggleSwitch x:Name="MasterToggle"
                                  Toggled="MasterToggle_Toggled"
                                  OnContent="On"
                                  OffContent="Off"
                                  MinWidth="0"/>
                    <!-- Pause flyout -->
                    <Button x:Name="PauseButton"
                            Content="Pause"
                            IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Pause for 30 minutes"
                                                Click="PauseButton_30_Click"/>
                                <MenuFlyoutItem Text="Pause for 1 hour"
                                                Click="PauseButton_60_Click"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Resume now"
                                                Click="PauseResume_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Quick tool: check a website against the enabled lists -->
        <Border Grid.Row="2" Margin="24,0,24,12" Style="{StaticResource WebFilterCard}" Padding="20,16">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE721;"
                              FontSize="16"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <TextBox Grid.Column="1"
                             x:Name="CheckWebsiteBox"
                             PlaceholderText="Check a website (example.com or https://example.com/page)"
                             TextChanged="CheckWebsiteBox_TextChanged"
                             KeyDown="CheckWebsiteBox_KeyDown"
                             HorizontalAlignment="Stretch"/>

                    <Button Grid.Column="2"
                            x:Name="CheckWebsiteButton"
                            Content="Check"
                            Click="CheckWebsiteButton_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanCheck, Mode=OneWay}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing Width="16" Height="16"
                                  IsActive="{x:Bind ViewModel.IsChecking, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.ListStatus, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <InfoBar x:Name="CheckResultBar"
                         IsOpen="False"
                         IsClosable="True"/>
            </StackPanel>
        </Border>

        <!-- Status area -->
        <StackPanel Grid.Row="3" Padding="24,0,24,12" Spacing="8">
            <InfoBar x:Name="NotElevatedInfoBar"
                     Severity="Warning"
                     Title="Administrator rights required"
                     Message="Administrator rights are needed to change DNS and firewall settings on this PC."
                     IsOpen="False"
                     IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Restart as administrator"
                            Click="RestartAsAdminButton_Click"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="TamperInfoBar"
                     Severity="Informational"
                     Title="DNS changed outside AppLock"
                     Message="DNS settings were changed outside AppLock and were automatically re-applied to the filter."
                     IsOpen="False"
                     IsClosable="True"/>

            <InfoBar x:Name="FilterErrorInfoBar"
                     Severity="Error"
                     Title="Filter stopped unexpectedly"
                     Message=""
                     IsOpen="False"
                     IsClosable="True"/>

            <InfoBar x:Name="RestoreSuccessBar"
                     Severity="Success"
                     Title="Network settings restored"
                     Message="Original DNS settings have been restored on all network adapters."
                     IsOpen="False"
                     IsClosable="True"/>
        </StackPanel>

        <!-- Honest scope note -->
        <TextBlock Grid.Row="4"
                   Margin="24,0,24,12"
                   Text="Blocks domain names, not single pages: blocking a site blocks its whole domain. A VPN, a proxy or a browser's own secure DNS can get around it."
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   TextWrapping="Wrap"/>

        <!-- Tabs -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Padding="24,0,24,12">
            <Button x:Name="CategoriesTabButton"
                    Content="Categories"
                    Tag="categories"
                    Click="Tab_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="16,8"/>
            <Button x:Name="SitesTabButton"
                    Content="Sites"
                    Tag="sites"
                    Click="Tab_Click"
                    Padding="16,8"/>
            <Button x:Name="ActivityTabButton"
                    Content="Activity"
                    Tag="activity"
                    Click="Tab_Click"
                    Padding="16,8"/>
            <Button x:Name="SettingsTabButton"
                    Content="Settings"
                    Tag="settings"
                    Click="Tab_Click"
                    Padding="16,8"/>
        </StackPanel>

        <!-- Tab content -->
        <Grid Grid.Row="6" Padding="24,0,24,24">

            <!-- Categories tab: real category cards -->
            <ScrollViewer x:Name="CategoriesPanel" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="CategoryRepeater"
                               ItemsSource="{x:Bind ViewModel.CategoryCards, Mode=OneWay}"
                               ItemTemplate="{StaticResource CategoryCardTemplate}"/>
            </ScrollViewer>

            <ScrollViewer x:Name="SitesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource WebFilterCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Sites"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Always block and always allow lists, plus switches for individual services such as YouTube, Instagram or Steam, will live here."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ActivityPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource WebFilterCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Activity"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Blocked requests, their counts and the log settings will be shown here. Nothing is logged until the filter is running."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource WebFilterCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Settings"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Mode, upstream DNS, block list updates, bypass protection and the emergency restore will be configured here."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Restoring the original DNS settings will always be available without a password."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WebFilterCard}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Emergency"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Restore the PC's original DNS settings immediately and turn off Web Filter. This always works without authentication."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <Button Content="Restore my network settings"
                                    Click="RestoreNetworkButton_Click"
                                    CornerRadius="4"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
