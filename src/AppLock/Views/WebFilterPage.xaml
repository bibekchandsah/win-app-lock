<Page
    x:Class="AppLock.Views.WebFilterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AppLock.ViewModels"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <!-- Card surface follows the Light/Dark/System theme; no fixed colours. -->
        <Style x:Key="WebFilterCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Sub-service row (for Social media expander) -->
        <DataTemplate x:Key="ServiceSubRowTemplate" x:DataType="vm:ServiceCardViewModel">
            <Grid Padding="12,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="{x:Bind IconGlyph}" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" OnContent="Blocked" OffContent="Allowed" MinWidth="0" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- Category card template -->
        <DataTemplate x:Key="CategoryCardTemplate" x:DataType="vm:CategoryCardViewModel">
            <Border Style="{StaticResource WebFilterCard}" Margin="0,0,0,10">
                <StackPanel Spacing="10">
                    <!-- Header row: icon, name, domain count, toggle -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0"
                                Width="36" Height="36"
                                CornerRadius="6"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind IconGlyph}"
                                      FontSize="16"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <!-- Name + description + domain count -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Name}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind Description}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind DomainCountLabel, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind AvailableVisible, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind UnavailableReason, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                       Visibility="{x:Bind UnavailableVisible, Mode=OneWay}"/>
                        </StackPanel>

                        <!-- Toggle (disabled when list unavailable) -->
                        <ToggleSwitch Grid.Column="2"
                                      IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                      IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                      OnContent="On"
                                      OffContent="Off"
                                      MinWidth="0"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <!-- First-enable inline hint -->
                    <InfoBar Severity="Informational"
                             Title=""
                             Message="Blocked sites will show 'This site can't be reached' in your browser."
                             IsOpen="{x:Bind FirstEnableHintVisible, Mode=TwoWay}"
                             IsClosable="True"/>

                    <!-- Limits tooltip (caption) -->
                    <TextBlock Text="{x:Bind Limits}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>

                    <!-- Sub-services expander (e.g. for Social Media) -->
                    <Expander Header="Individual services"
                              IsExpanded="False"
                              Visibility="{x:Bind HasSubServices}"
                              HorizontalAlignment="Stretch">
                        <ItemsRepeater ItemsSource="{x:Bind SubServices, Mode=OneWay}"
                                       ItemTemplate="{StaticResource ServiceSubRowTemplate}"/>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Standalone Service Card Template -->
        <DataTemplate x:Key="ServiceCardTemplate" x:DataType="vm:ServiceCardViewModel">
            <Border Style="{StaticResource WebFilterCard}" Margin="0,0,0,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="36" Height="36"
                            CornerRadius="6"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="{x:Bind IconGlyph}"
                                  FontSize="16"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Name}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind CategoryDisplayName}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind DomainsSummary}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ScheduleLabel, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>

                    <ToggleSwitch Grid.Column="2"
                                  IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                  OnContent="Blocked"
                                  OffContent="Allowed"
                                  MinWidth="0"
                                  VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Domain Row Template (for Always Block and Always Allow) -->
        <DataTemplate x:Key="DomainRowTemplate" x:DataType="vm:DomainItemViewModel">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Domain}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind Note}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind HasNote}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{x:Bind AddedDateFormatted}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="2"
                            Tag="{x:Bind}"
                            Click="DeleteDomain_Click"
                            ToolTipService.ToolTip="Delete"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,6"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Padding="24,24,24,12" Spacing="8">
            <TextBlock Text="Web Filter"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Block whole categories of websites or a single site for every browser on this PC"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Master switch and pause -->
        <Border Grid.Row="1" Margin="24,0,24,12" Style="{StaticResource WebFilterCard}" Padding="20,16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0"
                          Glyph="&#xE774;"
                          FontSize="20"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="StatusDot"
                                 Width="8" Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock x:Name="StatusTitle"
                                   Text="Web Filter is Off"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusDetail"
                               Text="No websites are blocked. The filter isn't set up yet."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ToggleSwitch x:Name="MasterToggle"
                                  Toggled="MasterToggle_Toggled"
                                  OnContent="On"
                                  OffContent="Off"
                                  MinWidth="0"/>
                    <!-- Pause flyout -->
                    <Button x:Name="PauseButton"
                            Content="Pause"
                            IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Pause for 30 minutes"
                                                Click="PauseButton_30_Click"/>
                                <MenuFlyoutItem Text="Pause for 1 hour"
                                                Click="PauseButton_60_Click"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Resume now"
                                                Click="PauseResume_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Quick tool: check a website against the enabled lists -->
        <Border Grid.Row="2" Margin="24,0,24,12" Style="{StaticResource WebFilterCard}" Padding="20,16">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE721;"
                              FontSize="16"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <TextBox Grid.Column="1"
                             x:Name="CheckWebsiteBox"
                             PlaceholderText="Check a website (example.com or https://example.com/page)"
                             TextChanged="CheckWebsiteBox_TextChanged"
                             KeyDown="CheckWebsiteBox_KeyDown"
                             HorizontalAlignment="Stretch"/>

                    <Button Grid.Column="2"
                            x:Name="CheckWebsiteButton"
                            Content="Check"
                            Click="CheckWebsiteButton_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanCheck, Mode=OneWay}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing Width="16" Height="16"
                                  IsActive="{x:Bind ViewModel.IsChecking, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.ListStatus, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <InfoBar x:Name="CheckResultBar"
                         IsOpen="False"
                         IsClosable="True"/>
            </StackPanel>
        </Border>

        <!-- Status area -->
        <StackPanel Grid.Row="3" Padding="24,0,24,12" Spacing="8">
            <InfoBar x:Name="NotElevatedInfoBar"
                     Severity="Warning"
                     Title="Administrator rights required"
                     Message="Administrator rights are needed to change DNS and firewall settings on this PC."
                     IsOpen="False"
                     IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Restart as administrator"
                            Click="RestartAsAdminButton_Click"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="TamperInfoBar"
                     Severity="Informational"
                     Title="DNS changed outside AppLock"
                     Message="DNS settings were changed outside AppLock and were automatically re-applied to the filter."
                     IsOpen="False"
                     IsClosable="True"/>

            <InfoBar x:Name="FilterErrorInfoBar"
                     Severity="Error"
                     Title="Filter stopped unexpectedly"
                     Message=""
                     IsOpen="False"
                     IsClosable="True"/>

            <InfoBar x:Name="RestoreSuccessBar"
                     Severity="Success"
                     Title="Network settings restored"
                     Message="Original DNS settings have been restored on all network adapters."
                     IsOpen="False"
                     IsClosable="True"/>
        </StackPanel>

        <!-- Honest scope note -->
        <TextBlock Grid.Row="4"
                   Margin="24,0,24,12"
                   Text="Blocks domain names, not single pages: blocking a site blocks its whole domain. A VPN, a proxy or a browser's own secure DNS can get around it."
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   TextWrapping="Wrap"/>

        <!-- Tabs -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Padding="24,0,24,12">
            <Button x:Name="CategoriesTabButton"
                    Content="Categories"
                    Tag="categories"
                    Click="Tab_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="16,8"/>
            <Button x:Name="SitesTabButton"
                    Content="Sites"
                    Tag="sites"
                    Click="Tab_Click"
                    Padding="16,8"/>
            <Button x:Name="ActivityTabButton"
                    Content="Activity"
                    Tag="activity"
                    Click="Tab_Click"
                    Padding="16,8"/>
            <Button x:Name="SettingsTabButton"
                    Content="Settings"
                    Tag="settings"
                    Click="Tab_Click"
                    Padding="16,8"/>
        </StackPanel>

        <!-- Tab content -->
        <Grid Grid.Row="6" Padding="24,0,24,24">

            <!-- Categories tab: real category cards -->
            <ScrollViewer x:Name="CategoriesPanel" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="CategoryRepeater"
                               ItemsSource="{x:Bind ViewModel.CategoryCards, Mode=OneWay}"
                               ItemTemplate="{StaticResource CategoryCardTemplate}"/>
            </ScrollViewer>

            <!-- Sites tab: Services, Always Block, Always Allow -->
            <ScrollViewer x:Name="SitesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Pivot x:Name="SitesPivot">
                        <!-- Services catalog -->
                        <PivotItem Header="Services">
                            <StackPanel Spacing="12" Margin="0,12,0,0">
                                <TextBlock Text="Block specific services without blocking a whole category. Each service has its own toggle."
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ServiceItems, Mode=OneWay}"
                                               ItemTemplate="{StaticResource ServiceCardTemplate}"/>
                            </StackPanel>
                        </PivotItem>

                        <!-- Always Block -->
                        <PivotItem Header="Always Block">
                            <StackPanel Spacing="12" Margin="0,12,0,0">
                                <TextBlock Text="These websites are always blocked on this PC, regardless of categories or schedules."
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>

                                <!-- Add form card -->
                                <Border Style="{StaticResource WebFilterCard}" Padding="16">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Add a domain to always block" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     x:Name="AlwaysBlockDomainBox"
                                                     PlaceholderText="example.com, *.site.com or URL"
                                                     KeyDown="AlwaysBlockInput_KeyDown"/>
                                            <TextBox Grid.Column="1"
                                                     x:Name="AlwaysBlockNoteBox"
                                                     PlaceholderText="Optional note (e.g. distracting)"
                                                     KeyDown="AlwaysBlockInput_KeyDown"/>
                                            <Button Grid.Column="2"
                                                    Content="Add"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Click="AddAlwaysBlockButton_Click"/>
                                        </Grid>
                                        <InfoBar x:Name="AlwaysBlockInfoBar" IsOpen="False" IsClosable="True"/>
                                    </StackPanel>
                                </Border>

                                <!-- Header actions: count + Import / Export -->
                                <Grid>
                                    <TextBlock Text="{x:Bind ViewModel.AlwaysBlockCountLabel, Mode=OneWay}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Content="Import..." Click="ImportAlwaysBlockButton_Click"/>
                                        <Button Content="Export..." Click="ExportAlwaysBlockButton_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Items list -->
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.AlwaysBlockItems, Mode=OneWay}"
                                               ItemTemplate="{StaticResource DomainRowTemplate}"/>
                            </StackPanel>
                        </PivotItem>

                        <!-- Always Allow -->
                        <PivotItem Header="Always Allow">
                            <StackPanel Spacing="12" Margin="0,12,0,0">
                                <TextBlock Text="These websites are always allowed, bypassing all category and service block rules. Adding or removing requires authentication."
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>

                                <!-- Add form card -->
                                <Border Style="{StaticResource WebFilterCard}" Padding="16">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Add a domain to always allow" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     x:Name="AlwaysAllowDomainBox"
                                                     PlaceholderText="example.com, *.site.com or URL"
                                                     KeyDown="AlwaysAllowInput_KeyDown"/>
                                            <TextBox Grid.Column="1"
                                                     x:Name="AlwaysAllowNoteBox"
                                                     PlaceholderText="Optional note (e.g. work requirement)"
                                                     KeyDown="AlwaysAllowInput_KeyDown"/>
                                            <Button Grid.Column="2"
                                                    Content="Add"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Click="AddAlwaysAllowButton_Click"/>
                                        </Grid>
                                        <InfoBar x:Name="AlwaysAllowInfoBar" IsOpen="False" IsClosable="True"/>
                                    </StackPanel>
                                </Border>

                                <!-- Header actions: count + Import / Export -->
                                <Grid>
                                    <TextBlock Text="{x:Bind ViewModel.AlwaysAllowCountLabel, Mode=OneWay}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Content="Import..." Click="ImportAlwaysAllowButton_Click"/>
                                        <Button Content="Export..." Click="ExportAlwaysAllowButton_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Items list -->
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.AlwaysAllowItems, Mode=OneWay}"
                                               ItemTemplate="{StaticResource DomainRowTemplate}"/>
                            </StackPanel>
                        </PivotItem>
                    </Pivot>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ActivityPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource WebFilterCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Activity"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Blocked requests, their counts and the log settings will be shown here. Nothing is logged until the filter is running."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource WebFilterCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Settings"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Mode, upstream DNS, block list updates, bypass protection and the emergency restore will be configured here."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Restoring the original DNS settings will always be available without a password."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WebFilterCard}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Emergency"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Restore the PC's original DNS settings immediately and turn off Web Filter. This always works without authentication."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <Button Content="Restore my network settings"
                                    Click="RestoreNetworkButton_Click"
                                    CornerRadius="4"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
