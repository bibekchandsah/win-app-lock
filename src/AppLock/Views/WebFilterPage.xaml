<Page
    x:Class="AppLock.Views.WebFilterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AppLock.ViewModels"
    xmlns:local="using:AppLock.Views"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <!-- Card surface follows the Light/Dark/System theme; no fixed colours. -->
        <Style x:Key="WebFilterCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Segmented Tab Bar Styles (Pill Navigation matching Image 1) -->
        <Style x:Key="SegmentedTabContainer" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="SegmentedTabButtonActive" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>

        <Style x:Key="SegmentedTabButtonInactive" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>

        <!-- Sub-service row (for Social media expander) -->
        <DataTemplate x:Key="ServiceSubRowTemplate" x:DataType="vm:ServiceCardViewModel">
            <Grid Padding="12,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="{x:Bind IconGlyph}" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" OnContent="Blocked" OffContent="Allowed" MinWidth="0" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- Category card template -->
        <DataTemplate x:Key="CategoryCardTemplate" x:DataType="vm:CategoryCardViewModel">
            <Border Style="{StaticResource WebFilterCard}" Margin="0,0,0,10">
                <StackPanel Spacing="10">
                    <!-- Header row: icon, name, domain count, toggle -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0"
                                Width="36" Height="36"
                                CornerRadius="6"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind IconGlyph}"
                                      FontSize="16"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <!-- Name + description + domain count -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Name}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind Description}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind DomainCountLabel, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind AvailableVisible, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind UnavailableReason, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                       Visibility="{x:Bind UnavailableVisible, Mode=OneWay}"/>
                        </StackPanel>

                        <!-- Actions: Schedule button + Toggle -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Click="CategorySchedule_Click"
                                    Tag="{x:Bind}"
                                    Padding="8,4"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE787;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ScheduleLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
                                </StackPanel>
                            </Button>
                            <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                          IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                          OnContent="On"
                                          OffContent="Off"
                                          MinWidth="0"
                                          VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- First-enable inline hint -->
                    <InfoBar Severity="Informational"
                             Title=""
                             Message="Blocked sites will show 'This site can't be reached' in your browser."
                             IsOpen="{x:Bind FirstEnableHintVisible, Mode=TwoWay}"
                             IsClosable="True"/>

                    <!-- Limits tooltip (caption) -->
                    <TextBlock Text="{x:Bind Limits}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>

                    <!-- Adult content sub-options: SafeSearch & YouTube Restricted Mode -->
                    <Border Visibility="{x:Bind AdultOptionsVisible, Mode=OneWay}"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,4,0,0">
                        <StackPanel Spacing="10">
                            <!-- SafeSearch toggle -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Enforce SafeSearch (Google, Bing, DuckDuckGo)"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="Filters explicit search results across major search engines."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind EnforceSafeSearch, Mode=TwoWay}"
                                              OnContent="On"
                                              OffContent="Off"
                                              MinWidth="0"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <!-- YouTube Restricted Mode -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="YouTube Restricted Mode"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="Hides potentially mature videos identified by YouTube."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          SelectedIndex="{x:Bind YouTubeModeIndex, Mode=TwoWay}"
                                          MinWidth="120"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="Off"/>
                                    <ComboBoxItem Content="Moderate"/>
                                    <ComboBoxItem Content="Strict"/>
                                </ComboBox>
                            </Grid>

                            <!-- Status line -->
                            <TextBlock Text="{x:Bind SafeSearchStatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <!-- Disclaimer / Notice -->
                            <TextBlock Text="Note: SafeSearch applies to Google, Bing, DuckDuckGo, and YouTube in browsers on this PC. It does not apply to other search engines or apps that bypass DNS."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Sub-services expander (e.g. for Social Media) -->
                    <Expander Header="Individual services"
                              IsExpanded="False"
                              Visibility="{x:Bind HasSubServices}"
                              HorizontalAlignment="Stretch">
                        <ItemsRepeater ItemsSource="{x:Bind SubServices, Mode=OneWay}"
                                       ItemTemplate="{StaticResource ServiceSubRowTemplate}"/>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Standalone Service Card Template -->
        <DataTemplate x:Key="ServiceCardTemplate" x:DataType="vm:ServiceCardViewModel">
            <Border Style="{StaticResource WebFilterCard}" Margin="0,0,0,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="36" Height="36"
                            CornerRadius="6"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="{x:Bind IconGlyph}"
                                  FontSize="16"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Name}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind CategoryDisplayName}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind DomainsSummary}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ScheduleLabel, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>

                    <!-- Actions: Schedule button + Toggle -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Click="ServiceSchedule_Click"
                                Tag="{x:Bind}"
                                Padding="8,4"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE787;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ScheduleLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                        </Button>
                        <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                      OnContent="Blocked"
                                      OffContent="Allowed"
                                      MinWidth="0"
                                      VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Domain Row Template (for Always Block and Always Allow) -->
        <DataTemplate x:Key="DomainRowTemplate" x:DataType="vm:DomainItemViewModel">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Domain}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind Note}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind HasNote}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{x:Bind AddedDateFormatted}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="2"
                            Tag="{x:Bind}"
                            Click="DeleteDomain_Click"
                            ToolTipService.ToolTip="Delete"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,6"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Temporary Allow Row Template -->
        <DataTemplate x:Key="TempAllowRowTemplate" x:DataType="vm:TempAllowItemViewModel">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Domain}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Temporary allow"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ExpiresFormatted}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="2"
                            Tag="{x:Bind}"
                            Click="RevokeTempAllow_Click"
                            Content="Revoke"
                            Padding="8,4"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- Log Row Template -->
        <DataTemplate x:Key="LogRowTemplate" x:DataType="vm:LogRowViewModel">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,4">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Time -->
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind TimeFormatted}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"
                               MinWidth="40"/>

                    <!-- Domain + Reason -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind Domain}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind Reason}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Count badge -->
                    <Border Grid.Column="2"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="10"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind HasCountBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind CountBadge}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    </Border>

                    <!-- Context menu button -->
                    <Button Grid.Column="3"
                            Tag="{x:Bind}"
                            Click="LogRow_AllowMenu_Click"
                            Padding="4"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Allow options">
                        <FontIcon Glyph="&#xE712;" FontSize="12"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Top domain row template -->
        <DataTemplate x:Key="TopDomainRowTemplate" x:DataType="vm:TopDomainRowViewModel">
            <Grid ColumnSpacing="12" Padding="2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Bind Domain}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1"
                           Text="{x:Bind CountLabel}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0" Margin="24,14,24,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Web Filter"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Block whole categories of websites or a single site for every browser on this PC"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Master switch and pause -->
        <Border Grid.Row="1" Margin="24,0,24,6" Style="{StaticResource WebFilterCard}" Padding="16,10">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0"
                          Glyph="&#xE774;"
                          FontSize="20"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="StatusDot"
                                 Width="8" Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock x:Name="StatusTitle"
                                   Text="Web Filter is Off"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusDetail"
                               Text="No websites are blocked. The filter isn't set up yet."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ToggleSwitch x:Name="MasterToggle"
                                  Toggled="MasterToggle_Toggled"
                                  OnContent="On"
                                  OffContent="Off"
                                  MinWidth="0"/>
                    <!-- Pause flyout -->
                    <Button x:Name="PauseButton"
                            Content="Pause"
                            IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Pause for 30 minutes"
                                                Click="PauseButton_30_Click"/>
                                <MenuFlyoutItem Text="Pause for 1 hour"
                                                Click="PauseButton_60_Click"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Resume now"
                                                Click="PauseResume_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Quick tool: check a website against the enabled lists -->
        <Border Grid.Row="2" Margin="24,0,24,6" Style="{StaticResource WebFilterCard}" Padding="16,10">
            <StackPanel Spacing="6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE721;"
                              FontSize="16"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <TextBox Grid.Column="1"
                             x:Name="CheckWebsiteBox"
                             PlaceholderText="Check a website (example.com or https://example.com/page)"
                             TextChanged="CheckWebsiteBox_TextChanged"
                             KeyDown="CheckWebsiteBox_KeyDown"
                             HorizontalAlignment="Stretch"/>

                    <Button Grid.Column="2"
                            x:Name="CheckWebsiteButton"
                            Content="Check"
                            Click="CheckWebsiteButton_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanCheck, Mode=OneWay}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing Width="14" Height="14"
                                  IsActive="{x:Bind ViewModel.IsChecking, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.ListStatus, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <InfoBar x:Name="CheckResultBar"
                         IsOpen="False"
                         IsClosable="True">
                    <InfoBar.Content>
                        <StackPanel x:Name="CheckBlockedActionPanel"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="0,8,0,0"
                                    Visibility="Collapsed">
                            <Button Content="Allow for 15 min" Click="Allow15Min_Click" Padding="8,4"/>
                            <Button Content="Allow for 1 hour" Click="Allow1Hour_Click" Padding="8,4"/>
                            <Button Content="Allow today" Click="AllowToday_Click" Padding="8,4"/>
                            <Button Content="Always allow" Click="CheckAlwaysAllow_Click" Padding="8,4"/>
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>
            </StackPanel>
        </Border>

        <!-- Status area -->
        <StackPanel Grid.Row="3" Padding="24,0,24,6" Spacing="6">
            <InfoBar x:Name="NotElevatedInfoBar"
                     Severity="Warning"
                     Title="Administrator rights required"
                     Message="Administrator rights are needed to change DNS and firewall settings on this PC."
                     IsOpen="False"
                     IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Restart as administrator"
                            Click="RestartAsAdminButton_Click"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="TamperInfoBar"
                     Severity="Informational"
                     Title="DNS changed outside AppLock"
                     Message="DNS settings were changed outside AppLock and were automatically re-applied to the filter."
                     IsOpen="False"
                     IsClosable="True"/>

            <InfoBar x:Name="FilterErrorInfoBar"
                     Severity="Error"
                     Title="Filter stopped unexpectedly"
                     Message=""
                     IsOpen="False"
                     IsClosable="True"/>

            <InfoBar x:Name="RestoreSuccessBar"
                     Severity="Success"
                     Title="Network settings restored"
                     Message="Original DNS settings have been restored on all network adapters."
                     IsOpen="False"
                     IsClosable="True"/>

            <InfoBar x:Name="VpnInfoBar"
                     Severity="Informational"
                     Title="VPN or proxy active"
                     Message="{x:Bind ViewModel.VpnOrProxyMessage, Mode=OneWay}"
                     IsOpen="{x:Bind ViewModel.IsVpnOrProxyActive, Mode=OneWay}"
                     IsClosable="True"/>

            <InfoBar x:Name="DomainJoinedInfoBar"
                     Severity="Warning"
                     Title="Domain-joined PC detected"
                     Message="This PC is joined to an organization domain. DNS and browser policies may be managed by policy."
                     IsOpen="{x:Bind ViewModel.IsDomainJoined, Mode=OneWay}"
                     IsClosable="True"/>
        </StackPanel>

        <!-- Honest scope note -->
        <TextBlock Grid.Row="4"
                   Margin="24,0,24,6"
                   Text="Blocks domain names, not single pages: blocking a site blocks its whole domain. A VPN, a proxy or a browser's own secure DNS can get around it."
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   TextWrapping="Wrap"/>

        <!-- Tabs (Segmented pill bar) -->
        <Border Grid.Row="5" Style="{StaticResource SegmentedTabContainer}" Margin="24,0,24,10">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="CategoriesTabButton"
                        Content="Categories"
                        Tag="categories"
                        Click="Tab_Click"
                        IsEnabled="{x:Bind ViewModel.IsLocalMode, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind GetTabToolTip(ViewModel.IsLocalMode), Mode=OneWay}"
                        Style="{StaticResource SegmentedTabButtonActive}"/>
                <Button x:Name="SitesTabButton"
                        Content="Sites"
                        Tag="sites"
                        Click="Tab_Click"
                        IsEnabled="{x:Bind ViewModel.IsLocalMode, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind GetTabToolTip(ViewModel.IsLocalMode), Mode=OneWay}"
                        Style="{StaticResource SegmentedTabButtonInactive}"/>
                <Button x:Name="ActivityTabButton"
                        Content="Activity"
                        Tag="activity"
                        Click="Tab_Click"
                        IsEnabled="{x:Bind ViewModel.IsLocalMode, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind GetTabToolTip(ViewModel.IsLocalMode), Mode=OneWay}"
                        Style="{StaticResource SegmentedTabButtonInactive}"/>
                <Button x:Name="SettingsTabButton"
                        Content="Settings"
                        Tag="settings"
                        Click="Tab_Click"
                        Style="{StaticResource SegmentedTabButtonInactive}"/>
            </StackPanel>
        </Border>

        <!-- Tab content -->
        <Grid Grid.Row="6" Padding="24,0,24,24">

            <!-- Categories tab: real category cards -->
            <ScrollViewer x:Name="CategoriesPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <InfoBar Severity="Informational"
                             IsOpen="{x:Bind ViewModel.IsProviderMode, Mode=OneWay}"
                             Title="Available in Local filter mode"
                             Message="Filtered DNS provider mode sets Windows DNS directly to a family filter. Custom category rules only apply in Local filter mode."
                             IsClosable="False"/>
                    <ItemsRepeater x:Name="CategoryRepeater"
                                   ItemsSource="{x:Bind ViewModel.CategoryCards, Mode=OneWay}"
                                   ItemTemplate="{StaticResource CategoryCardTemplate}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Sites tab: Services, Always Block, Always Allow -->
            <ScrollViewer x:Name="SitesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <InfoBar Severity="Informational"
                             IsOpen="{x:Bind ViewModel.IsProviderMode, Mode=OneWay}"
                             Title="Available in Local filter mode"
                             Message="Filtered DNS provider mode sets Windows DNS directly to a family filter. Custom service toggles, always block/allow lists, and temporary allows only apply in Local filter mode."
                             IsClosable="False"/>
                    <!-- Sites sub-tabs (Segmented pill bar matching Image 1) -->
                    <Border Style="{StaticResource SegmentedTabContainer}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="ServicesSubTabButton"
                                    Content="Services"
                                    Tag="services"
                                    Click="SitesSubTab_Click"
                                    Style="{StaticResource SegmentedTabButtonActive}"/>
                            <Button x:Name="AlwaysBlockSubTabButton"
                                    Content="Always Block"
                                    Tag="always_block"
                                    Click="SitesSubTab_Click"
                                    Style="{StaticResource SegmentedTabButtonInactive}"/>
                            <Button x:Name="AlwaysAllowSubTabButton"
                                    Content="Always Allow"
                                    Tag="always_allow"
                                    Click="SitesSubTab_Click"
                                    Style="{StaticResource SegmentedTabButtonInactive}"/>
                            <Button x:Name="TempAllowSubTabButton"
                                    Content="Temporary Allow"
                                    Tag="temp_allow"
                                    Click="SitesSubTab_Click"
                                    Style="{StaticResource SegmentedTabButtonInactive}"/>
                        </StackPanel>
                    </Border>

                    <!-- Services catalog -->
                    <StackPanel x:Name="ServicesSection" Spacing="12">
                        <TextBlock Text="Block specific services without blocking a whole category. Each service has its own toggle."
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ServiceItems, Mode=OneWay}"
                                       ItemTemplate="{StaticResource ServiceCardTemplate}"/>
                    </StackPanel>

                    <!-- Always Block -->
                    <StackPanel x:Name="AlwaysBlockSection" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="These websites are always blocked on this PC, regardless of categories or schedules."
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>

                        <!-- Add form card -->
                        <Border Style="{StaticResource WebFilterCard}" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Add a domain to always block" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             x:Name="AlwaysBlockDomainBox"
                                             PlaceholderText="example.com, *.site.com or URL"
                                             KeyDown="AlwaysBlockInput_KeyDown"/>
                                    <TextBox Grid.Column="1"
                                             x:Name="AlwaysBlockNoteBox"
                                             PlaceholderText="Optional note (e.g. distracting)"
                                             KeyDown="AlwaysBlockInput_KeyDown"/>
                                    <Button Grid.Column="2"
                                            Content="Add"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="AddAlwaysBlockButton_Click"/>
                                </Grid>
                                <InfoBar x:Name="AlwaysBlockInfoBar" IsOpen="False" IsClosable="True"/>
                            </StackPanel>
                        </Border>

                        <!-- Header actions: count | spacer | Search + Delete All + Import + Export -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind ViewModel.AlwaysBlockCountLabel, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="AlwaysBlockSearchBox"
                                         PlaceholderText="Search blocked domains..."
                                         TextChanged="AlwaysBlockSearch_TextChanged"
                                         Width="220"
                                         VerticalAlignment="Center"/>
                                <Button x:Name="ClearAlwaysBlockButton"
                                        Click="ClearAlwaysBlockButton_Click"
                                        ToolTipService.ToolTip="Delete all domains in Always Block">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                        <TextBlock Text="Delete All"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="Import..." Click="ImportAlwaysBlockButton_Click"/>
                                <Button Content="Export..." Click="ExportAlwaysBlockButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Items list -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredAlwaysBlockItems, Mode=OneWay}"
                                       ItemTemplate="{StaticResource DomainRowTemplate}"/>
                    </StackPanel>

                    <!-- Always Allow -->
                    <StackPanel x:Name="AlwaysAllowSection" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="These websites are always allowed, bypassing all category and service block rules. Adding or removing requires authentication."
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>

                        <!-- Add form card -->
                        <Border Style="{StaticResource WebFilterCard}" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Add a domain to always allow" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             x:Name="AlwaysAllowDomainBox"
                                             PlaceholderText="example.com, *.site.com or URL"
                                             KeyDown="AlwaysAllowInput_KeyDown"/>
                                    <TextBox Grid.Column="1"
                                             x:Name="AlwaysAllowNoteBox"
                                             PlaceholderText="Optional note (e.g. work requirement)"
                                             KeyDown="AlwaysAllowInput_KeyDown"/>
                                    <Button Grid.Column="2"
                                            Content="Add"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="AddAlwaysAllowButton_Click"/>
                                </Grid>
                                <InfoBar x:Name="AlwaysAllowInfoBar" IsOpen="False" IsClosable="True"/>
                            </StackPanel>
                        </Border>

                        <!-- Header actions: count | spacer | Search + Delete All + Import + Export -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind ViewModel.AlwaysAllowCountLabel, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="AlwaysAllowSearchBox"
                                         PlaceholderText="Search allowed domains..."
                                         TextChanged="AlwaysAllowSearch_TextChanged"
                                         Width="220"
                                         VerticalAlignment="Center"/>
                                <Button x:Name="ClearAlwaysAllowButton"
                                        Click="ClearAlwaysAllowButton_Click"
                                        ToolTipService.ToolTip="Delete all domains in Always Allow">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                        <TextBlock Text="Delete All"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="Import..." Click="ImportAlwaysAllowButton_Click"/>
                                <Button Content="Export..." Click="ExportAlwaysAllowButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Items list -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredAlwaysAllowItems, Mode=OneWay}"
                                       ItemTemplate="{StaticResource DomainRowTemplate}"/>
                    </StackPanel>

                    <!-- Temporary Allow -->
                    <StackPanel x:Name="TempAllowSection" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="Websites temporarily unblocked for 15 minutes, 1 hour, or until midnight. Once expired, they are automatically blocked again."
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="{x:Bind ViewModel.TempAllowsCountLabel, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ActiveTempAllows, Mode=OneWay}"
                                       ItemTemplate="{StaticResource TempAllowRowTemplate}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ActivityPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Margin="0,0,0,16">
                    <InfoBar Severity="Informational"
                             IsOpen="{x:Bind ViewModel.IsProviderMode, Mode=OneWay}"
                             Title="Available in Local filter mode"
                             Message="Filtered DNS provider mode sets Windows DNS directly to a family filter without running a local DNS server. Query logging and activity stats only apply in Local filter mode."
                             IsClosable="False"/>

                    <!-- Summary row -->
                    <Border Style="{StaticResource WebFilterCard}" Padding="16">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:Name="BlockedTodayNumber" Text="0"
                                           Style="{StaticResource TitleTextBlockStyle}"/>
                                <TextBlock Text="Blocked today"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="BlockedWeekNumber" Text="0"
                                           Style="{StaticResource TitleTextBlockStyle}"/>
                                <TextBlock Text="Blocked this week"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock x:Name="TopCategoryText" Text="None"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="Top blocked category"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Blocked requests -->
                    <Border Style="{StaticResource WebFilterCard}" Padding="16">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Blocked requests"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center"/>

                                <!-- Filter & Sort Bar -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Date Filter Pill -->
                                    <Border Style="{StaticResource SegmentedTabContainer}">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button x:Name="FilterTodayButton"
                                                    Content="Today"
                                                    Click="FilterToday_Click"
                                                    Style="{StaticResource SegmentedTabButtonActive}"
                                                    Padding="12,4"/>
                                            <Button x:Name="FilterAllButton"
                                                    Content="All time"
                                                    Click="FilterAll_Click"
                                                    Style="{StaticResource SegmentedTabButtonInactive}"
                                                    Padding="12,4"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Calendar date picker -->
                                    <CalendarDatePicker x:Name="ActivityDatePicker"
                                                        PlaceholderText="Pick date"
                                                        Width="130"/>

                                    <!-- Sorting option -->
                                    <ComboBox x:Name="SortActivityComboBox"
                                              SelectedIndex="0"
                                              SelectionChanged="SortActivityComboBox_SelectionChanged"
                                              Width="140">
                                        <ComboBoxItem Content="Newest first"/>
                                        <ComboBoxItem Content="Oldest first"/>
                                        <ComboBoxItem Content="Most requests"/>
                                        <ComboBoxItem Content="Domain (A-Z)"/>
                                        <ComboBoxItem Content="Domain (Z-A)"/>
                                    </ComboBox>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        x:Name="RefreshActivityButton"
                                        Click="RefreshActivity_Click"
                                        Content="&#xE72C;"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        Padding="8,4"
                                        Background="Transparent"
                                        BorderThickness="1"
                                        ToolTipService.ToolTip="Refresh"/>
                            </Grid>

                            <TextBlock Text="Repeats within a minute are grouped."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <!-- Empty state -->
                            <TextBlock x:Name="NoBlockedText"
                                       Text="No blocked requests logged for this period."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap"/>

                            <!-- Paged Rows List -->
                            <ItemsRepeater x:Name="BlockedList"
                                           ItemTemplate="{StaticResource LogRowTemplate}"/>

                            <!-- Pagination Controls -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        x:Name="ActivityPrevPageButton"
                                        Click="ActivityPrevPage_Click"
                                        IsEnabled="False"
                                        Padding="12,5">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE76B;" FontSize="11"/>
                                        <TextBlock Text="Previous"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="ActivityPageSummaryText"
                                               Text="0 items"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="·"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Rows:"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="RowsPerPageComboBox"
                                              SelectionChanged="RowsPerPageComboBox_SelectionChanged"
                                              MinWidth="80"
                                              Padding="8,4">
                                        <ComboBoxItem Content="10" Tag="10"/>
                                        <ComboBoxItem Content="30" Tag="30"/>
                                        <ComboBoxItem Content="50" Tag="50"/>
                                        <ComboBoxItem Content="100" Tag="100"/>
                                        <ComboBoxItem x:Name="RowsCustomItem" Content="Custom" Tag="0"/>
                                    </ComboBox>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        x:Name="ActivityNextPageButton"
                                        Click="ActivityNextPage_Click"
                                        IsEnabled="False"
                                        Padding="12,5">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Next"/>
                                        <FontIcon Glyph="&#xE76C;" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Top blocked domains (7 days) -->
                    <Border Style="{StaticResource WebFilterCard}" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Top blocked domains (7 days)"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>

                            <TextBlock x:Name="NoTopDomainsText"
                                       Text="No data yet."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                            <!-- Donut chart + legend side by side -->
                            <Grid x:Name="TopDomainsChartGrid" Visibility="Collapsed" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Donut canvas -->
                                <Canvas x:Name="DonutCanvas"
                                        Grid.Column="0"
                                        Width="180"
                                        Height="180"/>

                                <!-- Legend -->
                                <ItemsRepeater x:Name="TopDomainsLegend"
                                               Grid.Column="1"
                                               VerticalAlignment="Center">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="local:TopDomainLegendItem">
                                            <Grid Margin="0,3" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0"
                                                           Width="10" Height="10"
                                                           RadiusX="2" RadiusY="2"
                                                           VerticalAlignment="Center">
                                                    <Rectangle.Fill>
                                                        <SolidColorBrush Color="{x:Bind Color}"/>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Domain}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind CountLabel}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Logging controls -->
                    <Border Style="{StaticResource WebFilterCard}" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Logging controls"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>

                            <ToggleSwitch x:Name="LogBlockedToggle"
                                          Header="Log blocked requests"
                                          IsOn="True"
                                          MinWidth="0"
                                          Toggled="LogBlocked_Toggled"/>

                            <StackPanel Spacing="4">
                                <ToggleSwitch x:Name="LogAllowedToggle"
                                              Header="Log allowed requests"
                                              IsOn="False"
                                              MinWidth="0"
                                              Toggled="LogAllowed_Toggled"/>
                                <TextBlock Text="⚠ Allowed request logging records browsing history on this PC."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Log retention"
                                           Style="{StaticResource BodyTextBlockStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <RadioButton x:Name="Retain7Days" Content="7 days"
                                                 GroupName="LogRetention"
                                                 Checked="LogRetention_Checked" Tag="7"/>
                                    <RadioButton x:Name="Retain30Days" Content="30 days"
                                                 GroupName="LogRetention"
                                                 IsChecked="True"
                                                 Checked="LogRetention_Checked" Tag="30"/>
                                    <RadioButton x:Name="Retain90Days" Content="90 days"
                                                 GroupName="LogRetention"
                                                 Checked="LogRetention_Checked" Tag="90"/>
                                </StackPanel>
                            </StackPanel>

                            <ToggleSwitch x:Name="NotifyOnBlockToggle"
                                          Header="Notify when a site is blocked"
                                          IsOn="False"
                                          MinWidth="0"
                                          Toggled="NotifyOnBlock_Toggled">
                            </ToggleSwitch>
                            <TextBlock Text="Throttled to once per domain per 5 minutes."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <Button x:Name="ClearLogButton"
                                    Content="Clear log"
                                    Click="ClearLog_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <!-- Filter Mode card (M10) -->
                    <Border Style="{StaticResource WebFilterCard}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Filtering mode"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="Choose how AppLock filters web traffic on this PC."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <RadioButton x:Name="LocalFilterModeRadio"
                                             GroupName="WebFilterModeGroup"
                                             Checked="ModeRadio_Checked"
                                             Tag="local">
                                    <StackPanel Spacing="2" Margin="0,-2,0,0">
                                        <TextBlock Text="Local filter (recommended)"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="A lightweight DNS filter runs on this PC and Windows points at it. Supports custom categories, block/allow lists, services, schedules, and query logs."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="ProviderModeRadio"
                                             GroupName="WebFilterModeGroup"
                                             Checked="ModeRadio_Checked"
                                             Tag="provider">
                                    <StackPanel Spacing="2" Margin="0,-2,0,0">
                                        <TextBlock Text="Filtered DNS provider (simple)"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="AppLock points Windows DNS directly to a family-filtering DNS provider. Simple and lightweight; protects against adult content and malware without running a local service."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Filtered DNS provider options card (M10, visible in Provider mode) -->
                    <Border x:Name="ProviderOptionsCard"
                            Style="{StaticResource WebFilterCard}"
                            Visibility="{x:Bind GetProviderOptionsVisibility(ViewModel.IsProviderMode), Mode=OneWay}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Filtered DNS provider options"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="Select which family-filter DNS provider to point Windows to."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <!-- Cloudflare Family -->
                                <Border Padding="14,12"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0"
                                                     x:Name="CloudflareFamilyRadio"
                                                     GroupName="DnsProviderGroup"
                                                     Tag="cloudflare-family"
                                                     Checked="ProviderRadio_Checked"
                                                     VerticalAlignment="Top"
                                                     Margin="0,2,0,0"/>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="Cloudflare Family" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <TextBlock Text="Blocks malware and adult content." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="1.1.1.3, 1.0.0.3 · 2606:4700:4700::1113, 2606:4700:4700::1003" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <HyperlinkButton Grid.Column="2" Content="Website" NavigateUri="https://one.one.one.one/family/" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>

                                <!-- CleanBrowsing Family -->
                                <Border Padding="14,12"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0"
                                                     x:Name="CleanBrowsingFamilyRadio"
                                                     GroupName="DnsProviderGroup"
                                                     Tag="cleanbrowsing-family"
                                                     Checked="ProviderRadio_Checked"
                                                     VerticalAlignment="Top"
                                                     Margin="0,2,0,0"/>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="CleanBrowsing Family Filter" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <TextBlock Text="Blocks adult content, malicious domains, and enforces SafeSearch." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="185.228.168.168, 185.228.169.168 · 2a0d:2a00:1::, 2a0d:2a00:2::" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <HyperlinkButton Grid.Column="2" Content="Website" NavigateUri="https://cleanbrowsing.org/filters/" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>

                                <!-- CleanBrowsing Adult -->
                                <Border Padding="14,12"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0"
                                                     x:Name="CleanBrowsingAdultRadio"
                                                     GroupName="DnsProviderGroup"
                                                     Tag="cleanbrowsing-adult"
                                                     Checked="ProviderRadio_Checked"
                                                     VerticalAlignment="Top"
                                                     Margin="0,2,0,0"/>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="CleanBrowsing Adult Filter" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <TextBlock Text="Blocks adult content and malicious domains." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="185.228.168.10, 185.228.169.11 · 2a0d:2a00:1::1, 2a0d:2a00:2::1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <HyperlinkButton Grid.Column="2" Content="Website" NavigateUri="https://cleanbrowsing.org/filters/" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>

                                <!-- OpenDNS FamilyShield -->
                                <Border Padding="14,12"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0"
                                                     x:Name="OpenDnsFamilyRadio"
                                                     GroupName="DnsProviderGroup"
                                                     Tag="opendns-familyshield"
                                                     Checked="ProviderRadio_Checked"
                                                     VerticalAlignment="Top"
                                                     Margin="0,2,0,0"/>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="OpenDNS FamilyShield" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <TextBlock Text="Pre-configured to block adult websites and phishing." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="208.67.222.123, 208.67.220.123 · 2620:119:35::123, 2620:119:53::123" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <HyperlinkButton Grid.Column="2" Content="Website" NavigateUri="https://www.opendns.com/setupguide/#familyshield" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>

                                <!-- AdGuard Family Protection -->
                                <Border Padding="14,12"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0"
                                                     x:Name="AdGuardFamilyRadio"
                                                     GroupName="DnsProviderGroup"
                                                     Tag="adguard-family"
                                                     Checked="ProviderRadio_Checked"
                                                     VerticalAlignment="Top"
                                                     Margin="0,2,0,0"/>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="AdGuard Family Protection" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <TextBlock Text="Blocks adult websites, ads, trackers, and enforces SafeSearch." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="94.140.14.15, 94.140.15.16 · 2a10:50c0::bad1:ff, 2a10:50c0::bad2:ff" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <HyperlinkButton Grid.Column="2" Content="Website" NavigateUri="https://adguard-dns.io/en/public-dns.html" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="💡 Filtered DNS providers primarily block adult content and malware, not gambling or social media. To block gambling, social media, or specific sites, switch to Local filter mode."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Local filter options card (M10, visible in Local mode) -->
                    <Border x:Name="LocalOptionsCard"
                            Style="{StaticResource WebFilterCard}"
                            Visibility="{x:Bind GetLocalOptionsVisibility(ViewModel.IsLocalMode), Mode=OneWay}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Local filter options"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="Configure upstream DNS forwarder, caching, and block responses."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Upstream DNS -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Upstream DNS (where allowed lookups go)"
                                           Style="{StaticResource BodyTextBlockStyle}"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              x:Name="UpstreamComboBox"
                                              HorizontalAlignment="Stretch"
                                              SelectedIndex="{x:Bind ViewModel.UpstreamIndex, Mode=TwoWay}"
                                              SelectionChanged="UpstreamComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Cloudflare (DoH, default)"/>
                                        <ComboBoxItem Content="Google (DoH)"/>
                                        <ComboBoxItem Content="Quad9 (DoH)"/>
                                        <ComboBoxItem Content="My network's original DNS"/>
                                        <ComboBoxItem Content="Custom (DoH URL or IP)"/>
                                    </ComboBox>
                                    <Button Grid.Column="1"
                                            Content="Test upstream"
                                            Click="TestUpstreamButton_Click"/>
                                </Grid>
                                <TextBox x:Name="CustomUpstreamBox"
                                         Header="Custom upstream address (DoH URL or IP)"
                                         Text="{x:Bind ViewModel.CustomUpstream, Mode=TwoWay}"
                                         Visibility="{x:Bind ViewModel.IsCustomUpstream, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                         PlaceholderText="https://example.com/dns-query or 192.168.1.1"/>
                                <TextBlock x:Name="TestUpstreamResultText"
                                           Visibility="Collapsed"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </StackPanel>

                            <!-- DNS Cache & Block Response -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <ToggleSwitch Header="DNS cache"
                                                  IsOn="{x:Bind ViewModel.CacheEnabled, Mode=TwoWay}"
                                                  MinWidth="0"/>
                                    <Button Content="Clear cache"
                                            Click="ClearCacheButton_Click"
                                            Padding="12,4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Block response" Style="{StaticResource BodyTextBlockStyle}"/>
                                    <ComboBox x:Name="BlockResponseComboBox"
                                              HorizontalAlignment="Stretch"
                                              SelectedIndex="{x:Bind ViewModel.BlockResponseIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Not found (NXDOMAIN, default)"/>
                                        <ComboBoxItem Content="0.0.0.0 / :: (Null address)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Block lists card (M12, visible in Local mode) -->
                    <Border Style="{StaticResource WebFilterCard}"
                            Visibility="{x:Bind GetLocalOptionsVisibility(ViewModel.IsLocalMode), Mode=OneWay}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Block lists"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="Community-maintained open lists for adult content, gambling, malware, bypass tools, and more."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.BlockListsSummaryText, Mode=OneWay}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="Bundled snapshots loaded · Weekly automatic updates"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        x:Name="UpdateListsButton"
                                        Content="Update now"
                                        Click="UpdateListsButton_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock x:Name="UpdateListsResultText"
                                       Visibility="Collapsed"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Update automatically"
                                               Style="{StaticResource BodyTextBlockStyle}"/>
                                    <TextBlock Text="Periodically check for list updates over HTTPS."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.AutoUpdateLists, Mode=TwoWay}"
                                              OnContent="" OffContent="" MinWidth="0"/>
                            </Grid>

                            <!-- Credits & Licenses Link -->
                            <HyperlinkButton Content="Credits &amp; licenses"
                                             Click="CreditsAndLicenses_Click"
                                             Padding="0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Bypass protection card (M9) -->
                    <Border Style="{StaticResource WebFilterCard}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Bypass protection"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="Prevent apps and browsers from routing around Web Filter using alternate DNS or encrypted DNS."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Block other DNS servers -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Block other DNS servers"
                                               Style="{StaticResource BodyTextBlockStyle}"/>
                                    <TextBlock Text="Blocks outbound UDP/TCP port 53 and TCP port 853 (DNS over TLS) to external servers, stopping apps with hard-coded DNS."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              x:Name="BlockOtherDnsToggle"
                                              IsOn="{x:Bind ViewModel.BlockOtherDns, Mode=OneWay}"
                                              Toggled="BlockOtherDns_Toggled"
                                              OnContent="" OffContent="" MinWidth="0"/>
                            </Grid>

                            <!-- Block known public DoH servers -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Block known public DoH servers"
                                               Style="{StaticResource BodyTextBlockStyle}"/>
                                    <TextBlock Text="Blocks outbound connections to known public DNS-over-HTTPS resolver addresses (Cloudflare, Google, Quad9, AdGuard, etc.). The currently chosen upstream resolver is excluded."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              x:Name="BlockKnownDohToggle"
                                              IsOn="{x:Bind ViewModel.BlockKnownDoh, Mode=OneWay}"
                                              Toggled="BlockKnownDoh_Toggled"
                                              OnContent="" OffContent="" MinWidth="0"/>
                            </Grid>

                            <!-- Turn off browser Secure DNS -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Turn off browser Secure DNS (policy)"
                                               Style="{StaticResource BodyTextBlockStyle}"/>
                                    <TextBlock Text="Sets machine policies in Chrome, Edge, Brave, and Firefox to disable internal DNS-over-HTTPS. Browsers will indicate they are managed by policy."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              x:Name="BrowserPoliciesToggle"
                                              IsOn="{x:Bind ViewModel.BrowserPolicies, Mode=OneWay}"
                                              Toggled="BrowserPolicies_Toggled"
                                              OnContent="" OffContent="" MinWidth="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WebFilterCard}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Emergency"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Restore the PC's original DNS settings immediately and turn off Web Filter. This always works without authentication."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <Button Content="Restore my network settings"
                                    Click="RestoreNetworkButton_Click"
                                    CornerRadius="4"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
