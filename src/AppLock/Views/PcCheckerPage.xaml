<Page
    x:Class="AppLock.Views.PcCheckerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:AppLock.Views.Controls"
    xmlns:pcvm="using:AppLock.ViewModels.PcChecker"
    xmlns:models="using:AppLock.Models.PcChecker"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked"/>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked"/>
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!-- One tile of the Overview dashboard -->
        <DataTemplate x:Key="OverviewTileTemplate" x:DataType="pcvm:OverviewTile">
            <Button Click="Tile_Click"
                    Width="300"
                    Margin="0,0,12,12"
                    Padding="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind AutomationName}">
                <StackPanel Padding="16" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="{x:Bind Glyph}"
                                  FontSize="14"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind Title}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind Primary}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{x:Bind Secondary}"
                               Visibility="{x:Bind SecondaryVisibility}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- The common property renderer: any InfoItem draws the same way -->
        <DataTemplate x:Key="InfoRowTemplate" x:DataType="pcvm:InfoItemRow">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{x:Bind Label}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind BadgeText}"
                                   Visibility="{x:Bind BadgeVisibility}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{x:Bind DisplayValue, Mode=OneWay}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind SourceText}"
                                   Visibility="{x:Bind SourceVisibility}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>

                    <!-- Status is icon + tooltip text, never colour alone -->
                    <Grid Grid.Column="2" VerticalAlignment="Center" Width="18">
                        <FontIcon Glyph="&#xE73E;" FontSize="14"
                                  Visibility="{x:Bind OkVisibility}"
                                  ToolTipService.ToolTip="{x:Bind StatusText}"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        <FontIcon Glyph="&#xE946;" FontSize="14"
                                  Visibility="{x:Bind InfoVisibility}"
                                  ToolTipService.ToolTip="{x:Bind StatusText}"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <FontIcon Glyph="&#xE7BA;" FontSize="14"
                                  Visibility="{x:Bind WarningVisibility}"
                                  ToolTipService.ToolTip="{x:Bind StatusText}"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Visibility="{x:Bind ProblemVisibility}"
                                  ToolTipService.ToolTip="{x:Bind StatusText}"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </Grid>

                    <Button Grid.Column="3"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            Visibility="{x:Bind RevealVisibility}"
                            Click="RevealRow_Click"
                            ToolTipService.ToolTip="{x:Bind EyeToolTip, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind EyeToolTip, Mode=OneWay}">
                        <FontIcon Glyph="&#xE7B3;" FontSize="13"/>
                    </Button>

                    <Button Grid.Column="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            Click="CopyRow_Click"
                            ToolTipService.ToolTip="Copy this value"
                            AutomationProperties.Name="Copy this value">
                        <FontIcon Glyph="&#xE8C8;" FontSize="13"/>
                    </Button>

                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2">
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="6"
                                Visibility="{x:Bind LaunchVisibility}"
                                Click="LaunchRow_Click"
                                ToolTipService.ToolTip="Open this Windows tool"
                                AutomationProperties.Name="Open this Windows tool">
                            <FontIcon Glyph="&#xE8A7;" FontSize="13"/>
                        </Button>

                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="6"
                                Visibility="{x:Bind DismissVisibility}"
                                Click="DismissFinding_Click"
                                ToolTipService.ToolTip="Don't show this finding again"
                                AutomationProperties.Name="Dismiss this finding">
                            <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,20,24,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Breadcrumb and header -->
        <StackPanel Grid.Row="0" Spacing="14">
            <!-- Breadcrumb Navigation (same pattern as the Volume Mixer page) -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackButton"
                        Click="BackButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        TabIndex="0"
                        ToolTipService.ToolTip="Back"
                        AutomationProperties.Name="Back to Others">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Others"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="›"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="PC Checker"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="PC Checker"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Every detail about your hardware and software, with a health check"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Toolbar: search, detail level, identifier masking, refresh -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     MaxWidth="420"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     PlaceholderText="Search every field and value…"
                     TextChanged="SearchBox_TextChanged"
                     AutomationProperties.Name="Search every PC Checker field"/>

            <ComboBox x:Name="DetailLevelBox"
                      Grid.Column="1"
                      Width="132"
                      VerticalAlignment="Center"
                      SelectionChanged="DetailLevelBox_SelectionChanged"
                      AutomationProperties.Name="Details level">
                <ComboBoxItem Content="Basic"/>
                <ComboBoxItem Content="Detailed"/>
                <ComboBoxItem Content="Everything"/>
            </ComboBox>

            <ToggleSwitch x:Name="HideIdentifiersToggle"
                          Grid.Column="2"
                          VerticalAlignment="Center"
                          MinWidth="0"
                          OnContent="Hide identifiers"
                          OffContent="Show identifiers"
                          Toggled="HideIdentifiersToggle_Toggled"/>

            <Button x:Name="RefreshButton"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Click="RefreshButton_Click"
                    AutomationProperties.Name="Rescan (F5)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>

            <DropDownButton x:Name="MoreButton"
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="More PC Checker actions">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE712;" FontSize="12"/>
                    <TextBlock Text="More"/>
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="Copy a summary" Click="CopySummary_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Save report as HTML…" Tag="html" Click="SaveReport_Click"/>
                        <MenuFlyoutItem Text="Save report as text…" Tag="txt" Click="SaveReport_Click"/>
                        <MenuFlyoutItem Text="Save report as JSON…" Tag="json" Click="SaveReport_Click"/>
                        <MenuFlyoutItem Text="Save report as CSV…" Tag="csv" Click="SaveReport_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Take a snapshot" Click="TakeSnapshot_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE722;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Compare last two snapshots" Click="CompareSnapshots_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Hardware tests…" Click="OpenHardwareTests_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE950;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <ProgressRing x:Name="BusyRing"
                          Grid.Column="5"
                          Width="18"
                          Height="18"
                          IsActive="False"
                          VerticalAlignment="Center"/>
        </Grid>

        <!-- Category rail + content -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
                <ListView x:Name="CategoryList"
                          ItemsSource="{x:Bind ViewModel.Categories}"
                          SelectionMode="Single"
                          SelectionChanged="CategoryList_SelectionChanged"
                          AutomationProperties.Name="PC Checker categories">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="8,2"/>
                            <Setter Property="MinHeight" Value="34"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PcCategory">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="2">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Title}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">
                    <!-- Status line -->
                    <TextBlock x:Name="StatusTextBlock"
                               Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>

                    <InfoBar Severity="Informational"
                             IsClosable="False"
                             Title="Some values need administrator rights"
                             Message="Restart AppLock as administrator to read drive health, TPM details and some event logs."
                             Visibility="{x:Bind ViewModel.AdminHintVisibility, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button Content="Restart as administrator"
                                    Click="RestartAdminButton_Click"
                                    AutomationProperties.Name="Restart AppLock as administrator"/>
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <TextBlock Text="{x:Bind ViewModel.PlaceholderText, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.PlaceholderVisibility, Mode=OneWay}"
                               FontSize="13"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Tiles}"
                                  Visibility="{x:Bind ViewModel.TilesVisibility, Mode=OneWay}"
                                  ItemTemplate="{StaticResource OverviewTileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:WrapPanel HorizontalSpacing="0" VerticalSpacing="0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}"
                                  Visibility="{x:Bind ViewModel.RowsVisibility, Mode=OneWay}"
                                  ItemTemplate="{StaticResource InfoRowTemplate}"
                                  MaxWidth="900"
                                  HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
