<ContentDialog
    x:Class="AppLock.Views.Vault.ChangeVaultPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Change Vault Password"
    PrimaryButtonText="Update Password"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonClick="UpdatePasswordButton_Click">

    <StackPanel Spacing="16" MinWidth="360" MaxWidth="440">
        <TextBlock Text="Changing the vault password re-wraps the master key with a fresh salt. Your stored file contents remain untouched."
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <!-- New password -->
        <PasswordBox x:Name="NewPasswordBox"
                     Header="New password"
                     PlaceholderText="Enter new strong password"
                     PasswordRevealMode="Peek"
                     CornerRadius="4"
                     PasswordChanged="NewPasswordBox_PasswordChanged"/>

        <!-- Strength bar -->
        <StackPanel Spacing="4">
            <ProgressBar x:Name="StrengthBar" Value="0" Maximum="100" CornerRadius="2"/>
            <TextBlock x:Name="StrengthLabel" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Confirm password -->
        <PasswordBox x:Name="ConfirmPasswordBox"
                     Header="Confirm new password"
                     PlaceholderText="Repeat new password"
                     PasswordRevealMode="Peek"
                     CornerRadius="4"
                     PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

        <!-- Error text -->
        <TextBlock x:Name="ErrorText"
                   Foreground="{ThemeResource SystemErrorTextColor}"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"
                   FontSize="12"/>

        <!-- Progress ring -->
        <StackPanel x:Name="ProgressPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" HorizontalAlignment="Center">
            <ProgressRing IsActive="True" Width="20" Height="20"/>
            <TextBlock Text="Re-wrapping password slot with Argon2id…" VerticalAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>
