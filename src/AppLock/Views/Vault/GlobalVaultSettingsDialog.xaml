<ContentDialog
    x:Class="AppLock.Views.Vault.GlobalVaultSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Global Vault Settings"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonClick="SaveButton_Click">

    <ScrollViewer MaxHeight="520" Padding="0,0,12,0">
        <StackPanel Spacing="18" MinWidth="420" MaxWidth="520">

            <!-- Section 1: Auto-lock & Session -->
            <TextBlock Text="Auto-lock &amp; Session" FontWeight="SemiBold" FontSize="14"
                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>

            <ComboBox x:Name="DefaultAutoLockCombo"
                      Header="Default auto-lock timeout (idle)"
                      HorizontalAlignment="Stretch"
                      CornerRadius="4">
                <ComboBoxItem Content="1 minute"/>
                <ComboBoxItem Content="5 minutes"/>
                <ComboBoxItem Content="10 minutes (Recommended)"/>
                <ComboBoxItem Content="30 minutes"/>
                <ComboBoxItem Content="Never (Not recommended)"/>
            </ComboBox>

            <ToggleSwitch x:Name="LockOnPcLockSwitch"
                          Header="Lock vaults when PC locks or sleeps"
                          OffContent="Disabled" OnContent="Enabled"/>

            <ComboBox x:Name="LockOnMinimizeCombo"
                      Header="Lock when window minimized"
                      HorizontalAlignment="Stretch"
                      CornerRadius="4">
                <ComboBoxItem Content="Disabled"/>
                <ComboBoxItem Content="After 1 minute"/>
                <ComboBoxItem Content="After 5 minutes (Default)"/>
                <ComboBoxItem Content="After 15 minutes"/>
            </ComboBox>

            <ToggleSwitch x:Name="LockOnExitSwitch"
                          Header="Lock all vaults on AppLock exit"
                          OffContent="Disabled" OnContent="Enabled"/>

            <ToggleSwitch x:Name="RequireFreshAuthSwitch"
                          Header="Require authentication to open Vaults page"
                          OffContent="Disabled" OnContent="Enabled"/>

            <MenuFlyoutSeparator Margin="0,4"/>

            <!-- Section 2: Privacy & Display -->
            <TextBlock Text="Privacy &amp; Screen Capture" FontWeight="SemiBold" FontSize="14"
                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>

            <ToggleSwitch x:Name="ExcludeCaptureSwitch"
                          Header="Prevent screenshot &amp; screen sharing capture"
                          OffContent="Capture allowed" OnContent="Protected from capture"/>

            <ToggleSwitch x:Name="SecurePreviewOnlySwitch"
                          Header="Secure preview only (disable 'Open with external app')"
                          OffContent="Allow external apps" OnContent="In-memory preview only"/>

            <MenuFlyoutSeparator Margin="0,4"/>

            <!-- Section 3: File Handling & Trash -->
            <TextBlock Text="File Handling &amp; Trash" FontWeight="SemiBold" FontSize="14"
                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>

            <ToggleSwitch x:Name="DeleteOriginalsSwitch"
                          Header="Delete original files after verified add to vault"
                          OffContent="Keep originals" OnContent="Delete originals after verify"/>

            <ToggleSwitch x:Name="OverwriteOriginalsSwitch"
                          Header="Overwrite originals with zeros before deleting"
                          OffContent="Standard delete" OnContent="Overwrite before delete"/>

            <ToggleSwitch x:Name="TempGenericNamesSwitch"
                          Header="Use random names for temporary files in other apps"
                          OffContent="Original names" OnContent="Random generic names"/>

            <ToggleSwitch x:Name="TempOverwriteSwitch"
                          Header="Securely overwrite temporary files on exit/lock"
                          OffContent="Standard delete" OnContent="Zero-overwrite before delete"/>

            <NumberBox x:Name="TrashRetentionBox"
                       Header="Trash retention (days before permanent deletion, 0 = immediate)"
                       SpinButtonPlacementMode="Inline"
                       SmallChange="1"
                       LargeChange="7"
                       Minimum="0"
                       Maximum="365"
                       CornerRadius="4"/>

            <MenuFlyoutSeparator Margin="0,4"/>

            <!-- Section 4: System Integration & Advanced Security -->
            <TextBlock Text="System Integration &amp; Advanced Security" FontWeight="SemiBold" FontSize="14"
                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>

            <ToggleSwitch x:Name="ContextMenuSwitch"
                          Header="Windows Explorer context menu ('Add to AppLock Vault')"
                          OffContent="Disabled" OnContent="Enabled"/>

            <ToggleSwitch x:Name="SendToSwitch"
                          Header="'Add to AppLock Vault' in Windows Send To menu"
                          OffContent="Disabled" OnContent="Enabled"/>

            <ToggleSwitch x:Name="SizePaddingSwitch"
                          Header="Obfuscate file sizes (pad encrypted objects to prevent traffic/storage analysis)"
                          OffContent="Exact sizes" OnContent="Bucket size padding"/>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
