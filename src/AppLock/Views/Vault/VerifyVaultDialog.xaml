<ContentDialog
    x:Class="AppLock.Views.Vault.VerifyVaultDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Verify Vault Integrity"
    PrimaryButtonText="Start Verification"
    CloseButtonText="Close"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonClick="VerifyButton_Click">

    <StackPanel Spacing="16" MinWidth="400" MaxWidth="500">
        <TextBlock Text="Checks vault configuration authentication, index structure, object files on disk, and optional chunk-level decryption."
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <CheckBox x:Name="DeepVerifyCheck"
                  Content="Deep verify (decrypt all file chunks and verify authentication tags)"/>

        <!-- Progress section -->
        <StackPanel x:Name="ProgressSection" Spacing="6" Visibility="Collapsed">
            <ProgressBar x:Name="VerifyProgressBar" IsIndeterminate="False" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="ProgressStatusText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Results section -->
        <Border x:Name="ResultsBorder"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="6"
                Padding="14"
                Visibility="Collapsed">
            <StackPanel Spacing="8">
                <TextBlock x:Name="OverallStatusText" FontWeight="SemiBold" FontSize="14"/>

                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Config MAC:" FontWeight="Medium"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ConfigStatusText"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Index Integrity:" FontWeight="Medium"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="IndexStatusText"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Files Checked:" FontWeight="Medium"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FilesStatusText"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Corrupted / Missing:" FontWeight="Medium"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CorruptStatusText"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Orphan Objects:" FontWeight="Medium"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="OrphansStatusText"/>
                </Grid>

                <Button x:Name="CleanOrphansButton"
                        Content="Delete orphan objects"
                        HorizontalAlignment="Left"
                        Margin="0,6,0,0"
                        Visibility="Collapsed"
                        Click="CleanOrphansButton_Click"
                        CornerRadius="4"/>
            </StackPanel>
        </Border>

        <!-- Error log box if any errors -->
        <TextBox x:Name="ErrorDetailsBox"
                 Header="Details / Errors"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 Height="100"
                 Visibility="Collapsed"
                 TextWrapping="Wrap"
                 CornerRadius="4"/>
    </StackPanel>
</ContentDialog>
