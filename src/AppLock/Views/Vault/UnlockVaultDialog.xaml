<ContentDialog
    x:Class="AppLock.Views.Vault.UnlockVaultDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Unlock Vault"
    PrimaryButtonText="Unlock"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonClick="UnlockButton_Click">

    <StackPanel Spacing="16" MinWidth="340" MaxWidth="440">

        <!-- Vault name -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xF540;" FontFamily="Segoe Fluent Icons"
                      FontSize="28"
                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
            <TextBlock x:Name="VaultNameText"
                       VerticalAlignment="Center"
                       FontSize="17"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Windows Hello button (shown when enrolled) -->
        <Button x:Name="HelloButton"
                HorizontalAlignment="Stretch"
                Visibility="Collapsed"
                Click="HelloButton_Click"
                CornerRadius="4">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                <TextBlock Text="Use Windows Hello" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- Password panel -->
        <StackPanel x:Name="PasswordPanel" Spacing="12" Visibility="Visible">
            <PasswordBox x:Name="PasswordBox"
                         Header="Vault password"
                         PlaceholderText="Enter your vault password"
                         PasswordRevealMode="Peek"
                         CornerRadius="4"
                         KeyDown="PasswordBox_KeyDown"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <HyperlinkButton Content="Use recovery key instead"
                                 Click="UseRecoveryKeyButton_Click"
                                 FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <!-- Recovery key panel -->
        <StackPanel x:Name="RecoveryKeyPanel" Spacing="12" Visibility="Collapsed">
            <InfoBar Severity="Warning" IsOpen="True" IsClosable="False"
                     Message="Recovery key unlock — make sure you have saved your key safely."
                     CornerRadius="4"/>
            <TextBox x:Name="RecoveryKeyBox"
                     Header="Recovery key (8 groups of 5 characters, e.g. ABCDE-12345-…)"
                     PlaceholderText="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX-XXXXX-XXXXX-XXXXX"
                     FontFamily="Cascadia Code, Consolas, Courier New"
                     CharacterSpacing="40"
                     CornerRadius="4"
                     TextChanged="RecoveryKeyBox_TextChanged"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <HyperlinkButton Content="Use password instead"
                                 Click="UsePasswordButton_Click"
                                 FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <!-- Keep unlocked selector -->
        <ComboBox x:Name="KeepUnlockedBox"
                  Header="Keep unlocked for"
                  HorizontalAlignment="Stretch"
                  CornerRadius="4"
                  SelectedIndex="0">
            <ComboBoxItem Content="Until I lock it"/>
            <ComboBoxItem Content="5 minutes"/>
            <ComboBoxItem Content="15 minutes"/>
            <ComboBoxItem Content="30 minutes"/>
        </ComboBox>

        <!-- Lock conflict warning & take over button -->
        <InfoBar x:Name="ConflictInfoBar"
                 Severity="Warning"
                 IsOpen="False"
                 IsClosable="True"
                 CornerRadius="4">
            <InfoBar.ActionButton>
                <Button Content="Take over lock"
                        Click="TakeOverButton_Click"
                        CornerRadius="4"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Attempt counter / lockout info -->
        <InfoBar x:Name="AttemptInfoBar"
                 Severity="Warning"
                 IsOpen="False"
                 IsClosable="False"
                 CornerRadius="4"/>

        <!-- Error text -->
        <TextBlock x:Name="ErrorText"
                   Foreground="{ThemeResource SystemErrorTextColor}"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"
                   FontSize="12"/>

        <!-- Progress ring (shown while unlocking) -->
        <StackPanel x:Name="UnlockingPanel"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center">
            <ProgressRing IsActive="True" Width="20" Height="20"/>
            <TextBlock Text="Unlocking…" VerticalAlignment="Center"/>
        </StackPanel>

    </StackPanel>
</ContentDialog>
