<Window
    x:Class="AppLock.Views.Vault.SecurePreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Secure Preview">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          RowSpacing="8" Padding="16,12,16,16">

        <Grid.RowDefinitions>
            <!-- 0: Header & Controls Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Notification / Truncation banner -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Preview Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 0: Header & Controls ================= -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- File info -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xF540;" FontFamily="Segoe Fluent Icons"
                          FontSize="18"
                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                <TextBlock x:Name="FileNameText"
                           FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="11"/>
                        <TextBlock Text="In-Memory Preview" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Center: Format-specific action buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Image controls -->
                <StackPanel x:Name="ImageControlsPanel" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                    <Button Content="&#xE71F;" FontFamily="Segoe Fluent Icons"
                            Click="ZoomInButton_Click" ToolTipService.ToolTip="Zoom in" CornerRadius="4"/>
                    <Button Content="&#xE720;" FontFamily="Segoe Fluent Icons"
                            Click="ZoomOutButton_Click" ToolTipService.ToolTip="Zoom out" CornerRadius="4"/>
                    <Button Content="&#xE7AD;" FontFamily="Segoe Fluent Icons"
                            Click="RotateButton_Click" ToolTipService.ToolTip="Rotate 90°" CornerRadius="4"/>
                    <Button Content="1:1"
                            Click="ResetZoomButton_Click" ToolTipService.ToolTip="Reset zoom" CornerRadius="4"/>
                </StackPanel>

                <!-- Text controls -->
                <StackPanel x:Name="TextControlsPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                    <ToggleButton x:Name="WordWrapToggle" Content="Word wrap"
                                  IsChecked="True"
                                  Click="WordWrapToggle_Click" CornerRadius="4"/>
                    <TextBox x:Name="SearchBox"
                             PlaceholderText="Find in text…"
                             Width="160"
                             CornerRadius="4"
                             TextChanged="SearchBox_TextChanged"/>
                </StackPanel>

                <!-- PDF controls -->
                <StackPanel x:Name="PdfControlsPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                    <Button Content="&#xE76B;" FontFamily="Segoe Fluent Icons"
                            Click="PdfPrevPage_Click" ToolTipService.ToolTip="Previous page" CornerRadius="4"/>
                    <TextBlock x:Name="PdfPageIndicator" Text="Page 1 of 1"
                               VerticalAlignment="Center" FontSize="12"/>
                    <Button Content="&#xE76C;" FontFamily="Segoe Fluent Icons"
                            Click="PdfNextPage_Click" ToolTipService.ToolTip="Next page" CornerRadius="4"/>
                </StackPanel>
            </StackPanel>

            <!-- Right: Close button -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Close" Click="CloseButton_Click" CornerRadius="4"/>
            </StackPanel>
        </Grid>

        <!-- ================= 1: InfoBar (Truncation / Warnings) ================= -->
        <InfoBar x:Name="WarningInfoBar"
                 Grid.Row="1"
                 Severity="Warning"
                 IsOpen="False"
                 IsClosable="True"
                 CornerRadius="4"/>

        <!-- ================= 2: Preview Content Area ================= -->
        <Grid Grid.Row="2"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8">

            <!-- Loading Ring -->
            <ProgressRing x:Name="LoadingRing"
                          IsActive="True"
                          Width="40" Height="40"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>

            <!-- Error Display -->
            <StackPanel x:Name="ErrorPanel"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <FontIcon Glyph="&#xE783;" FontFamily="Segoe Fluent Icons"
                          FontSize="36"
                          Foreground="{ThemeResource SystemErrorTextColor}"/>
                <TextBlock x:Name="ErrorText"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 1. Image Preview -->
            <ScrollViewer x:Name="ImageScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="PreviewImage"
                           Stretch="None">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ImageScale" ScaleX="1.0" ScaleY="1.0"/>
                                <RotateTransform x:Name="ImageRotate" Angle="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Grid>
            </ScrollViewer>

            <!-- 2. Text Preview -->
            <ScrollViewer x:Name="TextScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed"
                          Padding="16">
                <TextBox x:Name="PreviewTextBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         FontFamily="Cascadia Code, Consolas, Courier New"
                         FontSize="13"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         Background="Transparent"/>
            </ScrollViewer>

            <!-- 3. PDF Preview -->
            <ScrollViewer x:Name="PdfScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16">
                    <Image x:Name="PdfImage" Stretch="Uniform"/>
                </Grid>
            </ScrollViewer>

            <!-- 4. Media Preview (Audio/Video) -->
            <MediaPlayerElement x:Name="PreviewMediaPlayer"
                                AreTransportControlsEnabled="True"
                                AutoPlay="True"
                                Visibility="Collapsed"/>

        </Grid>
    </Grid>
</Window>
