<Page
    x:Class="AppLock.Views.Vault.VaultBrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AppLock.ViewModels.Vault"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          RowSpacing="12" Padding="24,16,24,16"
          AllowDrop="True"
          DragOver="Page_DragOver"
          Drop="Page_Drop">

        <Grid.RowDefinitions>
            <!-- 0: Header & Lock button -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Breadcrumb & Search -->
            <RowDefinition Height="Auto"/>
            <!-- 2: CommandBar -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Optional Encryption InfoBar -->
            <RowDefinition Height="Auto"/>
            <!-- 4: File list / Empty state -->
            <RowDefinition Height="*"/>
            <!-- 5: Docked progress panel -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =================== 0. Header =================== -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="&#xE72B;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="14"
                    Width="36" Height="36"
                    CornerRadius="18"
                    Click="BackButton_Click"
                    AutomationProperties.Name="Back to Vaults"
                    ToolTipService.ToolTip="Back to Vaults"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xF540;" FontFamily="Segoe Fluent Icons"
                              FontSize="20"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <TextBlock x:Name="VaultTitleText"
                               Text="{x:Bind ViewModel.VaultName, Mode=OneWay}"
                               FontSize="22" FontWeight="SemiBold"/>
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="Unlocked" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.StatusSummary, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="&#xE72E;  Lock vault"
                        Click="LockNowButton_Click"
                        CornerRadius="4"/>
            </StackPanel>
        </Grid>

        <!-- =================== 1. Breadcrumbs & Search =================== -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <!-- Breadcrumb Path -->
            <BreadcrumbBar Grid.Column="0"
                           ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}"
                           ItemClicked="BreadcrumbBar_ItemClicked">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="vm:BreadcrumbItem">
                        <TextBlock Text="{x:Bind Name}" FontSize="13"/>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>

            <!-- Search box -->
            <AutoSuggestBox Grid.Column="1"
                            QueryIcon="Find"
                            PlaceholderText="Search files…"
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                            TextChanged="SearchBox_TextChanged"/>
        </Grid>

        <!-- =================== 2. CommandBar =================== -->
        <CommandBar Grid.Row="2"
                    DefaultLabelPosition="Right"
                    Background="Transparent"
                    HorizontalAlignment="Stretch">
            <AppBarButton Icon="Add" Label="Add files"
                          Click="AddFilesButton_Click"
                          Visibility="{x:Bind GetNormalVisibility(ViewModel.IsTrashMode), Mode=OneWay}"/>
            <AppBarButton Icon="Folder" Label="Add folder"
                          Click="AddFolderButton_Click"
                          Visibility="{x:Bind GetNormalVisibility(ViewModel.IsTrashMode), Mode=OneWay}"/>
            <AppBarButton Icon="NewFolder" Label="New folder"
                          Click="NewFolderButton_Click"
                          Visibility="{x:Bind GetNormalVisibility(ViewModel.IsTrashMode), Mode=OneWay}"/>
            <AppBarSeparator Visibility="{x:Bind GetNormalVisibility(ViewModel.IsTrashMode), Mode=OneWay}"/>
            <AppBarButton Icon="OpenFile" Label="Open with app"
                          Click="OpenWithAppButton_Click"
                          Visibility="{x:Bind GetNormalVisibility(ViewModel.IsTrashMode), Mode=OneWay}"/>
            <AppBarButton Icon="Share" Label="Export…"
                          Click="ExportButton_Click"/>
            <AppBarButton Icon="Delete" Label="Delete"
                          Click="DeleteButton_Click"/>
            <AppBarSeparator/>
            <AppBarToggleButton x:Name="TrashToggle"
                                Icon="Delete"
                                Label="Trash view"
                                IsChecked="{x:Bind ViewModel.IsTrashMode, Mode=OneWay}"
                                Click="TrashToggle_Click"/>
            <AppBarButton Icon="Clear" Label="Empty trash"
                          Click="EmptyTrashButton_Click"
                          Visibility="{x:Bind GetTrashVisibility(ViewModel.IsTrashMode), Mode=OneWay}"/>
            <AppBarButton Icon="Refresh" Label="Restore selected"
                          Click="RestoreButton_Click"
                          Visibility="{x:Bind GetTrashVisibility(ViewModel.IsTrashMode), Mode=OneWay}"/>

            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="EnableHelloButton"
                              Icon="Permissions"
                              Label="Enable Windows Hello"
                              Click="EnableHelloButton_Click"/>
                <AppBarButton x:Name="DisableHelloButton"
                              Icon="Cancel"
                              Label="Remove Windows Hello"
                              Click="DisableHelloButton_Click"/>
                <AppBarSeparator/>
                <AppBarButton Icon="Setting" Label="Vault settings"
                              Click="VaultSettingsButton_Click"/>
                <AppBarButton Icon="Admin" Label="Change password…"
                              Click="ChangePasswordButton_Click"/>
                <AppBarButton Icon="Accept" Label="Verify vault integrity"
                              Click="VerifyVaultButton_Click"/>
                <AppBarButton Icon="Copy" Label="Back up vault…"
                              Click="BackupVaultButton_Click"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!-- =================== 3. InfoBars =================== -->
        <StackPanel Grid.Row="3" Spacing="8">
            <InfoBar x:Name="OpenFilesInfoBar"
                     Severity="Warning"
                     IsOpen="False"
                     IsClosable="False"
                     CornerRadius="4">
                <InfoBar.ActionButton>
                    <Button Content="Close &amp; flush edits"
                            Click="CloseTempFilesButton_Click"
                            CornerRadius="4"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar Severity="Informational"
                     IsOpen="{x:Bind ViewModel.ShowEncryptionBanner, Mode=TwoWay}"
                     IsClosable="True"
                     Message="This vault is encrypted. File contents, file names and folder structure are securely encrypted on disk."
                     CornerRadius="4"/>
        </StackPanel>

        <!-- =================== 4. File List / Empty State =================== -->
        <Grid Grid.Row="4">
            <!-- Empty state -->
            <StackPanel x:Name="EmptyStatePanel"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind GetEmptyVisibility(ViewModel.Items.Count), Mode=OneWay}">
                <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons"
                          FontSize="48"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="This folder is empty"
                           FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Drag and drop files here, or use Add files above."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Files ListView -->
            <ListView x:Name="FileListView"
                      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      SelectionMode="Extended"
                      IsItemClickEnabled="True"
                      ItemClick="FileListView_ItemClick"
                      CornerRadius="6"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:VaultItemViewModel">
                        <Grid ColumnSpacing="12" Padding="8,4"
                              ContextRequested="Item_ContextRequested">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <!-- Glyph -->
                            <FontIcon Grid.Column="0"
                                      Glyph="{x:Bind Glyph}"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="18"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>

                            <!-- Name -->
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Name}"
                                       VerticalAlignment="Center"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Type -->
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind TypeDescription}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <!-- Size -->
                            <TextBlock Grid.Column="3"
                                       Text="{x:Bind DisplaySize}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       TextAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <!-- Modified -->
                            <TextBlock Grid.Column="4"
                                       Text="{x:Bind DisplayModified}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- =================== 5. Docked Progress Panel =================== -->
        <Border Grid.Row="5"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,10"
                Visibility="{x:Bind GetProgressVisibility(ViewModel.IsOperationRunning), Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.OperationStatusText, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold"/>
                    <ProgressBar Minimum="0" Maximum="100"
                                 Value="{x:Bind ViewModel.OperationProgress, Mode=OneWay}"
                                 Height="4" CornerRadius="2"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Cancel"
                        Click="CancelOperationButton_Click"
                        VerticalAlignment="Center"
                        CornerRadius="4"/>
            </Grid>
        </Border>

    </Grid>
</Page>
