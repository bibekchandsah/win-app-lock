<ContentDialog
    x:Class="AppLock.Views.SelfDisciplineDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="LilacAccentBrush" Color="#D9A0E8"/>

        <Style x:Key="LilacPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D9A0E8"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,6"/>
        </Style>

        <Style x:Key="SegmentedTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </ContentDialog.Resources>

    <Grid MinWidth="460" MaxWidth="520" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- App Info Subtitle Header -->
            <RowDefinition Height="Auto"/> <!-- 3-Tab Segmented Bar -->
            <RowDefinition Height="*"/>    <!-- Tab Content Panels -->
            <RowDefinition Height="Auto"/> <!-- Weakening Re-Auth Panel -->
            <RowDefinition Height="Auto"/> <!-- Inline Error Banner -->
        </Grid.RowDefinitions>

        <!-- Header: Target App Info & Stopwatch Icon -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0" Glyph="&#xE916;" FontSize="20" Foreground="#D9A0E8" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Self-Discipline" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="TargetAppSubheader" Text="Settings for this app" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- Segmented Tab Bar (3 Tabs) -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="3">
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="TabButton0"
                        Grid.Column="0"
                        Style="{StaticResource SegmentedTabButtonStyle}"
                        Click="TabButton_Click"
                        Tag="0">
                    <TextBlock Text="Daily usage quota" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Button>

                <Button x:Name="TabButton1"
                        Grid.Column="1"
                        Style="{StaticResource SegmentedTabButtonStyle}"
                        Click="TabButton_Click"
                        Tag="1">
                    <TextBlock Text="Scheduled lock" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Button>

                <Button x:Name="TabButton2"
                        Grid.Column="2"
                        Style="{StaticResource SegmentedTabButtonStyle}"
                        Click="TabButton_Click"
                        Tag="2">
                    <TextBlock Text="Auto-relock on timeout" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Button>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="2" MinHeight="330">
            <!-- TAB 0: Daily usage quota -->
            <StackPanel x:Name="Tab0Panel" Spacing="14" Visibility="Visible">
                <!-- Toggle Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Enable daily usage quota" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Only counts while the app is in the foreground. When the limit is reached, the app is locked again; enter the password to extend time."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="QuotaToggle"
                                      Grid.Column="1"
                                      OnContent=""
                                      OffContent=""
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      Toggled="QuotaToggle_Toggled"/>
                    </Grid>
                </Border>

                <!-- Daily Limit Minutes Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Daily limit (minutes)" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <NumberBox x:Name="QuotaLimitNumberBox"
                                   Grid.Column="1"
                                   Minimum="1"
                                   Maximum="1440"
                                   SmallChange="5"
                                   LargeChange="15"
                                   SpinButtonPlacementMode="Inline"
                                   MinWidth="130"
                                   ValueChanged="QuotaLimitNumberBox_ValueChanged"/>
                    </Grid>
                </Border>

                <!-- Circular Progress Ring (Donut) -->
                <Grid x:Name="QuotaRingContainer" Width="150" Height="150" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <!-- Circular track ellipse -->
                    <Ellipse Width="130" Height="130"
                             Stroke="#3A3A3E"
                             StrokeThickness="9"
                             Fill="Transparent"/>

                    <!-- Determinate ProgressRing -->
                    <ProgressRing x:Name="QuotaProgressRing"
                                  Width="130" Height="130"
                                  IsIndeterminate="False"
                                  Minimum="0"
                                  Maximum="60"
                                  Value="0"
                                  Foreground="#D9A0E8"/>

                    <!-- Center text -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="QuotaUsedTimeText"
                                   Text="0:00"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Used today"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- TAB 1: Scheduled lock -->
            <Grid x:Name="Tab1Panel" Visibility="Collapsed">
                <!-- Empty State -->
                <StackPanel x:Name="ScheduledEmptyPanel" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE787;" FontSize="42" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No time blocks set. The app won't be locked by schedule."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               MaxWidth="300"
                               HorizontalAlignment="Center"/>
                    <Button x:Name="EmptyAddBlockButton"
                            Content="Add time block"
                            Click="AddBlockButton_Click"
                            Background="#D9A0E8"
                            Foreground="#1A1A1A"
                            FontWeight="SemiBold"
                            CornerRadius="4"
                            Padding="16,6"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- With Blocks State -->
                <StackPanel x:Name="ScheduledBlocksPanel" Spacing="10" Visibility="Visible">
                    <TextBlock Text="During scheduled periods the app is locked automatically; outside them it works normally."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>

                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TimeBlocksContainer" Spacing="8"/>
                    </ScrollViewer>

                    <Button x:Name="ListAddBlockButton"
                            Click="AddBlockButton_Click"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,0"
                            BorderBrush="#D9A0E8"
                            BorderThickness="1"
                            Background="Transparent"
                            Foreground="#D9A0E8"
                            CornerRadius="4"
                            Padding="18,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="11"/>
                            <TextBlock Text="Add time block" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- TAB 2: Auto-relock on timeout (idle) -->
            <StackPanel x:Name="Tab2Panel" Spacing="14" Visibility="Collapsed">
                <!-- Toggle Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Enable auto-relock after idle" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Timeout is based on keyboard/mouse idle time."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="IdleToggle"
                                      Grid.Column="1"
                                      OnContent=""
                                      OffContent=""
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      Toggled="IdleToggle_Toggled"/>
                    </Grid>
                </Border>

                <!-- Idle Timeout Minutes Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Auto-relock after idle (minutes)" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <NumberBox x:Name="IdleLimitNumberBox"
                                   Grid.Column="1"
                                   Minimum="1"
                                   Maximum="240"
                                   SmallChange="5"
                                   LargeChange="15"
                                   SpinButtonPlacementMode="Inline"
                                   MinWidth="130"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Weakening Re-Authentication Section (appears when weakening settings) -->
        <Border x:Name="WeakeningAuthPanel"
                Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="#D9A0E8"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Visibility="Collapsed">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="#D9A0E8"/>
                    <TextBlock Text="Admin password required to weaken settings" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="AdminAuthPasswordBox"
                                 Grid.Column="0"
                                 PlaceholderText="Enter admin password to save"
                                 KeyDown="AdminAuthPasswordBox_KeyDown"/>
                    <Button x:Name="HelloVerifyButton"
                            Grid.Column="1"
                            Click="HelloVerifyButton_Click"
                            ToolTipService.ToolTip="Verify with Windows Hello"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE77B;" FontSize="14"/>
                            <TextBlock Text="Hello" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Inline Validation Error Banner -->
        <InfoBar x:Name="InlineErrorBar"
                 Grid.Row="4"
                 Severity="Error"
                 IsOpen="False"
                 IsClosable="True"
                 CornerRadius="6"/>
    </Grid>
</ContentDialog>

