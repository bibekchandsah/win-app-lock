<Page
    x:Class="AppLock.Views.InternetAccessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AppLock.Models"
    xmlns:local="using:AppLock.Views"
    xmlns:vm="using:AppLock.ViewModels"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <!-- Converters -->
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:BoolToTrustColorConverter x:Key="BoolToColorConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <local:BoolToStatusColorConverter x:Key="BoolToStatusColorConverter"/>
        
        <!-- Color converter for status chips -->
        <SolidColorBrush x:Key="BlockedColor" Color="#DC3545"/>
        <SolidColorBrush x:Key="AllowedColor" Color="#28A745"/>
        <SolidColorBrush x:Key="PartialColor" Color="#FFC107"/>
        <SolidColorBrush x:Key="MissingColor" Color="#6C757D"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Padding="24,24,24,12">
            <StackPanel Spacing="8">
                <TextBlock Text="Internet Access" 
                           Style="{StaticResource TitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Control which applications can access the internet" 
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Info Bars -->
        <StackPanel Grid.Row="1" Padding="24,0,24,12" Spacing="8">
            <!-- Not Elevated Banner -->
            <InfoBar x:Name="NotElevatedInfoBar"
                     Severity="Warning"
                     Title="Administrator rights required"
                     Message="Administrator rights are needed to change firewall rules."
                     IsOpen="False"
                     IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Restart as administrator" 
                            Click="RestartAsAdminButton_Click"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Firewall Disabled Banner -->
            <InfoBar x:Name="FirewallDisabledInfoBar"
                     Severity="Informational"
                     Title="Firewall is off"
                     Message="Rules are saved but won't be enforced while Windows Defender Firewall is off."
                     IsOpen="False"
                     IsClosable="True">
                <InfoBar.ActionButton>
                    <Button Content="Open Windows Security" 
                            Click="OpenWindowsSecurityButton_Click"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Group Policy Locked Banner -->
            <InfoBar x:Name="GroupPolicyLockedInfoBar"
                     Severity="Error"
                     Title="Firewall managed by policy"
                     Message="A group policy or MDM controls the firewall. Changes cannot be made."
                     IsOpen="False"
                     IsClosable="False"/>
        </StackPanel>

        <!-- Main Content: Tabs -->
        <Grid Grid.Row="2" Padding="24,0,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab Headers -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                <Button x:Name="AppsTabButton"
                        Content="Apps"
                        Click="AppsTabButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Apps tab"
                        AutomationProperties.HelpText="View and manage firewall rules for applications"
                        Padding="16,8"/>
                <Button x:Name="ActiveConnectionsTabButton"
                        Content="Active connections"
                        Click="ActiveConnectionsTabButton_Click"
                        AutomationProperties.Name="Active connections tab"
                        AutomationProperties.HelpText="View processes currently using network connections"
                        Padding="16,8"/>
                <Button x:Name="NetworkDevicesTabButton"
                        Content="Network devices"
                        Click="NetworkDevicesTabButton_Click"
                        AutomationProperties.Name="Network devices tab"
                        AutomationProperties.HelpText="Scan Wi-Fi devices and get alerted when an unknown one joins"
                        Padding="16,8"/>
                <Button x:Name="ListeningPortsTabButton"
                        Content="Listening ports"
                        Click="ListeningPortsTabButton_Click"
                        AutomationProperties.Name="Listening ports tab"
                        AutomationProperties.HelpText="Monitor listening ports and incoming traffic"
                        Padding="16,8"/>
            </StackPanel>

            <!-- Tab Content -->
            <Grid Grid.Row="1">
                <!-- Apps Tab -->
                <Grid x:Name="AppsTabContent" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Command Bar -->
                    <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent"
                                AutomationProperties.Name="Applications command bar">
                        <AppBarButton Label="Add app" Icon="Add" 
                                      AutomationProperties.Name="Add application"
                                      AutomationProperties.HelpText="Add an application to control its internet access">
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Browse for program…" Click="BrowseForProgram_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE838;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="From running programs…" Click="FromRunningPrograms_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8A7;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Pick a window…" Click="PickAWindow_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8B9;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="From installed apps…" Click="FromInstalledApps_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xECAA;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarButton Label="Refresh" Icon="Refresh" Click="RefreshApps_Click"
                                      AutomationProperties.Name="Refresh application list"/>
                        <AppBarButton Label="Block all selected" Click="BlockAllSelected_Click"
                                      AutomationProperties.Name="Block internet for selected applications">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xF140;"/>
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Unblock all selected" Click="UnblockAllSelected_Click"
                                      AutomationProperties.Name="Allow internet for selected applications">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE785;"/><!-- Shield with checkmark -->
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Remove" Icon="Delete" Click="RemoveSelected_Click"
                                      AutomationProperties.Name="Remove selected applications from list"/>
                        <AppBarButton Label="More">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE712;"/>
                            </AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Import rules…" Click="ImportRules_Click"/>
                                    <MenuFlyoutItem Text="Export rules…" Click="ExportRules_Click"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Repair rules" Click="RepairRules_Click"/>
                                    <MenuFlyoutItem Text="Remove all AppLock rules" Click="RemoveAllAppLockRules_Click" Foreground="Red"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Firewall status" Click="FirewallStatus_Click"/>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                    </CommandBar>

                    <!-- Apps List / Empty State -->
                    <Grid Grid.Row="1">
                        <!-- Empty State -->
                        <StackPanel x:Name="AppsEmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="16">
                            <FontIcon Glyph="&#xEB5E;" 
                                      FontSize="64" 
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="No apps added" 
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Add an app to control its internet access." 
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Apps ListView -->
                        <ListView x:Name="AppsListView"
                                  Visibility="Collapsed"
                                  SelectionMode="Multiple"
                                  Padding="0"
                                  AutomationProperties.Name="Applications list"
                                  AutomationProperties.HelpText="List of applications with firewall rules"
                                  Loaded="AppsListView_Loaded">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="16,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                            <ColumnDefinition Width="*"/>    <!-- Info -->
                                            <ColumnDefinition Width="Auto"/> <!-- Direction -->
                                            <ColumnDefinition Width="Auto"/> <!-- Status -->
                                            <ColumnDefinition Width="Auto"/> <!-- Toggle -->
                                            <ColumnDefinition Width="Auto"/> <!-- Repair -->
                                        </Grid.ColumnDefinitions>

                                        <!-- App Icon with conditional fallback -->
                                        <Grid Grid.Column="0" Width="40" Height="40">
                                            <!-- Fallback background (only visible when Icon is null) -->
                                            <Border
                                                CornerRadius="4"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Visibility="{Binding Icon, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                                                <FontIcon
                                                    Glyph="&#xE8A7;"
                                                    FontSize="20"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                            </Border>
                                            <!-- Actual icon (visible when loaded, no background) -->
                                            <Image Source="{Binding Icon, Mode=OneWay}" 
                                                   Width="40" Height="40"
                                                   Stretch="Uniform"
                                                   Visibility="{Binding Icon, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        </Grid>

                                        <!-- App Info -->
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       FontWeight="SemiBold"
                                                       FontSize="14"/>
                                            <TextBlock Text="{Binding ExePath}" 
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <ToolTipService.ToolTip>
                                                    <TextBlock Text="{Binding ExePath}"/>
                                                </ToolTipService.ToolTip>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Direction Selector -->
                                        <ComboBox Grid.Column="2"
                                                  SelectedItem="{Binding Direction, Mode=TwoWay}"
                                                  MinWidth="120"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="DirectionComboBox_SelectionChanged">
                                            <x:String>Outgoing</x:String>
                                            <x:String>Incoming</x:String>
                                            <x:String>Both</x:String>
                                        </ComboBox>

                                        <!-- Status Chip -->
                                        <Border Grid.Column="3"
                                                Padding="12,6"
                                                CornerRadius="12"
                                                VerticalAlignment="Center"
                                                Margin="8,0"
                                                AutomationProperties.LiveSetting="Polite">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding StatusBrush.Color}" Opacity="0.2"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding StatusBrush}"/>
                                        </Border>

                                        <!-- Block/Allow Toggle -->
                                        <ToggleSwitch Grid.Column="4"
                                                      IsOn="{Binding IsBlocked, Mode=TwoWay}"
                                                      OffContent="Allowed"
                                                      OnContent="Blocked"
                                                      MinWidth="100"
                                                      VerticalAlignment="Center"
                                                      Toggled="BlockedToggle_Toggled"/>

                                        <!-- Repair Button (only visible when drift detected) -->
                                        <Button Grid.Column="5"
                                                Content="Repair"
                                                Click="RepairSingle_Click"
                                                Tag="{Binding}"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding RepairButtonVisibility}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal"/>
                                                                <VisualState x:Name="PointerOver">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBackground" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </VisualState>
                                                                <VisualState x:Name="Pressed">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBackground" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </VisualState>
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                        <Border x:Name="ButtonBackground"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                CornerRadius="4"
                                                                Padding="12,6">
                                                            <TextBlock Text="Repair"
                                                                       FontSize="12"
                                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <!-- Active Connections Tab -->
                <Grid x:Name="ActiveConnectionsTabContent" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter and options -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="Filter by process, address, or protocol..."
                            Text="{x:Bind ActiveConnectionsViewModel.FilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center"
                            Height="32"
                            Margin="0,0,12,0"/>

                        <!-- Filter Toggle -->
                        <Grid Grid.Column="1" 
                              VerticalAlignment="Center"
                              Tapped="FilterToggleGrid_Tapped">
                            <ToggleSwitch
                                x:Name="FilterToggle"
                                IsOn="{x:Bind ActiveConnectionsViewModel.ShowOnlyWithConnections, Mode=TwoWay}"
                                OffContent="Showing all"
                                OnContent="Connected only"
                                MinWidth="0"/>
                        </Grid>
                    </Grid>

                    <!-- Connections list -->
                    <ListView
                        x:Name="ConnectionsListView"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ActiveConnectionsViewModel.FilteredConnections, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ActiveConnection">
                                <Grid ColumnSpacing="12" Padding="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Process -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind ProcessName}" FontWeight="SemiBold"/>
                                        <TextBlock 
                                            Text="{x:Bind ProcessPath}" 
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- PID -->
                                    <TextBlock 
                                        Grid.Column="1" 
                                        Text="{x:Bind ProcessId}" 
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <!-- Protocol -->
                                    <Border
                                        Grid.Column="2"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        VerticalAlignment="Center">
                                        <TextBlock 
                                            Text="{x:Bind Protocol}" 
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Connection -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Connection}" FontFamily="Consolas" FontSize="12"/>
                                        <TextBlock 
                                            Text="{x:Bind State}" 
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>

                                    <!-- System badge -->
                                    <TextBlock
                                        Grid.Column="4"
                                        Text="System Process"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Padding="8,4"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind SystemBadgeVisibility, Mode=OneWay}"/>

                                    <!-- Block button -->
                                    <Button
                                        Grid.Column="5"
                                        Content="Block"
                                        Click="BlockConnection_Click"
                                        Tag="{x:Bind}"
                                        IsEnabled="{x:Bind CanBlock}"
                                        VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Status bar -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <ProgressRing
                            Width="16"
                            Height="16"
                            IsActive="{x:Bind ActiveConnectionsViewModel.IsLoading, Mode=OneWay}"/>
                        <TextBlock
                            Text="{x:Bind ActiveConnectionsViewModel.StatusText, Mode=OneWay}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            VerticalAlignment="Center"/>
                        <TextBlock
                            Text="• Auto-refreshing every 3 seconds"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════════
                     Network Devices Tab
                     ═══════════════════════════════════════════════════════════ -->
                <Grid x:Name="NetworkDevicesTabContent" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Settings card -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20,16"
                            Margin="0,0,0,12">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="16">
                                <!-- Enable scanner row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Network scanner"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"/>
                                        <TextBlock Text="Periodically scan the ARP table to discover devices on your Wi-Fi or LAN."
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                 x:Name="ScannerEnabledToggle"
                                                 IsOn="{x:Bind NetworkScannerViewModel.ScannerEnabled, Mode=TwoWay}"
                                                 OnContent=""
                                                 OffContent=""
                                                 MinWidth="0"
                                                 VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Alert row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Alert on new device"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"/>
                                        <TextBlock Text="Show a notification when a device with an unknown MAC address joins the network."
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                 IsOn="{x:Bind NetworkScannerViewModel.AlertOnNewDevice, Mode=TwoWay}"
                                                 OnContent=""
                                                 OffContent=""
                                                 MinWidth="0"
                                                 VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <!-- Scan interval picker -->
                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" MinWidth="130">
                                <TextBlock Text="Scan interval"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="ScanIntervalComboBox"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="ScanIntervalComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="10"  Content="Every 10 s"/>
                                    <ComboBoxItem Tag="30"  Content="Every 30 s"/>
                                    <ComboBoxItem Tag="60"  Content="Every 1 min"/>
                                    <ComboBoxItem Tag="120" Content="Every 2 min"/>
                                    <ComboBoxItem Tag="300" Content="Every 5 min"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Toolbar -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ScanNowButton"
                                    Click="ScanNowButton_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D4;" FontSize="14"/>
                                    <TextBlock Text="Scan now"/>
                                </StackPanel>
                            </Button>
                            <Button Click="ForgetAllDevices_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    <TextBlock Text="Forget all"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="MacApiKeyButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D7;" FontSize="14"/>
                                    <TextBlock Text="MAC API Key"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="MacApiKeyFlyout" Placement="Bottom">
                                        <StackPanel Width="320" Spacing="10" Padding="4">
                                            <TextBlock Text="MACVendors.com API Key" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="Optional. Enter your API key from macvendors.com for live lookups. If left blank, free lookups via maclookup.app and macvendors.com are used automatically."
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                            <PasswordBox x:Name="MacApiKeyBox"
                                                         Header="API Key"
                                                         PlaceholderText="Paste your API key here"
                                                         PasswordRevealMode="Peek"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                <Button Content="Clear" Click="ClearMacApiKey_Click"/>
                                                <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="SaveMacApiKey_Click"/>
                                            </StackPanel>
                                            <HyperlinkButton Content="Get an API key at macvendors.com"
                                                             NavigateUri="https://macvendors.com/api"
                                                             Padding="0"
                                                             FontSize="11"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <AutoSuggestBox x:Name="NetworkDeviceSearchBox"
                                            PlaceholderText="Search IP, MAC, vendor, online/offline…"
                                            QueryIcon="Find"
                                            Width="280"
                                            TextChanged="NetworkDeviceSearchBox_TextChanged"
                                            QuerySubmitted="NetworkDeviceSearchBox_QuerySubmitted"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind NetworkScannerViewModel.LastScanText, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Device list / Empty state -->
                    <Grid Grid.Row="2">
                        <!-- Empty state -->
                        <StackPanel x:Name="NetworkDevicesEmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12"
                                    Visibility="Visible">
                            <FontIcon Glyph="&#xE770;"
                                      FontSize="56"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="NetworkDevicesEmptyStateTitle"
                                       Text="No devices found yet"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="NetworkDevicesEmptyStateSubtitle"
                                       Text="Enable the scanner or press Scan now to discover devices on your network."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="400"/>
                        </StackPanel>

                        <!-- Device ListView -->
                        <ListView x:Name="NetworkDevicesListView"
                                  Visibility="Collapsed"
                                  SelectionMode="None"
                                  Padding="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,10" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>   <!-- device icon -->
                                            <ColumnDefinition Width="*"/>    <!-- name + hostname + badges -->
                                            <ColumnDefinition Width="130"/>  <!-- manufacturer -->
                                            <ColumnDefinition Width="150"/>  <!-- MAC -->
                                            <ColumnDefinition Width="80"/>   <!-- status -->
                                            <ColumnDefinition Width="120"/>  <!-- first seen -->
                                            <ColumnDefinition Width="120"/>  <!-- last seen -->
                                            <ColumnDefinition Width="Auto"/> <!-- actions -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Device icon in a rounded card -->
                                        <Border Grid.Column="0"
                                                Width="40" Height="40"
                                                CornerRadius="8"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="{Binding DeviceIcon}"
                                                      FontSize="20"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Name + hostname + badges row -->
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="{Binding DisplayName}">
                                            <!-- Top row: display name + "This device" badge + trust dot -->
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- "This device" badge -->
                                                <Border CornerRadius="4"
                                                        Padding="6,2"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        Visibility="{Binding IsThisDevice, Converter={StaticResource BoolToVisConverter}}"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE7F8;"
                                                                  FontSize="10"
                                                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="This device"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Trust indicator dot -->
                                                <Ellipse Width="8" Height="8"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding IsTrusted, Converter={StaticResource BoolToColorConverter}}"/>
                                            </StackPanel>

                                            <!-- Subtitle: hostname if different from display name, then IP -->
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding SubtitleHostname}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Visibility="{Binding SubtitleHostname, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                <TextBlock Text="{Binding IpAddress}"
                                                           FontSize="11"
                                                           FontFamily="Consolas"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Manufacturer -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Manufacturer}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding Manufacturer}"/>

                                        <!-- MAC address -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding MacAddress}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                        <!-- Online/Offline status pill -->
                                        <Border Grid.Column="4"
                                                CornerRadius="12"
                                                Padding="10,4"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding IsOnline, Converter={StaticResource BoolToStatusColorConverter}}"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- First seen -->
                                        <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="First seen"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding FirstSeen}"
                                                       FontSize="12"/>
                                        </StackPanel>

                                        <!-- Last seen -->
                                        <StackPanel Grid.Column="6" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="Last seen"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding LastSeen}"
                                                       FontSize="12"/>
                                        </StackPanel>

                                        <!-- Action buttons -->
                                        <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <!-- Rename inline -->
                                            <TextBox Text="{Binding FriendlyName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     PlaceholderText="Name…"
                                                     Width="110"
                                                     VerticalAlignment="Center"
                                                     LostFocus="DeviceName_LostFocus"/>

                                            <!-- Trust -->
                                            <Button Click="TrustDevice_Click"
                                                    Tag="{Binding}"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Mark as trusted">
                                                <FontIcon Glyph="&#xE73E;" FontSize="14"/>
                                            </Button>

                                            <!-- Forget -->
                                            <Button Click="ForgetDevice_Click"
                                                    Tag="{Binding}"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Remove from list">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Status bar -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <ProgressRing Width="16" Height="16"
                                      IsActive="{x:Bind NetworkScannerViewModel.IsScanning, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind NetworkScannerViewModel.StatusText, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Listening Ports Tab -->
                <Grid x:Name="ListeningPortsTabContent" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Summary strip -->
                        <RowDefinition Height="Auto"/> <!-- Filters & Toolbar -->
                        <RowDefinition Height="*"/>    <!-- Port list / empty state -->
                        <RowDefinition Height="Auto"/> <!-- Status bar -->
                    </Grid.RowDefinitions>

                    <!-- Summary strip -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Metric counts -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Listening"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ListeningPortsViewModel.TotalListeningCount, Mode=OneWay}"
                                               FontSize="20"
                                               FontWeight="SemiBold"/>
                                </StackPanel>

                                <Border Width="1" Height="28" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="Reachable from network"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ListeningPortsViewModel.ReachableCount, Mode=OneWay}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                </StackPanel>

                                <Border Width="1" Height="28" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="Localhost only"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ListeningPortsViewModel.LocalhostCount, Mode=OneWay}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <Border Width="1" Height="28" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="Blocked by AppLock"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ListeningPortsViewModel.BlockedCount, Mode=OneWay}"
                                               FontSize="20"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Auto-refresh & Last updated -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <StackPanel Spacing="2" HorizontalAlignment="Right">
                                    <TextBlock Text="Auto-refreshing (5s)"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Last updated:"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="{x:Bind ListeningPortsViewModel.LastUpdatedText, Mode=OneWay}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Click="RefreshListeningPorts_Click"
                                        ToolTipService.ToolTip="Refresh listening ports"
                                        Padding="8,6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Filters & Toolbar -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <AutoSuggestBox x:Name="ListeningPortSearchBox"
                                        Grid.Column="0"
                                        PlaceholderText="Search port, protocol, address, app, PID…"
                                        QueryIcon="Find"
                                        Width="300"
                                        TextChanged="ListeningPortSearchBox_TextChanged"
                                        QuerySubmitted="ListeningPortSearchBox_QuerySubmitted"/>

                        <!-- Filter Chips -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="PortFilterAllButton"
                                    Content="All"
                                    Click="PortFilterChip_Click"
                                    Tag="All"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="12,6"/>
                            <Button x:Name="PortFilterReachableButton"
                                    Content="Reachable from network"
                                    Click="PortFilterChip_Click"
                                    Tag="Reachable"
                                    Padding="12,6"/>
                            <Button x:Name="PortFilterLocalhostButton"
                                    Content="Localhost only"
                                    Click="PortFilterChip_Click"
                                    Tag="Localhost"
                                    Padding="12,6"/>
                            <Button x:Name="PortFilterTcpButton"
                                    Content="TCP"
                                    Click="PortFilterChip_Click"
                                    Tag="TCP"
                                    Padding="12,6"/>
                            <Button x:Name="PortFilterUdpButton"
                                    Content="UDP"
                                    Click="PortFilterChip_Click"
                                    Tag="UDP"
                                    Padding="12,6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Port List / Empty State -->
                    <Grid Grid.Row="2">
                        <!-- Empty State -->
                        <StackPanel x:Name="ListeningPortsEmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12"
                                    Visibility="Collapsed">
                            <FontIcon Glyph="&#xE774;"
                                      FontSize="56"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="ListeningPortsEmptyStateTitle"
                                       Text="No listening ports found"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ListeningPortsEmptyStateSubtitle"
                                       Text="No sockets are currently waiting for incoming connections."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="400"/>
                        </StackPanel>

                        <!-- ListView -->
                        <ListView x:Name="ListeningPortsListView"
                                  ItemsSource="{x:Bind ListeningPortsViewModel.Ports, Mode=OneWay}"
                                  SelectionMode="None"
                                  Padding="0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ListeningPortItemViewModel">
                                    <Grid Padding="12,10" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>   <!-- Protocol -->
                                            <ColumnDefinition Width="180"/>  <!-- Port & Address -->
                                            <ColumnDefinition Width="160"/>  <!-- Reach / Scope -->
                                            <ColumnDefinition Width="*"/>    <!-- Process Name & PID -->
                                            <ColumnDefinition Width="160"/>  <!-- Exposure -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Protocol pill -->
                                        <Border Grid.Column="0"
                                                CornerRadius="4"
                                                Padding="8,3"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind Protocol}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- Port and Local Address -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="Port"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind Port}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind LocalAddressText}"
                                                       FontSize="11"
                                                       FontFamily="Consolas"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- Reach / Scope chip -->
                                        <Border Grid.Column="2"
                                                CornerRadius="12"
                                                Padding="10,4"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                ToolTipService.ToolTip="{x:Bind ScopeTooltip}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind ScopeIcon}" FontSize="12"/>
                                                <TextBlock Text="{x:Bind ScopeText}"
                                                           FontSize="11"
                                                           FontWeight="Medium"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Process Name & PID -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind AppName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind PidText}"
                                                       FontSize="11"
                                                       FontFamily="Consolas"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <!-- Exposure chip -->
                                        <Border Grid.Column="4"
                                                CornerRadius="4"
                                                Padding="8,3"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                ToolTipService.ToolTip="{x:Bind ExposureTooltip}">
                                            <TextBlock Text="{x:Bind ExposureText}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Status bar -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <ProgressRing Width="16" Height="16"
                                      IsActive="{x:Bind ListeningPortsViewModel.IsLoading, Mode=OneWay}"/>
                        <TextBlock Text="Listening ports monitor active"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

            </Grid>  <!-- end tab content container -->
        </Grid>
    </Grid>
</Page>
