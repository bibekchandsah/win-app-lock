<Page
    x:Class="AppLock.Views.InternetAccessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AppLock.Models"
    xmlns:local="using:AppLock.Views"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Color converter for status chips -->
        <SolidColorBrush x:Key="BlockedColor" Color="#DC3545"/>
        <SolidColorBrush x:Key="AllowedColor" Color="#28A745"/>
        <SolidColorBrush x:Key="PartialColor" Color="#FFC107"/>
        <SolidColorBrush x:Key="MissingColor" Color="#6C757D"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Padding="24,24,24,12">
            <StackPanel Spacing="8">
                <TextBlock Text="Internet Access" 
                           Style="{StaticResource TitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Control which applications can access the internet" 
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Info Bars -->
        <StackPanel Grid.Row="1" Padding="24,0,24,12" Spacing="8">
            <!-- Not Elevated Banner -->
            <InfoBar x:Name="NotElevatedInfoBar"
                     Severity="Warning"
                     Title="Administrator rights required"
                     Message="Administrator rights are needed to change firewall rules."
                     IsOpen="False"
                     IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Restart as administrator" 
                            Click="RestartAsAdminButton_Click"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Firewall Disabled Banner -->
            <InfoBar x:Name="FirewallDisabledInfoBar"
                     Severity="Informational"
                     Title="Firewall is off"
                     Message="Rules are saved but won't be enforced while Windows Defender Firewall is off."
                     IsOpen="False"
                     IsClosable="True">
                <InfoBar.ActionButton>
                    <Button Content="Open Windows Security" 
                            Click="OpenWindowsSecurityButton_Click"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Group Policy Locked Banner -->
            <InfoBar x:Name="GroupPolicyLockedInfoBar"
                     Severity="Error"
                     Title="Firewall managed by policy"
                     Message="A group policy or MDM controls the firewall. Changes cannot be made."
                     IsOpen="False"
                     IsClosable="False"/>
        </StackPanel>

        <!-- Main Content: Tabs -->
        <Grid Grid.Row="2" Padding="24,0,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab Headers -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                <Button x:Name="AppsTabButton"
                        Content="Apps"
                        Click="AppsTabButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Apps tab"
                        AutomationProperties.HelpText="View and manage firewall rules for applications"
                        Padding="16,8"/>
                <Button x:Name="ActiveConnectionsTabButton"
                        Content="Active connections"
                        Click="ActiveConnectionsTabButton_Click"
                        AutomationProperties.Name="Active connections tab"
                        AutomationProperties.HelpText="View processes currently using network connections"
                        Padding="16,8"/>
            </StackPanel>

            <!-- Tab Content -->
            <Grid Grid.Row="1">
                <!-- Apps Tab -->
                <Grid x:Name="AppsTabContent" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Command Bar -->
                    <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent"
                                AutomationProperties.Name="Applications command bar">
                        <AppBarButton Label="Add app" Icon="Add" 
                                      AutomationProperties.Name="Add application"
                                      AutomationProperties.HelpText="Add an application to control its internet access">
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Browse for program…" Click="BrowseForProgram_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE838;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="From running programs…" Click="FromRunningPrograms_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8A7;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Pick a window…" Click="PickAWindow_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8B9;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="From installed apps…" Click="FromInstalledApps_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xECAA;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarButton Label="Refresh" Icon="Refresh" Click="RefreshApps_Click"
                                      AutomationProperties.Name="Refresh application list"/>
                        <AppBarButton Label="Block all selected" Click="BlockAllSelected_Click"
                                      AutomationProperties.Name="Block internet for selected applications">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xF140;"/>
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Unblock all selected" Click="UnblockAllSelected_Click"
                                      AutomationProperties.Name="Allow internet for selected applications">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8E8;"/>
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Remove" Icon="Delete" Click="RemoveSelected_Click"
                                      AutomationProperties.Name="Remove selected applications from list"/>
                        <AppBarButton Label="More">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE712;"/>
                            </AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Import rules…" Click="ImportRules_Click"/>
                                    <MenuFlyoutItem Text="Export rules…" Click="ExportRules_Click"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Repair rules" Click="RepairRules_Click"/>
                                    <MenuFlyoutItem Text="Remove all AppLock rules" Click="RemoveAllAppLockRules_Click" Foreground="Red"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Firewall status" Click="FirewallStatus_Click"/>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                    </CommandBar>

                    <!-- Apps List / Empty State -->
                    <Grid Grid.Row="1">
                        <!-- Empty State -->
                        <StackPanel x:Name="AppsEmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="16">
                            <FontIcon Glyph="&#xEB5E;" 
                                      FontSize="64" 
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="No apps added" 
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Add an app to control its internet access." 
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Apps ListView -->
                        <ListView x:Name="AppsListView"
                                  Visibility="Collapsed"
                                  SelectionMode="Multiple"
                                  Padding="0"
                                  AutomationProperties.Name="Applications list"
                                  AutomationProperties.HelpText="List of applications with firewall rules">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="16,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                            <ColumnDefinition Width="*"/>    <!-- Info -->
                                            <ColumnDefinition Width="Auto"/> <!-- Direction -->
                                            <ColumnDefinition Width="Auto"/> <!-- Status -->
                                            <ColumnDefinition Width="Auto"/> <!-- Toggle -->
                                            <ColumnDefinition Width="Auto"/> <!-- Repair -->
                                        </Grid.ColumnDefinitions>

                                        <!-- App Icon (placeholder) -->
                                        <Border Grid.Column="0" 
                                                Width="40" Height="40"
                                                CornerRadius="4"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                            <Image Source="{Binding Icon, Mode=OneWay}" 
                                                   Width="32" Height="32"
                                                   Stretch="Uniform"/>
                                        </Border>

                                        <!-- App Info -->
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       FontWeight="SemiBold"
                                                       FontSize="14"/>
                                            <TextBlock Text="{Binding ExePath}" 
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <ToolTipService.ToolTip>
                                                    <TextBlock Text="{Binding ExePath}"/>
                                                </ToolTipService.ToolTip>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Direction Selector -->
                                        <ComboBox Grid.Column="2"
                                                  SelectedItem="{Binding Direction, Mode=TwoWay}"
                                                  MinWidth="120"
                                                  VerticalAlignment="Center">
                                            <ComboBoxItem Content="Outgoing"/>
                                            <ComboBoxItem Content="Incoming"/>
                                            <ComboBoxItem Content="Both"/>
                                        </ComboBox>

                                        <!-- Status Chip -->
                                        <Border Grid.Column="3"
                                                Padding="12,6"
                                                CornerRadius="12"
                                                VerticalAlignment="Center"
                                                Margin="8,0"
                                                AutomationProperties.LiveSetting="Polite">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding StatusBrush.Color}" Opacity="0.2"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding StatusBrush}"/>
                                        </Border>

                                        <!-- Block/Allow Toggle -->
                                        <ToggleSwitch Grid.Column="4"
                                                      IsOn="{Binding IsBlocked, Mode=TwoWay}"
                                                      OffContent="Allowed"
                                                      OnContent="Blocked"
                                                      MinWidth="100"
                                                      VerticalAlignment="Center"/>

                                        <!-- Repair Button (only visible when drift detected) -->
                                        <Button Grid.Column="5"
                                                Content="Repair"
                                                Click="RepairSingle_Click"
                                                Tag="{Binding}"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding RepairButtonVisibility}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal"/>
                                                                <VisualState x:Name="PointerOver">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBackground" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </VisualState>
                                                                <VisualState x:Name="Pressed">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBackground" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </VisualState>
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                        <Border x:Name="ButtonBackground"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                CornerRadius="4"
                                                                Padding="12,6">
                                                            <TextBlock Text="Repair"
                                                                       FontSize="12"
                                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <!-- Active Connections Tab -->
                <Grid x:Name="ActiveConnectionsTabContent" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter and options -->
                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="Filter by process, address, or protocol..."
                            Text="{x:Bind ActiveConnectionsViewModel.FilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <ToggleSwitch
                            Grid.Column="1"
                            Header="Show only connected"
                            IsOn="{x:Bind ActiveConnectionsViewModel.ShowOnlyWithConnections, Mode=TwoWay}"
                            MinWidth="0"/>
                    </Grid>

                    <!-- Connections list -->
                    <ListView
                        x:Name="ConnectionsListView"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ActiveConnectionsViewModel.FilteredConnections, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ActiveConnection">
                                <Grid ColumnSpacing="12" Padding="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Process -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind ProcessName}" FontWeight="SemiBold"/>
                                        <TextBlock 
                                            Text="{x:Bind ProcessPath}" 
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- PID -->
                                    <TextBlock 
                                        Grid.Column="1" 
                                        Text="{x:Bind ProcessId}" 
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <!-- Protocol -->
                                    <Border
                                        Grid.Column="2"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        VerticalAlignment="Center">
                                        <TextBlock 
                                            Text="{x:Bind Protocol}" 
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Connection -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Connection}" FontFamily="Consolas" FontSize="12"/>
                                        <TextBlock 
                                            Text="{x:Bind State}" 
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>

                                    <!-- System badge -->
                                    <TextBlock
                                        Grid.Column="4"
                                        Text="System Process"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Padding="8,4"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind SystemBadgeVisibility, Mode=OneWay}"/>

                                    <!-- Block button -->
                                    <Button
                                        Grid.Column="5"
                                        Content="Block"
                                        Click="BlockConnection_Click"
                                        Tag="{x:Bind}"
                                        IsEnabled="{x:Bind CanBlock}"
                                        VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Status bar -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <ProgressRing
                            Width="16"
                            Height="16"
                            IsActive="{x:Bind ActiveConnectionsViewModel.IsLoading, Mode=OneWay}"/>
                        <TextBlock
                            Text="{x:Bind ActiveConnectionsViewModel.StatusText, Mode=OneWay}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            VerticalAlignment="Center"/>
                        <TextBlock
                            Text="• Auto-refreshing every 3 seconds"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
