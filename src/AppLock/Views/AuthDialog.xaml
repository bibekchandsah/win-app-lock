<ContentDialog
    x:Class="AppLock.Views.AuthDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Verify Admin Password"
    PrimaryButtonText="Unlock"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Spacing="16" MinWidth="300">
        <TextBlock Text="Enter your admin password to continue"
                   TextWrapping="Wrap"/>

        <PasswordBox x:Name="PasswordBox"
                     Header="Password"
                     PlaceholderText="Enter password"
                     PasswordRevealMode="Peek"
                     KeyDown="PasswordBox_KeyDown"/>

        <!-- Windows Hello Button -->
        <Button x:Name="WindowsHelloButton"
                Click="WindowsHelloButton_Click"
                HorizontalAlignment="Stretch"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xEB68;" FontSize="16"/>
                <TextBlock Text="Use Windows Hello"/>
            </StackPanel>
        </Button>

        <TextBlock x:Name="ErrorText"
                   Foreground="{ThemeResource SystemErrorTextColor}"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"/>

        <TextBlock x:Name="LockoutText"
                   Foreground="{ThemeResource SystemErrorTextColor}"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>
