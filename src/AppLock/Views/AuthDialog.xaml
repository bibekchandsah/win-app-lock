<ContentDialog
    x:Class="AppLock.Views.AuthDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Verify Admin Password"
    PrimaryButtonText="Unlock"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">


    <StackPanel Spacing="16" MinWidth="340">
        <!-- 1. Password Login View -->
        <StackPanel x:Name="PasswordPanel" Spacing="16" Visibility="Visible">
            <TextBlock Text="Enter your admin password to continue"
                       TextWrapping="Wrap"/>

            <PasswordBox x:Name="PasswordBox"
                         Header="Password"
                         PlaceholderText="Enter password"
                         PasswordRevealMode="Peek"
                         CornerRadius="4"
                         KeyDown="PasswordBox_KeyDown"/>

            <!-- Windows Hello Button -->
            <Button x:Name="WindowsHelloButton"
                    Click="WindowsHelloButton_Click"
                    HorizontalAlignment="Stretch"
                    CornerRadius="4"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEB68;" FontSize="16"/>
                    <TextBlock Text="Use Windows Hello"/>
                </StackPanel>
            </Button>

            <HyperlinkButton x:Name="ForgotPasswordButton"
                             Content="Forgot password? Reset via security question"
                             Click="ForgotPasswordButton_Click"
                             HorizontalAlignment="Center"
                             FontSize="12"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="{ThemeResource SystemErrorTextColor}"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="LockoutText"
                       Foreground="{ThemeResource SystemErrorTextColor}"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 2. Security Question Verification View -->
        <StackPanel x:Name="SecurityQuestionPanel" Spacing="16" Visibility="Collapsed">
            <TextBlock Text="Answer your security question to reset password"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="SecurityQuestionText"
                       FontWeight="SemiBold"
                       FontSize="15"
                       TextWrapping="Wrap"/>

            <TextBox x:Name="SecurityAnswerBox"
                     PlaceholderText="Enter your answer"
                     CornerRadius="4"
                     KeyDown="SecurityAnswerBox_KeyDown"/>

            <TextBlock x:Name="QuestionErrorText"
                       Foreground="{ThemeResource SystemErrorTextColor}"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"/>

            <HyperlinkButton Content="Back to password login"
                             Click="BackToPassword_Click"
                             HorizontalAlignment="Center"
                             FontSize="12"/>
        </StackPanel>

        <!-- 3. New Password Reset View -->
        <StackPanel x:Name="ResetPasswordPanel" Spacing="16" Visibility="Collapsed">
            <TextBlock Text="Your identity has been verified. Enter a new admin password."
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <PasswordBox x:Name="NewPasswordBox"
                         Header="New Password"
                         PlaceholderText="Enter new password (min. 6 characters)"
                         PasswordRevealMode="Peek"
                         CornerRadius="4"
                         PasswordChanged="NewPasswordBox_PasswordChanged"/>

            <PasswordBox x:Name="ConfirmPasswordBox"
                         Header="Confirm New Password"
                         PlaceholderText="Re-enter new password"
                         PasswordRevealMode="Peek"
                         CornerRadius="4"
                         PasswordChanged="NewPasswordBox_PasswordChanged"/>

            <StackPanel Spacing="4">
                <TextBlock Text="Password Strength:" FontSize="12"/>
                <ProgressBar x:Name="StrengthBar"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             CornerRadius="2"
                             Height="4"/>
                <TextBlock x:Name="StrengthText"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <TextBlock x:Name="ResetErrorText"
                       Foreground="{ThemeResource SystemErrorTextColor}"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"/>

            <HyperlinkButton Content="Back to password login"
                             Click="BackToPassword_Click"
                             HorizontalAlignment="Center"
                             FontSize="12"/>
        </StackPanel>

        <!-- 4. Windows Hello Pending View -->
        <StackPanel x:Name="HelloPendingPanel" Spacing="16" Visibility="Collapsed" HorizontalAlignment="Center" Padding="0,4">
            <!-- Hello Icon -->
            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="28"
                    Width="56" Height="56"
                    HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE77B;" FontSize="28" Foreground="White"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Status text -->
            <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="Windows Hello verification pending…"
                           FontSize="15"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
                <TextBlock Text="The Windows Hello prompt may be behind this window."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="320"/>
            </StackPanel>

            <!-- Tip box -->
            <Border Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    MaxWidth="340">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE946;" FontSize="14"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="How to complete verification:"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               MaxWidth="320"
                               Style="{ThemeResource CaptionTextBlockStyle}">
                        <Run Text="• Use your fingerprint sensor, face, or PIN directly"/>
                        <LineBreak/>
                        <Run Text="• Or press "/>
                        <Run Text="Alt+Tab" FontWeight="SemiBold"/>
                        <Run Text=" to switch to the Windows Hello prompt"/>
                        <LineBreak/>
                        <Run Text="• Or use mouse gestures / taskbar to find it"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Cancel button -->
            <Button x:Name="HelloCancelButton"
                    Content="Cancel Windows Hello"
                    Click="HelloCancelButton_Click"
                    HorizontalAlignment="Center"
                    CornerRadius="4"
                    Padding="16,6"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>
