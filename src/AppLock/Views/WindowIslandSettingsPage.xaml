<Page
    x:Class="AppLock.Views.WindowIslandSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CategoryListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style x:Key="IslandSettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style x:Key="IslandSettingTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="IslandSettingDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Page.Resources>

    <Grid Padding="24,20,24,24" RowSpacing="14" MaxWidth="1120" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Breadcrumb and header -->
        <StackPanel Grid.Row="0" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackButton"
                        Click="BackButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Others"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="›"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Window Island"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="Window Island" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="A native WinUI 3 notch at the top of the screen drawn with the Composition API — clock, battery and quick controls on an independent, lag-free UI thread."
                    TextWrapping="Wrap"
                    Opacity="0.7" />
            </StackPanel>
        </StackPanel>

        <!-- Category rail + settings content -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Settings"
                               FontSize="11"
                               Margin="10,8,10,6"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListView x:Name="CategoryList"
                                  SelectionMode="Single"
                                  SelectionChanged="CategoryList_SelectionChanged"
                                  ItemContainerStyle="{StaticResource CategoryListItemStyle}"
                                  AutomationProperties.Name="Window Island settings categories">
                            <ListViewItem Tag="general">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE713;" FontSize="14" Opacity="0.85" />
                                    <TextBlock Text="General" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="appearance">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE790;" FontSize="14" Opacity="0.85" />
                                    <TextBlock Text="Appearance" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="visibility">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE890;" FontSize="14" Opacity="0.85" />
                                    <TextBlock Text="Visibility" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="indicators">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="14" Opacity="0.85" />
                                    <TextBlock Text="Notch Indicators" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="clock">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE823;" FontSize="14" Opacity="0.85" />
                                    <TextBlock Text="Clock &amp; Calendar" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="media">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="14" Opacity="0.85" />
                                    <TextBlock Text="Media &amp; Lyrics" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="cards">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7E7;" FontSize="14" Opacity="0.85" />
                                    <TextBlock Text="Event Cards" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="controls">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE9E9;" FontSize="14" Opacity="0.85" />
                                    <TextBlock Text="Controls Tab" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="weather">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE753;" FontSize="14" Opacity="0.85" />
                                    <TextBlock Text="Weather" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="chat">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="14" Opacity="0.85" />
                                    <TextBlock Text="Chat" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="search">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE721;" FontSize="14" Opacity="0.85" />
                                    <TextBlock Text="Search Commands" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="performance">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE945;" FontSize="14" Opacity="0.85" />
                                    <TextBlock Text="Performance" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="about">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" Opacity="0.85" />
                                    <TextBlock Text="About &amp; Developer" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </ListViewItem>
                        </ListView>
                    </ScrollViewer>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ContentScroller"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">

                    <!-- ░░ General ░░ -->
                    <StackPanel x:Name="SectionGeneral" Spacing="8">
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Enable Window Island" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Runs a hardware-accelerated dynamic bar pinned to the top of your screen."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="EnabledToggle"
                                              Grid.Column="1"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center"
                                              Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Global hotkey" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Keyboard shortcut to show or fold Window Island from anywhere. Default: Ctrl+Shift+W."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <TextBox x:Name="HotkeyBox"
                                         Grid.Column="1"
                                         Width="220"
                                         VerticalAlignment="Center"
                                         PlaceholderText="Ctrl+Shift+W"
                                         TextChanged="OnHotkeyChanged" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Screenshot save folder" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Folder where Home tab &quot;Full screen&quot; screenshots and saved QR codes are stored."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ScreenshotsFolderBox"
                                             Grid.Column="0"
                                             TextChanged="OnScreenshotsFolderChanged" />
                                    <Button x:Name="ScreenshotsFolderBrowseBtn"
                                            Grid.Column="1"
                                            Content="Browse…"
                                            Click="ScreenshotsFolderBrowseBtn_Click" />
                                    <Button x:Name="ScreenshotsFolderResetBtn"
                                            Grid.Column="2"
                                            Content="Reset"
                                            Click="ScreenshotsFolderResetBtn_Click" />
                                </Grid>
                                <TextBlock x:Name="ScreenshotsDefaultPathText" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ░░ Appearance ░░ -->
                    <StackPanel x:Name="SectionAppearance" Spacing="8" Visibility="Collapsed">
                        <!-- Shape -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Shape" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Notch attaches flush to the top screen edge; Capsule floats as a rounded pill."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="ShapeBox" Grid.Column="1" MinWidth="240" VerticalAlignment="Center" SelectionChanged="OnSelectionChanged">
                                    <ComboBoxItem Content="Notch (flush with screen edge)" Tag="Notch" />
                                    <ComboBoxItem Content="Capsule (floating pill)" Tag="Capsule" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Position -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Position" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Choose where the folded and expanded island sits along the top of your screen."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="PositionBox" Grid.Column="1" MinWidth="240" VerticalAlignment="Center" SelectionChanged="OnSelectionChanged">
                                    <ComboBoxItem Content="Top center" Tag="TopCenter" />
                                    <ComboBoxItem Content="Top left" Tag="TopLeft" />
                                    <ComboBoxItem Content="Top right" Tag="TopRight" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Theme -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Theme" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Match your Windows light/dark mode automatically or force a specific island theme."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeBox" Grid.Column="1" MinWidth="240" VerticalAlignment="Center" SelectionChanged="OnSelectionChanged">
                                    <ComboBoxItem Content="System default" Tag="System" />
                                    <ComboBoxItem Content="Light" Tag="Light" />
                                    <ComboBoxItem Content="Dark" Tag="Dark" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Island Color -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Island Color" Style="{StaticResource IslandSettingTitleStyle}" />
                                        <TextBlock Text="Pick a preset tint or custom hex color for the island background; text contrast adjusts automatically."
                                                   Style="{StaticResource IslandSettingDescStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="IslandColorBox" Grid.Column="1" MinWidth="240" VerticalAlignment="Center" SelectionChanged="OnIslandColorChanged">
                                        <ComboBoxItem Content="Default (Auto black/white)" Tag="Default" />
                                        <ComboBoxItem Content="Dark Navy" Tag="Navy" />
                                        <ComboBoxItem Content="Deep Indigo" Tag="Indigo" />
                                        <ComboBoxItem Content="Forest Green" Tag="Green" />
                                        <ComboBoxItem Content="Rich Maroon" Tag="Maroon" />
                                        <ComboBoxItem Content="Warm Brown" Tag="Brown" />
                                        <ComboBoxItem Content="Soft Cream" Tag="Cream" />
                                        <ComboBoxItem Content="Fresh Mint" Tag="Mint" />
                                        <ComboBoxItem Content="Gentle Lavender" Tag="Lavender" />
                                        <ComboBoxItem Content="Custom color" Tag="Custom" />
                                    </ComboBox>
                                </Grid>

                                <StackPanel x:Name="IslandCustomColorPanel"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Right"
                                            Visibility="Collapsed">
                                    <Button x:Name="IslandCustomColorButton"
                                            Width="56" Height="32" Padding="3" CornerRadius="4"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            AutomationProperties.Name="Pick custom island color"
                                            ToolTipService.ToolTip="Pick a custom island color">
                                        <Border x:Name="IslandCustomColorSwatch" CornerRadius="3"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                Background="#1E293B"/>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <ColorPicker x:Name="IslandCustomColorPicker"
                                                             Width="300"
                                                             IsAlphaEnabled="False"
                                                             IsAlphaSliderVisible="False"
                                                             IsAlphaTextInputVisible="False"
                                                             IsColorChannelTextInputVisible="False"
                                                             IsHexInputVisible="True"
                                                             IsMoreButtonVisible="False"
                                                             ColorSpectrumShape="Box"
                                                             ColorChanged="IslandCustomColorPicker_ColorChanged"/>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBox x:Name="IslandCustomColorHexBox"
                                             Width="96"
                                             VerticalAlignment="Center"
                                             FontFamily="Consolas"
                                             PlaceholderText="#1E293B"
                                             MaxLength="7"
                                             TextChanged="IslandCustomColorHexBox_TextChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Size Scale -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Size Scale" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Scale the overall dimensions of the island up or down to fit your screen resolution."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                    <TextBlock x:Name="SizeLabelText" FontSize="12" Opacity="0.7" />
                                </StackPanel>
                                <Slider x:Name="SizeSlider" Grid.Column="1" Width="240" VerticalAlignment="Center" ValueChanged="OnSliderChanged" />
                            </Grid>
                        </Border>

                        <!-- Background Opacity -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Background Opacity (Transparency)" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Adjust how translucent or solid the island backdrop appears over open windows."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                    <TextBlock x:Name="OpacityLabelText" FontSize="12" Opacity="0.7" />
                                </StackPanel>
                                <Slider x:Name="OpacitySlider" Grid.Column="1" Width="240" VerticalAlignment="Center" ValueChanged="OnSliderChanged" />
                            </Grid>
                        </Border>

                        <!-- Vertical Offset -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Vertical Offset (DIPs)" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Nudge the island downward from the top edge in device-independent pixels."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                    <TextBlock x:Name="YOffsetLabelText" FontSize="12" Opacity="0.7" />
                                </StackPanel>
                                <Slider x:Name="YOffsetSlider" Grid.Column="1" Width="240" VerticalAlignment="Center" ValueChanged="OnSliderChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ░░ Visibility ░░ -->
                    <StackPanel x:Name="SectionVisibility" Spacing="8" Visibility="Collapsed">
                        <!-- Hide in full-screen apps -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Hide in full-screen apps" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Hide the island automatically while games, videos, or presentations are running in full screen."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="HideInFullScreenToggle"
                                              Grid.Column="1"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center"
                                              Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Come out over full-screen apps -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Come out over them when the cursor is at the top edge" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Half a second (500 ms) of the cursor at the edge above the island's place and it comes out over the app. Better left off for games: the cursor gets there in their menus, and the game may minimize. The island's hotkeys call it out anyway."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="EdgeDwellToggle"
                                              Grid.Column="1"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center"
                                              Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Auto-hide -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Hide the island until it is needed" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="The folded island slides off-screen and stays out of the way of what is under it: browser tabs, window buttons. Rest the cursor at the very top edge above it and it comes back; with a card or hotkey it comes out by itself."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoHideToggle"
                                              Grid.Column="1"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center"
                                              Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Stay in sight on desktop -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Stay in sight on the desktop" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="For auto-hide: while the Windows desktop itself is in front, with no program window on it, the island stays in sight."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoHideStayOnDesktopToggle"
                                              Grid.Column="1"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center"
                                              Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Hide only when overlapped -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Hide only while a window is under the island" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Keep the island visible when nothing is behind it, and slide it away only while a window overlaps its position."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoHideOnlyWhenOverlappedToggle"
                                              Grid.Column="1"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center"
                                              Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Chosen apps rule -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Chosen apps rule" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Automatically hide the island—or show it exclusively—whenever one of your listed apps below becomes the active foreground window."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="ChosenAppsModeBox" Grid.Column="1" MinWidth="240" VerticalAlignment="Center" SelectionChanged="OnSelectionChanged">
                                    <ComboBoxItem Content="Disabled" Tag="Disabled" />
                                    <ComboBoxItem Content="Hide while one is in front" Tag="Hide" />
                                    <ComboBoxItem Content="Only show while one is in front (Keep)" Tag="Keep" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Chosen process names -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Chosen process names" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Enter executable names without .exe, separated by commas (e.g. chrome, notepad). Used by the Chosen apps rule above."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <TextBox x:Name="ChosenAppsBox"
                                         Grid.Column="1"
                                         PlaceholderText="e.g. chrome, notepad"
                                         Width="260"
                                         VerticalAlignment="Center"
                                         TextChanged="OnChosenAppsChanged" />
                            </Grid>
                        </Border>

                        <!-- Place under top taskbar -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Place under the taskbar when it is docked at the top" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="When the Windows taskbar is docked at the top edge, position the island right below it so nothing overlaps."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="UnderTopTaskbarToggle"
                                              Grid.Column="1"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center"
                                              Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Through mode -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Through mode" Style="{StaticResource IslandSettingTitleStyle}" />
                                        <TextBlock Text="The folded island lets clicks through and does not open under the cursor: it is in sight and in nobody's way. Hotkeys open it. Turn the mode on and off here, with its own hotkey, or with -through in Alt+Space."
                                                   Style="{StaticResource IslandSettingDescStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ThroughModeToggle"
                                                  Grid.Column="1"
                                                  OnContent=""
                                                  OffContent=""
                                                  MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Toggled="OnSettingChanged" />
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Through mode hotkey" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Optional keyboard shortcut to toggle click-through mode."
                                                   Style="{StaticResource IslandSettingDescStyle}" />
                                    </StackPanel>
                                    <TextBox x:Name="ThroughModeHotkeyBox"
                                             Grid.Column="1"
                                             PlaceholderText="e.g. Ctrl+Shift+T"
                                             Width="220"
                                             VerticalAlignment="Center"
                                             TextChanged="OnHotkeyChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Show on monitor -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Show on monitor" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Choose whether the island stays on your primary display or automatically moves to whichever monitor your mouse cursor is currently on."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="TargetMonitorBox" Grid.Column="1" MinWidth="240" VerticalAlignment="Center" SelectionChanged="OnSelectionChanged">
                                    <ComboBoxItem Content="Primary monitor" Tag="Primary" />
                                    <ComboBoxItem Content="Monitor with cursor" Tag="Cursor" />
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ░░ Notch Indicators ░░ -->
                    <StackPanel x:Name="SectionIndicators" Spacing="8" Visibility="Collapsed">
                        <!-- Show clock -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Show clock" Style="{StaticResource IslandSettingTitleStyle}" />
                                        <TextBlock Text="Display the current time on the folded island so you can glance at it anytime."
                                                   Style="{StaticResource IslandSettingDescStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ShowClockToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                                </Grid>
                                <StackPanel Margin="4,0,0,0" Spacing="4" Visibility="{x:Bind ShowClockToggle.IsOn, Mode=OneWay}">
                                    <CheckBox x:Name="TimeFormat24HCheck" Content="24-hour format (e.g. 14:30 vs 2:30 PM)" Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
                                    <CheckBox x:Name="ShowSecondsCheck" Content="Show seconds" Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Show battery -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Show battery percentage &amp; status" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Show remaining battery percentage and charging icon on the folded island."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowBatteryToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Temperature -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Show temperature on folded island" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Display current outdoor temperature and weather icon for your configured city."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="WeatherTempOnIslandToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Mic dot -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Microphone indicator dot on folded island" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Show a privacy indicator dot whenever an application is actively recording from your microphone."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="MicDotToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Cam dot -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Camera indicator dot on folded island" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Show a green privacy indicator dot whenever an application is using your webcam."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CamDotToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- CPU usage -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="CPU usage on folded island" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Show live processor utilization percentage on the folded island."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowCpuNotchToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- RAM usage -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="RAM usage on folded island" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Show live system memory usage percentage on the folded island."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowRamNotchToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Disk usage -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Disk usage on folded island" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Show live storage drive activity percentage on the folded island."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowDiskNotchToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- GPU usage -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="GPU usage on folded island" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Show live graphics card utilization percentage on the folded island."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowGpuNotchToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Download speed -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Download speed on folded island" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Display real-time incoming network bandwidth on the folded island."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowDownSpeedNotchToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Upload speed -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Upload speed on folded island" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Display real-time outgoing network bandwidth on the folded island."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowUpSpeedNotchToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ░░ Clock & Calendar ░░ -->
                    <StackPanel x:Name="SectionClock" Spacing="8" Visibility="Collapsed">
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Clock style in Date &amp; Calendar tab" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Choose whether the Date &amp; Calendar tab shows a digital readout or an analog clock face."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="CalendarClockStyleBox"
                                          Grid.Column="1"
                                          MinWidth="240"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnSelectionChanged">
                                    <ComboBoxItem Content="Digital" Tag="Digital" />
                                    <ComboBoxItem Content="Digital with seconds" Tag="DigitalSeconds" />
                                    <ComboBoxItem Content="Analog" Tag="Analog" />
                                    <ComboBoxItem Content="Analog with seconds" Tag="AnalogSeconds" />
                                    <ComboBoxItem Content="Analog classic (numbers &amp; ticks)" Tag="AnalogClassic" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="World clocks" Style="{StaticResource IslandSettingTitleStyle}" />
                                <TextBlock Text="Add, reorder, or remove custom place clocks shown in the island's Date &amp; Calendar tab. Changes sync in real time and persist across restarts."
                                           Style="{StaticResource IslandSettingDescStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="SettingsClockPlaceBox"
                                             PlaceholderText="Place name (e.g. Paris)"
                                             Width="170" />
                                    <ComboBox x:Name="SettingsClockTzBox"
                                              PlaceholderText="Select time zone"
                                              Width="270" />
                                    <Button x:Name="SettingsAddClockBtn"
                                            Content="Add"
                                            Click="SettingsAddClockBtn_Click"
                                            Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="SettingsWorldClocksList" Spacing="6" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ░░ Media & Lyrics ░░ -->
                    <StackPanel x:Name="SectionMedia" Spacing="8" Visibility="Collapsed">
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Player style on Home" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Select how album artwork and background colors are rendered in the expanded media player."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="MediaPlayerStyleBox"
                                          Grid.Column="1"
                                          MinWidth="260"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnSelectionChanged">
                                    <ComboBoxItem Content="Compact (album art + subtle glow)" Tag="Compact" />
                                    <ComboBoxItem Content="Fill (whole player in album colors)" Tag="Fill" />
                                    <ComboBoxItem Content="Soft mirror (centered art + blurred sides)" Tag="SoftMirror" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="The pill while music plays" Style="{StaticResource IslandSettingTitleStyle}" />
                                <TextBlock Text="&quot;With the name&quot;: the track and a bar of its time. &quot;Mini player&quot;: the cover, the bar and the buttons; a click opens the island, not the cursor. &quot;With the words&quot;: the line being sung (needs &quot;Show lyrics beside the player&quot; below)."
                                           Style="{StaticResource IslandSettingDescStyle}" />
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button x:Name="MediaPillUsualBtn" Content="Usual" Tag="Usual"
                                                Click="OnMediaPillModeClick" BorderThickness="0" CornerRadius="6" Padding="12,6" />
                                        <Button x:Name="MediaPillWithNameBtn" Content="With the name" Tag="WithName"
                                                Click="OnMediaPillModeClick" BorderThickness="0" CornerRadius="6" Padding="12,6" />
                                        <Button x:Name="MediaPillMiniPlayerBtn" Content="Mini player" Tag="MiniPlayer"
                                                Click="OnMediaPillModeClick" BorderThickness="0" CornerRadius="6" Padding="12,6" />
                                        <Button x:Name="MediaPillWithWordsBtn" Content="With the words" Tag="WithWords"
                                                Click="OnMediaPillModeClick" BorderThickness="0" CornerRadius="6" Padding="12,6" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Show lyrics beside the player" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="When the playing track has lyrics they appear next to the player card on the Home tab. Turn this off to keep the player at full width and skip the lyrics lookup."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="LyricsToggle"
                                              Grid.Column="1"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center"
                                              Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ░░ Event Cards ░░ -->
                    <StackPanel x:Name="SectionCards" Spacing="8" Visibility="Collapsed">
                        <!-- Caps Lock -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Caps Lock on/off notification" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Show a quick card whenever you toggle Caps Lock so you always know its state." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CardCapsLockToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Num Lock -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Num Lock on/off notification" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Show a quick card whenever you toggle Num Lock on your keyboard." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CardNumLockToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Delete key warning + custom keys -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Delete key press warning" Style="{StaticResource IslandSettingTitleStyle}" />
                                        <TextBlock Text="Flash a brief warning card when the Delete key is pressed to help prevent accidental deletions." Style="{StaticResource IslandSettingDescStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="CardDeleteKeyWarningToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Custom key warnings" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Add extra comma-separated key names to trigger a quick warning card when pressed." Style="{StaticResource IslandSettingDescStyle}" />
                                    </StackPanel>
                                    <TextBox x:Name="CardCustomKeyWarningsBox"
                                             Grid.Column="1"
                                             Width="260"
                                             VerticalAlignment="Center"
                                             PlaceholderText="e.g. Insert, PrintScreen, F12"
                                             TextChanged="OnCustomKeyWarningsChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Volume -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Volume adjustments (+ mouse wheel)" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Show a live volume bar card when volume changes, and allow scrolling on the island to adjust volume." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CardVolumeToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Clipboard -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Clipboard copy (text and images)" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Preview newly copied text snippets and images briefly on the island." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CardClipboardToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Screenshot -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Screenshot saved alert" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Show a thumbnail preview card with quick open actions whenever a screenshot is saved." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CardScreenshotToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Downloads -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Downloads" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Show download progress and a completion card with a shortcut to the finished file." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CardDownloadsToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- File copy progress -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="File copy progress" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Show a live progress bar card while Windows Explorer copies or moves files." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CardFileCopyToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- VPN -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="VPN connect / disconnect" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Notify you on the island when a VPN connection starts or drops." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CardVpnToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Low battery -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Low battery alert (20 %, 10 %, 5 %)" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Display an urgent battery warning card when charge drops to 20%, 10%, or 5%." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CardBatteryLowToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Charger plugged/unplugged -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Charger plugged / unplugged" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Show a confirmation card when power adapter is connected, disconnected, or reaches 100%." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CardChargingToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Mic usage -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Microphone usage detected" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Alert you with a card (including a quick system-wide mute button) when an app activates your microphone." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CardMicToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Cam usage -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Camera usage detected" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Alert you with a card showing which app started recording from your webcam." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CardCamToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Card display duration -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Card display duration" Style="{StaticResource IslandSettingTitleStyle}" />
                                        <TextBlock Text="Set how long temporary notification cards remain expanded before collapsing back into the island." Style="{StaticResource IslandSettingDescStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="CardStayBox" Grid.Column="1" MinWidth="220" VerticalAlignment="Center" SelectionChanged="OnCardStaySelectionChanged">
                                        <ComboBoxItem Content="Brief (1.0s)" Tag="1s" />
                                        <ComboBoxItem Content="Shorter (2.0s)" Tag="Shorter" />
                                        <ComboBoxItem Content="Usual (3.5s)" Tag="Usual" />
                                        <ComboBoxItem Content="Longer (6.0s)" Tag="Longer" />
                                        <ComboBoxItem Content="Custom" Tag="Custom" />
                                    </ComboBox>
                                </Grid>
                                <StackPanel x:Name="CardStayCustomPanel" Spacing="4" Visibility="Collapsed">
                                    <TextBlock x:Name="CardStayCustomLabel" Text="Custom duration: 4.0 s" FontSize="12" Opacity="0.8" />
                                    <Slider x:Name="CardStayCustomSlider"
                                            Minimum="0.5"
                                            Maximum="30"
                                            StepFrequency="0.5"
                                            TickFrequency="5"
                                            Width="260"
                                            HorizontalAlignment="Left"
                                            ValueChanged="OnCardStayCustomSliderChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Windows Notifications — unavailable without package identity -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}" Opacity="0.72">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Windows Notifications" Style="{StaticResource IslandSettingTitleStyle}" />
                                <TextBlock Style="{StaticResource IslandSettingDescStyle}"
                                           Text="Not available in this build — AppLock runs as an unpackaged app. Package identity (MSIX) is required to listen to Windows notifications." />
                                <HyperlinkButton Content="Open Windows Notification Settings"
                                                 NavigateUri="ms-settings:notifications" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ░░ Controls Tab ░░ -->
                    <StackPanel x:Name="SectionControls" Spacing="8" Visibility="Collapsed">
                        <!-- Close after quick card -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Close Island after running a quick-action card" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Automatically fold the island back down right after you trigger a quick action such as Mute or Lock." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ControlsCloseAfterCardToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Show BT battery card -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Show Bluetooth battery card" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Display a quick card inside the Controls tab listing connected Bluetooth accessories and their battery levels." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ControlsShowBtBatteryCardToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Show BT battery on folded island -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Show connected Bluetooth battery on folded island" Style="{StaticResource IslandSettingTitleStyle}" />
                                        <TextBlock Text="Pin the battery level of your active Bluetooth headset or device directly onto the folded island." Style="{StaticResource IslandSettingDescStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ControlsShowBtBatteryOnIslandToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                                </Grid>
                                <StackPanel Spacing="10" Visibility="{x:Bind ControlsShowBtBatteryOnIslandToggle.IsOn, Mode=OneWay}">
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Show multiple connected devices on folded island" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="Display every connected Bluetooth audio/input device side-by-side (expands folded island width)." Style="{StaticResource IslandSettingDescStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ControlsShowMultipleBtOnIslandToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                                    </Grid>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Folded Bluetooth battery display" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="Choose how Bluetooth battery status is formatted on the folded pill." Style="{StaticResource IslandSettingDescStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="ControlsBtBatteryIslandStyleBox"
                                                  Grid.Column="1"
                                                  MinWidth="240"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="OnSelectionChanged">
                                            <ComboBoxItem Content="Device icon + percentage (e.g. 🎧 100%)" Tag="IconAndPercent" />
                                            <ComboBoxItem Content="Device icon + battery icon (e.g. 🎧 🔋)" Tag="IconAndBattery" />
                                            <ComboBoxItem Content="Device icon + battery + percentage" Tag="IconBatteryAndPercent" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Bluetooth battery warning notifications -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Bluetooth battery warning notifications" Style="{StaticResource IslandSettingTitleStyle}" />
                                        <TextBlock Text="Trigger a low-battery warning card when a connected Bluetooth device drops below your chosen thresholds." Style="{StaticResource IslandSettingDescStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ControlsBtLowBatteryAlertToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                                </Grid>
                                <StackPanel Spacing="10" Visibility="{x:Bind ControlsBtLowBatteryAlertToggle.IsOn, Mode=OneWay}">
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Warning levels (% below)" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="Comma-separated battery percentages at which an alert fires as the device discharges." Style="{StaticResource IslandSettingDescStyle}" />
                                        </StackPanel>
                                        <TextBox x:Name="ControlsBtWarningLevelsBox"
                                                 Grid.Column="1"
                                                 Width="220"
                                                 VerticalAlignment="Center"
                                                 PlaceholderText="e.g. 80, 50, 20, 10"
                                                 TextChanged="OnBtWarningLevelsChanged" />
                                    </Grid>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Also show in Windows notifications" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="Send a Windows system tray toast in addition to the island warning card." Style="{StaticResource IslandSettingDescStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ControlsBtWarningWindowsNotificationToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Brightness slider -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Show Brightness slider" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Include a screen brightness slider inside the Controls tab." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ControlsShowBrightnessToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Microphone control -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Show Microphone control" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Include a system-wide microphone mute/unmute control and input level slider in Controls." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ControlsShowMicrophoneToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Power buttons row -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Show Power buttons row" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Display Lock, Sleep, Restart, and Shut down quick-action buttons at the bottom of Controls." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ControlsShowPowerRowToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Reset Quick Cards -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Quick Cards Layout" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Restore all quick-action tiles in the Controls tab back to their default order and visibility." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <Button x:Name="ControlsResetCardsBtn"
                                        Grid.Column="1"
                                        Content="Reset to Defaults"
                                        VerticalAlignment="Center"
                                        Click="ControlsResetCardsBtn_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ░░ Weather ░░ -->
                    <StackPanel x:Name="SectionWeather" Spacing="8" Visibility="Collapsed">
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Search &amp; Set City" Style="{StaticResource IslandSettingTitleStyle}" />
                                        <TextBlock Text="Search for a city and pick a result to add it and make it your active weather location."
                                                   Style="{StaticResource IslandSettingDescStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBox x:Name="WeatherCityBox" Width="210" PlaceholderText="e.g. London, Tokyo" KeyDown="WeatherCityBox_KeyDown" />
                                        <Button x:Name="WeatherSearchBtn" Content="Search" Style="{StaticResource AccentButtonStyle}" Click="WeatherSearchBtn_Click" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="WeatherCityStatus" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                                <StackPanel x:Name="WeatherSearchResultsList" Spacing="6" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Saved Cities" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Switch your active weather city or remove cities you no longer need. Changes sync in real time with Window Island."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="SettingsWeatherCitiesList" Spacing="6" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Units" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Switch between Celsius / meters-per-second and Fahrenheit / miles-per-hour."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="WeatherUnitsBox" Grid.Column="1" MinWidth="220" VerticalAlignment="Center" SelectionChanged="OnSelectionChanged">
                                    <ComboBoxItem Content="Metric (°C · m/s)" Tag="metric" />
                                    <ComboBoxItem Content="Imperial (°F · mph)" Tag="imperial" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Warn about rain and snow" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Pop up an alert card roughly one hour before rain or snow is expected at your location."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="WeatherRainWarningToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ░░ Chat ░░ -->
                    <StackPanel x:Name="SectionChat" Spacing="8" Visibility="Collapsed">
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="AI Assistants" Style="{StaticResource IslandSettingTitleStyle}" />
                                <TextBlock Text="Embedded web AI assistants (Gemini, DeepSeek, ChatGPT, and custom sites). Logins persist in your local user data folder."
                                           Style="{StaticResource IslandSettingDescStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Idle release timeout" Style="{StaticResource IslandSettingTitleStyle}" />
                                        <TextBlock Text="Automatically unload the embedded WebView2 session after this period of inactivity to free RAM."
                                                   Style="{StaticResource IslandSettingDescStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ChatIdleBox" Grid.Column="1" MinWidth="220" VerticalAlignment="Center" SelectionChanged="OnSelectionChanged">
                                        <ComboBoxItem Content="1 minute" Tag="1" />
                                        <ComboBoxItem Content="3 minutes" Tag="3" />
                                        <ComboBoxItem Content="5 minutes (default)" Tag="5" />
                                        <ComboBoxItem Content="10 minutes" Tag="10" />
                                        <ComboBoxItem Content="15 minutes" Tag="15" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="ChatRuntimeStatusText" FontSize="11" Opacity="0.65" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ░░ Search Commands ░░ -->
                    <StackPanel x:Name="SectionSearch" Spacing="12" Visibility="Collapsed">
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Command Bar Hotkey" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Global keyboard shortcut to open or toggle the Command Bar (default: Alt+Space)."
                                               Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <TextBox x:Name="CommandBarHotkeyBox"
                                         Grid.Column="1"
                                         PlaceholderText="Alt+Space"
                                         Width="220"
                                         VerticalAlignment="Center"
                                         TextChanged="OnHotkeyChanged" />
                            </Grid>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Default Command Search Engine" Style="{StaticResource IslandSettingTitleStyle}" />
                                        <TextBlock Text="Choose which search engine opens when you type a plain query in the Command Bar."
                                                   Style="{StaticResource IslandSettingDescStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="DefaultSearchEngineBox"
                                              Grid.Column="1"
                                              MinWidth="200"
                                              VerticalAlignment="Center"
                                              SelectionChanged="OnDefaultSearchEngineChanged">
                                        <ComboBoxItem Content="Google" Tag="google" />
                                        <ComboBoxItem Content="Bing" Tag="bing" />
                                        <ComboBoxItem Content="DuckDuckGo" Tag="duckduckgo" />
                                        <ComboBoxItem Content="Custom" Tag="custom" />
                                    </ComboBox>
                                </Grid>
                                <TextBox x:Name="CustomDefaultSearchUrlBox"
                                         Header="Custom search URL"
                                         PlaceholderText="https://example.com/search?q={query}"
                                         Visibility="Collapsed"
                                         TextChanged="OnCustomDefaultSearchUrlChanged" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Quick Web Searches in Command Bar" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Type @command followed by your search term in the Command Bar (e.g. @youtube nepali music, @github winui, @amazon laptop). You can add custom searches or reset to defaults below."
                                           FontSize="12" Opacity="0.75" TextWrapping="Wrap" />

                                <!-- Add Custom Search Form -->
                                <TextBlock Text="Add New Search Command" FontWeight="Medium" FontSize="12" Margin="0,4,0,0" />
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewSearchCommandBox"
                                             Grid.Column="0"
                                             PlaceholderText="@tag (e.g. @wiki)" />
                                    <TextBox x:Name="NewSearchNameBox"
                                             Grid.Column="1"
                                             PlaceholderText="Name (e.g. Wikipedia)" />
                                    <TextBox x:Name="NewSearchUrlBox"
                                             Grid.Column="2"
                                             PlaceholderText="URL (e.g. https://en.wikipedia.org/wiki/Special:Search?search=)" />
                                    <Button x:Name="AddSearchBtn"
                                            Grid.Column="3"
                                            Click="AddSearchBtn_Click"
                                            ToolTipService.ToolTip="Add Search Command">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                                            <TextBlock Text="Add" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="SearchCommandValidationText" FontSize="11" Foreground="#FF6B6B" Visibility="Collapsed" />

                                <!-- Search Commands List Header -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Configured Search Commands" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" />
                                    <Button x:Name="ResetSearchesBtn"
                                            Grid.Column="1"
                                            Content="Reset to Defaults"
                                            FontSize="11"
                                            Padding="8,4"
                                            Click="ResetSearchesBtn_Click" />
                                </Grid>

                                <Border BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        CornerRadius="6"
                                        MaxHeight="260"
                                        Padding="6">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="SearchCommandsListPanel" Spacing="4" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ░░ Performance ░░ -->
                    <StackPanel x:Name="SectionPerformance" Spacing="8" Visibility="Collapsed">
                        <!-- Lite mode -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Lite mode" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Use fewer visual effects (solid background, 120 ms fades) to minimize GPU and CPU usage." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="LiteModeToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Reduced motion -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Reduced motion" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Switch to fast 80 ms transitions and disable animated equalizers for a calmer, snappier feel." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ReducedMotionToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Hide from screenshots & recordings -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Hide island from screenshots and screen recordings" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Exclude the island window from screen capture tools, streams, and screenshots. Turn off if your recording software flags capture protection." Style="{StaticResource IslandSettingDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ExcludeFromCaptureToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Opening duration -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Opening Animation Duration (ms)" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Control how quickly the island expands when hovered or triggered." Style="{StaticResource IslandSettingDescStyle}" />
                                    <TextBlock x:Name="AnimationDurationLabelText" FontSize="12" Opacity="0.7" />
                                </StackPanel>
                                <Slider x:Name="AnimationDurationSlider" Grid.Column="1" Width="240" VerticalAlignment="Center"
                                        Minimum="80" Maximum="1000" StepFrequency="20" TickFrequency="100"
                                        ValueChanged="OnDelaySliderChanged" />
                            </Grid>
                        </Border>

                        <!-- Closing duration -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Closing Animation Duration (ms)" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Control how quickly the island folds back into its compact pill." Style="{StaticResource IslandSettingDescStyle}" />
                                    <TextBlock x:Name="CloseAnimationDurationLabelText" FontSize="12" Opacity="0.7" />
                                </StackPanel>
                                <Slider x:Name="CloseAnimationDurationSlider" Grid.Column="1" Width="240" VerticalAlignment="Center"
                                        Minimum="80" Maximum="1000" StepFrequency="20" TickFrequency="100"
                                        ValueChanged="OnDelaySliderChanged" />
                            </Grid>
                        </Border>

                        <!-- Hover open delay -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Hover Open Delay (ms)" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="How long the cursor must rest over the folded island before it automatically opens." Style="{StaticResource IslandSettingDescStyle}" />
                                    <TextBlock x:Name="OpenDelayLabelText" FontSize="12" Opacity="0.7" />
                                </StackPanel>
                                <Slider x:Name="OpenDelaySlider" Grid.Column="1" Width="240" VerticalAlignment="Center"
                                        Minimum="0" Maximum="600" StepFrequency="25" TickFrequency="50"
                                        ValueChanged="OnDelaySliderChanged" />
                            </Grid>
                        </Border>

                        <!-- Hover close delay -->
                        <Border Style="{StaticResource IslandSettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Hover Close Delay (ms)" Style="{StaticResource IslandSettingTitleStyle}" />
                                    <TextBlock Text="Grace period after your cursor leaves the expanded island before it folds shut." Style="{StaticResource IslandSettingDescStyle}" />
                                    <TextBlock x:Name="CloseDelayLabelText" FontSize="12" Opacity="0.7" />
                                </StackPanel>
                                <Slider x:Name="CloseDelaySlider" Grid.Column="1" Width="240" VerticalAlignment="Center"
                                        Minimum="0" Maximum="1500" StepFrequency="50" TickFrequency="100"
                                        ValueChanged="OnDelaySliderChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ░░ About & Developer ░░ -->
                    <StackPanel x:Name="SectionAbout" Spacing="16" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Network &amp; Privacy Summary" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="• MET Norway: Weather forecasts queried from api.met.no&#x0a;• OpenStreetMap Nominatim: City location search queried from nominatim.openstreetmap.org&#x0a;• Chat Tab: Selected AI assistants run directly in sandboxed WebView2&#x0a;• Shortcuts Bar: Favicon icons downloaded directly for pinned web links&#x0a;• Zero Telemetry: No analytics, tracking or crash data is transmitted&#x0a;• 100% Local Storage: All notes, history, shelf and caches stay in %LOCALAPPDATA%\AppLock\island\"
                                           FontSize="12"
                                           Opacity="0.8"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="Credits &amp; Open-Source Licenses" FontWeight="SemiBold" FontSize="13" Margin="0,6,0,0" />
                                <TextBlock Text="• ZXing.Net (Apache License 2.0) — QR code generation&#x0a;• MET Norway Weather API (CC BY 4.0) — Forecast data&#x0a;• OpenStreetMap contributors (ODbL) — Geocoding data&#x0a;• Microsoft Windows App SDK &amp; WinUI 3 (MIT License)"
                                           FontSize="12"
                                           Opacity="0.8"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Developer Tools" FontWeight="SemiBold" FontSize="13" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Show live frame-time &amp; FPS overlay on the island" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="Display real-time rendering frame rate and composition timing on the island for diagnostics."
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="FrameStatsToggle"
                                                  Grid.Column="1"
                                                  OnContent=""
                                                  OffContent=""
                                                  MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Toggled="OnSettingChanged" />
                                </Grid>

                                <Button x:Name="RunBenchmarkBtn"
                                        Content="Run Animation Benchmark (Cycles: 50 open/close)"
                                        Click="RunBenchmarkBtn_Click" />

                                <TextBlock x:Name="BenchmarkResultText"
                                           Text="No benchmark executed in this session."
                                           FontSize="12"
                                           Opacity="0.7"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
