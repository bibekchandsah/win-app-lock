                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Developer Tools" FontWeight="SemiBold" FontSize="13" />
                                <ToggleSwitch x:Name="FrameStatsToggle"
