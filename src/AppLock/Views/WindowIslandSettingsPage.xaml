<Page
    x:Class="AppLock.Views.WindowIslandSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Window Island" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="A native WinUI 3 notch at the top of the screen drawn with the Composition API — clock, battery and quick controls, animated with springs."
                TextWrapping="Wrap"
                Opacity="0.7" />

            <InfoBar
                x:Name="ComingSoonBar"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Coming soon"
                Message="Window Island is under development. Enable the toggle to reserve the setting; the native notch will appear in a future milestone." />

            <ToggleSwitch
                x:Name="EnabledToggle"
                Header="Enable Window Island"
                Toggled="OnSettingChanged" />

            <ComboBox x:Name="PositionBox" Header="Position" SelectionChanged="OnSelectionChanged" Width="240">
                <ComboBoxItem Content="Top center" Tag="TopCenter" />
                <ComboBoxItem Content="Top left" Tag="TopLeft" />
                <ComboBoxItem Content="Top right" Tag="TopRight" />
            </ComboBox>

            <ComboBox x:Name="ShapeBox" Header="Shape" SelectionChanged="OnSelectionChanged" Width="240">
                <ComboBoxItem Content="Notch (flush with screen edge)" Tag="Notch" />
                <ComboBoxItem Content="Capsule (floating pill)" Tag="Capsule" />
            </ComboBox>

            <ComboBox x:Name="ThemeBox" Header="Theme" SelectionChanged="OnSelectionChanged" Width="240">
                <ComboBoxItem Content="System default" Tag="System" />
                <ComboBoxItem Content="Light" Tag="Light" />
                <ComboBoxItem Content="Dark" Tag="Dark" />
            </ComboBox>

            <StackPanel Spacing="4">
                <TextBlock Text="Size" Opacity="0.7" FontSize="12"/>
                <Slider x:Name="SizeSlider" Minimum="60" Maximum="150" TickFrequency="10"
                        ValueChanged="OnSliderChanged" Width="300" HorizontalAlignment="Left"/>
                <TextBlock x:Name="SizeLabelText" FontSize="12" Opacity="0.6"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Opacity" Opacity="0.7" FontSize="12"/>
                <Slider x:Name="OpacitySlider" Minimum="40" Maximum="100" TickFrequency="5"
                        ValueChanged="OnSliderChanged" Width="300" HorizontalAlignment="Left"/>
                <TextBlock x:Name="OpacityLabelText" FontSize="12" Opacity="0.6"/>
            </StackPanel>

            <ToggleSwitch x:Name="ShowClockToggle" Header="Show clock" Toggled="OnSettingChanged" />
            <ToggleSwitch x:Name="ShowBatteryToggle" Header="Show battery" Toggled="OnSettingChanged" />

        </StackPanel>
    </ScrollViewer>
</Page>
