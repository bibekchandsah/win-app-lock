<Page
    x:Class="AppLock.Views.WindowIslandSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CategoryListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
    </Page.Resources>

    <Grid Padding="24,20,24,24" RowSpacing="14" MaxWidth="1120" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Breadcrumb and header -->
        <StackPanel Grid.Row="0" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackButton"
                        Click="BackButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Others"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="›"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Window Island"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="Window Island" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="A native WinUI 3 notch at the top of the screen drawn with the Composition API — clock, battery and quick controls on an independent, lag-free UI thread."
                    TextWrapping="Wrap"
                    Opacity="0.7" />
            </StackPanel>
        </StackPanel>

        <!-- Category rail + settings content -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Settings"
                               FontSize="11"
                               Margin="10,8,10,6"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListView x:Name="CategoryList"
                                  SelectionMode="Single"
                                  SelectionChanged="CategoryList_SelectionChanged"
                                  ItemContainerStyle="{StaticResource CategoryListItemStyle}"
                                  AutomationProperties.Name="Window Island settings categories">
                            <ListViewItem Tag="general">
                                <TextBlock Text="General" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="appearance">
                                <TextBlock Text="Appearance" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="visibility">
                                <TextBlock Text="Visibility" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="indicators">
                                <TextBlock Text="Notch Indicators" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="media">
                                <TextBlock Text="Media &amp; Lyrics" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="cards">
                                <TextBlock Text="Event Cards" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="controls">
                                <TextBlock Text="Controls Tab" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="weather">
                                <TextBlock Text="Weather" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="chat">
                                <TextBlock Text="Chat" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="search">
                                <TextBlock Text="Search Commands" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="performance">
                                <TextBlock Text="Performance" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="about">
                                <TextBlock Text="About &amp; Developer" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                        </ListView>
                    </ScrollViewer>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ContentScroller"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">

                    <!-- ░░ General ░░ -->
                    <StackPanel x:Name="SectionGeneral" Spacing="16">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Enable Window Island" FontWeight="SemiBold" />
                                    <TextBlock Text="Runs a hardware-accelerated dynamic bar pinned to the top of your screen"
                                               FontSize="12" Opacity="0.6" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              x:Name="EnabledToggle"
                                              Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Global hotkey" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Global hotkey to toggle Window Island" Opacity="0.7" FontSize="12"/>
                            <TextBox x:Name="HotkeyBox" Width="260" HorizontalAlignment="Left" TextChanged="OnHotkeyChanged" />
                            <TextBlock Text="Default: Ctrl+Shift+W" FontSize="11" Opacity="0.5" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ░░ Appearance ░░ -->
                    <StackPanel x:Name="SectionAppearance" Spacing="14" Visibility="Collapsed">
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="ShapeBox" Grid.Column="0" Header="Shape" SelectionChanged="OnSelectionChanged" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Notch (flush with screen edge)" Tag="Notch" />
                                <ComboBoxItem Content="Capsule (floating pill)" Tag="Capsule" />
                            </ComboBox>

                            <ComboBox x:Name="PositionBox" Grid.Column="1" Header="Position" SelectionChanged="OnSelectionChanged" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Top center" Tag="TopCenter" />
                                <ComboBoxItem Content="Top left" Tag="TopLeft" />
                                <ComboBoxItem Content="Top right" Tag="TopRight" />
                            </ComboBox>
                        </Grid>

                        <ComboBox x:Name="ThemeBox" Header="Theme" SelectionChanged="OnSelectionChanged" Width="260">
                            <ComboBoxItem Content="System default" Tag="System" />
                            <ComboBoxItem Content="Light" Tag="Light" />
                            <ComboBoxItem Content="Dark" Tag="Dark" />
                        </ComboBox>

                        <ComboBox x:Name="IslandColorBox" Header="Island Color" SelectionChanged="OnSelectionChanged" Width="260">
                            <ComboBoxItem Content="Default (Auto black/white)" Tag="Default" />
                            <ComboBoxItem Content="Dark Navy" Tag="Navy" />
                            <ComboBoxItem Content="Deep Indigo" Tag="Indigo" />
                            <ComboBoxItem Content="Forest Green" Tag="Green" />
                            <ComboBoxItem Content="Rich Maroon" Tag="Maroon" />
                            <ComboBoxItem Content="Warm Brown" Tag="Brown" />
                            <ComboBoxItem Content="Soft Cream" Tag="Cream" />
                            <ComboBoxItem Content="Fresh Mint" Tag="Mint" />
                            <ComboBoxItem Content="Gentle Lavender" Tag="Lavender" />
                        </ComboBox>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Size Scale" Opacity="0.7" FontSize="12"/>
                            <Slider x:Name="SizeSlider" Width="320" HorizontalAlignment="Left"
                                    ValueChanged="OnSliderChanged" />
                            <TextBlock x:Name="SizeLabelText" FontSize="12" Opacity="0.6"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Background Opacity (Transparency)" Opacity="0.7" FontSize="12"/>
                            <Slider x:Name="OpacitySlider" Width="320" HorizontalAlignment="Left"
                                    ValueChanged="OnSliderChanged" />
                            <TextBlock x:Name="OpacityLabelText" FontSize="12" Opacity="0.6"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Vertical Offset (DIPs)" Opacity="0.7" FontSize="12"/>
                            <Slider x:Name="YOffsetSlider" Width="320" HorizontalAlignment="Left"
                                    ValueChanged="OnSliderChanged" />
                            <TextBlock x:Name="YOffsetLabelText" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ░░ Visibility ░░ -->
                    <StackPanel x:Name="SectionVisibility" Spacing="10" Visibility="Collapsed">
                        <ToggleSwitch x:Name="HideInFullScreenToggle"
                                      Header="Hide in full-screen apps (games, video, presentations)"
                                      Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="EdgeDwellToggle"
                                      Header="Come out over full-screen apps when cursor rests at top edge (500 ms dwell)"
                                      Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="AutoHideToggle"
                                      Header="Auto-hide island until needed (slides off-screen)"
                                      Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="AutoHideStayOnDesktopToggle"
                                      Header="Stay in sight on desktop (when Windows desktop is foreground)"
                                      Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="AutoHideOnlyWhenOverlappedToggle"
                                      Header="Hide only while a window is under the island"
                                      Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="UnderTopTaskbarToggle"
                                      Header="Place under the taskbar when it is docked at the top"
                                      Toggled="OnSettingChanged" />
                        <ComboBox x:Name="TargetMonitorBox" Header="Show on monitor" SelectionChanged="OnSelectionChanged" Width="260">
                            <ComboBoxItem Content="Primary monitor" Tag="Primary" />
                            <ComboBoxItem Content="Monitor with cursor" Tag="Cursor" />
                        </ComboBox>
                        <ComboBox x:Name="ChosenAppsModeBox" Header="Chosen apps rule" SelectionChanged="OnSelectionChanged" Width="260">
                            <ComboBoxItem Content="Disabled" Tag="Disabled" />
                            <ComboBoxItem Content="Hide while one is in front" Tag="Hide" />
                            <ComboBoxItem Content="Only show while one is in front (Keep)" Tag="Keep" />
                        </ComboBox>
                        <TextBox x:Name="ChosenAppsBox"
                                 Header="Chosen process names (comma-separated, e.g. chrome, notepad)"
                                 Width="360"
                                 HorizontalAlignment="Left"
                                 TextChanged="OnChosenAppsChanged" />
                    </StackPanel>

                    <!-- ░░ Notch Indicators ░░ -->
                    <StackPanel x:Name="SectionIndicators" Spacing="10" Visibility="Collapsed">
                        <ToggleSwitch x:Name="ShowClockToggle" Header="Show clock" Toggled="OnSettingChanged" />
                        <StackPanel Margin="28,0,0,0" Spacing="8" Visibility="{x:Bind ShowClockToggle.IsOn, Mode=OneWay}">
                            <CheckBox x:Name="TimeFormat24HCheck" Content="24-hour format (e.g. 14:30 vs 2:30 PM)" Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
                            <CheckBox x:Name="ShowSecondsCheck" Content="Show seconds" Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
                        </StackPanel>

                        <ToggleSwitch x:Name="ShowBatteryToggle" Header="Show battery percentage &amp; status" Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="WeatherTempOnIslandToggle" Header="Show temperature on folded island" Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="MicCamDotsToggle" Header="Mic / camera indicator dots on folded island" Toggled="OnSettingChanged" />
                    </StackPanel>

                    <!-- ░░ Media & Lyrics ░░ -->
                    <StackPanel x:Name="SectionMedia" Spacing="10" Visibility="Collapsed">
                        <ToggleSwitch x:Name="LyricsToggle"
                                      Header="Show lyrics beside the player"
                                      Toggled="OnSettingChanged" />
                        <TextBlock Text="When the playing track has lyrics they appear next to the player card on the Home tab. Turn this off to keep the player at full width and skip the lyrics lookup."
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" MaxWidth="560"/>
                    </StackPanel>

                    <!-- ░░ Event Cards ░░ -->
                    <StackPanel x:Name="SectionCards" Spacing="10" Visibility="Collapsed">
                        <ToggleSwitch x:Name="CardCapsLockToggle" Header="Caps Lock on/off notification" Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="CardNumLockToggle" Header="Num Lock on/off notification" Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="CardDeleteKeyWarningToggle" Header="Delete key press warning" Toggled="OnSettingChanged" />
                        <TextBox x:Name="CardCustomKeyWarningsBox"
                                 Width="360"
                                 HorizontalAlignment="Left"
                                 Header="Custom key warnings (comma-separated)"
                                 PlaceholderText="e.g. Insert, PrintScreen, F12"
                                 TextChanged="OnCustomKeyWarningsChanged" />
                        <ToggleSwitch x:Name="CardVolumeToggle" Header="Volume adjustments (+ mouse wheel)" Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="CardClipboardToggle" Header="Clipboard copy (text and images)" Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="CardScreenshotToggle" Header="Screenshot saved alert" Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="CardVpnToggle" Header="VPN connect / disconnect" Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="CardBatteryLowToggle" Header="Low battery alert (20 %, 10 %, 5 %)" Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="CardChargingToggle" Header="Charger plugged / unplugged" Toggled="OnSettingChanged" />

                        <ComboBox x:Name="CardStayBox" Header="Card display duration" SelectionChanged="OnSelectionChanged" Width="260">
                            <ComboBoxItem Content="Shorter (2.0s)" Tag="Shorter" />
                            <ComboBoxItem Content="Usual (3.5s)" Tag="Usual" />
                            <ComboBoxItem Content="Longer (6.0s)" Tag="Longer" />
                        </ComboBox>

                        <!-- Windows Notifications — unavailable without package identity -->
                        <StackPanel Spacing="4" Opacity="0.55">
                            <TextBlock Text="Windows Notifications" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Text="Not available in this build — AppLock runs as an unpackaged app. Package identity (MSIX) is required to listen to Windows notifications." />
                            <HyperlinkButton Content="Open Windows Notification Settings"
                                             NavigateUri="ms-settings:notifications" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ░░ Controls Tab ░░ -->
                    <StackPanel x:Name="SectionControls" Spacing="10" Visibility="Collapsed">
                        <ToggleSwitch x:Name="ControlsCloseAfterCardToggle"
                                      Header="Close Island after running a quick-action card"
                                      Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="ControlsShowBtBatteryCardToggle"
                                      Header="Show Bluetooth battery card"
                                      Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="ControlsShowBtBatteryOnIslandToggle"
                                      Header="Show connected Bluetooth battery on folded island"
                                      Toggled="OnSettingChanged" />
                        <StackPanel Margin="28,0,0,0" Spacing="10" Visibility="{x:Bind ControlsShowBtBatteryOnIslandToggle.IsOn, Mode=OneWay}">
                            <ToggleSwitch x:Name="ControlsShowMultipleBtOnIslandToggle"
                                          Header="Show multiple connected devices on folded island (expands width)"
                                          Toggled="OnSettingChanged" />
                            <ComboBox x:Name="ControlsBtBatteryIslandStyleBox"
                                      Header="Folded Bluetooth battery display"
                                      SelectionChanged="OnSelectionChanged"
                                      Width="280">
                                <ComboBoxItem Content="Device icon + percentage (e.g. 🎧 100%)" Tag="IconAndPercent" />
                                <ComboBoxItem Content="Device icon + battery icon (e.g. 🎧 🔋)" Tag="IconAndBattery" />
                                <ComboBoxItem Content="Device icon + battery + percentage" Tag="IconBatteryAndPercent" />
                            </ComboBox>
                        </StackPanel>
                        <ToggleSwitch x:Name="ControlsBtLowBatteryAlertToggle"
                                      Header="Bluetooth battery warning notifications"
                                      Toggled="OnSettingChanged" />
                        <StackPanel Margin="28,0,0,0" Spacing="10" Visibility="{x:Bind ControlsBtLowBatteryAlertToggle.IsOn, Mode=OneWay}">
                            <TextBox x:Name="ControlsBtWarningLevelsBox"
                                     Width="280"
                                     HorizontalAlignment="Left"
                                     Header="Warning levels (% below, comma-separated)"
                                     PlaceholderText="e.g. 80, 50, 20, 10"
                                     TextChanged="OnBtWarningLevelsChanged" />
                            <ToggleSwitch x:Name="ControlsBtWarningWindowsNotificationToggle"
                                          Header="Also show in Windows notifications"
                                          Toggled="OnSettingChanged" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ControlsShowBrightnessToggle"
                                      Header="Show Brightness slider"
                                      Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="ControlsShowMicrophoneToggle"
                                      Header="Show Microphone control"
                                      Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="ControlsShowPowerRowToggle"
                                      Header="Show Power buttons row (Lock, Sleep, Restart, Shut down)"
                                      Toggled="OnSettingChanged" />
                        <Button x:Name="ControlsResetCardsBtn"
                                Content="Reset Quick Cards to Defaults"
                                Click="ControlsResetCardsBtn_Click" />
                    </StackPanel>

                    <!-- ░░ Weather ░░ -->
                    <StackPanel x:Name="SectionWeather" Spacing="10" Visibility="Collapsed">
                        <TextBlock Text="Configured City" Opacity="0.7" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="WeatherCityBox" Width="260" PlaceholderText="e.g. London, Tokyo, New York" />
                            <Button x:Name="WeatherSearchBtn" Content="Set City" Click="WeatherSearchBtn_Click" />
                        </StackPanel>
                        <TextBlock x:Name="WeatherCityStatus" FontSize="11" Opacity="0.6"/>

                        <ComboBox x:Name="WeatherUnitsBox" Header="Units" SelectionChanged="OnSelectionChanged" Width="260">
                            <ComboBoxItem Content="Metric (°C · m/s)" Tag="metric" />
                            <ComboBoxItem Content="Imperial (°F · mph)" Tag="imperial" />
                        </ComboBox>

                        <ToggleSwitch x:Name="WeatherRainWarningToggle" Header="Warn about rain and snow (card ~1h before)" Toggled="OnSettingChanged" />
                    </StackPanel>

                    <!-- ░░ Chat ░░ -->
                    <StackPanel x:Name="SectionChat" Spacing="10" Visibility="Collapsed">
                        <TextBlock Text="Embedded web AI assistants (Gemini, DeepSeek, ChatGPT, and custom sites). Logins persist in local user data folder."
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" />

                        <ComboBox x:Name="ChatIdleBox" Header="Idle release timeout" SelectionChanged="OnSelectionChanged" Width="260">
                            <ComboBoxItem Content="1 minute" Tag="1" />
                            <ComboBoxItem Content="3 minutes" Tag="3" />
                            <ComboBoxItem Content="5 minutes (default)" Tag="5" />
                            <ComboBoxItem Content="10 minutes" Tag="10" />
                            <ComboBoxItem Content="15 minutes" Tag="15" />
                        </ComboBox>

                        <TextBlock x:Name="ChatRuntimeStatusText" FontSize="11" Opacity="0.6" />
                    </StackPanel>

                    <!-- ░░ Search Commands ░░ -->
                    <StackPanel x:Name="SectionSearch" Spacing="12" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Default Command Search Engine" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Choose which search engine opens when you type a plain query in the Command Bar."
                                           FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                                <ComboBox x:Name="DefaultSearchEngineBox"
                                          Header="Search engine"
                                          Width="220"
                                          SelectionChanged="OnDefaultSearchEngineChanged">
                                    <ComboBoxItem Content="Google" Tag="google" />
                                    <ComboBoxItem Content="Bing" Tag="bing" />
                                    <ComboBoxItem Content="DuckDuckGo" Tag="duckduckgo" />
                                    <ComboBoxItem Content="Custom" Tag="custom" />
                                </ComboBox>
                                <TextBox x:Name="CustomDefaultSearchUrlBox"
                                         Header="Custom search URL"
                                         PlaceholderText="https://example.com/search?q={query}"
                                         Visibility="Collapsed"
                                         TextChanged="OnCustomDefaultSearchUrlChanged" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Quick Web Searches in Command Bar" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Type @command followed by your search term in the Command Bar (e.g. @youtube nepali music, @github winui, @amazon laptop). You can add custom searches or reset to defaults below."
                                           FontSize="12" Opacity="0.75" TextWrapping="Wrap" />

                                <!-- Add Custom Search Form -->
                                <TextBlock Text="Add New Search Command" FontWeight="Medium" FontSize="12" Margin="0,4,0,0" />
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewSearchCommandBox"
                                             Grid.Column="0"
                                             PlaceholderText="@tag (e.g. @wiki)" />
                                    <TextBox x:Name="NewSearchNameBox"
                                             Grid.Column="1"
                                             PlaceholderText="Name (e.g. Wikipedia)" />
                                    <TextBox x:Name="NewSearchUrlBox"
                                             Grid.Column="2"
                                             PlaceholderText="URL (e.g. https://en.wikipedia.org/wiki/Special:Search?search=)" />
                                    <Button x:Name="AddSearchBtn"
                                            Grid.Column="3"
                                            Click="AddSearchBtn_Click"
                                            ToolTipService.ToolTip="Add Search Command">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                                            <TextBlock Text="Add" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="SearchCommandValidationText" FontSize="11" Foreground="#FF6B6B" Visibility="Collapsed" />

                                <!-- Search Commands List Header -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Configured Search Commands" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" />
                                    <Button x:Name="ResetSearchesBtn"
                                            Grid.Column="1"
                                            Content="Reset to Defaults"
                                            FontSize="11"
                                            Padding="8,4"
                                            Click="ResetSearchesBtn_Click" />
                                </Grid>

                                <Border BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        CornerRadius="6"
                                        MaxHeight="260"
                                        Padding="6">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="SearchCommandsListPanel" Spacing="4" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ░░ Performance ░░ -->
                    <StackPanel x:Name="SectionPerformance" Spacing="10" Visibility="Collapsed">
                        <ToggleSwitch x:Name="LiteModeToggle"
                                      Header="Lite mode — fewer effects (solid background, 120 ms fades, low CPU)"
                                      Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="ReducedMotionToggle"
                                      Header="Reduced motion (80 ms fast transitions, skip equalizers)"
                                      Toggled="OnSettingChanged" />
                        <ToggleSwitch x:Name="ExcludeFromCaptureToggle"
                                      Header="Hide island from screenshots and screen recordings"
                                      Toggled="OnSettingChanged" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Hover Open Delay (ms)" Opacity="0.7" FontSize="12"/>
                            <Slider x:Name="OpenDelaySlider" Width="320" HorizontalAlignment="Left"
                                    Minimum="0" Maximum="600" StepFrequency="25" TickFrequency="50"
                                    ValueChanged="OnDelaySliderChanged" />
                            <TextBlock x:Name="OpenDelayLabelText" FontSize="12" Opacity="0.6"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Hover Close Delay (ms)" Opacity="0.7" FontSize="12"/>
                            <Slider x:Name="CloseDelaySlider" Width="320" HorizontalAlignment="Left"
                                    Minimum="0" Maximum="1500" StepFrequency="50" TickFrequency="100"
                                    ValueChanged="OnDelaySliderChanged" />
                            <TextBlock x:Name="CloseDelayLabelText" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ░░ About & Developer ░░ -->
                    <StackPanel x:Name="SectionAbout" Spacing="16" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Network &amp; Privacy Summary" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="• MET Norway: Weather forecasts queried from api.met.no&#x0a;• OpenStreetMap Nominatim: City location search queried from nominatim.openstreetmap.org&#x0a;• Chat Tab: Selected AI assistants run directly in sandboxed WebView2&#x0a;• Shortcuts Bar: Favicon icons downloaded directly for pinned web links&#x0a;• Zero Telemetry: No analytics, tracking or crash data is transmitted&#x0a;• 100% Local Storage: All notes, history, shelf and caches stay in %LOCALAPPDATA%\AppLock\island\"
                                           FontSize="12"
                                           Opacity="0.8"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="Credits &amp; Open-Source Licenses" FontWeight="SemiBold" FontSize="13" Margin="0,6,0,0" />
                                <TextBlock Text="• ZXing.Net (Apache License 2.0) — QR code generation&#x0a;• MET Norway Weather API (CC BY 4.0) — Forecast data&#x0a;• OpenStreetMap contributors (ODbL) — Geocoding data&#x0a;• Microsoft Windows App SDK &amp; WinUI 3 (MIT License)"
                                           FontSize="12"
                                           Opacity="0.8"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
