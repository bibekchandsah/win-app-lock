<Page
    x:Class="AppLock.Views.WindowIslandSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CategoryListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
    </Page.Resources>

    <Grid Padding="24,20,24,24" RowSpacing="14" MaxWidth="1120" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Breadcrumb and header -->
        <StackPanel Grid.Row="0" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackButton"
                        Click="BackButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Others"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="›"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Window Island"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="Window Island" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="A native WinUI 3 notch at the top of the screen drawn with the Composition API — clock, battery and quick controls on an independent, lag-free UI thread."
                    TextWrapping="Wrap"
                    Opacity="0.7" />
            </StackPanel>
        </StackPanel>

        <!-- Category rail + settings content -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Settings"
                               FontSize="11"
                               Margin="10,8,10,6"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListView x:Name="CategoryList"
                                  SelectionMode="Single"
                                  SelectionChanged="CategoryList_SelectionChanged"
                                  ItemContainerStyle="{StaticResource CategoryListItemStyle}"
                                  AutomationProperties.Name="Window Island settings categories">
                            <ListViewItem Tag="general">
                                <TextBlock Text="General" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="appearance">
                                <TextBlock Text="Appearance" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="visibility">
                                <TextBlock Text="Visibility" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="indicators">
                                <TextBlock Text="Notch Indicators" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="clock">
                                <TextBlock Text="Clock &amp; Calendar" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="media">
                                <TextBlock Text="Media &amp; Lyrics" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="cards">
                                <TextBlock Text="Event Cards" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="controls">
                                <TextBlock Text="Controls Tab" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="weather">
                                <TextBlock Text="Weather" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="chat">
                                <TextBlock Text="Chat" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="search">
                                <TextBlock Text="Search Commands" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="performance">
                                <TextBlock Text="Performance" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                            <ListViewItem Tag="about">
                                <TextBlock Text="About &amp; Developer" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </ListViewItem>
                        </ListView>
                    </ScrollViewer>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ContentScroller"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">

                    <!-- ░░ General ░░ -->
                    <StackPanel x:Name="SectionGeneral" Spacing="16">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Enable Window Island" FontWeight="SemiBold" />
                                    <TextBlock Text="Runs a hardware-accelerated dynamic bar pinned to the top of your screen"
                                               FontSize="12" Opacity="0.6" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              x:Name="EnabledToggle"
                                              Toggled="OnSettingChanged" />
                            </Grid>
                        </Border>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Global hotkey" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Global hotkey to toggle Window Island" Opacity="0.7" FontSize="12"/>
                            <TextBox x:Name="HotkeyBox" Width="260" HorizontalAlignment="Left" TextChanged="OnHotkeyChanged" />
                            <TextBlock Text="Default: Ctrl+Shift+W" FontSize="11" Opacity="0.5" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Screenshot save folder" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Folder where Home tab &quot;Full screen&quot; screenshots and saved QR codes are stored"
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="ScreenshotsFolderBox"
                                         Width="360"
                                         TextChanged="OnScreenshotsFolderChanged" />
                                <Button x:Name="ScreenshotsFolderBrowseBtn"
                                        Content="Browse…"
                                        Click="ScreenshotsFolderBrowseBtn_Click" />
                                <Button x:Name="ScreenshotsFolderResetBtn"
                                        Content="Reset"
                                        Click="ScreenshotsFolderResetBtn_Click" />
                            </StackPanel>
                            <TextBlock x:Name="ScreenshotsDefaultPathText" FontSize="11" Opacity="0.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ░░ Appearance ░░ -->
                    <StackPanel x:Name="SectionAppearance" Spacing="14" Visibility="Collapsed">
                        <Grid ColumnSpacing="16" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ComboBox x:Name="ShapeBox" Grid.Column="0" Grid.Row="0" Header="Shape" SelectionChanged="OnSelectionChanged" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Notch (flush with screen edge)" Tag="Notch" />
                                <ComboBoxItem Content="Capsule (floating pill)" Tag="Capsule" />
                            </ComboBox>
                            <TextBlock Grid.Column="0" Grid.Row="1"
                                       Text="Notch attaches flush to the top screen edge; Capsule floats as a rounded pill."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                            <ComboBox x:Name="PositionBox" Grid.Column="1" Grid.Row="0" Header="Position" SelectionChanged="OnSelectionChanged" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Top center" Tag="TopCenter" />
                                <ComboBoxItem Content="Top left" Tag="TopLeft" />
                                <ComboBoxItem Content="Top right" Tag="TopRight" />
                            </ComboBox>
                            <TextBlock Grid.Column="1" Grid.Row="1"
                                       Text="Choose where the folded and expanded island sits along the top of your screen."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </Grid>

                        <StackPanel Spacing="4">
                            <ComboBox x:Name="ThemeBox" Header="Theme" SelectionChanged="OnSelectionChanged" Width="260">
                                <ComboBoxItem Content="System default" Tag="System" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                            </ComboBox>
                            <TextBlock Text="Match your Windows light/dark mode automatically or force a specific island theme."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ComboBox x:Name="IslandColorBox" Header="Island Color" SelectionChanged="OnIslandColorChanged" Width="260">
                                    <ComboBoxItem Content="Default (Auto black/white)" Tag="Default" />
                                    <ComboBoxItem Content="Dark Navy" Tag="Navy" />
                                    <ComboBoxItem Content="Deep Indigo" Tag="Indigo" />
                                    <ComboBoxItem Content="Forest Green" Tag="Green" />
                                    <ComboBoxItem Content="Rich Maroon" Tag="Maroon" />
                                    <ComboBoxItem Content="Warm Brown" Tag="Brown" />
                                    <ComboBoxItem Content="Soft Cream" Tag="Cream" />
                                    <ComboBoxItem Content="Fresh Mint" Tag="Mint" />
                                    <ComboBoxItem Content="Gentle Lavender" Tag="Lavender" />
                                    <ComboBoxItem Content="Custom color" Tag="Custom" />
                                </ComboBox>

                                <StackPanel x:Name="IslandCustomColorPanel"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Bottom"
                                            Visibility="Collapsed">
                                    <Button x:Name="IslandCustomColorButton"
                                            Width="56" Height="32" Padding="3" CornerRadius="4"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            AutomationProperties.Name="Pick custom island color"
                                            ToolTipService.ToolTip="Pick a custom island color">
                                        <Border x:Name="IslandCustomColorSwatch" CornerRadius="3"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                Background="#1E293B"/>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <ColorPicker x:Name="IslandCustomColorPicker"
                                                             Width="300"
                                                             IsAlphaEnabled="False"
                                                             IsAlphaSliderVisible="False"
                                                             IsAlphaTextInputVisible="False"
                                                             IsColorChannelTextInputVisible="False"
                                                             IsHexInputVisible="True"
                                                             IsMoreButtonVisible="False"
                                                             ColorSpectrumShape="Box"
                                                             ColorChanged="IslandCustomColorPicker_ColorChanged"/>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBox x:Name="IslandCustomColorHexBox"
                                             Width="96"
                                             VerticalAlignment="Center"
                                             FontFamily="Consolas"
                                             PlaceholderText="#1E293B"
                                             MaxLength="7"
                                             TextChanged="IslandCustomColorHexBox_TextChanged"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Pick a preset tint or custom hex color for the island background; text contrast adjusts automatically."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Size Scale" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Scale the overall dimensions of the island up or down to fit your screen resolution."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <Slider x:Name="SizeSlider" Width="320" HorizontalAlignment="Left"
                                    ValueChanged="OnSliderChanged" />
                            <TextBlock x:Name="SizeLabelText" FontSize="12" Opacity="0.6"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Background Opacity (Transparency)" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Adjust how translucent or solid the island backdrop appears over open windows."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <Slider x:Name="OpacitySlider" Width="320" HorizontalAlignment="Left"
                                    ValueChanged="OnSliderChanged" />
                            <TextBlock x:Name="OpacityLabelText" FontSize="12" Opacity="0.6"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Vertical Offset (DIPs)" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Nudge the island downward from the top edge in device-independent pixels."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <Slider x:Name="YOffsetSlider" Width="320" HorizontalAlignment="Left"
                                    ValueChanged="OnSliderChanged" />
                            <TextBlock x:Name="YOffsetLabelText" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ░░ Visibility ░░ -->
                    <StackPanel x:Name="SectionVisibility" Spacing="0" Visibility="Collapsed">
                        <!-- Hide in full-screen apps -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Hide in full-screen apps"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Hide the island automatically while games, videos, or presentations are running in full screen."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="HideInFullScreenToggle"
                                          Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Come out over full-screen apps -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Come out over them when the cursor is at the top edge"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Half a second (500 ms) of the cursor at the edge above the island's place and it comes out over the app. Better left off for games: the cursor gets there in their menus, and the game may minimize. The island's hotkeys call it out anyway."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="EdgeDwellToggle"
                                          Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Auto-hide -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Hide the island until it is needed"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="The folded island slides off-screen and stays out of the way of what is under it: browser tabs, window buttons. Rest the cursor at the very top edge above it and it comes back; with a card or hotkey it comes out by itself."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoHideToggle"
                                          Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Stay in sight on desktop -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Stay in sight on the desktop"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="For auto-hide: while the Windows desktop itself is in front, with no program window on it, the island stays in sight."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoHideStayOnDesktopToggle"
                                          Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Hide only when overlapped -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Hide only while a window is under the island"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Keep the island visible when nothing is behind it, and slide it away only while a window overlaps its position."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoHideOnlyWhenOverlappedToggle"
                                          Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Place under top taskbar -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Place under the taskbar when it is docked at the top"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="When the Windows taskbar is docked at the top edge, position the island right below it so nothing overlaps."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="UnderTopTaskbarToggle"
                                          Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Through mode -->
                        <StackPanel Spacing="8" Padding="0,10">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Through mode"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="The folded island lets clicks through and does not open under the cursor: it is in sight and in nobody's way. Hotkeys open it. Turn the mode on and off here, with its own hotkey, or with -through in Alt+Space."
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ThroughModeToggle"
                                              Grid.Column="1"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center"
                                              Toggled="OnSettingChanged" />
                            </Grid>
                            <TextBox x:Name="ThroughModeHotkeyBox"
                                     Header="Through mode hotkey"
                                     PlaceholderText="e.g. Ctrl+Shift+T (optional)"
                                     Width="260"
                                     HorizontalAlignment="Left"
                                     TextChanged="OnHotkeyChanged" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <StackPanel Spacing="4">
                                <ComboBox x:Name="TargetMonitorBox" Header="Show on monitor" SelectionChanged="OnSelectionChanged" Width="260">
                                    <ComboBoxItem Content="Primary monitor" Tag="Primary" />
                                    <ComboBoxItem Content="Monitor with cursor" Tag="Cursor" />
                                </ComboBox>
                                <TextBlock Text="Choose whether the island stays on your primary display or automatically moves to whichever monitor your mouse cursor is currently on."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <ComboBox x:Name="ChosenAppsModeBox" Header="Chosen apps rule" SelectionChanged="OnSelectionChanged" Width="260">
                                    <ComboBoxItem Content="Disabled" Tag="Disabled" />
                                    <ComboBoxItem Content="Hide while one is in front" Tag="Hide" />
                                    <ComboBoxItem Content="Only show while one is in front (Keep)" Tag="Keep" />
                                </ComboBox>
                                <TextBlock Text="Automatically hide the island—or show it exclusively—whenever one of your listed apps below becomes the active foreground window."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBox x:Name="ChosenAppsBox"
                                         Header="Chosen process names (comma-separated, e.g. chrome, notepad)"
                                         Width="360"
                                         HorizontalAlignment="Left"
                                         TextChanged="OnChosenAppsChanged" />
                                <TextBlock Text="Enter executable names without .exe, separated by commas. Used by the Chosen apps rule above."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- ░░ Notch Indicators ░░ -->
                    <StackPanel x:Name="SectionIndicators" Spacing="0" Visibility="Collapsed">
                        <!-- Show clock -->
                        <StackPanel Spacing="8" Padding="0,10">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Show clock" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Display the current time on the folded island so you can glance at it anytime."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowClockToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                            <StackPanel Margin="20,0,0,0" Spacing="6" Visibility="{x:Bind ShowClockToggle.IsOn, Mode=OneWay}">
                                <CheckBox x:Name="TimeFormat24HCheck" Content="24-hour format (e.g. 14:30 vs 2:30 PM)" Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
                                <CheckBox x:Name="ShowSecondsCheck" Content="Show seconds" Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Show battery -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Show battery percentage &amp; status" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Show remaining battery percentage and charging icon on the folded island."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShowBatteryToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Temperature -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Show temperature on folded island" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Display current outdoor temperature and weather icon for your configured city."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="WeatherTempOnIslandToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Mic dot -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Microphone indicator dot on folded island" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Show a privacy indicator dot whenever an application is actively recording from your microphone."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="MicDotToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Cam dot -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Camera indicator dot on folded island" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Show a green privacy indicator dot whenever an application is using your webcam."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CamDotToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- CPU usage -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="CPU usage on folded island" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Show live processor utilization percentage on the folded island."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShowCpuNotchToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- RAM usage -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="RAM usage on folded island" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Show live system memory usage percentage on the folded island."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShowRamNotchToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Disk usage -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Disk usage on folded island" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Show live storage drive activity percentage on the folded island."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShowDiskNotchToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- GPU usage -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="GPU usage on folded island" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Show live graphics card utilization percentage on the folded island."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShowGpuNotchToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Download speed -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Download speed on folded island" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Display real-time incoming network bandwidth on the folded island."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShowDownSpeedNotchToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Upload speed -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Upload speed on folded island" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Display real-time outgoing network bandwidth on the folded island."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShowUpSpeedNotchToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                    </StackPanel>

                    <!-- ░░ Clock & Calendar ░░ -->
                    <StackPanel x:Name="SectionClock" Spacing="10" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <ComboBox x:Name="CalendarClockStyleBox"
                                      Header="Clock style in Date &amp; Calendar tab"
                                      SelectionChanged="OnSelectionChanged"
                                      Width="260">
                                <ComboBoxItem Content="Digital" Tag="Digital" />
                                <ComboBoxItem Content="Digital with seconds" Tag="DigitalSeconds" />
                                <ComboBoxItem Content="Analog" Tag="Analog" />
                                <ComboBoxItem Content="Analog with seconds" Tag="AnalogSeconds" />
                                <ComboBoxItem Content="Analog classic (numbers &amp; ticks)" Tag="AnalogClassic" />
                            </ComboBox>
                            <TextBlock Text="Choose whether the Date &amp; Calendar tab shows a digital readout or an analog clock face."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="8" Margin="0,8,0,0" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="World clocks" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Add, reorder, or remove custom place clocks shown in the island's Date &amp; Calendar tab. Changes sync in real time and persist across restarts."
                                       FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="SettingsClockPlaceBox"
                                         PlaceholderText="Place name (e.g. Paris)"
                                         Width="170" />
                                <ComboBox x:Name="SettingsClockTzBox"
                                          PlaceholderText="Select time zone"
                                          Width="270" />
                                <Button x:Name="SettingsAddClockBtn"
                                        Content="Add"
                                        Click="SettingsAddClockBtn_Click"
                                        Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                            <StackPanel x:Name="SettingsWorldClocksList" Spacing="6" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ░░ Media & Lyrics ░░ -->
                    <StackPanel x:Name="SectionMedia" Spacing="14" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <ComboBox x:Name="MediaPlayerStyleBox"
                                      Header="Player style on Home"
                                      SelectionChanged="OnSelectionChanged"
                                      Width="300">
                                <ComboBoxItem Content="Compact (album art + subtle glow)" Tag="Compact" />
                                <ComboBoxItem Content="Fill (whole player in album colors)" Tag="Fill" />
                                <ComboBoxItem Content="Soft mirror (centered art + blurred sides)" Tag="SoftMirror" />
                            </ComboBox>
                            <TextBlock Text="Select how album artwork and background colors are rendered in the expanded media player."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="The pill while music plays" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="&quot;With the name&quot;: the track and a bar of its time. &quot;Mini player&quot;: the cover, the bar and the buttons; a click opens the island, not the cursor. &quot;With the words&quot;: the line being sung (needs &quot;Show lyrics beside the player&quot; below)."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="560" />
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="MediaPillUsualBtn" Content="Usual" Tag="Usual"
                                            Click="OnMediaPillModeClick" BorderThickness="0" CornerRadius="6" Padding="12,6" />
                                    <Button x:Name="MediaPillWithNameBtn" Content="With the name" Tag="WithName"
                                            Click="OnMediaPillModeClick" BorderThickness="0" CornerRadius="6" Padding="12,6" />
                                    <Button x:Name="MediaPillMiniPlayerBtn" Content="Mini player" Tag="MiniPlayer"
                                            Click="OnMediaPillModeClick" BorderThickness="0" CornerRadius="6" Padding="12,6" />
                                    <Button x:Name="MediaPillWithWordsBtn" Content="With the words" Tag="WithWords"
                                            Click="OnMediaPillModeClick" BorderThickness="0" CornerRadius="6" Padding="12,6" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid ColumnSpacing="16" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Show lyrics beside the player" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="When the playing track has lyrics they appear next to the player card on the Home tab. Turn this off to keep the player at full width and skip the lyrics lookup."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="LyricsToggle"
                                          Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnSettingChanged" />
                        </Grid>
                    </StackPanel>

                    <!-- ░░ Event Cards ░░ -->
                    <StackPanel x:Name="SectionCards" Spacing="0" Visibility="Collapsed">
                        <!-- Caps Lock -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Caps Lock on/off notification" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Show a quick card whenever you toggle Caps Lock so you always know its state."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CardCapsLockToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Num Lock -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Num Lock on/off notification" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Show a quick card whenever you toggle Num Lock on your keyboard."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CardNumLockToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Delete key warning + custom keys -->
                        <StackPanel Spacing="8" Padding="0,10">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Delete key press warning" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Flash a brief warning card when the Delete key is pressed to help prevent accidental deletions."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CardDeleteKeyWarningToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                            <StackPanel Spacing="4">
                                <TextBox x:Name="CardCustomKeyWarningsBox"
                                         Width="360"
                                         HorizontalAlignment="Left"
                                         Header="Custom key warnings (comma-separated)"
                                         PlaceholderText="e.g. Insert, PrintScreen, F12"
                                         TextChanged="OnCustomKeyWarningsChanged" />
                                <TextBlock Text="Add extra key names to trigger a quick warning card whenever any of them is pressed."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Volume -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Volume adjustments (+ mouse wheel)" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Show a live volume bar card when volume changes, and allow scrolling on the island to adjust volume."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CardVolumeToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Clipboard -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Clipboard copy (text and images)" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Preview newly copied text snippets and images briefly on the island."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CardClipboardToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Screenshot -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Screenshot saved alert" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Show a thumbnail preview card with quick open actions whenever a screenshot is saved."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CardScreenshotToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Downloads -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Downloads" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Show download progress and a completion card with a shortcut to the finished file."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CardDownloadsToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- File copy progress -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="File copy progress" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Show a live progress bar card while Windows Explorer copies or moves files."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CardFileCopyToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- VPN -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="VPN connect / disconnect" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Notify you on the island when a VPN connection starts or drops."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CardVpnToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Low battery -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Low battery alert (20 %, 10 %, 5 %)" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Display an urgent battery warning card when charge drops to 20%, 10%, or 5%."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CardBatteryLowToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Charger plugged/unplugged -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Charger plugged / unplugged" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Show a confirmation card when power adapter is connected, disconnected, or reaches 100%."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CardChargingToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Mic usage -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Microphone usage detected" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Alert you with a card (including a quick system-wide mute button) when an app activates your microphone."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CardMicToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Cam usage -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Camera usage detected" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Alert you with a card showing which app started recording from your webcam."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CardCamToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="8" Padding="0,12,0,4">
                            <StackPanel Spacing="4">
                                <ComboBox x:Name="CardStayBox" Header="Card display duration" SelectionChanged="OnCardStaySelectionChanged" Width="260">
                                    <ComboBoxItem Content="Brief (1.0s)" Tag="1s" />
                                    <ComboBoxItem Content="Shorter (2.0s)" Tag="Shorter" />
                                    <ComboBoxItem Content="Usual (3.5s)" Tag="Usual" />
                                    <ComboBoxItem Content="Longer (6.0s)" Tag="Longer" />
                                    <ComboBoxItem Content="Custom" Tag="Custom" />
                                </ComboBox>
                                <TextBlock Text="Set how long temporary notification cards remain expanded before collapsing back into the island."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="CardStayCustomPanel" Spacing="4" Visibility="Collapsed" Margin="0,2,0,0">
                                <TextBlock x:Name="CardStayCustomLabel" Text="Custom duration: 4.0 s" FontSize="12" Opacity="0.8" />
                                <Slider x:Name="CardStayCustomSlider"
                                        Minimum="0.5"
                                        Maximum="30"
                                        StepFrequency="0.5"
                                        TickFrequency="5"
                                        Width="260"
                                        HorizontalAlignment="Left"
                                        ValueChanged="OnCardStayCustomSliderChanged" />
                            </StackPanel>

                            <!-- Windows Notifications — unavailable without package identity -->
                            <StackPanel Spacing="4" Opacity="0.65" Margin="0,6,0,0">
                                <TextBlock Text="Windows Notifications" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Text="Not available in this build — AppLock runs as an unpackaged app. Package identity (MSIX) is required to listen to Windows notifications." />
                                <HyperlinkButton Content="Open Windows Notification Settings"
                                                 NavigateUri="ms-settings:notifications" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- ░░ Controls Tab ░░ -->
                    <StackPanel x:Name="SectionControls" Spacing="0" Visibility="Collapsed">
                        <!-- Close after quick card -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Close Island after running a quick-action card" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Automatically fold the island back down right after you trigger a quick action such as Mute or Lock."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ControlsCloseAfterCardToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Show BT battery card -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Show Bluetooth battery card" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Display a quick card inside the Controls tab listing connected Bluetooth accessories and their battery levels."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ControlsShowBtBatteryCardToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Show BT battery on folded island -->
                        <StackPanel Spacing="10" Padding="0,10">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Show connected Bluetooth battery on folded island" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Pin the battery level of your active Bluetooth headset or device directly onto the folded island."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ControlsShowBtBatteryOnIslandToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                            <StackPanel Margin="20,0,0,0" Spacing="10" Visibility="{x:Bind ControlsShowBtBatteryOnIslandToggle.IsOn, Mode=OneWay}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Show multiple connected devices on folded island" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="Display every connected Bluetooth audio/input device side-by-side (expands folded island width)."
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ControlsShowMultipleBtOnIslandToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                                </Grid>
                                <StackPanel Spacing="4">
                                    <ComboBox x:Name="ControlsBtBatteryIslandStyleBox"
                                              Header="Folded Bluetooth battery display"
                                              SelectionChanged="OnSelectionChanged"
                                              Width="280">
                                        <ComboBoxItem Content="Device icon + percentage (e.g. 🎧 100%)" Tag="IconAndPercent" />
                                        <ComboBoxItem Content="Device icon + battery icon (e.g. 🎧 🔋)" Tag="IconAndBattery" />
                                        <ComboBoxItem Content="Device icon + battery + percentage" Tag="IconBatteryAndPercent" />
                                    </ComboBox>
                                    <TextBlock Text="Choose how Bluetooth battery status is formatted on the folded pill."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Bluetooth battery warning notifications -->
                        <StackPanel Spacing="10" Padding="0,10">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Bluetooth battery warning notifications" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Trigger a low-battery warning card when a connected Bluetooth device drops below your chosen thresholds."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ControlsBtLowBatteryAlertToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                            </Grid>
                            <StackPanel Margin="20,0,0,0" Spacing="10" Visibility="{x:Bind ControlsBtLowBatteryAlertToggle.IsOn, Mode=OneWay}">
                                <StackPanel Spacing="4">
                                    <TextBox x:Name="ControlsBtWarningLevelsBox"
                                             Width="280"
                                             HorizontalAlignment="Left"
                                             Header="Warning levels (% below, comma-separated)"
                                             PlaceholderText="e.g. 80, 50, 20, 10"
                                             TextChanged="OnBtWarningLevelsChanged" />
                                    <TextBlock Text="Comma-separated battery percentages at which an alert fires as the device discharges."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Also show in Windows notifications" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="Send a Windows system tray toast in addition to the island warning card."
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ControlsBtWarningWindowsNotificationToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Brightness slider -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Show Brightness slider" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Include a screen brightness slider inside the Controls tab."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ControlsShowBrightnessToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Microphone control -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Show Microphone control" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Include a system-wide microphone mute/unmute control and input level slider in Controls."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ControlsShowMicrophoneToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Power buttons row -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Show Power buttons row" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Display Lock, Sleep, Restart, and Shut down quick-action buttons at the bottom of Controls."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ControlsShowPowerRowToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Padding="0,12,0,0">
                            <Button x:Name="ControlsResetCardsBtn"
                                    Content="Reset Quick Cards to Defaults"
                                    Click="ControlsResetCardsBtn_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ░░ Weather ░░ -->
                    <StackPanel x:Name="SectionWeather" Spacing="12" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Configured City" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Enter a city name to fetch local forecasts and current temperature for the Weather tab and folded indicator."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBox x:Name="WeatherCityBox" Width="260" PlaceholderText="e.g. London, Tokyo, New York" />
                                <Button x:Name="WeatherSearchBtn" Content="Set City" Click="WeatherSearchBtn_Click" />
                            </StackPanel>
                            <TextBlock x:Name="WeatherCityStatus" FontSize="11" Opacity="0.6"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <ComboBox x:Name="WeatherUnitsBox" Header="Units" SelectionChanged="OnSelectionChanged" Width="260">
                                <ComboBoxItem Content="Metric (°C · m/s)" Tag="metric" />
                                <ComboBoxItem Content="Imperial (°F · mph)" Tag="imperial" />
                            </ComboBox>
                            <TextBlock Text="Switch between Celsius / meters-per-second and Fahrenheit / miles-per-hour."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid ColumnSpacing="16" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Warn about rain and snow" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Pop up an alert card roughly one hour before rain or snow is expected at your location."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="WeatherRainWarningToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                    </StackPanel>

                    <!-- ░░ Chat ░░ -->
                    <StackPanel x:Name="SectionChat" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Embedded web AI assistants (Gemini, DeepSeek, ChatGPT, and custom sites). Logins persist in your local user data folder."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                        <StackPanel Spacing="4">
                            <ComboBox x:Name="ChatIdleBox" Header="Idle release timeout" SelectionChanged="OnSelectionChanged" Width="260">
                                <ComboBoxItem Content="1 minute" Tag="1" />
                                <ComboBoxItem Content="3 minutes" Tag="3" />
                                <ComboBoxItem Content="5 minutes (default)" Tag="5" />
                                <ComboBoxItem Content="10 minutes" Tag="10" />
                                <ComboBoxItem Content="15 minutes" Tag="15" />
                            </ComboBox>
                            <TextBlock Text="Automatically unload the embedded WebView2 session after this period of inactivity to free RAM."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock x:Name="ChatRuntimeStatusText" FontSize="11" Opacity="0.6" />
                    </StackPanel>

                    <!-- ░░ Search Commands ░░ -->
                    <StackPanel x:Name="SectionSearch" Spacing="12" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Default Command Search Engine" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Choose which search engine opens when you type a plain query in the Command Bar."
                                           FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                                <ComboBox x:Name="DefaultSearchEngineBox"
                                          Header="Search engine"
                                          Width="220"
                                          SelectionChanged="OnDefaultSearchEngineChanged">
                                    <ComboBoxItem Content="Google" Tag="google" />
                                    <ComboBoxItem Content="Bing" Tag="bing" />
                                    <ComboBoxItem Content="DuckDuckGo" Tag="duckduckgo" />
                                    <ComboBoxItem Content="Custom" Tag="custom" />
                                </ComboBox>
                                <TextBox x:Name="CustomDefaultSearchUrlBox"
                                         Header="Custom search URL"
                                         PlaceholderText="https://example.com/search?q={query}"
                                         Visibility="Collapsed"
                                         TextChanged="OnCustomDefaultSearchUrlChanged" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Quick Web Searches in Command Bar" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Type @command followed by your search term in the Command Bar (e.g. @youtube nepali music, @github winui, @amazon laptop). You can add custom searches or reset to defaults below."
                                           FontSize="12" Opacity="0.75" TextWrapping="Wrap" />

                                <!-- Add Custom Search Form -->
                                <TextBlock Text="Add New Search Command" FontWeight="Medium" FontSize="12" Margin="0,4,0,0" />
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewSearchCommandBox"
                                             Grid.Column="0"
                                             PlaceholderText="@tag (e.g. @wiki)" />
                                    <TextBox x:Name="NewSearchNameBox"
                                             Grid.Column="1"
                                             PlaceholderText="Name (e.g. Wikipedia)" />
                                    <TextBox x:Name="NewSearchUrlBox"
                                             Grid.Column="2"
                                             PlaceholderText="URL (e.g. https://en.wikipedia.org/wiki/Special:Search?search=)" />
                                    <Button x:Name="AddSearchBtn"
                                            Grid.Column="3"
                                            Click="AddSearchBtn_Click"
                                            ToolTipService.ToolTip="Add Search Command">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                                            <TextBlock Text="Add" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="SearchCommandValidationText" FontSize="11" Foreground="#FF6B6B" Visibility="Collapsed" />

                                <!-- Search Commands List Header -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Configured Search Commands" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" />
                                    <Button x:Name="ResetSearchesBtn"
                                            Grid.Column="1"
                                            Content="Reset to Defaults"
                                            FontSize="11"
                                            Padding="8,4"
                                            Click="ResetSearchesBtn_Click" />
                                </Grid>

                                <Border BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        CornerRadius="6"
                                        MaxHeight="260"
                                        Padding="6">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="SearchCommandsListPanel" Spacing="4" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ░░ Performance ░░ -->
                    <StackPanel x:Name="SectionPerformance" Spacing="0" Visibility="Collapsed">
                        <!-- Lite mode -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Lite mode" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Use fewer visual effects (solid background, 120 ms fades) to minimize GPU and CPU usage."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="LiteModeToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Reduced motion -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Reduced motion" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Switch to fast 80 ms transitions and disable animated equalizers for a calmer, snappier feel."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ReducedMotionToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Hide from screenshots & recordings -->
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Hide island from screenshots and screen recordings" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Exclude the island window from screen capture tools, streams, and screenshots. Turn off if your recording software flags capture protection."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ExcludeFromCaptureToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnSettingChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Opening Animation Duration (ms)" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Control how quickly the island expands when hovered or triggered."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Slider x:Name="AnimationDurationSlider" Width="320" HorizontalAlignment="Left"
                                        Minimum="80" Maximum="1000" StepFrequency="20" TickFrequency="100"
                                        ValueChanged="OnDelaySliderChanged" />
                                <TextBlock x:Name="AnimationDurationLabelText" FontSize="12" Opacity="0.6"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Closing Animation Duration (ms)" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Control how quickly the island folds back into its compact pill."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Slider x:Name="CloseAnimationDurationSlider" Width="320" HorizontalAlignment="Left"
                                        Minimum="80" Maximum="1000" StepFrequency="20" TickFrequency="100"
                                        ValueChanged="OnDelaySliderChanged" />
                                <TextBlock x:Name="CloseAnimationDurationLabelText" FontSize="12" Opacity="0.6"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Hover Open Delay (ms)" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="How long the cursor must rest over the folded island before it automatically opens."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Slider x:Name="OpenDelaySlider" Width="320" HorizontalAlignment="Left"
                                        Minimum="0" Maximum="600" StepFrequency="25" TickFrequency="50"
                                        ValueChanged="OnDelaySliderChanged" />
                                <TextBlock x:Name="OpenDelayLabelText" FontSize="12" Opacity="0.6"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Hover Close Delay (ms)" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Grace period after your cursor leaves the expanded island before it folds shut."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Slider x:Name="CloseDelaySlider" Width="320" HorizontalAlignment="Left"
                                        Minimum="0" Maximum="1500" StepFrequency="50" TickFrequency="100"
                                        ValueChanged="OnDelaySliderChanged" />
                                <TextBlock x:Name="CloseDelayLabelText" FontSize="12" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- ░░ About & Developer ░░ -->
                    <StackPanel x:Name="SectionAbout" Spacing="16" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Network &amp; Privacy Summary" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="• MET Norway: Weather forecasts queried from api.met.no&#x0a;• OpenStreetMap Nominatim: City location search queried from nominatim.openstreetmap.org&#x0a;• Chat Tab: Selected AI assistants run directly in sandboxed WebView2&#x0a;• Shortcuts Bar: Favicon icons downloaded directly for pinned web links&#x0a;• Zero Telemetry: No analytics, tracking or crash data is transmitted&#x0a;• 100% Local Storage: All notes, history, shelf and caches stay in %LOCALAPPDATA%\AppLock\island\"
                                           FontSize="12"
                                           Opacity="0.8"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="Credits &amp; Open-Source Licenses" FontWeight="SemiBold" FontSize="13" Margin="0,6,0,0" />
                                <TextBlock Text="• ZXing.Net (Apache License 2.0) — QR code generation&#x0a;• MET Norway Weather API (CC BY 4.0) — Forecast data&#x0a;• OpenStreetMap contributors (ODbL) — Geocoding data&#x0a;• Microsoft Windows App SDK &amp; WinUI 3 (MIT License)"
                                           FontSize="12"
                                           Opacity="0.8"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Developer Tools" FontWeight="SemiBold" FontSize="13" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Show live frame-time &amp; FPS overlay on the island" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="Display real-time rendering frame rate and composition timing on the island for diagnostics."
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="FrameStatsToggle"
                                                  Grid.Column="1"
                                                  OnContent=""
                                                  OffContent=""
                                                  MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Toggled="OnSettingChanged" />
                                </Grid>

                                <Button x:Name="RunBenchmarkBtn"
                                        Content="Run Animation Benchmark (Cycles: 50 open/close)"
                                        Click="RunBenchmarkBtn_Click" />

                                <TextBlock x:Name="BenchmarkResultText"
                                           Text="No benchmark executed in this session."
                                           FontSize="12"
                                           Opacity="0.7"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
