<Page
    x:Class="AppLock.Views.FirstRunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" 
                    MaxWidth="400" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Spacing="24">
            
            <!-- Welcome Header -->
            <StackPanel Spacing="8">
                <TextBlock Text="Welcome to AppLock" 
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Set up your admin password to get started" 
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>

            <!-- Password Setup Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Create Admin Password" 
                               Style="{ThemeResource SubtitleTextBlockStyle}"/>

                    <PasswordBox x:Name="PasswordBox"
                                 Header="Password (minimum 6 characters)"
                                 PlaceholderText="Enter password"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Header="Confirm Password"
                                 PlaceholderText="Re-enter password"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <TextBlock x:Name="ErrorText"
                               Foreground="{ThemeResource SystemErrorTextColor}"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"/>

                    <Button x:Name="SetupButton"
                            Content="Continue"
                            Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="SetupButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Info -->
            <TextBlock Text="Your password will be securely hashed and stored locally. It cannot be recovered if forgotten."
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Page>
