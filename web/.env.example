# Public Firebase web configuration. Copy to .env.local for development.
#
# These values identify the project; they are not secrets and they authorise
# nothing on their own. Never add a service account, admin credential, refresh
# token or Sync passphrase to any VITE_ variable: everything here ships to the
# browser.
#
# For the emulator suite use the demo project id below and the emulator ports.

VITE_FIREBASE_API_KEY=AIzaSyA0LX7rlE76BqjArQxDrRc2RNI5vR9I2c0
VITE_FIREBASE_AUTH_DOMAIN=meroapplock.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://meroapplock-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=meroapplock
VITE_FIREBASE_APP_ID=1:1017717437647:web:d189427eb56f2d170273ba

# Set to 1 to point the SDKs at the local emulator suite (milestone 3).
VITE_USE_EMULATORS=0

# App Check debug token for local development. Register it in the console and
# never commit the real value.
VITE_APPCHECK_DEBUG_TOKEN=


