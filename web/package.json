{
  "name": "applock-sync-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "AppLock Sync web dashboard (Svelte + TypeScript + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check && npm run build"
  },
  "dependencies": {
    "firebase": "^11.10.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.5",
    "svelte": "^5.38.7",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
